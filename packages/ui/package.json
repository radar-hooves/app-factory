{
	"name": "@poodle64/ui",
	"version": "2026.9.19",
	"description": "Household shared component layer: shadcn-svelte primitives (bits-ui) plus the composed page chrome every app builds its routes from, restyled by each app's @poodle64/design-tokens alias layer. One fix reaches every app.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/radar-hooves/design-system.git"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public",
		"provenance": false
	},
	"files": [
		"bin",
		"dist",
		"registry"
	],
	"exports": {
		"./package.json": "./package.json",
		"./styles.css": "./dist/styles.css",
		"./utils": {
			"types": "./dist/utils.d.ts",
			"svelte": "./dist/utils.js"
		},
		"./format": {
			"types": "./dist/format.d.ts",
			"svelte": "./dist/format.js"
		},
		"./telemetry": {
			"types": "./dist/telemetry.d.ts",
			"svelte": "./dist/telemetry.js"
		},
		"./feedback": {
			"types": "./dist/components/feedback/index.d.ts",
			"svelte": "./dist/components/feedback/index.js"
		},
		"./*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js"
		}
	},
	"bin": {
		"ds-check-colour-surface": "bin/check-colour-surface.mjs"
	},
	"peerDependencies": {
		"bits-ui": "^2.18.1",
		"formsnap": "^2.0.1",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.33.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.0"
	},
	"peerDependenciesMeta": {
		"mode-watcher": {
			"optional": true
		},
		"svelte-sonner": {
			"optional": true
		},
		"formsnap": {
			"optional": true
		},
		"sveltekit-superforms": {
			"optional": true
		}
	},
	"dependencies": {
		"@grafana/faro-web-sdk": "^2.11.0",
		"@grafana/faro-web-tracing": "^2.11.0",
		"@jsonforms/core": "^3.8.0",
		"@lucide/svelte": "^1.25.0",
		"@tanstack/table-core": "^8.21.3",
		"clsx": "^2.1.1",
		"html-to-image": "^1.11.13",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@poodle64/design-tokens": "workspace:*",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/cli": "^4.3.2",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.1",
		"bits-ui": "^2.18.1",
		"formsnap": "^2.0.1",
		"jsdom": "^29.1.1",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.62.0",
		"publint": "^0.3.15",
		"svelte": "^5.56.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"scripts": {
		"build": "node scripts/generate-registry.mjs && svelte-kit sync && svelte-package && publint",
		"registry": "node scripts/generate-registry.mjs",
		"registry:check": "node scripts/generate-registry.mjs --check",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "pnpm run build && vitest run",
		"test:browser": "pnpm run harness:build && node harness/drive.mjs",
		"prepublishOnly": "pnpm run build",
		"harness:build": "vite build --config harness/vite.config.ts && tailwindcss -i harness/harness.css -o harness/dist/app.css --minify",
		"harness:serve": "python3 -m http.server 4180 --directory harness/dist"
	},
	"packageManager": "pnpm@10.28.0"
}
