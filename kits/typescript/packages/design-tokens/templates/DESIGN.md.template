# Per-app DESIGN.md — North Star format.
# YAML front matter: normative token overrides and palette choices.
# Markdown prose: intent the tokens cannot encode.
# Agents and contributors read this file before generating or reviewing any UI.
# When this file and shared-design-language.md diverge, the shared language wins
# on structure; this file wins on per-app brand colour and prose direction.
#
# Fill in every REQUIRED field. Delete or comment out OPTIONAL fields that do
# not apply. Keep this file under 20 KB; move long component contracts to docs/.
#
# Binding invariants (no per-app exception):
#   corner radius base: 0.625rem (--ds-radius-lg)
#   fonts: Fraunces (display), Avenir Next -> Hanken Grotesk Variable (body), JetBrains Mono (code)
#   status vocabulary: success / warning / error / info / neutral
#   colour space: oklch
#   CSS namespace: --ds-*
#   token format: DTCG 2025.10, consumed by Style Dictionary v4

name: YOUR_APP_NAME                          # REQUIRED — kebab-case preferred
description: >-                             # REQUIRED — one sentence
  One-sentence aesthetic direction.
  E.g. "Calm, dense control plane on warm-paper surfaces with a eucalyptus-green
  accent and a fixed vivid status palette. Light-first, dark available."

version: 2026.7.3                           # CalVer; bump when tokens change
mode: light-first                           # light-first | dark-first | equal

# ---------------------------------------------------------------------------
# Brand primary — the ONE action accent. Override --ds-color-primary in :root.
# Everything else in the shared token sheet is used as-is.
#
# The constraint is a FILL constraint, and that is the whole constraint:
# --ds-color-primary must meet WCAG AA (>=4.5:1) against its OWN -foreground
# pair, in both modes — primary as a background with text on top. No shared
# component paints it as ink on chrome, so a light or high-lightness brand hue
# costs you nothing in legibility. Pick the hue your brand wants.
# ---------------------------------------------------------------------------
primary:
  light: oklch(0.50 0.155 XXX)              # REQUIRED — pick a hue (XXX = 0-360)
  dark: oklch(0.70 0.140 XXX)               # REQUIRED — lighter for dark mode
  foreground-light: oklch(0.99 0.005 XXX)   # text on primary button (light)
  foreground-dark: oklch(0.20 0.030 XXX)    # text on primary button (dark)

# ---------------------------------------------------------------------------
# Colour overrides (OPTIONAL).
# Only list tokens that differ from the shared design-system defaults.
# The shared defaults live in tokens/tokens.tokens.json.
# Do NOT redefine the status palette; it is binding and fixed.
# ---------------------------------------------------------------------------
# colours:
#   light:
#     background: oklch(...)       # override shared default
#   dark:
#     background: oklch(...)

# ---------------------------------------------------------------------------
# Typography (OPTIONAL override notes only — families are binding).
# Families: Fraunces (display), Avenir Next -> Hanken Grotesk Variable (body),
# JetBrains Mono (code). These cannot be changed per app. Notes here are for
# scale or usage intent.
# ---------------------------------------------------------------------------
typography:
  notes: >-
    Page titles use Fraunces display-l (1.75rem/600/-0.02em).
    Body defaults to the body face at 0.9375rem/1.4: Avenir Next on Apple
    devices, Hanken Grotesk Variable everywhere else.
    Any machine-produced value (ID, timestamp, amount) uses JetBrains Mono.

# ---------------------------------------------------------------------------
# Radius (OPTIONAL — shared defaults apply; document if you use a tighter scale)
# Binding base: --ds-radius-lg = 0.625rem. Derived: sm (chips), xl (dialogues).
# ---------------------------------------------------------------------------
# rounded:
#   note: "tighter than default — security UI reads as more precise"
#   lg: 0.5rem    # override base radius only if you have a documented reason

# ---------------------------------------------------------------------------
# Spacing (OPTIONAL — notes only)
# The named scale ships as --ds-spacing-* CSS variables for hand-written CSS.
# It is NOT in the Tailwind @theme block: a named --spacing-* entry captures
# w-*/max-w-*/min-w-*/basis-* off the container scale. In markup use the
# numeric scale — p-1 / p-2 / p-4 / p-6 / p-8 / p-12 are xs…2xl.
# ---------------------------------------------------------------------------
# spacing:
#   notes: "cards use p-4; page gutters px-8"
