{
	"name": "@poodle64/ui",
	"version": "2026.11.13",
	"description": "Household shared component layer: shadcn-svelte primitives (bits-ui) plus the composed page chrome every app builds its routes from, restyled by each app's @poodle64/design-tokens alias layer. One fix reaches every app.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/radar-hooves/app-factory.git",
		"directory": "kits/typescript/packages/ui"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public",
		"provenance": true
	},
	"files": [
		"bin",
		"dist",
		"registry"
	],
	"exports": {
		"./package.json": "./package.json",
		"./styles.css": "./dist/styles.css",
		"./utils": {
			"types": "./dist/utils.d.ts",
			"svelte": "./dist/utils.js"
		},
		"./format": {
			"types": "./dist/format.d.ts",
			"svelte": "./dist/format.js"
		},
		"./telemetry": {
			"types": "./dist/telemetry.d.ts",
			"svelte": "./dist/telemetry.js"
		},
		"./updater": {
			"types": "./dist/updater.svelte.d.ts",
			"svelte": "./dist/updater.svelte.js"
		},
		"./feedback": {
			"types": "./dist/components/feedback/index.d.ts",
			"svelte": "./dist/components/feedback/index.js"
		},
		"./alerts": {
			"types": "./dist/components/alerts/index.d.ts",
			"svelte": "./dist/components/alerts/index.js"
		},
		"./settings": {
			"types": "./dist/components/settings/index.d.ts",
			"svelte": "./dist/components/settings/index.js"
		},
		"./icons/*": {
			"types": "./dist/icons/*.svelte.d.ts",
			"svelte": "./dist/icons/*.svelte"
		},
		"./*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js"
		}
	},
	"bin": {
		"ds-check-colour-surface": "bin/check-colour-surface.mjs",
		"ds-icons-from-lucide": "bin/icons-from-lucide.mjs"
	},
	"peerDependencies": {
		"@tauri-apps/api": "^2.0.0",
		"@tauri-apps/plugin-process": "^2.0.0",
		"@tauri-apps/plugin-updater": "^2.0.0",
		"bits-ui": "^2.18.1",
		"formsnap": "^2.1.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.33.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.0 || ^3.0.0"
	},
	"peerDependenciesMeta": {
		"@tauri-apps/api": {
			"optional": true
		},
		"@tauri-apps/plugin-process": {
			"optional": true
		},
		"@tauri-apps/plugin-updater": {
			"optional": true
		},
		"formsnap": {
			"optional": true
		},
		"mode-watcher": {
			"optional": true
		},
		"svelte-sonner": {
			"optional": true
		},
		"sveltekit-superforms": {
			"optional": true
		}
	},
	"dependencies": {
		"@cfworker/json-schema": "^4.1.6",
		"@grafana/faro-web-sdk": "^2.11.0",
		"@grafana/faro-web-tracing": "^2.11.0",
		"@jsonforms/core": "^3.8.0",
		"@tanstack/table-core": "^8.21.3",
		"clsx": "^2.1.1",
		"d3-force": "^3.0.0",
		"esm-env": "^1.2.2",
		"html-to-image": "^1.11.13",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^4.0.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@phosphor-icons/core": "^2.1.1",
		"@poodle64/design-tokens": "workspace:*",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/cli": "^4.3.2",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^26.0.0",
		"axe-core": "^4.14.0",
		"bits-ui": "^2.18.1",
		"formsnap": "^2.1.0",
		"jsdom": "^31.0.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.62.0",
		"publint": "^0.3.15",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^3.1.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.5"
	},
	"scripts": {
		"build": "node scripts/generate-registry.mjs && node scripts/generate-icons.mjs && svelte-package && publint",
		"registry": "node scripts/generate-registry.mjs",
		"registry:check": "node scripts/generate-registry.mjs --check",
		"check": "node scripts/generate-icons.mjs && svelte-check --tsconfig ./tsconfig.json",
		"test": "pnpm run build && vitest run",
		"test:browser": "pnpm run harness:build && node harness/drive.mjs && node harness/graph.mjs",
		"prepublishOnly": "pnpm run build",
		"harness:build": "vite build --config harness/vite.config.ts && tailwindcss -i harness/harness.css -o harness/dist/app.css --minify",
		"harness:serve": "python3 -m http.server 4180 --directory harness/dist",
		"icons": "node scripts/generate-icons.mjs"
	},
	"packageManager": "pnpm@12.20.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
