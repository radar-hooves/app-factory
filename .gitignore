# ============================================================================
# Operating System
# ============================================================================
.DS_Store
._.DS_Store
Thumbs.db
desktop.ini

# ============================================================================
# Editor / IDE
# ============================================================================
.idea/
# Share the four VS Code config files. !.vscode/ re-includes the directory so the
# file allow-list can take effect even when a global git ignore excludes .vscode/.
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.swp
*.swo
*~

# ============================================================================
# Claude Code
# ============================================================================
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/.sessions/
.claude/worktrees/
.worktrees/
# Worktree governance-resolution shims (master-project#188). Provisioned by
# /master:setup-symlinks, never tracked: a worktree resolves its inherited
# master symlinks through the MAIN checkout's copy of these, so tracking them
# would put .claude/.claude/skills inside every worktree and register the whole
# skills pool a second time as worktree-scoped duplicates.
.claude/.claude
.claude/docs
.claude/rules-library

# ============================================================================
# Environment & Secrets
# ============================================================================
.env
.env.*
!.env.example
.envrc.local
.direnv/

