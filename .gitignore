logs/
*.log

# ============================================================================
# Project-Specific
# ============================================================================
# Style Dictionary build output — never edit by hand
dist/
# Generated situation→component map — regenerated by @poodle64/ui build from
# scripts/situations.json + source, shipped via package "files". Like dist/,
# it is generated, never edited by hand, so it is not committed.
packages/ui/registry/
# pnpm pack output
*.tgz
