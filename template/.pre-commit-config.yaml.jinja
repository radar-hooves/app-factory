default_language_version:
  python: python3.14

# Merge commits run no gate without pre-merge-commit; changing this needs `pre-commit install` re-run.
default_install_hook_types: [pre-commit, pre-merge-commit]

repos:
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.0
    hooks:
      - id: gitleaks
        name: 'security - Detect hardcoded secrets'

  - repo: local
    hooks:
      - id: check-pii
        name: 'security - Detect PII (names, mobiles, personal emails)'
        entry: household-precommit-pii
        language: system
        types: [text]

      - id: rules-fence
        name: 'governance - Rule content lands only at an open sunset-review sitting'
        entry: household-precommit-rules-fence
        language: system
        pass_filenames: true
        files: '^\.claude/rules/.*\.md$'

      - id: check-handoff-tracks-work
        name: 'governance - Handoff outstanding work is tracked'
        entry: household-precommit-handoff-tracking
        language: system
        files: '^docs/development/handoffs/.*\.md$'
        pass_filenames: true

      - id: check-handoff-status-chain
        name: 'governance - Handoff status chain is honest'
        entry: household-precommit-handoff-status
        language: system
        files: '^docs/development/handoffs/.*\.md$'
        pass_filenames: true

      # Wired late: tracks-work and status-chain were wired here 21/08; this
      # gate was not. Neither of the other two counts files, so drift past
      # the retention window would pass with both green.
      - id: check-handoff-retention
        name: 'governance - A new handoff prunes its folder'
        entry: household-precommit-handoff-retention
        language: system
        files: '^docs/development/handoffs/.*\.md$'
        pass_filenames: true

  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: end-of-file-fixer
        name: 'files - Fix end of files'
      - id: trailing-whitespace
        name: 'files - Trim trailing whitespace'
        args: [--markdown-linebreak-ext=md]
      - id: check-yaml
        name: 'yaml - Validate YAML syntax'
        args: [--unsafe]
      - id: check-toml
        name: 'toml - Validate TOML syntax'
      - id: check-json
        name: 'json - Validate JSON syntax'
      - id: check-merge-conflict
        name: 'git - Detect conflict markers'
      - id: check-added-large-files
        name: 'git - Block large file commits'
        args: ['--maxkb=5000']
      - id: check-case-conflict
        name: 'filesystem - Check case sensitivity'
      - id: detect-private-key
        name: 'security - Detect private keys'

  # Bounded to the trees an app keeps Python in. With no `files` pattern
  # these run on every staged .py anywhere in the repo, including one sitting
  # outside any tree with a [tool.ruff] above it — which ruff then lints and
  # REWRITES under its own defaults rather than under the app's config, at a
  # different line length. Inert in a template app, whose Python is all under
  # backend/; `scripts/` and `tools/` are each an app's own ratified
  # root-inventory name for root Python tooling (variants.yaml).
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.15.17
    hooks:
      - id: ruff
        name: 'python - Lint with ruff'
        args: [--fix]
        files: '^(backend|scripts|tools)/'
      - id: ruff-format
        name: 'python - Format with ruff'
        files: '^(backend|scripts|tools)/'

  # Keeps backend/uv.lock in sync with backend/pyproject.toml
  - repo: local
    hooks:
      - id: uv-lock-check
        name: 'uv - lockfile in sync'
        entry: uv lock --check --project backend
        language: system
        pass_filenames: false
        files: ^backend/(pyproject\.toml|uv\.lock)$

  # mypy runs here as well as in CI, so a type error cannot reach main via a
  # green local commit. pass_filenames: false because mypy resolves across
  # files, so it takes the whole tree exactly as CI does; `files` still gates
  # WHETHER it runs. Warm-cache cost is a fraction of a second.
  #
  # Piped through mypy-baseline so the gate fails on errors this change
  # INTRODUCES, not on debt the repo already carried. A gate that fails on the
  # day it lands gets disabled — the same baselined-debt discipline the drift
  # and craft gates already use. Pay debt down, then re-sync with
  # `cd backend && uv run mypy src | uv run mypy-baseline sync`.
  #
  # The baseline is a RATCHET by default: mypy-baseline fails when an entry has
  # been RESOLVED but left in the file, so it cannot stop shrinking and a fixed
  # error cannot silently become permitted again. Do NOT add --allow-unsynced;
  # that opts out of exactly that property. Measured safe — matching is on error
  # content, not line numbers, so editing above a banked error does not trip it.
  #
  # Not a bare pipe: bash reports the LAST stage's status, so
  # `mypy | mypy-baseline filter` hands back the FILTER's verdict, and the filter
  # exits 0 on empty stdin — a mypy that crashed passed the gate, having never
  # type-checked anything. `set -o pipefail` is not the fix either, because mypy
  # exits 1 on every error it finds, including the banked ones the baseline exists
  # to permit. mypy's own exit code is what separates the two: 0 and 1 are
  # mypy-baseline's call, 2 and above (a usage error, an INTERNAL ERROR, or uv
  # failing to launch mypy at all) are nobody's, so the hook exits with mypy's
  # status and reprints its stdout. The crash banner itself is on stderr and
  # reaches the terminal either way.
  #
  # Never name a specific app in a template file: the parity normaliser rewrites
  # an app's own name to a placeholder wherever it appears, so a comment naming
  # one makes that app — and only that app — fail the gate forever.
  - repo: local
    hooks:
      - id: mypy
        name: 'python - Type-check with mypy'
        entry: bash -c 'cd backend || exit; rc=0; out=$(uv run mypy src) || rc=$?; if [ "$rc" -ge 2 ]; then printf "%s\n" "$out"; exit "$rc"; fi; printf "%s\n" "$out" | uv run mypy-baseline filter'
        language: system
        pass_filenames: false
        files: ^backend/(src/.*\.py|pyproject\.toml|uv\.lock|mypy-baseline\.txt)$

  # Prettier is the frontend's only formatter, as ruff-format is the backend's.
  # Needs `pnpm install` in frontend/, like the two design gates below.
  #
  # The `cd` is load-bearing and the prefix strip goes with it: prettier
  # resolves a config's `plugins` entries against its own CWD, not against the
  # config file, so run from the repo root it finds frontend/.prettierrc and
  # then fails to load prettier-plugin-svelte from there. pre-commit hands
  # paths relative to the repo root, hence ${@#frontend/}.
  - repo: local
    hooks:
      - id: prettier
        name: 'frontend - Format with prettier'
        entry: bash -c 'cd frontend && exec node_modules/.bin/prettier --write --ignore-unknown "${@#frontend/}"' --
        language: system
        files: '^frontend/.*\.(svelte|ts|js|mjs|cjs|css|json|html)$'

  # Stylelint is the CSS half of the same job, and it is here because CI runs it
  # and nothing local did. Measured 2026-08-21: a root-font-size sweep put a
  # comment directly under a declaration in every app's `app.css`, `pnpm check`
  # (svelte-check) had nothing to say about it, and Frontend CI went red on main
  # in NINE apps for a day over one missing blank line. A gate that runs only in
  # CI is a gate the local loop cannot see.
  #
  # Same `cd` and prefix strip as prettier above, for the same reason: stylelint
  # resolves its config's plugins against its own CWD.
  - repo: local
    hooks:
      - id: stylelint
        name: 'frontend - Lint CSS with stylelint'
        entry: bash -c 'cd frontend && exec node_modules/.bin/stylelint --fix "${@#frontend/}"' --
        language: system
        files: '^frontend/.*\.(css|svelte)$'

  # ESLint is the third instance of the lesson stylelint's comment records, and
  # it was simply missed. Measured 2026-09-01: `no-this-alias` in a userscript
  # TEST file put one app's Frontend CI red for five days across nine runs.
  # `pnpm lint` is CI's FIRST step, so stylelint, svelte-check, the two design
  # gates and 582 unit tests never ran on main for those five days — one red
  # step hid five green ones.
  #
  # Same `cd` and prefix strip as the two above, for the same config-resolution
  # reason. Deliberately NO `--fix`: prettier and stylelint are formatters and
  # auto-applying them is safe, but ESLint carries semantic rules whose fixes
  # rewrite code that should be read first. This hook blocks and reports.
  # Flags are kept to none so local matches CI's bare `eslint .` exactly —
  # a local gate stricter than CI is its own kind of broken.
  - repo: local
    hooks:
      - id: eslint
        name: 'frontend - Lint JS/TS with eslint'
        entry: bash -c 'cd frontend && exec node_modules/.bin/eslint "${@#frontend/}"' --
        language: system
        files: '^frontend/.*\.(svelte|ts|js|mjs|cjs)$'

  # Catches craft defects every other gate is blind to — a nested card, a
  # side-tab accent border, gradient-text on a heading, decorative slop. It
  # compiles, renders, type-checks and passes its tests; it is only wrong once
  # a human looks at the rendered page (canonical-app-shape.md). The script
  # also has a --live mode that drives a real browser against a running dev
  # server; pre-commit deliberately runs static only.
  #
  # Gates on NEW hard findings only, against frontend/.design-craft-baseline.json
  # — a debt register, so it lands on a non-clean app and still fails forward.
  # Needs `pnpm install` in frontend/ (the script exits 2 with a clear message
  # if impeccable is missing).
  - repo: local
    hooks:
      - id: design-craft
        name: 'design - No new UI craft defects (slop, overflow, nesting)'
        entry: node frontend/scripts/check-design-craft.mjs
        language: system
        files: '^frontend/src/.*\.(svelte|css|ts)$'
        pass_filenames: false

  # The shadcn colour surface is the one class of breakage every other gate is
  # blind to: drop either load-bearing line from src/app.css and `build`, `lint`,
  # `lint:css` and `check` all still pass while bg-card, bg-muted, bg-accent,
  # bg-popover and border-input compile to no rule at all. That is
  # radar-hooves/design-system#3, which reached every app before anyone saw it.
  # Fast (no build, no browser): compiles app.css in-process and asserts the
  # utilities emit a real declaration and the package is still scanned.
  - repo: local
    hooks:
      - id: colour-surface
        name: 'design - The shadcn colour surface resolves'
        entry: node frontend/scripts/check-colour-surface.mjs
        language: system
        files: '^frontend/(src/app\.css|package\.json)$'
        pass_filenames: false

  # Catches the app hand-rolling what @poodle64/ui already ships — a local
  # component duplicating a shipped one, or a route writing its own <h1>
  # instead of composing the shared PageHeader. It compiles, renders,
  # type-checks and passes its tests, and is only wrong once a human sees it
  # does not match the rest of the app (canonical-app-shape.md).
  #
  # Gates on NEW findings only, against frontend/.ui-drift-baseline.json — a
  # debt register, so it lands on a non-clean app and still fails forward.
  # Needs `pnpm install` in frontend/ (the script exits 2 with a clear message
  # if @poodle64/ui is missing).
  - repo: local
    hooks:
      - id: design-drift
        name: 'design - No new UI drift (hand-rolled shared components)'
        entry: node frontend/scripts/check-ui-drift.mjs
        language: system
        files: '^frontend/src/.*\.svelte$'
        pass_filenames: false

  # The mechanical fence for master-project#839: a commit that edits a file the
  # factory owns is refused, derived every run from the factory's own file list
  # (`git ls-files template/` in check-template-parity.py's `stamped_files()`)
  # rather than a list hand-kept here — the same derivation canonical-shape.yaml
  # already runs in CI, now also at commit time, on THIS machine, before the
  # edit ever reaches a PR. `pass_filenames: false`: DRIFT can appear in any
  # owed file, not only a staged one, exactly like the mypy hook above.
  #
  # Reached through .claude/skills, the relative symlink `/master:setup-symlinks`
  # gives every repo under master-project's `repos/` (this repo carries the same
  # symlink itself) — never vendored, never a household PATH command, because
  # this check has no meaning off a machine that also holds the factory. A
  # missing symlink fails loudly rather than skipping quietly: a fence nobody
  # can see go dark is not a fence (core.md "a mechanical fence, not a sentence").
  #
  # Passes right after a genuine copier update: that operation re-renders the
  # owed files AND regenerates .template-parity.json in the same motion (either
  # `converge-to-template.py --apply`, or a plain `copier update` followed by
  # `check-template-parity.py --generate .` to resync the manifest — the second
  # step is the one a bare `copier update` does not do for you), so the file
  # this gate compares against moves with the files it is comparing.
  - repo: local
    hooks:
      - id: template-parity
        name: 'governance - No app edit to a file the factory owns'
        entry: >-
          bash -c 'set -eu;
          script=".claude/skills/canonical-app-migration/check-template-parity.py";
          if [ ! -f "$script" ]; then
            echo "template-parity: $script is missing — this checkout has no master-project symlinks (run /master:setup-symlinks), so the factory-file fence cannot run" >&2;
            exit 1;
          fi;
          python3 "$script" .'
        language: system
        pass_filenames: false

  # ────────────────────────── App-owned hooks ──────────────────────────────
  #
  # THE extension point for this file, and the reason nothing above needs an
  # exception. pre-commit has no include directive, so this file takes the same
  # terminal marker .gitignore, Dockerfile and .dockerignore already carry
  # (canonical-app-shape.md §Extension Points): everything above the line is the
  # factory's and is compared byte-for-byte in every app, and the app writes
  # only below it. Measured 03/09/2026: this was the single most-drifted file in
  # the fleet — four apps' Canonical Shape gate red on it alone, and three more
  # excepting the WHOLE file to carry one hook each.
  #
  # The tail is ENUMERATED, not open, and `check-canonical-shape.py` enforces
  # the enumeration rather than trusting this comment. Exactly three things are
  # true below the marker:
  #
  #   1. Only `- repo: local` entries. A tail is not a place to pin third-party
  #      tooling; a hook worth a supply-chain dependency is worth the template.
  #   2. No top-level key. YAML would happily accept an `exclude:` at column 0
  #      down here, and it would silently disarm every factory hook above — a
  #      far bigger hole than the one this closes.
  #   3. No hook `id:` that already appears above. A list entry cannot delete an
  #      earlier one, but a re-declared id is how "add a hook" becomes "soften a
  #      factory hook". A factory hook that is wrong for this app is wrong for
  #      the fleet: take it to the template, not below this line.
  #
  # Give each hook its reason, the way the factory's own do. A rule several apps
  # carry is a rule the factory should have — the tail is a derived dimension of
  # the fleet divergence report for exactly that reason.
  #
  # App-owned below this line; the factory owns everything above it.
