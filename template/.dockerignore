# Git
.git
.gitignore
.gitattributes

# Documentation (not needed in image)
docs/
DESIGN.md
*.md
!README.md

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/

# Python. `**/` because a .dockerignore pattern is anchored at the context
# root: a bare `.venv/` lets a developer's backend/.venv into the build, where
# it overlays the builder's venv and the package stage fails "No interpreter
# found".
**/__pycache__/
**/*.py[cod]
**/*.so
**/.venv/
**/venv/
**/*.egg-info/
dist/
build/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# Node — exclude installed/build artefacts but keep the frontend source: the
# Dockerfile's frontend stage builds the SPA inside the image.
node_modules/
**/node_modules/
frontend/build/
frontend/.svelte-kit/

# Environment & secrets, at any depth (backend/.env is the one that exists).
**/.env
**/.env.*
!**/.env.example
.envrc*
.direnv/
.mcp.json

# Tests
tests/
*.test.*

# OS
.DS_Store
Thumbs.db

# The build context's own extension point, and the sibling of the Dockerfile's.
# `docs/` is excluded above because no app ships its documentation in an image —
# but an app whose Dockerfile COPYs something from an excluded path must
# re-include it HERE or the build fails on a source that is not in the context.
# One reason per line.
# App-owned below this line; the factory owns everything above it.
