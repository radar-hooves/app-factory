# syntax=docker/dockerfile:1
{% if has_frontend %}
# Stage 1: Frontend build (pnpm, SvelteKit static adapter)
FROM node:22-slim AS frontend
WORKDIR /frontend

# Copy lockfile + manifest before source for cache efficiency. The pnpm
# version comes from frontend/package.json's packageManager field alone —
# corepack honours it, and it is what CI's pnpm/action-setup resolves too, so
# one field drives the container and the CI gate alike.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/.npmrc ./

# Pinned to package.json's packageManager (pnpm@10.28.0) — keep the two in
# step; bare `corepack enable` alone lets a floating pnpm break the build.
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

# No registry configuration and no build secret: @poodle64/design-tokens and
# @poodle64/ui are public on registry.npmjs.org, which serves them to an
# anonymous install. Do not reintroduce a scope registry or a token mount —
# that was the GitHub Packages arrangement, which required an authenticated
# read for a public package and 404'd every unconfigured install.
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
RUN pnpm build
{% endif %}

# Stage {% if has_frontend %}2{% else %}1{% endif %}: Backend dependency build (uv-native)
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0
WORKDIR /app/backend

# --no-editable copies the source into the venv (no dangling .pth pointers) so
# the runtime stage's copied venv is fully self-contained.
COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-default-groups --no-dev --no-editable

# Stage {% if has_frontend %}3{% else %}2{% endif %}: Runtime
FROM python:3.14-slim-bookworm

WORKDIR /app

# Git commit hash baked in at build time.
# Usage: docker build --build-arg GIT_COMMIT=$(git rev-parse --short HEAD) .
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}

ENV TZ=Australia/Brisbane
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Domain runtime binaries. This block is the factory's and is identical in every
# app; the LIST is the app's, the same shape as the palette or the port. Most
# apps ship an empty backend/system-packages.txt and this is a no-op adding no
# layer. It sits here, above every app-code COPY, so an ordinary code change
# never invalidates the apt layer — and above USER, because apt needs root.
# The file is REQUIRED: delete it in an app and the COPY fails the build.
COPY backend/system-packages.txt ./backend/system-packages.txt
RUN packages="$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' ./backend/system-packages.txt | tr '\n' ' ')" \
    && if [ -n "$packages" ]; then \
         apt-get update \
         && apt-get install -y --no-install-recommends $packages \
         && rm -rf /var/lib/apt/lists/*; \
       fi

# Non-root user (uid 1000; household container convention). Generic name —
# every COPY below sets ownership by numeric --chown, so nothing depends on
# the username matching the package.
RUN useradd -m -u 1000 -s /bin/bash appuser

# Self-contained venv from the builder.
COPY --from=builder --chown=1000:1000 /app/backend/.venv /app/backend/.venv
ENV PATH="/app/backend/.venv/bin:$PATH"

# alembic.ini + migration scripts are plain files, not part of the installed
# wheel; entrypoint.sh below invokes alembic against them directly from
# /app/backend.
COPY --chown=1000:1000 backend/alembic ./backend/alembic
COPY --chown=1000:1000 backend/alembic.ini ./backend/alembic.ini

# Migrates the database, stamps the deployment environment, then execs the
# ASGI server ({{ package_name }}.server:app — keep in step if that target moves).
COPY --chown=1000:1000 backend/entrypoint.sh ./backend/entrypoint.sh
RUN chmod +x ./backend/entrypoint.sh

# The MCP actor registry (mcp/actors.py) — maps an Authentik-authenticated
# identity to an actor id; {{ project_name | upper | replace('-', '_') }}_ACTORS_CONFIG_PATH points at it.
COPY --chown=1000:1000 config ./config
ENV {{ project_name | upper | replace('-', '_') }}_ACTORS_CONFIG_PATH=/app/config/actors.yaml
{% if has_frontend %}
# Built SPA at the path main.py's _FRONTEND_BUILD expects, relative to the
# process cwd (WORKDIR /app) — frontend/build.
COPY --from=frontend --chown=1000:1000 /frontend/build ./frontend/build
{% endif %}
USER 1000:1000

EXPOSE {{ backend_port }}

CMD ["./backend/entrypoint.sh"]
