# syntax=docker/dockerfile:1

# Stage 1: Frontend build (pnpm, SvelteKit static adapter)
FROM node:22-slim AS frontend
WORKDIR /frontend

# Copy lockfile + manifest before source for cache efficiency. The pnpm
# version comes from frontend/package.json's packageManager field alone —
# corepack honours it, and it is what CI's pnpm/action-setup resolves too, so
# one field drives the container and the CI gate alike.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/.npmrc ./

# Pinned to package.json's packageManager (pnpm@10.28.0) — keep the two in
# step; bare `corepack enable` alone lets a floating pnpm break the build.
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

# No registry configuration and no build secret: @poodle64/design-tokens and
# @poodle64/ui are public on registry.npmjs.org, which serves them to an
# anonymous install. Do not reintroduce a scope registry or a token mount —
# that was the GitHub Packages arrangement, which required an authenticated
# read for a public package and 404'd every unconfigured install.
RUN pnpm install --frozen-lockfile

COPY frontend/ ./

# The heap ceiling is pinned rather than inherited. node:22-slim gives V8 about
# 2096 MB by default, and a client bundle carrying the usual rich-content set
# (a diagram renderer, a syntax highlighter, a PDF writer, a chart library)
# peaks within a few percent of it — one app's build died with "Ineffective
# mark-compacts near heap limit" while the floating base tag it had previously
# used happened to hand out 2240 MB and just fit. That margin was inherited, not
# chosen. The flag costs nothing where the default already suffices.
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm build


# Stage 2: Backend dependency build (uv-native)
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0
WORKDIR /app/backend

# The builder can read the household private index (pypi.example.com) when an app
# depends on a sibling published there (ragify, core-memory, redactyl-core, …).
# The read credential arrives as a BuildKit secret mounted at /root/.netrc, and
# NETRC points uv at it explicitly — the same env var the CI runner sets for
# host-run uv, fed to the build by the golden docker-image caller's
# build-secret-files input.
#
# An app with only PUBLIC dependencies builds unchanged, with nothing to pass or
# configure: a BuildKit secret mount is OPTIONAL by default, so an absent `netrc`
# secret simply leaves /root/.netrc missing, and uv treats a NETRC that names a
# nonexistent file as "no netrc" rather than an error — verified by building this
# image both with no secret passed and with a dummy netrc mounted.
# The secret is mounted only for this RUN, so the credential never enters image
# history the way a build ARG would; the default build network reaches the index.
#
# --no-editable copies the source into the venv (no dangling .pth pointers) so
# the runtime stage's copied venv is fully self-contained.
COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=secret,id=netrc,target=/root/.netrc \
    NETRC=/root/.netrc uv sync --frozen --no-default-groups --no-dev --no-editable

# Stage 3: Runtime
FROM python:3.14-slim-bookworm

WORKDIR /app

# Git commit hash baked in at build time.
# Usage: docker build --build-arg GIT_COMMIT=$(git rev-parse --short HEAD) .
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}

ENV TZ=Australia/Brisbane
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Domain runtime binaries. This block is the factory's and is identical in every
# app; the LIST is the app's, the same shape as the palette or the port. Most
# apps ship an empty backend/system-packages.txt and this is a no-op adding no
# layer. It sits here, above every app-code COPY, so an ordinary code change
# never invalidates the apt layer — and above USER, because apt needs root.
# The file is REQUIRED: delete it in an app and the COPY fails the build.
# Debian's own security patches first: the base image rebuilds days after an
# advisory, and the image scan gates on a HIGH the moment it is published.
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
COPY backend/system-packages.txt ./backend/system-packages.txt
RUN packages="$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' ./backend/system-packages.txt | tr '\n' ' ')" \
    && if [ -n "$packages" ]; then \
         apt-get update \
         && apt-get install -y --no-install-recommends $packages \
         && rm -rf /var/lib/apt/lists/*; \
       fi

# Strip the base image's system pip and setuptools. The app runs entirely from
# the self-contained venv copied below, so the base interpreter's own pip and
# setuptools are never invoked at runtime — yet they were the sole source of the
# two HIGH findings the image scan gates on: pip vendors msgpack
# (GHSA-6v7p-g79w-8964) and the base tag bundles setuptools (CVE-2025-47273).
# Neither is in uv.lock, so no app can fix them by bumping a dependency.
# `rm`, not `pip uninstall`, because pip cannot reliably remove itself.
RUN rm -rf \
      /usr/local/lib/python3.14/site-packages/pip \
      /usr/local/lib/python3.14/site-packages/pip-*.dist-info \
      /usr/local/lib/python3.14/site-packages/setuptools \
      /usr/local/lib/python3.14/site-packages/setuptools-*.dist-info \
      /usr/local/lib/python3.14/site-packages/pkg_resources \
      /usr/local/lib/python3.14/site-packages/_distutils_hack \
      /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.14

# Non-root user (uid 1000; household container convention). Generic name —
# every COPY below sets ownership by numeric --chown, so nothing depends on
# the username matching the package.
RUN useradd -m -u 1000 -s /bin/bash appuser

# Self-contained venv from the builder.
COPY --from=builder --chown=1000:1000 /app/backend/.venv /app/backend/.venv
ENV PATH="/app/backend/.venv/bin:$PATH"

# alembic.ini + migration scripts are plain files, not part of the installed
# wheel; entrypoint.sh below invokes alembic against them directly from
# /app/backend.
COPY --chown=1000:1000 backend/alembic ./backend/alembic
COPY --chown=1000:1000 backend/alembic.ini ./backend/alembic.ini

# Migrates the database, stamps the deployment environment, then execs the
# ASGI server ({{ package_name }}.server:app — keep in step if that target moves).
COPY --chown=1000:1000 backend/entrypoint.sh ./backend/entrypoint.sh
RUN chmod +x ./backend/entrypoint.sh

# entrypoint.sh's final line is `gunicorn --config backend/gunicorn.conf.py`, so
# this file is REQUIRED at runtime, not optional tuning. It is a plain file read
# at startup, not part of the installed wheel — it lives at backend/, not under
# src/{{ package_name }}/ — so the venv copied above does NOT carry it. Miss this
# COPY and the build still succeeds, then gunicorn exits immediately with
# "'backend/gunicorn.conf.py' doesn't exist" and the container crashloops behind
# migrations that themselves ran fine — a quiet, misleading failure.
COPY --chown=1000:1000 backend/gunicorn.conf.py ./backend/gunicorn.conf.py

# The MCP actor registry (mcp/actors.py) — maps an Authentik-authenticated
# identity to an actor id; {{ project_name | upper | replace('-', '_') }}_ACTORS_CONFIG_PATH points at it.
COPY --chown=1000:1000 config ./config
ENV {{ project_name | upper | replace('-', '_') }}_ACTORS_CONFIG_PATH=/app/config/actors.yaml

# Built SPA at the path main.py's _FRONTEND_BUILD expects, relative to the
# process cwd (WORKDIR /app) — frontend/build.
COPY --from=frontend --chown=1000:1000 /frontend/build ./frontend/build

USER 1000:1000

EXPOSE {{ backend_port }}

CMD ["./backend/entrypoint.sh"]

# Claude Code, the engine the agent slice drives (api/agent/session.py spawns
# `claude -p` per persona per question). Installed with the vendor's native
# installer under the runtime user's own home, because this runs after USER
# and uid 1000 owns ~/.local. The signed apt repo would be better supply
# chain, but adding an apt source is a change ABOVE the marker below and so a
# parity exception; a pinned installer here keeps the factory's copy
# byte-identical, which is the trade taken.
#
# The version is PINNED and the autoupdater disabled, together: an image whose
# binary rewrites itself at runtime is not the image that was tested, and a
# container that reaches the network on start is one more thing to diagnose.
# Bump this line deliberately, the same as any other dependency.
ENV DISABLE_AUTOUPDATER=1
ENV PATH="/home/appuser/.local/bin:${PATH}"
RUN curl -fsSL -o /tmp/install-claude.sh https://claude.ai/install.sh \
    && bash /tmp/install-claude.sh 2.1.257 \
    && rm -f /tmp/install-claude.sh \
    && claude --version

# A Dockerfile has no include directive, so app image content takes the same
# terminal extension point `.gitignore` does: everything above this marker is
# owed byte-identical, and an app appends its own COPY/ENV below it with a
# reason per line. After CMD on purpose — CMD is metadata, so a trailing COPY
# still lands in the image, and app content invalidating only the last layers is
# the cache order you want. Two constraints: USER is already set, so a tail step
# runs as uid 1000 (use `COPY --chown=1000:1000`, not a root RUN); and anything
# the FRONTEND or BUILDER stage needs cannot live here — that is a real
# exception, not a tail.
# App-owned below this line; the factory owns everything above it.
