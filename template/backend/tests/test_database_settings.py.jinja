"""Where the store password comes from, and in which order.

The order is `Vended`'s own contract (`config/vend.py`): the environment,
then the boot-lane file, then the broker. `test_vend.py` proves that
mechanism in general; this file proves `DatabaseSettings` wires it to the
right credential. No test here ever asserts on a password VALUE reaching a
log.
"""

import logging

import pytest

from {{ package_name }}.config import vend as vend_module
from {{ package_name }}.config.sections.database import DatabaseSettings


def test_an_explicit_password_beats_the_boot_lane_file(tmp_path) -> None:
    """A deployment supplying POSTGRES_PASSWORD never opens the file."""
    credential = tmp_path / "postgres-password"
    credential.write_text("from-the-file\n")
    settings = DatabaseSettings(postgres_password="from-the-environment", postgres_password_file=str(credential))
    assert settings.postgres_password == "from-the-environment"


def test_the_boot_lane_file_is_read_when_no_password_was_supplied(tmp_path) -> None:
    """Stripped, so the trailing newline a host-minted file carries is not part of it."""
    credential = tmp_path / "postgres-password"
    credential.write_text("from-the-file\n")
    settings = DatabaseSettings(postgres_password="", postgres_password_file=str(credential))
    assert settings.postgres_password == "from-the-file"


def test_an_unreadable_file_warns_and_falls_through_to_the_broker(
    tmp_path, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
) -> None:
    """The broker's diagnostic is the better one where it can be reached.

    So a missing file does not raise here; it warns with the reason and lets the
    broker answer, which is what a development checkout does anyway. The
    assertion is on the REASON rather than the path: the log redactor replaces a
    high-entropy token wholesale, and a pytest tmp_path is one.
    """
    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)  # conftest defaults it off for the suite
    monkeypatch.setattr(vend_module, "vend", lambda credential, field: "from-the-broker")
    with caplog.at_level(logging.WARNING):
        settings = DatabaseSettings(postgres_password="", postgres_password_file=str(tmp_path / "not-there"))
    assert settings.postgres_password == "from-the-broker"
    assert any("No such file or directory" in record.getMessage() for record in caplog.records)


def test_the_password_vends_under_this_app_s_own_credential(monkeypatch: pytest.MonkeyPatch) -> None:
    """`postgres_password` names `{{ project_name }}-db`/`password` — this app's own row in the catalogue, never a shared or guessed one."""
    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)  # conftest defaults it off for the suite
    calls: list[tuple[str, str]] = []

    def fake_vend(credential: str, field: str) -> str:
        calls.append((credential, field))
        return "from-the-broker"

    monkeypatch.setattr(vend_module, "vend", fake_vend)
    settings = DatabaseSettings(postgres_password="")
    assert settings.postgres_password == "from-the-broker"
    assert calls == [("{{ project_name }}-db", "password")]


def test_the_pool_defaults_to_sqlalchemys_and_an_app_sizes_it_by_setting(monkeypatch: pytest.MonkeyPatch) -> None:
    """The engine takes its pool from `DatabaseSettings`, so a worker app declares it rather than forks `db/session.py`."""
    from {{ package_name }}.db import session as db_session

    defaults = DatabaseSettings(postgres_password="x")
    assert (defaults.pool_size, defaults.max_overflow) == (5, 10)

    monkeypatch.setenv("{{ project_name | upper | replace('-', '_') }}_DB_POOL_SIZE", "10")
    monkeypatch.setenv("{{ project_name | upper | replace('-', '_') }}_DB_MAX_OVERFLOW", "20")
    sized = DatabaseSettings(postgres_password="x")
    settings = type("S", (), {"database": sized, "debug": False})()
    monkeypatch.setattr(db_session, "get_settings", lambda: settings)
    monkeypatch.setattr(db_session, "_engine", None)
    try:
        pool = db_session.get_engine().pool
        assert (pool.size(), pool._max_overflow) == (10, 20)  # noqa: SLF001 -- no public accessor for the overflow
    finally:
        db_session._engine = None  # noqa: SLF001
