"""The application factory's posture: what the app serves, and to whom.

Four settings-driven decisions main.py makes at construction time, and where the SPA stops. Each is a
posture rather than a preference, and each was previously true only because
nobody had changed the line — so this file pins them, and pins the
`create_app(settings=...)` seam that lets a test drive them at all.
"""

from fastapi.middleware.cors import CORSMiddleware
from httpx import ASGITransport, AsyncClient

from {{ package_name }} import main
from {{ package_name }}.config import get_settings
from {{ package_name }}.main import create_app

DOCUMENT_ROUTES = ("/openapi.json", "/docs", "/redoc")


def _app_with(**overrides):
    """Build the app under a copy of the real settings, one field changed.

    `model_copy` rather than a fresh Settings(): the sections resolve from the
    process environment through get_settings()'s own path, so a test changes the
    one field it is about and inherits every other value the app really runs on.
    """
    return create_app(settings=get_settings().model_copy(update=overrides))


def _has_cors(app) -> bool:
    return any(middleware.cls is CORSMiddleware for middleware in app.user_middleware)


async def _get(app, path: str) -> int:
    transport = ASGITransport(app=app)
    async with AsyncClient(transport=transport, base_url="http://test") as client:
        response = await client.get(path)
    return response.status_code


async def test_the_api_document_and_its_two_uis_are_served_by_default(app):
    """The default posture is open: the shared ingress shell guards them at the edge."""
    for path in DOCUMENT_ROUTES:
        assert await _get(app, path) == 200, path


async def test_openapi_enabled_false_closes_the_document_and_both_uis():
    """An app reachable without traversing the edge closes them in the app instead.

    All three, not only /docs: the schema is what enumerates the route surface,
    so leaving it served while hiding its UI publishes exactly what matters.
    """
    closed = _app_with(openapi_enabled=False)
    for path in DOCUMENT_ROUTES:
        assert await _get(closed, path) == 404, path


async def test_no_cors_middleware_without_a_configured_origin(app):
    """The console is same-origin, so the common case installs no policy at all."""
    assert not _has_cors(app)


async def test_cors_middleware_is_installed_once_an_origin_is_configured():
    assert _has_cors(_app_with(cors_origins="https://example.test"))


async def test_a_deploy_reaches_the_next_load_and_hashed_assets_are_kept(monkeypatch, tmp_path):
    """Every response that is the shell says revalidate, a 304 too; only the hashed build output is cached for good."""
    (tmp_path / "index.html").write_text("<html></html>")
    (tmp_path / "_app" / "immutable").mkdir(parents=True)
    (tmp_path / "_app" / "immutable" / "start.abc123.js").write_text("")
    (tmp_path / "_app" / "version.json").write_text("{}")
    monkeypatch.setattr(main, "_FRONTEND_BUILD", tmp_path)
    shell = "no-cache, max-age=0, must-revalidate"
    transport = ASGITransport(app=create_app(settings=get_settings()))
    async with AsyncClient(transport=transport, base_url="http://test") as client:
        for path in ("/", "/index.html", "/a/client/route"):
            response = await client.get(path)
            assert (response.status_code, response.headers["cache-control"]) == (200, shell), path
        again = await client.get("/a/client/route", headers={"if-none-match": response.headers["etag"]})
        assert (again.status_code, again.headers["cache-control"]) == (304, shell)
        asset = await client.get("/_app/immutable/start.abc123.js")
        assert asset.headers["cache-control"] == "public, max-age=31536000, immutable"
        version = await client.get("/_app/version.json")
        assert "immutable" not in version.headers.get("cache-control", "")


# The current build's shell, importing its entry module the way SvelteKit's bootstrap does.
SHELL = '<html><script>import("./_app/immutable/entry/start.named.js")</script></html>'
ENTRY = "/_app/immutable/entry"


def _built(monkeypatch, tmp_path) -> AsyncClient:
    """A build whose entry module `app.live.js` exists and whose shell names `start.named.js`, which does not."""
    (tmp_path / "index.html").write_text(SHELL)
    (tmp_path / "_app" / "immutable" / "entry").mkdir(parents=True)
    (tmp_path / "_app" / "immutable" / "entry" / "app.live.js").write_text("export const live = 1;")
    monkeypatch.setattr(main, "_FRONTEND_BUILD", tmp_path)
    return AsyncClient(transport=ASGITransport(app=create_app(settings=get_settings())), base_url="http://test")


async def test_a_shell_cached_from_an_earlier_build_reloads_instead_of_going_blank(monkeypatch, tmp_path):
    """The stale shell's bootstrap has no catch, so its missing entry module is answered with one that reloads."""
    async with _built(monkeypatch, tmp_path) as client:
        gone = await client.get(f"{ENTRY}/start.gone.js")
    assert (gone.status_code, gone.headers["content-type"].split(";")[0]) == (200, "text/javascript")
    assert gone.headers["cache-control"] == "no-store"
    assert "start.gone" not in gone.text
    # The guard is what stops a reload loop and keeps each stale route recoverable: dropping any part fails here.
    for guard in (
        "location.reload()",
        "{{ project_name }}:stale-shell-reload:",
        "location.pathname + location.search",
        "< 15000",
        "sessionStorage.getItem",
        "sessionStorage.setItem",
        "try {",
        "} catch",
    ):
        assert guard in gone.text, guard
    # Same-origin script under `script-src 'self'`, and `nosniff` needs the JavaScript type it has.
    assert "'self'" in gone.headers["content-security-policy"]
    assert gone.headers["x-content-type-options"] == "nosniff"


async def test_only_an_entry_module_the_current_shell_does_not_name_is_answered(monkeypatch, tmp_path):
    """Any other miss stays a 404: a stale tab's missing chunk is for SvelteKit's recovery, a broken build must show.

    A missing node or chunk, a stylesheet and any other `_app/` file; the entry module the current shell itself
    names; a file that exists keeps its own body and its cache for good; and a miss outside `_app/` is the shell.
    """
    async with _built(monkeypatch, tmp_path) as client:
        for path in (
            "/_app/immutable/nodes/0.gone.js",
            "/_app/immutable/chunks/gone.js",
            "/_app/immutable/assets/0.gone.css",
            "/_app/gone.js",
            "/_app/version.json",
            f"{ENTRY}/start.named.js",
        ):
            assert (await client.get(path)).status_code == 404, path
        live = await client.get(f"{ENTRY}/app.live.js")
        assert (live.text, live.headers["cache-control"]) == (
            "export const live = 1;",
            "public, max-age=31536000, immutable",
        )
        assert (await client.get("/gone.js")).text == SHELL


async def test_an_api_path_the_spa_declines_is_the_routers(monkeypatch, tmp_path):
    """A redirect to the trailing-slash form that exists, or a JSON 404; never the SPA's page."""
    (tmp_path / "index.html").write_text("<html></html>")
    monkeypatch.setattr(main, "_FRONTEND_BUILD", tmp_path)
    transport = ASGITransport(app=create_app(settings=get_settings()))
    async with AsyncClient(transport=transport, base_url="http://test") as client:
        assert (await client.get("/a/client/route")).text == "<html></html>"
        api = main._API_PREFIX
        for path, existing in ((f"{api}/system/health/", f"{api}/system/health"), ("/mcp", "/mcp/")):
            redirect = await client.get(path)
            assert (redirect.status_code, redirect.headers["location"]) == (307, f"http://test{existing}"), path
        for path in (f"{api}/no-such-route", api):
            missing = await client.get(path)
            assert (missing.status_code, missing.json()) == (404, {"detail": "Not Found"}), path
