"""The migrated-schema cache (`conftest.py`): a hit loads what a miss dumped, and an edited migration is a miss."""

from collections.abc import Generator
from pathlib import Path

import pytest
from sqlalchemy import create_engine, text

from tests import conftest


def _backend(root: Path, migration: str) -> Path:
    (root / "alembic" / "versions").mkdir(parents=True)
    (root / "alembic" / "versions" / "0001_a.py").write_text(migration)
    (root / "alembic" / "env.py").write_text("# env\n")
    (root / "src" / "{{ package_name }}" / "db").mkdir(parents=True)
    (root / "src" / "{{ package_name }}" / "db" / "roles.py").write_text("# roles\n")
    return root


def test_an_edited_or_added_migration_is_a_different_key_so_it_replays(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(conftest, "_EPHEMERAL_POSTGRES", object())
    monkeypatch.setenv("XDG_CACHE_HOME", str(tmp_path / "cache"))
    backend = _backend(tmp_path / "backend", "revision = '1'\n")
    key = conftest._schema_cache_path(backend)
    assert key is not None and conftest._schema_cache_path(backend) == key
    key.parent.mkdir(parents=True)
    key.write_bytes(b"dump")  # the cache a run of the unedited chain left

    (backend / "alembic" / "versions" / "0001_a.py").write_text("revision = '1'  # edited\n")
    edited = conftest._schema_cache_path(backend)
    assert edited != key and edited is not None and not edited.exists()

    (backend / "alembic" / "versions" / "0002_b.py").write_text("revision = '2'\n")
    assert conftest._schema_cache_path(backend) not in (key, edited)


def test_an_explicit_server_is_never_cached(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(conftest, "_EPHEMERAL_POSTGRES", None)
    assert conftest._schema_cache_path(_backend(tmp_path, "revision = '1'\n")) is None


@pytest.fixture
def migrated_server(monkeypatch: pytest.MonkeyPatch) -> Generator[str]:
    """A Postgres of this test's own, holding a database one migration deep, as the cache sees the suite's.

    Its own rather than the suite's: an xdist worker holds no handle on the suite's container, and
    the cache functions work through the handle. Yields the migrated database's name.
    """
    monkeypatch.setattr(conftest, "_EPHEMERAL_POSTGRES", None)
    settings = conftest._start_ephemeral_postgres()
    monkeypatch.setattr(conftest, "_TEST_SERVER", settings)
    monkeypatch.setattr(conftest, "TEST_DATABASE_NAME", "migrated")
    try:
        engine = create_engine(conftest._maintenance_url(), isolation_level="AUTOCOMMIT")
        with engine.connect() as conn:
            conn.execute(text(f"CREATE ROLE \"{conftest.TEST_OWNER}\" LOGIN CREATEROLE PASSWORD 'owner'"))
            conn.execute(text(f"CREATE ROLE \"{conftest.TEST_RUNTIME}\" LOGIN PASSWORD 'runtime'"))
            conn.execute(text(f'CREATE DATABASE migrated OWNER "{conftest.TEST_OWNER}"'))
        engine.dispose()
        migrated = create_engine(conftest._maintenance_url("migrated"), isolation_level="AUTOCOMMIT")
        with migrated.connect() as conn:
            conn.execute(text("CREATE TABLE alembic_version (version_num text)"))
            conn.execute(text("INSERT INTO alembic_version VALUES ('abc')"))
            conn.execute(text(f'ALTER TABLE alembic_version OWNER TO "{conftest.TEST_OWNER}"'))
            conn.execute(text(f'GRANT SELECT ON alembic_version TO "{conftest.TEST_RUNTIME}"'))
        migrated.dispose()
        yield "migrated"
    finally:
        conftest._stop_ephemeral_postgres()


def _fresh_database(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(conftest, "TEST_DATABASE_NAME", "fresh")
    conftest._recreate_test_database()


def _revisions_and_runtime_read(database: str) -> tuple[set[str], bool]:
    engine = create_engine(conftest._maintenance_url(database))
    try:
        with engine.connect() as conn:
            revisions = {row[0] for row in conn.execute(text("SELECT version_num FROM alembic_version"))}
            readable = bool(
                conn.execute(
                    text("SELECT has_table_privilege(:role, 'alembic_version', 'SELECT')"),
                    {"role": conftest.TEST_RUNTIME},
                ).scalar()
            )
            owner = conn.execute(text("SELECT tableowner FROM pg_tables WHERE tablename = 'alembic_version'")).scalar()
    finally:
        engine.dispose()
    assert owner == conftest.TEST_OWNER
    return revisions, readable


def test_a_dump_of_the_migrated_database_loads_into_a_fresh_one(
    tmp_path: Path, migrated_server: str, monkeypatch: pytest.MonkeyPatch
) -> None:
    dump = tmp_path / "schema.dump"
    conftest._store_cached_schema(dump)
    assert dump.stat().st_size > 0

    monkeypatch.setattr(conftest, "TEST_DATABASE_NAME", "fresh")
    conftest._recreate_test_database()
    assert conftest._load_cached_schema(dump) is True
    assert _revisions_and_runtime_read("fresh") == ({"abc"}, True)


def test_a_dump_that_will_not_load_is_removed_and_leaves_a_usable_database(
    tmp_path: Path, migrated_server: str, monkeypatch: pytest.MonkeyPatch
) -> None:
    dump = tmp_path / "schema.dump"
    dump.write_bytes(b"not a dump")
    _fresh_database(monkeypatch)
    assert conftest._load_cached_schema(dump) is False
    assert not dump.exists()
    engine = create_engine(conftest._maintenance_url("fresh"))
    try:
        with engine.connect() as conn:
            assert conn.execute(text("SELECT 1")).scalar() == 1
    finally:
        engine.dispose()
