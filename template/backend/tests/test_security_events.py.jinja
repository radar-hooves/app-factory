"""Privileged actions and entitlement denials, recorded as structured security events.

One log line per event on the ``{{ package_name }}.security`` logger (``security_events.py``);
shipping it is ``api_common.telemetry.configure()``'s job, so these tests read the records.
"""

import json
import logging

import pytest
from httpx import AsyncClient
from sqlalchemy import select
from sqlalchemy.orm import Session

from {{ package_name }} import security_events
from {{ package_name }}.api.users.models import User
from tests.support.fake_authentik import FakeAuthentik
from tests.test_mcp_person_gate import _drive, _person
from tests.test_mcp_person_gate import fake as fake_authentik  # noqa: F401 -- a fixture, found by name

LOGGER = "{{ package_name }}.security"


@pytest.fixture(autouse=True)
def _fresh_dedupe() -> None:
    security_events._seen.clear()


def _events(caplog: pytest.LogCaptureFixture, name: str | None = None) -> list[logging.LogRecord]:
    return [
        record
        for record in caplog.records
        if record.name == LOGGER and (name is None or getattr(record, "security_event", None) == name)
    ]


def _headers(uid: str, entitlements: str | None = None, **more: str) -> dict[str, str]:
    headers = {"x-authentik-uid": uid, "x-authentik-username": uid, "authorization": "Bearer s3cret-token-value"}
    if entitlements is not None:
        headers["x-authentik-entitlements"] = entitlements
    return headers | more


def _nothing_secret(records: list[logging.LogRecord]) -> None:
    for record in records:
        assert "s3cret-token-value" not in json.dumps(record.__dict__, default=str)


async def test_a_denied_module_gate_records_the_module_and_grade(
    client: AsyncClient, caplog: pytest.LogCaptureFixture
) -> None:
    caplog.set_level(logging.INFO, logger=LOGGER)
    refused = await client.get("/api/admin/users", headers=_headers("somebody", "reports|chat-helper"))
    assert refused.status_code == 403

    (event,) = _events(caplog, "entitlement_denied")
    assert event.levelno == logging.WARNING
    assert event.outcome == "denied"  # type: ignore[attr-defined]
    assert event.event_class == "security"  # type: ignore[attr-defined]
    assert event.gated_module == "admin"  # type: ignore[attr-defined]
    assert event.grade == "read"  # type: ignore[attr-defined]
    assert event.actor_uid == "somebody"  # type: ignore[attr-defined]
    assert event.actor_username == "somebody"  # type: ignore[attr-defined]
    assert event.actor_type == "person"  # type: ignore[attr-defined]
    assert event.actor_id  # type: ignore[attr-defined]
    assert event.actor_entitlements == ["reports", "chat-helper"]  # type: ignore[attr-defined]
    assert event.http_method == "GET"  # type: ignore[attr-defined]
    assert event.http_path == "/api/admin/users"  # type: ignore[attr-defined]
    assert event.source_ip  # type: ignore[attr-defined]
    _nothing_secret(_events(caplog))


async def test_the_http_path_carries_no_query_string(client: AsyncClient, caplog: pytest.LogCaptureFixture) -> None:
    caplog.set_level(logging.INFO, logger=LOGGER)
    await client.get("/api/admin/users?search=alice", headers=_headers("somebody"))
    (event,) = _events(caplog, "entitlement_denied")
    assert event.http_path == "/api/admin/users"  # type: ignore[attr-defined]


async def test_a_write_denial_names_the_write_grade(
    client: AsyncClient, caplog: pytest.LogCaptureFixture, session: Session
) -> None:
    await client.get("/api/users/me", headers=_headers("the-subject"))
    subject = session.execute(select(User).where(User.authentik_uid == "the-subject")).scalar_one()
    caplog.set_level(logging.INFO, logger=LOGGER)
    refused = await client.patch(
        f"/api/admin/users/{subject.id}", json={"is_active": False}, headers=_headers("viewer", "admin")
    )
    assert refused.status_code == 403
    (event,) = _events(caplog, "entitlement_denied")
    assert (event.gated_module, event.grade) == ("admin", "write")  # type: ignore[attr-defined]
    assert _events(caplog, "admin_user_updated") == []


async def test_an_admin_update_records_the_change_and_the_actor(
    client: AsyncClient, caplog: pytest.LogCaptureFixture, session: Session
) -> None:
    await client.get("/api/users/me", headers=_headers("the-subject"))
    subject = session.execute(select(User).where(User.authentik_uid == "the-subject")).scalar_one()
    caplog.set_level(logging.INFO, logger=LOGGER)

    done = await client.patch(
        f"/api/admin/users/{subject.id}", json={"is_active": False}, headers=_headers("the-admin", "admin:write")
    )
    assert done.status_code == 200

    (event,) = _events(caplog, "admin_user_updated")
    assert event.levelno == logging.INFO
    assert event.outcome == "allowed"  # type: ignore[attr-defined]
    assert event.target == str(subject.id)  # type: ignore[attr-defined]
    assert event.change == "is_active True -> False"  # type: ignore[attr-defined]
    assert event.actor_uid == "the-admin"  # type: ignore[attr-defined]
    assert event.http_method == "PATCH"  # type: ignore[attr-defined]
    assert not hasattr(event, "actor_entitlements")
    _nothing_secret(_events(caplog))


async def test_an_app_gate_refusal_is_recorded(client: AsyncClient, caplog: pytest.LogCaptureFixture) -> None:
    caplog.set_level(logging.INFO, logger=LOGGER)
    refused = await client.get("/api/users/", headers=_headers("chatter", "chat-helper"))
    assert refused.status_code == 403
    (event,) = _events(caplog, "entitlement_denied")
    assert event.actor_entitlements == ["chat-helper"]  # type: ignore[attr-defined]
    assert event.http_path == "/api/users/"  # type: ignore[attr-defined]


async def test_view_as_is_recorded_once_per_asked_set(client: AsyncClient, caplog: pytest.LogCaptureFixture) -> None:
    caplog.set_level(logging.INFO, logger=LOGGER)
    headers = _headers("the-admin", "admin|reports|example", **{"x-view-as": "reports"})
    for _ in range(5):
        assert (await client.get("/api/users/me", headers=headers)).status_code == 200

    (event,) = _events(caplog, "view_as_used")
    assert event.outcome == "allowed"  # type: ignore[attr-defined]
    assert event.held == ["admin", "reports", "example"]  # type: ignore[attr-defined]
    assert event.asked == ["reports"]  # type: ignore[attr-defined]
    assert event.actor_uid == "the-admin"  # type: ignore[attr-defined]

    other = _headers("the-admin", "admin|reports|example", **{"x-view-as": "example"})
    await client.get("/api/users/me", headers=other)
    assert len(_events(caplog, "view_as_used")) == 2


async def test_a_view_as_header_without_admin_is_recorded_as_denied_once(
    client: AsyncClient, caplog: pytest.LogCaptureFixture
) -> None:
    caplog.set_level(logging.INFO, logger=LOGGER)
    headers = _headers("sneaky", "reports", **{"x-view-as": "reports|admin"})
    for _ in range(3):
        assert (await client.get("/api/users/me", headers=headers)).status_code == 200

    assert _events(caplog, "view_as_used") == []
    (event,) = _events(caplog, "view_as_denied")
    assert event.levelno == logging.WARNING
    assert event.outcome == "denied"  # type: ignore[attr-defined]
    assert event.asked == ["admin", "reports"]  # type: ignore[attr-defined]
    assert event.actor_entitlements == ["reports"]  # type: ignore[attr-defined]


async def test_no_view_as_header_records_nothing(client: AsyncClient, caplog: pytest.LogCaptureFixture) -> None:
    caplog.set_level(logging.INFO, logger=LOGGER)
    await client.get("/api/users/me", headers=_headers("the-admin", "admin"))
    assert _events(caplog) == []


def test_a_detail_key_that_collides_with_a_log_record_attribute_does_not_raise(
    caplog: pytest.LogCaptureFixture,
) -> None:
    caplog.set_level(logging.INFO, logger=LOGGER)
    security_events.record("probe", "allowed", module="x", name="y", message="z")
    (event,) = _events(caplog, "probe")
    assert (event.detail_module, event.detail_name, event.detail_message) == ("x", "y", "z")  # type: ignore[attr-defined]


@pytest.mark.integration
async def test_a_refused_mcp_tool_is_recorded_without_the_bearer(
    fake_authentik: FakeAuthentik,  # noqa: F811 -- the fixture imported above
    caplog: pytest.LogCaptureFixture,
) -> None:
    caplog.set_level(logging.INFO, logger=LOGGER)
    token = _person(fake_authentik, "p-notes", "notes", "chat-helper")
    await _drive(token)

    denied = {r.target: r for r in _events(caplog, "mcp_tool_denied")}
    assert {"ledger_read", "notes_write", "admin_write", "undeclared"} <= set(denied)
    assert "notes_read" not in denied
    event = denied["ledger_read"]
    assert event.levelno == logging.WARNING
    assert event.actor_uid == "p-notes"  # type: ignore[attr-defined]
    assert event.actor_type == "person"  # type: ignore[attr-defined]
    assert event.actor_entitlements == ["notes", "chat-helper"]  # type: ignore[attr-defined]
    assert event.reason == "missing ledger"  # type: ignore[attr-defined]
    assert event.http_path.startswith("/mcp")  # type: ignore[attr-defined]
    assert denied["undeclared"].reason == "undeclared"  # type: ignore[attr-defined]
    # tools/list and tools/call both run the check: the list entry is deduped, the refused call is
    # always recorded, so a tool the person tried to call shows twice (hidden once, refused once).
    targets = [r.target for r in _events(caplog, "mcp_tool_denied")]  # type: ignore[attr-defined]
    assert targets.count("ledger_read") == 2
    _nothing_secret(_events(caplog))
    assert token not in json.dumps([r.__dict__ for r in _events(caplog)], default=str)
