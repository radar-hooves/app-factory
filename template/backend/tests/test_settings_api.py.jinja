"""The settings slice, driven through HTTP, plus the declare-time refusal it cannot skip.

Every test runs against a registry of its own holding two settings of its own,
a boolean and a bounds-checked integer, for the schema, the write, the reset,
and the history trail, so the slice is proved whatever the app declares (an app
that deleted the scaffold's `api/example/` declares none). `model_alias`'s
gateway-reachability and `narrow` behaviour is proved directly against
`declare.py`/`service.py`, with a fake gateway, since no live one exists in
this suite.
"""

import asyncio
import threading
import uuid

import pytest
from fastapi import FastAPI
from httpx import ASGITransport, AsyncClient
from sqlalchemy import delete, select
from sqlalchemy.orm import Session

from {{ package_name }}.api.settings import declare, service
from {{ package_name }}.api.settings.declare import SettingType, declare_setting
from {{ package_name }}.api.settings.models import SettingChange, SettingOverride
from {{ package_name }}.api.users.models import User
from {{ package_name }}.db.session import get_session_factory
from {{ package_name }}.exceptions import NotFoundError, ValidationError


def _make_user(session: Session) -> uuid.UUID:
    """A real `users` row, for a direct service-layer test with no HTTP request to upsert one.

    `SettingOverride.updated_by_id`/`SettingChange.changed_by_id` are real
    foreign keys, so a synthetic `uuid4()` with no backing row would fail the
    insert rather than exercise the behaviour under test.
    """
    uid = f"test-{uuid.uuid4().hex}"
    user = User(authentik_uid=uid, username=uid)
    session.add(user)
    session.flush()
    return user.id


def _headers(uid: str, entitlements: str | None = None) -> dict[str, str]:
    headers = {"x-authentik-uid": uid, "x-authentik-username": uid}
    if entitlements is not None:
        headers["x-authentik-entitlements"] = entitlements
    return headers


async def _sign_in(client: AsyncClient, uid: str) -> None:
    await client.get("/api/users/me", headers=_headers(uid))


TOGGLE = "selftest.toggle"
LIMIT = "selftest.limit"


@pytest.fixture(autouse=True)
def _own_settings(monkeypatch: pytest.MonkeyPatch) -> None:
    """A fresh registry per test, holding this module's two settings; a test's own declarations end with it."""
    monkeypatch.setattr(declare, "_REGISTRY", {})
    declare_setting(TOGGLE, type=SettingType.boolean, default=True, title="A toggle", description="")
    declare_setting(
        LIMIT, type=SettingType.integer, default=20, minimum=1, maximum=100, title="A limit", description=""
    )


# ── The gate ─────────────────────────────────────────────────────────────────


async def test_a_caller_without_the_admin_entitlement_is_refused(client: AsyncClient) -> None:
    refused = await client.get("/api/settings/", headers=_headers("somebody"))
    assert refused.status_code == 403
    assert refused.json()["details"] == {"module": "admin", "grade": "read"}


async def test_a_read_admin_can_look_but_not_write(client: AsyncClient) -> None:
    listed = await client.get("/api/settings/", headers=_headers("the-viewer", "admin"))
    assert listed.status_code == 200

    refused = await client.patch(
        f"/api/settings/{TOGGLE}",
        json={"value": False},
        headers=_headers("the-viewer", "admin"),
    )
    assert refused.status_code == 403
    assert refused.json()["details"] == {"module": "admin", "grade": "write"}


# ── The document ─────────────────────────────────────────────────────────────


async def test_the_document_carries_the_schema_and_the_defaults(client: AsyncClient) -> None:
    body = (await client.get("/api/settings/", headers=_headers("an-admin", "admin"))).json()

    toggle = body["schema"]["properties"][TOGGLE]
    assert toggle["type"] == "boolean"
    bounded = body["schema"]["properties"][LIMIT]
    assert bounded["type"] == "integer"
    assert bounded["minimum"] == 1
    assert bounded["maximum"] == 100

    assert body["value"][TOGGLE] is True
    assert body["value"][LIMIT] == 20
    assert body["defaults"][TOGGLE] is True
    assert body["defaults"][LIMIT] == 20
    # No `overridden` field on the wire: which keys differ is derivable from
    # `value`/`defaults` alone, and the frontend derives it (`+page.svelte`).
    assert "overridden" not in body
    assert body["value"][TOGGLE] == body["defaults"][TOGGLE]


# ── Writing, resetting, and the trail they leave ─────────────────────────────


async def test_a_write_then_a_reset_round_trips_through_the_override(client: AsyncClient) -> None:
    admin = _headers("the-writer", "admin:write")
    await _sign_in(client, "the-writer")

    written = await client.patch(f"/api/settings/{LIMIT}", json={"value": 50}, headers=admin)
    assert written.status_code == 200
    assert written.json() == {"key": LIMIT, "value": 50, "default": 20, "overridden": True}

    document = (await client.get("/api/settings/", headers=admin)).json()
    assert document["value"][LIMIT] == 50
    assert document["value"][LIMIT] != document["defaults"][LIMIT]

    reset = await client.post(f"/api/settings/{LIMIT}/reset", headers=admin)
    assert reset.status_code == 200
    assert reset.json() == {"key": LIMIT, "value": 20, "default": 20, "overridden": False}

    history = (await client.get("/api/settings/history", headers=admin)).json()
    keys_and_values = [(c["key"], c["old_value"], c["new_value"]) for c in history["changes"]]
    assert (LIMIT, 20, 50) in keys_and_values
    assert (LIMIT, 50, 20) in keys_and_values
    written_entry = next(c for c in history["changes"] if c["new_value"] == 50)
    assert written_entry["changed_by"] == "the-writer"


async def test_a_value_outside_the_declared_bounds_is_refused(client: AsyncClient) -> None:
    admin = _headers("the-writer", "admin:write")
    refused = await client.patch(f"/api/settings/{LIMIT}", json={"value": 500}, headers=admin)
    assert refused.status_code == 422


async def test_an_undeclared_key_is_not_found(client: AsyncClient) -> None:
    admin = _headers("the-writer", "admin:write")
    missing = await client.patch("/api/settings/no.such.setting", json={"value": 1}, headers=admin)
    assert missing.status_code == 404


# Each fanned-out request holds a pooled connection and a worker thread while it
# waits — see test_workspaces_api.py's own FAN_OUT for the same pool-size ceiling.
FAN_OUT = 5


async def test_fanned_out_first_writes_to_a_setting_all_succeed(app: FastAPI, monkeypatch: pytest.MonkeyPatch) -> None:
    """Several admins save the same never-before-overridden setting at once.

    Driven for real, like the workspaces slice's own first-sight race
    (`test_workspaces_api.py`): bypasses the `client` fixture's one shared
    rollback session, since a real race needs real concurrent transactions.
    Each request's read of the current value is held until every request has
    read, which is the interleaving where every one of them finds no override
    row and tries to write the first one. With a `session.get` then a
    conditional INSERT, all but one of these would crash with an uncaught
    `IntegrityError` (500); the INSERT … ON CONFLICT idiom makes every request
    succeed and still leaves one `SettingChange` per write.
    """
    key = f"test.{uuid.uuid4().hex}.race"
    declare_setting(key, type=SettingType.integer, default=0, title="Race", description="")

    real_get_value = service.get_value
    everyone_has_read = threading.Barrier(FAN_OUT, timeout=10)
    this_request = threading.local()

    def read_then_wait_for_the_rest(session: Session, read_key: str):
        value = real_get_value(session, read_key)
        if read_key == key and not getattr(this_request, "waited", False):
            this_request.waited = True
            everyone_has_read.wait()
        return value

    monkeypatch.setattr(service, "get_value", read_then_wait_for_the_rest)

    admin = _headers("the-racer", "admin:write")
    try:
        async with AsyncClient(
            transport=ASGITransport(app=app, raise_app_exceptions=False), base_url="http://test"
        ) as race_client:
            responses = await asyncio.gather(
                *(race_client.patch(f"/api/settings/{key}", json={"value": n}, headers=admin) for n in range(FAN_OUT))
            )

        assert [response.status_code for response in responses] == [200] * FAN_OUT

        with get_session_factory()() as db:
            assert db.get(SettingOverride, key) is not None
            changes = db.execute(select(SettingChange).where(SettingChange.key == key)).scalars().all()
            assert len(changes) == FAN_OUT
    finally:
        with get_session_factory()() as db, db.begin():
            db.execute(delete(SettingChange).where(SettingChange.key == key))
            db.execute(delete(SettingOverride).where(SettingOverride.key == key))


# ── Declaring a setting ───────────────────────────────────────────────────────


def test_a_secret_shaped_key_is_refused_at_declaration() -> None:
    with pytest.raises(ValueError, match="secret or a person's identifier"):
        declare_setting(
            f"test.{uuid.uuid4().hex}.api_key",
            type=SettingType.string,
            default="",
            title="A gateway key",
            description="",
        )


def test_declaring_the_same_key_twice_is_refused() -> None:
    key = f"test.{uuid.uuid4().hex}"
    declare_setting(key, type=SettingType.boolean, default=True, title="Once", description="")
    with pytest.raises(ValueError, match="already declared"):
        declare_setting(key, type=SettingType.boolean, default=True, title="Twice", description="")


def test_an_email_shaped_key_is_refused_at_declaration() -> None:
    """The worked example `_FORBIDDEN_SUBSTRINGS`' own comment names: a `string`
    called `notification_email` holds a person's identifier under a permitted
    type, so the substring check — not the closed `SettingType` enum — is what
    has to catch it."""
    with pytest.raises(ValueError, match="secret or a person's identifier"):
        declare_setting(
            f"test.{uuid.uuid4().hex}.notification_email",
            type=SettingType.string,
            default="",
            title="Notification email",
            description="Where to send an alert when the nightly job fails.",
        )


def test_an_ordinary_key_naming_nothing_forbidden_is_accepted() -> None:
    key = f"test.{uuid.uuid4().hex}.digest_frequency_hours"
    setting = declare_setting(
        key,
        type=SettingType.integer,
        default=24,
        minimum=1,
        maximum=168,
        title="Digest frequency",
        description="How often, in hours, the summary digest runs.",
    )
    assert setting.key == key


# ── model_alias: reachability, narrowing, and degrading when the gateway is down ──


def test_model_alias_offers_and_accepts_only_what_narrow_admits(session: Session) -> None:
    key = f"test.{uuid.uuid4().hex}.model_alias"
    declare_setting(
        key,
        type=SettingType.model_alias,
        default="mimir/deep",
        title="A model",
        description="",
        list_models=lambda: ["mimir/deep", "goku/fast"],
        narrow=lambda alias: None if alias.startswith("mimir/") else f"{alias} is not a Tier-3 alias",
    )
    schema = service.build_schema()
    assert schema["properties"][key]["enum"] == ["mimir/deep"]

    admin_id = _make_user(session)
    with pytest.raises(ValidationError, match="not a Tier-3 alias"):
        service.set_value(session, key, "goku/fast", actor_user_id=admin_id)
    service.set_value(session, key, "mimir/deep", actor_user_id=admin_id)  # does not raise


def test_model_alias_degrades_rather_than_refuses_when_the_gateway_is_unreachable(session: Session) -> None:
    key = f"test.{uuid.uuid4().hex}.model_alias"

    def _broken() -> list[str]:
        raise ConnectionError("gateway is down")

    declare_setting(
        key,
        type=SettingType.model_alias,
        default="anything/goes",
        title="A model",
        description="",
        list_models=_broken,
    )
    schema = service.build_schema()
    assert "enum" not in schema["properties"][key]
    assert "could not confirm" in schema["properties"][key]["description"]

    # A write still succeeds — an unreachable gateway degrades, it never refuses.
    service.set_value(session, key, "whatever/works", actor_user_id=_make_user(session))


def test_get_value_raises_not_found_for_an_undeclared_key(session: Session) -> None:
    with pytest.raises(NotFoundError):
        service.get_value(session, f"test.{uuid.uuid4().hex}.nope")
