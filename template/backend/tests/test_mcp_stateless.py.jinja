"""The embedded /mcp surface must be stateless, or it breaks under the worker pool.

Production serves this app through gunicorn with a worker POOL. FastMCP's default
streamable-HTTP transport keeps each session's live transport in a per-PROCESS
dict keyed by Mcp-Session-Id, so a follow-up request routed to a different worker
finds nothing and gets JSON-RPC -32600 "Session not found". It is load-dependent,
so a single-worker check cannot see it.

These tests build the app TWICE and send the follow-up to the second instance —
two processes, as the pool would. The gate is replaced with a pass-through so the
surface is reachable without an identity provider; everything else is the app's
own construction, so removing ``stateless_http=True`` from ``main.py`` fails
``test_session_survives_a_different_worker`` rather than merely changing a flag.
"""

from typing import Any

import httpx
import pytest

import {{ package_name }}.main as main_module
from {{ package_name }}.main import create_app

PROTOCOL_VERSION = "2025-06-18"
_HEADERS = {"content-type": "application/json", "accept": "application/json, text/event-stream"}
_INITIALIZE: dict[str, Any] = {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
        "protocolVersion": PROTOCOL_VERSION,
        "capabilities": {},
        "clientInfo": {"name": "worker-pool-test", "version": "1"},
    },
}
_TOOLS_LIST: dict[str, Any] = {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}


@pytest.fixture
def ungated(monkeypatch: pytest.MonkeyPatch) -> None:
    """Mount /mcp without the bearer gate, so these tests need no identity provider.

    Only the gate is replaced. The MCP app itself is built by create_app() exactly
    as production builds it, which is the whole point: the stateless flag under
    test is the one main.py actually passes.
    """
    monkeypatch.setattr(main_module, "require_bearer_auth", lambda inner_app, **_kwargs: inner_app)


def _client(app: object) -> httpx.AsyncClient:
    # localhost, not a made-up hostname: an app with a trusted-host middleware
    # rejects anything else with 400 "Invalid host header" before routing.
    return httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url="http://localhost")


async def test_session_survives_a_different_worker(ungated: None) -> None:
    """Initialize on one worker, then call a tool on another. The pool does this."""
    first, second = create_app(), create_app()

    async with (
        first.router.lifespan_context(first),
        second.router.lifespan_context(second),
        _client(first) as worker_one,
        _client(second) as worker_two,
    ):
        initialised = await worker_one.post("/mcp/", json=_INITIALIZE, headers=_HEADERS)
        assert initialised.status_code == 200, initialised.text

        follow_up = dict(_HEADERS)
        follow_up["mcp-protocol-version"] = PROTOCOL_VERSION
        if session_id := initialised.headers.get("mcp-session-id"):
            follow_up["mcp-session-id"] = session_id

        listed = await worker_two.post("/mcp/", json=_TOOLS_LIST, headers=follow_up)

    assert listed.status_code == 200, (
        "the follow-up failed on a second worker: the /mcp mount in main.py is "
        f"session-bound, so production loses roughly (workers-1)/workers of them. {listed.text}"
    )
    assert "Session not found" not in listed.text


async def test_initialize_issues_no_session_to_lose(ungated: None) -> None:
    """Stateless mode hands back no Mcp-Session-Id, which is why nothing can be lost."""
    app = create_app()
    async with app.router.lifespan_context(app), _client(app) as client:
        response = await client.post("/mcp/", json=_INITIALIZE, headers=_HEADERS)

    assert response.status_code == 200, response.text
    assert response.headers.get("mcp-session-id") is None, (
        "a session id came back, so the transport is stateful and per-process"
    )
