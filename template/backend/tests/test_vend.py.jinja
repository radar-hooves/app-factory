"""The declarative vend-on-empty mechanism: `Vended` field specs and `VendedSettings`.

`test_database_settings.py` proves the database section wires this to the
right credential; this file proves the mechanism itself, independent of any
one field's business meaning — the environment wins, an empty field vends by
its declared (credential, field), a vend failure retries with backoff then
raises the broker's own diagnostic and nothing more, and the boot-lane file
escape hatch answers before the broker is ever asked. The attest-flow tests
further down prove `vend`'s own in-process software-key mechanics: a missing
key file, and a real P-256 signature the broker could actually verify.
"""

import base64
from datetime import UTC, datetime, timedelta
from typing import Annotated, Any

import pytest
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import ec
from cryptography.hazmat.primitives.asymmetric.utils import encode_dss_signature
from cryptography.hazmat.primitives.serialization import Encoding, NoEncryption, PrivateFormat, PublicFormat
from pydantic import SecretStr
from pydantic_settings import SettingsConfigDict

from {{ package_name }}.config import vend as vend_module
from {{ package_name }}.config.vend import Vended, VendedSettings, VendError


@pytest.fixture(autouse=True)
def _reset_bearer_cache() -> None:
    """The in-memory bearer cache is process-global; a test that attests must not leak into the next one."""
    vend_module._BEARER_CACHE.clear()


class _ExampleSettings(VendedSettings):
    """A synthetic settings model exercising a plain and a secret vended field."""

    model_config = SettingsConfigDict(env_prefix="EXAMPLE_VENDED_TEST_")

    plain_field: Annotated[str, Vended("example-credential", "plain-field")] = ""
    secret_field: Annotated[SecretStr, Vended("example-credential", "secret-field")] = SecretStr("")


class _FiledSettings(VendedSettings):
    """A synthetic settings model exercising the boot-lane file escape hatch."""

    model_config = SettingsConfigDict(env_prefix="EXAMPLE_VENDED_TEST_")

    value: Annotated[str, Vended("example-credential", "value-field", file_field="value_file")] = ""
    value_file: str | None = None


def _forbidden_vend(credential: str, field: str) -> str:
    raise AssertionError(f"must not vend '{credential}.{field}' when a value was already available")


def test_env_wins_when_set(monkeypatch: pytest.MonkeyPatch) -> None:
    """A value the environment supplied is never overwritten by a vend."""
    monkeypatch.setattr(vend_module, "vend", _forbidden_vend)
    settings = _ExampleSettings(plain_field="from-the-environment", secret_field="also-from-the-environment")
    assert settings.plain_field == "from-the-environment"
    assert settings.secret_field.get_secret_value() == "also-from-the-environment"


def test_empty_vends_by_credential_and_field(monkeypatch: pytest.MonkeyPatch) -> None:
    """An empty field is filled by `vend(credential, field)`, keyed exactly as declared."""
    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)  # conftest defaults it off for the suite
    calls: list[tuple[str, str]] = []

    def fake_vend(credential: str, field: str) -> str:
        calls.append((credential, field))
        return f"vended-{field}"

    monkeypatch.setattr(vend_module, "vend", fake_vend)
    settings = _ExampleSettings()
    assert settings.plain_field == "vended-plain-field"
    assert settings.secret_field.get_secret_value() == "vended-secret-field"
    assert set(calls) == {("example-credential", "plain-field"), ("example-credential", "secret-field")}


def test_a_vend_failure_retries_then_raises_without_the_value(monkeypatch: pytest.MonkeyPatch) -> None:
    """Bounded retries with backoff — for a broker locked or not yet answering
    after a restart — then the broker's own diagnostic, and nothing this app
    was not already told.
    """
    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)  # conftest defaults it off for the suite
    monkeypatch.setattr(vend_module, "_VEND_ATTEMPTS", 3)
    monkeypatch.setattr(vend_module, "_VEND_BACKOFF_SECONDS", 0)
    attempts: list[tuple[str, str]] = []

    def failing_vend(credential: str, field: str) -> str:
        attempts.append((credential, field))
        raise VendError(f"could not vend '{credential}.{field}' from https://broker.example: broker locked")

    monkeypatch.setattr(vend_module, "vend", failing_vend)
    with pytest.raises(VendError) as excinfo:
        _ExampleSettings()
    assert attempts == [("example-credential", "plain-field")] * 3
    assert "broker locked" in str(excinfo.value)


def test_the_boot_lane_file_answers_before_the_broker_is_ever_asked(tmp_path) -> None:
    """The one escape hatch: a value already on disk means `vend` is never called."""
    credential_file = tmp_path / "boot-lane-secret"
    credential_file.write_text("from-the-file\n")
    settings = _FiledSettings(value="", value_file=str(credential_file))
    assert settings.value == "from-the-file"


def test_the_boot_lane_file_still_falls_through_to_vend_when_unreadable(
    tmp_path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A file path that names nothing readable is not a value: the broker still answers."""
    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)  # conftest defaults it off for the suite
    monkeypatch.setattr(vend_module, "vend", lambda credential, field: "from-the-broker")
    settings = _FiledSettings(value="", value_file=str(tmp_path / "not-there"))
    assert settings.value == "from-the-broker"


def test_the_vend_switch_leaves_a_field_empty_and_unset_still_raises(monkeypatch: pytest.MonkeyPatch) -> None:
    """`<PREFIX>_VEND=off` -- CI's no-identity context -- skips the broker and leaves
    an empty field at its empty default; with the switch unset (every other context,
    production included), the same empty field still raises rather than starting
    silently unconfigured.
    """
    monkeypatch.setattr(vend_module, "vend", _forbidden_vend)
    monkeypatch.setenv(vend_module._VEND_SWITCH_ENV, "off")
    settings = _ExampleSettings()
    assert settings.plain_field == ""
    assert settings.secret_field.get_secret_value() == ""

    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)
    monkeypatch.setattr(
        vend_module, "vend", lambda credential, field: (_ for _ in ()).throw(VendError("no software identity key"))
    )
    with pytest.raises(VendError):
        _ExampleSettings()


# ---------------------------------------------------------------------------
# `vend`'s own mechanics: the in-process software-key attest client
# ---------------------------------------------------------------------------


def _generate_key_file(path) -> ec.EllipticCurvePrivateKey:
    """Write a fresh P-256 key to `path`, exactly as the host mints one at activation."""
    key = ec.generate_private_key(ec.SECP256R1())
    pem = key.private_bytes(Encoding.PEM, PrivateFormat.PKCS8, NoEncryption())
    path.write_bytes(pem)
    return key


class _FakeResponse:
    def __init__(self, status_code: int, payload: dict[str, Any]) -> None:
        self.status_code = status_code
        self._payload = payload

    def json(self) -> dict[str, Any]:
        return self._payload


def test_missing_key_file_raises_vend_error_naming_the_path(tmp_path, monkeypatch: pytest.MonkeyPatch) -> None:
    """No key file -- this app was never activated on this host -- is a clear, named-path VendError."""
    missing = tmp_path / "never-minted.key"
    monkeypatch.setattr(vend_module, "PORTCULLIS_KEY_FILE", str(missing))

    with pytest.raises(VendError, match=str(missing)):
        vend_module.vend("example-credential", "plain-field")


def test_the_attest_flow_signs_a_real_challenge_and_vends_the_field(
    tmp_path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Challenge -> sign -> token -> vend against a mocked broker, with a REAL P-256 key.

    The broker would reject a forged or mis-targeted signature, so verifying it
    against the presented public key is the only way this test would fail if the
    flow signed the wrong message, the wrong bytes, or the wrong encoding.
    """
    key_path = tmp_path / "consumer.key"
    key = _generate_key_file(key_path)
    monkeypatch.setattr(vend_module, "PORTCULLIS_KEY_FILE", str(key_path))
    expected_spki_b64 = base64.b64encode(
        key.public_key().public_bytes(Encoding.DER, PublicFormat.SubjectPublicKeyInfo)
    ).decode()
    future = (datetime.now(UTC) + timedelta(hours=1)).isoformat()

    def fake_post(url: str, *, json: dict[str, Any], timeout: float) -> _FakeResponse:
        if url.endswith("/v1/attest/challenge"):
            assert json == {"public_key_der": expected_spki_b64}
            return _FakeResponse(200, {"challenge_id": "chal_1", "nonce": "nonce_1"})
        if url.endswith("/v1/attest/token"):
            assert json["challenge_id"] == "chal_1"
            assert json["nonce"] == "nonce_1"
            raw = base64.b64decode(json["signature_b64"])
            r, s = int.from_bytes(raw[:32], "big"), int.from_bytes(raw[32:], "big")
            key.public_key().verify(
                encode_dss_signature(r, s), b"chal_1.nonce_1", ec.ECDSA(hashes.SHA256())
            )
            return _FakeResponse(200, {"key": "pc_test_bearer", "expires_at": future, "max_expires_at": future})
        raise AssertionError(f"unexpected POST {url}")

    def fake_get(url: str, *, headers: dict[str, str], timeout: float) -> _FakeResponse:
        assert url.endswith("/v1/credentials/example-credential")
        assert headers == {"Authorization": "Bearer pc_test_bearer"}
        return _FakeResponse(
            200,
            {"material": {"kind": "static", "fields": [{"name": "plain-field", "value": "vended-value"}]}},
        )

    monkeypatch.setattr(vend_module.httpx, "post", fake_post)
    monkeypatch.setattr(vend_module.httpx, "get", fake_get)

    assert vend_module.vend("example-credential", "plain-field") == "vended-value"


def test_a_cached_bearer_is_reused_without_re_attesting(tmp_path, monkeypatch: pytest.MonkeyPatch) -> None:
    """A bearer well inside its lifetime is reused: no second challenge/token round trip."""
    key_path = tmp_path / "consumer.key"
    _generate_key_file(key_path)
    monkeypatch.setattr(vend_module, "PORTCULLIS_KEY_FILE", str(key_path))
    future = (datetime.now(UTC) + timedelta(hours=1)).isoformat()
    attest_calls = 0

    def fake_post(url: str, *, json: dict[str, Any], timeout: float) -> _FakeResponse:
        nonlocal attest_calls
        attest_calls += 1
        if url.endswith("/v1/attest/challenge"):
            return _FakeResponse(200, {"challenge_id": "chal_1", "nonce": "nonce_1"})
        return _FakeResponse(200, {"key": "pc_test_bearer", "expires_at": future, "max_expires_at": future})

    def fake_get(url: str, *, headers: dict[str, str], timeout: float) -> _FakeResponse:
        return _FakeResponse(200, {"material": {"kind": "static", "fields": [{"name": "f", "value": "v"}]}})

    monkeypatch.setattr(vend_module.httpx, "post", fake_post)
    monkeypatch.setattr(vend_module.httpx, "get", fake_get)

    vend_module.vend("example-credential", "f")
    vend_module.vend("example-credential", "f")

    assert attest_calls == 2  # one challenge + one token; the second vend hit the cache
