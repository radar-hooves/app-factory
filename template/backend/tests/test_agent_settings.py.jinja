"""The gateway credential never leaks through a repr or a dump.

`gateway_key` crosses into the child process at exactly one call site
(`session.py`'s `_environment()`); everywhere else it must read back as a
redacted placeholder, never the value itself.
"""

from pathlib import Path

import pytest

from {{ package_name }}.config.paths import project_root
from {{ package_name }}.config.sections.agent import AgentSettings, _default_personas_dir


def test_the_default_personas_dir_prefers_the_cwd_over_project_root(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """`project_root()` lands nowhere in a container; `Path.cwd()` is its WORKDIR.

    A container ships `config/personas` at `/app/config/personas` and never at
    wherever the installed package's `project_root()` walk lands, so the
    default must find it via the process's cwd, exactly as
    `frontend_build_dir()`/`data_dir()` already do.
    """
    (tmp_path / "config" / "personas").mkdir(parents=True)
    monkeypatch.chdir(tmp_path)
    assert _default_personas_dir() == tmp_path / "config" / "personas"


def test_the_default_personas_dir_falls_back_to_project_root(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    """No `config/personas` under the cwd — the source-tree layout — falls back."""
    monkeypatch.chdir(tmp_path)
    assert _default_personas_dir() == project_root() / "config" / "personas"


def test_the_gateway_key_never_appears_in_a_repr_or_a_dump() -> None:
    settings = AgentSettings(gateway_key="not-a-real-token")
    assert "not-a-real-token" not in repr(settings)
    assert "not-a-real-token" not in str(settings.model_dump())
    assert "not-a-real-token" not in str(settings.model_dump(mode="json"))


def test_the_real_value_is_still_reachable_for_the_child_process() -> None:
    settings = AgentSettings(gateway_key="not-a-real-token")
    assert settings.gateway_key.get_secret_value() == "not-a-real-token"
