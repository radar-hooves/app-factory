"""The agent slice's settings: where personas live, and the gateway a persona is confined to.

`gateway_key` crosses into the child process at exactly one call site
(`AgentSettings.driver()`, into the kit's `cli.environment()`); everywhere
else it must read back as a redacted placeholder, never the value itself. It resolves from the broker
like every other secret, and only for a deployment that names a gateway.
"""

from pathlib import Path

import pytest
from agent_common import cli
from agent_common.persona import Persona

from {{ package_name }}.config import vend as vend_module
from {{ package_name }}.config.paths import project_root
from {{ package_name }}.config.sections.agent import AgentSettings, _default_personas_dir


def test_the_default_personas_dir_prefers_the_cwd_over_project_root(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """`project_root()` lands nowhere in a container; `Path.cwd()` is its WORKDIR.

    A container ships `config/personas` at `/app/config/personas` and never at
    wherever the installed package's `project_root()` walk lands, so the
    default must find it via the process's cwd, exactly as
    `frontend_build_dir()`/`data_dir()` already do.
    """
    (tmp_path / "config" / "personas").mkdir(parents=True)
    monkeypatch.chdir(tmp_path)
    assert _default_personas_dir() == tmp_path / "config" / "personas"


def test_the_default_personas_dir_falls_back_to_project_root(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    """No `config/personas` under the cwd — the source-tree layout — falls back."""
    monkeypatch.chdir(tmp_path)
    assert _default_personas_dir() == project_root() / "config" / "personas"


def test_the_gateway_key_never_appears_in_a_repr_or_a_dump() -> None:
    settings = AgentSettings(gateway_key="not-a-real-token")
    assert "not-a-real-token" not in repr(settings)
    assert "not-a-real-token" not in str(settings.model_dump())
    assert "not-a-real-token" not in str(settings.model_dump(mode="json"))


def test_the_real_value_is_still_reachable_for_the_child_process() -> None:
    settings = AgentSettings(gateway_key="not-a-real-token")
    assert settings.gateway_key.get_secret_value() == "not-a-real-token"


def _vends(monkeypatch: pytest.MonkeyPatch) -> list[tuple[str, str]]:
    """Record every broker vend instead of making it."""
    asked: list[tuple[str, str]] = []

    def _fake_vend(credential: str, field: str) -> str:
        asked.append((credential, field))
        return "vended-gateway-key"

    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)  # conftest defaults it off for the suite
    monkeypatch.setattr(vend_module, "vend", _fake_vend)
    return asked


def test_no_gateway_asks_the_broker_for_nothing(monkeypatch: pytest.MonkeyPatch) -> None:
    asked = _vends(monkeypatch)
    AgentSettings()
    assert asked == []


def test_a_named_gateway_vends_its_key_from_the_broker(monkeypatch: pytest.MonkeyPatch) -> None:
    asked = _vends(monkeypatch)
    settings = AgentSettings(gateway_url="https://gateway.example")
    assert asked == [("{{ project_name }}-gateway", "value")]
    assert settings.gateway_key.get_secret_value() == "vended-gateway-key"


def test_a_gateway_that_named_its_own_key_is_vended_by_that_name(monkeypatch: pytest.MonkeyPatch) -> None:
    """A gateway that mints one key per consumer under its own scheme: the deployment declares the name."""
    asked = _vends(monkeypatch)
    AgentSettings(gateway_url="https://gateway.example", gateway_key_credential="gateway-issued-name")
    assert asked == [("gateway-issued-name", "value")]


def test_a_named_gateway_confines_the_child_to_it(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    """With a gateway named, the child reaches it and nothing else: the OAuth token the app
    process carries for the direct path is withheld, even while the key is empty (CI's
    `<APP>_VEND=off`), so a missing key fails at the gateway rather than falling through."""
    monkeypatch.setenv("CLAUDE_CODE_OAUTH_TOKEN", "direct-path-token")
    persona = Persona(name="p", home=tmp_path, allowed_tools="", disallowed_tools="")

    env = cli.environment(AgentSettings(gateway_url="https://gateway.example").driver(), persona)
    assert env["ANTHROPIC_BASE_URL"] == "https://gateway.example"
    assert env["ANTHROPIC_AUTH_TOKEN"] == ""
    assert "CLAUDE_CODE_OAUTH_TOKEN" not in env

    direct = cli.environment(AgentSettings().driver(), persona)
    assert direct["CLAUDE_CODE_OAUTH_TOKEN"] == "direct-path-token"
    assert "ANTHROPIC_BASE_URL" not in direct
