"""What a chat attachment's bytes must be: its type by signature, its structure, and the optional clamd scan.

The scan is driven against a tiny threaded stand-in for clamd speaking the
INSTREAM protocol over real TCP, so the framing the app sends is asserted, not
mocked. The same refusals at the route are in `test_agent_api.py`.
"""

import socket
from collections.abc import Callable, Iterator

import pytest

from {{ package_name }}.api.agent import content
from {{ package_name }}.config.sections.agent import AgentSettings
from {{ package_name }}.exceptions import ServiceUnavailableError, UnsupportedMediaTypeError, ValidationError
from tests.support import attachments
from tests.support.fake_clamd import FakeClamd


@pytest.mark.parametrize("name", list(attachments.GENUINE))
def test_each_type_is_taken_with_its_genuine_bytes(name: str) -> None:
    content.verify(f"file{name}", attachments.genuine(name))
    content.verify(f"FILE{name.upper()}", attachments.genuine(name))


@pytest.mark.parametrize("name", [".png", ".jpg", ".jpeg", ".webp", ".pdf", ".docx"])
def test_a_renamed_executable_is_refused_whatever_it_is_called(name: str) -> None:
    with pytest.raises(UnsupportedMediaTypeError, match="is not a"):
        content.verify(f"picture{name}", b"MZ\x90\x00" + b"\x00" * 64)


def test_a_png_is_not_a_jpeg() -> None:
    with pytest.raises(UnsupportedMediaTypeError):
        content.verify("a.jpg", attachments.PNG)


def test_a_text_file_with_a_nul_or_invalid_utf8_is_refused() -> None:
    for name, data in (("a.txt", b"ab\x00cd"), ("a.md", b"\xff\xfe\x00h"), ("a.txt", b"\x80abc")):
        with pytest.raises(UnsupportedMediaTypeError):
            content.verify(name, data)


def test_a_pdf_may_start_within_its_first_kilobyte() -> None:
    content.verify("a.pdf", b"\n" * 500 + attachments.PDF)
    with pytest.raises(UnsupportedMediaTypeError):
        content.verify("a.pdf", b"\n" * 2000 + attachments.PDF)


@pytest.mark.parametrize("token", [b"/JavaScript", b"/JS", b"/Launch"])
def test_a_pdf_carrying_script_or_a_launch_action_is_refused(token: bytes) -> None:
    bad = attachments.PDF + b"2 0 obj\n<< /OpenAction << /S " + token + b" /JS (app.alert(1)) >> >>\nendobj\n"
    with pytest.raises(UnsupportedMediaTypeError, match="script or a launch"):
        content.verify("a.pdf", bad)


def test_a_pdf_name_that_only_starts_like_a_script_token_is_taken() -> None:
    content.verify("a.pdf", attachments.PDF + b"<< /JSON 1 >>")


def test_a_docx_without_its_document_part_is_refused() -> None:
    with pytest.raises(UnsupportedMediaTypeError, match=r"not a \.docx"):
        content.verify("a.docx", attachments.docx(without="word/document.xml"))
    with pytest.raises(UnsupportedMediaTypeError, match=r"not a \.docx"):
        content.verify("a.docx", b"PK\x03\x04 but not a zip")


def test_a_docx_with_macros_is_refused() -> None:
    with pytest.raises(UnsupportedMediaTypeError, match="macros"):
        content.verify("a.docx", attachments.docx({"word/vbaProject.bin": b"\x00"}))


def test_a_zip_bomb_is_refused_without_extracting_it() -> None:
    with pytest.raises(UnsupportedMediaTypeError, match="expands"):
        content.verify("a.docx", attachments.docx({"word/bomb.xml": b"\x00" * (4 * 2**20)}))


def test_a_docx_expanding_past_the_total_is_refused(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(content, "ZIP_TOTAL_BYTES", 1000)
    with pytest.raises(UnsupportedMediaTypeError, match="expands"):
        content.verify("a.docx", attachments.docx({"word/a.xml": bytes(range(256)) * 5}))


# ── clamd ────────────────────────────────────────────────────────────────


type Starter = Callable[[bytes], FakeClamd]


@pytest.fixture
def clamd() -> Iterator[Starter]:
    made: list[FakeClamd] = []

    def start(reply: bytes) -> FakeClamd:
        made.append(FakeClamd(reply))
        return made[-1]

    yield start
    for fake in made:
        fake.close()


def _settings(port: int, host: str = "127.0.0.1") -> AgentSettings:
    return AgentSettings(clamd_host=host, clamd_port=port, clamd_timeout_seconds=2.0)


async def test_a_clean_file_is_streamed_to_clamd_whole_and_passes(clamd: Starter) -> None:
    fake = clamd(b"stream: OK\0")
    big = attachments.TEXT * 100_000  # more than one chunk
    await content.checked(_settings(fake.port), {"a.txt": big, "b.pdf": attachments.PDF})
    assert fake.streams == [big, attachments.PDF]


async def test_a_file_clamd_finds_a_signature_in_is_refused_422_naming_it(clamd: Starter) -> None:
    fake = clamd(b"stream: Eicar-Test-Signature FOUND\0")
    with pytest.raises(ValidationError, match="Eicar-Test-Signature"):
        await content.checked(_settings(fake.port), {"a.txt": attachments.TEXT})


async def test_a_clamd_that_answers_an_error_fails_closed_503(clamd: Starter) -> None:
    fake = clamd(b"INSTREAM size limit exceeded. ERROR\0")
    with pytest.raises(ServiceUnavailableError):
        await content.checked(_settings(fake.port), {"a.txt": attachments.TEXT})


async def test_a_clamd_that_cannot_be_reached_fails_closed_503() -> None:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    with pytest.raises(ServiceUnavailableError):
        await content.checked(_settings(port), {"a.txt": attachments.TEXT})


async def test_a_file_that_is_not_its_type_is_refused_before_clamd_is_asked(clamd: Starter) -> None:
    fake = clamd(b"stream: OK\0")
    with pytest.raises(UnsupportedMediaTypeError):
        await content.checked(_settings(fake.port), {"a.png": b"MZ"})
    assert fake.streams == []


async def test_no_host_means_no_scan_and_says_so_once(caplog: pytest.LogCaptureFixture) -> None:
    content._scan_off_logged = False
    with caplog.at_level("WARNING", logger=content.logger.name):
        await content.checked(AgentSettings(), {"a.txt": attachments.TEXT})
        await content.checked(AgentSettings(), {"a.txt": attachments.TEXT})
    assert [r.getMessage() for r in caplog.records].count(
        "Attachments are not scanned for malware: no clamd host is configured (AGENT_CLAMD_HOST)"
    ) == 1
