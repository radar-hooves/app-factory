"""{{ project_name }}'s own test fixtures — the extension point for conftest.py.

`conftest.py` belongs to the factory and is owed byte-identical, so everything
this suite needs beyond it lives here. conftest star-imports this module at the
one point where both of its guarantees hold: the throwaway test database is
resolved and every ``POSTGRES_*`` is assigned, and no app module has been
imported yet.

Which means both shapes work, and neither has to fight the file that carries
them:

- an environment variable this app must set BEFORE it is first imported —
  assign it at module level here, not with ``setdefault``, if a run must never
  inherit whatever a shell happens to export;
- a fixture, a factory, a second authenticated client, a constant its tests
  share — define it here and every test sees it, exactly as if it sat in
  conftest.

Empty by default, and an app with nothing to add leaves it that way.
"""

#: How long this app's own worker process takes to boot under `uvicorn`, from
#: spawn to answering `/openapi.json` -- the fact
#: `test_a_second_worker_process_watches_messages_stops_and_resumes_a_job`
#: (`tests/test_agent_jobs_api.py`) polls a second worker against, and the
#: floor its hanging job's idle timeout is kept above so the boot itself
#: never reads as a stall. The scaffold app boots in a couple of seconds; an
#: app whose import graph is heavier raises this to its own measured boot
#: time plus margin (radar-hooves/godswood#839: ~35s observed under CI).
SECOND_WORKER_BOOT_SECONDS = 60.0

#: The host the second-worker test's readiness probe sends as its `Host`
#: header. A bare loopback IP works for the scaffold; an app whose
#: trusted-host guard refuses one by design (`platform/proxy-delegated-auth.md`)
#: overrides this to `"localhost"`, which the guard's dev allowlist accepts.
SECOND_WORKER_PROBE_HOST = "127.0.0.1"


def app_session_start() -> None:
    """This app's own once-per-run setup, called by conftest's session-start hook.

    Runs AFTER the test database exists and is migrated to head, which is the
    only order that can work for anything touching tables. Seeding the one
    identity every request must resolve is the usual reason to want it.

    A named entry point rather than a second ``pytest_sessionstart`` here,
    because this module is star-imported into conftest: a hook of the same name
    would REPLACE the factory's and silently skip building the database.

    No-op by default.
    """
