"""A HUP leaves the JSON log line in place (gunicorn.conf.py).

Gunicorn re-applies its logging config on every HUP. A full dictConfig replaced the
root handlers, and `configure()` is idempotent, so nothing put the JSON handler
back: the new worker logged plain text and Loki lost every field until a restart.
This sends a real HUP to a real gunicorn running the stamped config.
"""

import json
import os
import signal
import socket
import subprocess
import sys
import textwrap
import time
from pathlib import Path

import httpx

BACKEND = Path(__file__).resolve().parents[1]

APP = textwrap.dedent(
    """
    import logging

    from {{ package_name }}.logging import configure_logging

    configure_logging()
    log = logging.getLogger("hup_probe")


    async def app(scope, receive, send):
        if scope["type"] == "http":
            log.warning("hup probe")
            await send({"type": "http.response.start", "status": 200, "headers": []})
            await send({"type": "http.response.body", "body": b"ok"})
    """
)


def free_port() -> int:
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return int(probe.getsockname()[1])


def start_budget() -> float:
    return 60.0 * max(1.0, os.getloadavg()[0] / (os.cpu_count() or 1))


def _lines(path: Path) -> list[str]:
    return path.read_text().splitlines()


def _wait_for(predicate, what: str):
    started, budget = time.monotonic(), start_budget()
    while time.monotonic() - started < budget:
        if (found := predicate()) is not None:
            return found
        time.sleep(0.2)
    raise AssertionError(f"{what} did not happen within {budget:.0f}s")


def test_log_lines_are_json_after_a_hup(tmp_path: Path) -> None:
    (tmp_path / "hup_probe_app.py").write_text(APP)
    out = tmp_path / "out.log"
    port = free_port()
    with out.open("w") as sink:
        process = subprocess.Popen(
            [
                sys.executable,
                "-m",
                "gunicorn",
                "hup_probe_app:app",
                "--config",
                str(BACKEND / "gunicorn.conf.py"),
                "--bind",
                f"127.0.0.1:{port}",
                "--no-control-socket",
            ],
            cwd=BACKEND,
            stdout=sink,
            stderr=subprocess.STDOUT,
            env={
                **os.environ,
                "FRONT_DOOR_HOST": "",
                "WEB_CONCURRENCY": "1",
                "PYTHONPATH": os.pathsep.join([str(tmp_path), os.environ.get("PYTHONPATH", "")]),
            },
        )
        try:

            def probe_line() -> dict | None:
                try:
                    httpx.get(f"http://127.0.0.1:{port}/", timeout=1)
                except httpx.TransportError:
                    return None
                for line in reversed(_lines(out)):
                    if "hup probe" in line:
                        return {"line": line}
                return None

            before = _wait_for(probe_line, "the first request")["line"]
            assert json.loads(before)["message"] == "hup probe"

            seen = len(_lines(out))
            process.send_signal(signal.SIGHUP)
            _wait_for(lambda: True if any("Hang up" in line for line in _lines(out)[seen:]) else None, "the HUP")
            # The reloaded worker answers once it is up; its line is the one after the HUP.
            mark = len(_lines(out))
            _wait_for(lambda: True if probe_line() and len(_lines(out)) > mark else None, "a request after the HUP")
            after = [line for line in _lines(out)[mark:] if "hup probe" in line]
            assert after, _lines(out)[seen:]
            for line in after:
                assert json.loads(line)["message"] == "hup probe", line
        finally:
            process.terminate()
            process.wait(timeout=30)
