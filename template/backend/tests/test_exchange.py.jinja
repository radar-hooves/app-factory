"""The token exchange, both sides, over real HTTP: an app carries a person, a service verifies them.

`tests/support/fake_authentik.py` stands in for Authentik's token endpoint
and JWKS, minting what the live exchange minted on atlas
(app-factory `docs/research/2026-10-17-token-exchange-proof.md`), so every case
drives this app's real client and verifier rather than a mock of either.
"""

import asyncio
import logging
import time
import types
from collections.abc import AsyncIterator, Iterator

import jwt
import pytest
from cryptography.hazmat.primitives.asymmetric import rsa
from fastapi import FastAPI
from httpx import ASGITransport, AsyncClient
from pydantic import SecretStr

from {{ package_name }} import exchange as exchange_module
from {{ package_name }}.config.sections.exchange import ExchangeSettings
from {{ package_name }}.exceptions import AuthenticationError, ServiceUnavailableError, register_exception_handlers
from {{ package_name }}.exchange import REUSE_MARGIN_SECONDS, Asker, Asking, CurrentAsker, Exchange, Issued
from tests.support.fake_authentik import LIFETIME, FakeAuthentik

APP = "{{ project_name }}"
SECRET = "fake-exchange-secret-long-enough-for-hs256"
PERSON = "uid-asker-0001"


@pytest.fixture
def authentik() -> Iterator[FakeAuthentik]:
    fake = FakeAuthentik()
    server = fake.serve()
    fake.provider(APP, secret=SECRET)
    fake.provider("library", federates=(APP,))
    fake.provider("elsewhere")
    fake.groups[PERSON] = ["household"]
    fake.entitlements[(PERSON, APP)] = ["chat-helper", "notes:write"]
    fake.entitlements[(PERSON, "library")] = ["collection-manual"]
    yield fake
    server.shutdown()


def _settings(authentik: FakeAuthentik, client_id: str = APP, secret: str = SECRET) -> ExchangeSettings:
    return ExchangeSettings(issuer=authentik.issuer(client_id), client_id=client_id, client_secret=SecretStr(secret))


@pytest.fixture
async def app_side(authentik: FakeAuthentik) -> AsyncIterator[Exchange]:
    exchange = Exchange(_settings(authentik))
    yield exchange
    await exchange.aclose()


@pytest.fixture
async def library_side(authentik: FakeAuthentik) -> AsyncIterator[Exchange]:
    exchange = Exchange(_settings(authentik, "library", ""))
    yield exchange
    await exchange.aclose()


async def test_an_app_carries_a_person_to_a_service_that_verifies_them(
    app_side: Exchange, library_side: Exchange
) -> None:
    token = await app_side.token(f"as:{PERSON}", "library")
    assert await library_side.verified(token) == Asker(
        sub=PERSON, app=APP, username=PERSON, groups=("household",), entitlements=("collection-manual",)
    )


async def test_with_no_audience_the_token_is_for_this_app_and_carries_its_own_entitlements(
    app_side: Exchange, library_side: Exchange
) -> None:
    token = await app_side.token(f"as:{PERSON}")
    asker = await app_side.verified(token)
    assert asker is not None
    assert (asker.sub, asker.app, asker.entitlements) == (PERSON, APP, ("chat-helper", "notes:write"))
    assert await library_side.verified(token) is None, "a token for this app is not the library's"


async def test_a_token_for_another_audience_is_refused(app_side: Exchange, library_side: Exchange) -> None:
    for_the_library = await app_side.token(f"as:{PERSON}", "library")
    assert await app_side.verified(for_the_library) is None


async def test_a_forged_token_is_refused(authentik: FakeAuthentik, app_side: Exchange) -> None:
    other_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    assert await app_side.verified(authentik.mint(APP, PERSON, key=other_key)) is None
    genuine = authentik.mint(APP, PERSON)
    head, _, signature = genuine.split(".")
    tampered = authentik.mint(APP, "uid-someone-else").split(".")[1]
    assert await app_side.verified(f"{head}.{tampered}.{signature}") is None
    assert await app_side.verified(genuine) is not None


async def test_an_expired_token_is_refused(authentik: FakeAuthentik, app_side: Exchange) -> None:
    assert await app_side.verified(authentik.mint(APP, PERSON, lifetime=-1)) is None


async def test_a_token_signed_with_the_client_secret_is_refused(authentik: FakeAuthentik, app_side: Exchange) -> None:
    claims = jwt.decode(authentik.mint(APP, PERSON), options={"verify_signature": False})
    assert await app_side.verified(jwt.encode(claims, SECRET, algorithm="HS256", headers={"kid": "x"})) is None


async def test_a_token_that_names_no_asking_app_is_refused(authentik: FakeAuthentik, app_side: Exchange) -> None:
    assert await app_side.verified(authentik.mint(APP, PERSON, asker_claim=None)) is None


async def test_a_token_from_another_issuer_is_routed_elsewhere(authentik: FakeAuthentik, app_side: Exchange) -> None:
    assert app_side.issued_here(authentik.mint(APP, PERSON))
    assert not app_side.issued_here(authentik.mint("elsewhere", PERSON))
    assert not app_side.issued_here("an-opaque-machine-token")


async def test_a_person_whose_sign_in_ended_is_refused_as_a_401(authentik: FakeAuthentik, app_side: Exchange) -> None:
    authentik.signed_out.add(PERSON)
    with pytest.raises(AuthenticationError):
        await app_side.token(f"as:{PERSON}", "library")


async def test_a_service_that_does_not_federate_this_app_is_a_503(app_side: Exchange) -> None:
    with pytest.raises(ServiceUnavailableError) as refused:
        await app_side.token(f"as:{PERSON}", "elsewhere")
    assert refused.value.context["error"] == "invalid_target"


async def test_a_wrong_client_secret_is_a_503(authentik: FakeAuthentik) -> None:
    exchange = Exchange(_settings(authentik, secret="not-the-secret"))
    try:
        with pytest.raises(ServiceUnavailableError) as refused:
            await exchange.token(f"as:{PERSON}")
        assert refused.value.context["error"] == "invalid_client"
    finally:
        await exchange.aclose()


async def test_an_unreachable_authentik_is_a_503_and_unreachable_keys_a_connection_error(
    authentik: FakeAuthentik,
) -> None:
    token = authentik.mint(APP, PERSON)
    exchange = Exchange(
        ExchangeSettings(issuer="http://127.0.0.1:9/application/o/x/", client_id=APP, client_secret=SecretStr(SECRET))
    )
    try:
        with pytest.raises(ServiceUnavailableError):
            await exchange.token(f"as:{PERSON}")
        with pytest.raises(ConnectionError):
            await exchange.verified(token)
    finally:
        await exchange.aclose()


async def test_unknown_keys_refetch_the_jwks_at_most_once_a_minute(
    authentik: FakeAuthentik, app_side: Exchange
) -> None:
    other_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    for _ in range(5):
        forged = jwt.encode(
            jwt.decode(authentik.mint(APP, PERSON), options={"verify_signature": False}),
            other_key,
            algorithm="RS256",
            headers={"kid": "a-kid-nobody-published"},
        )
        assert await app_side.verified(forged) is None
    assert authentik.jwks_reads == 1


async def test_a_request_with_no_forwarded_token_or_no_exchange_cannot_be_carried(
    app_side: Exchange,
) -> None:
    with pytest.raises(ServiceUnavailableError) as absent:
        await Asking(app_side, "", PERSON).token("library")
    assert absent.value.context == {"absent": "X-authentik-jwt"}
    off = Exchange(ExchangeSettings())
    try:
        with pytest.raises(ServiceUnavailableError):
            await Asking(off, f"as:{PERSON}", PERSON).token("library")
        assert await off.verified("anything") is None
    finally:
        await off.aclose()


async def test_one_request_mints_once_per_audience_and_only_for_its_own_person(
    authentik: FakeAuthentik, app_side: Exchange
) -> None:
    asking = Asking(app_side, f"as:{PERSON}", PERSON)
    assert await asking.token("library") == await asking.token("library")
    assert authentik.exchanged.count((APP, "library")) == 1
    with pytest.raises(AuthenticationError):
        await Asking(app_side, f"as:{PERSON}", "uid-someone-else").token("library")


def _clock(monkeypatch: pytest.MonkeyPatch) -> list[float]:
    """The exchange's monotonic clock, held still until a test moves it."""
    now = [1000.0]
    monkeypatch.setattr(exchange_module, "time", types.SimpleNamespace(monotonic=lambda: now[0], time=time.time))
    return now


async def test_a_service_token_is_reused_across_requests_for_the_same_person_only(
    authentik: FakeAuthentik, app_side: Exchange
) -> None:
    first = await Asking(app_side, f"as:{PERSON}", PERSON).token("library")
    assert await Asking(app_side, f"as:{PERSON}", PERSON).token("library") == first
    assert authentik.exchanged.count((APP, "library")) == 1
    other = "uid-asker-0002"
    assert await Asking(app_side, f"as:{other}", other).token("library") != first
    assert authentik.exchanged.count((APP, "library")) == 2


async def test_a_service_token_is_minted_again_once_under_a_minute_of_it_remains(
    authentik: FakeAuthentik, app_side: Exchange, monkeypatch: pytest.MonkeyPatch
) -> None:
    now = _clock(monkeypatch)
    await Asking(app_side, f"as:{PERSON}", PERSON).token("library")
    now[0] += LIFETIME - REUSE_MARGIN_SECONDS - 1
    await Asking(app_side, f"as:{PERSON}", PERSON).token("library")
    assert authentik.exchanged.count((APP, "library")) == 1
    now[0] += 2
    await Asking(app_side, f"as:{PERSON}", PERSON).token("library")
    assert authentik.exchanged.count((APP, "library")) == 2


async def test_lapsed_tokens_are_dropped_when_another_is_kept(
    app_side: Exchange, monkeypatch: pytest.MonkeyPatch
) -> None:
    now = _clock(monkeypatch)
    await Asking(app_side, f"as:{PERSON}", PERSON).token("library")
    now[0] += LIFETIME + 1
    await Asking(app_side, "as:uid-asker-0002", "uid-asker-0002").token("library")
    assert list(app_side._issued) == [("uid-asker-0002", "library")]


async def test_this_apps_own_token_is_minted_for_every_request(authentik: FakeAuthentik, app_side: Exchange) -> None:
    await Asking(app_side, f"as:{PERSON}", PERSON).token()
    await Asking(app_side, f"as:{PERSON}", PERSON).token()
    assert authentik.exchanged.count((APP, None)) == 2


async def test_the_turn_token_and_a_service_token_are_minted_at_the_same_time(
    app_side: Exchange, monkeypatch: pytest.MonkeyPatch
) -> None:
    started: list[str | None] = []
    both = asyncio.Event()
    real = app_side.issue

    async def issue(subject: str, audience: str | None = None) -> Issued:
        started.append(audience)
        if len(started) == 2:
            both.set()
        async with asyncio.timeout(5):
            await both.wait()
        return await real(subject, audience)

    monkeypatch.setattr(app_side, "issue", issue)
    asking = Asking(app_side, f"as:{PERSON}", PERSON)
    async with asyncio.TaskGroup() as group:
        group.create_task(asking.token())
        group.create_task(asking.token("library"))
    assert sorted(started, key=str) == [None, "library"]


async def test_a_fresh_service_token_is_minted_past_a_held_one_and_becomes_the_one_held(
    authentik: FakeAuthentik, app_side: Exchange, monkeypatch: pytest.MonkeyPatch
) -> None:
    now = _clock(monkeypatch)
    held = await Asking(app_side, f"as:{PERSON}", PERSON).token("library")
    now[0] += LIFETIME - REUSE_MARGIN_SECONDS - 1
    fresh = await Asking(app_side, f"as:{PERSON}", PERSON).fresh("library")
    assert fresh != held
    assert authentik.exchanged.count((APP, "library")) == 2
    assert await Asking(app_side, f"as:{PERSON}", PERSON).token("library") == fresh


async def test_a_reuse_does_not_wait_on_a_mint_in_flight(app_side: Exchange) -> None:
    held = await Asking(app_side, f"as:{PERSON}", PERSON).token("library")
    asking = Asking(app_side, f"as:{PERSON}", PERSON)
    release = asyncio.Event()
    real = app_side.issue

    async def issue(subject: str, audience: str | None = None) -> Issued:
        await release.wait()
        return await real(subject, audience)

    app_side.issue = issue  # type: ignore[method-assign]
    minting = asyncio.create_task(asking.fresh("library"))
    await asyncio.sleep(0.05)
    async with asyncio.timeout(1):
        assert await asking.token("library") == held
    release.set()
    assert await minting != held


async def test_an_unreachable_jwks_is_one_read_and_a_503_for_every_caller_until_a_retry(
    authentik: FakeAuthentik, app_side: Exchange
) -> None:
    authentik.jwks_up = False
    genuine = authentik.mint(APP, PERSON)
    for _ in range(3):
        with pytest.raises(ConnectionError):
            await app_side.verified(genuine)
    authentik.jwks_up = True
    with pytest.raises(ConnectionError):
        await app_side.verified(genuine)
    assert authentik.jwks_reads == 1


async def test_a_held_key_answers_through_an_outage_and_a_rotated_out_one_stops(
    authentik: FakeAuthentik, app_side: Exchange
) -> None:
    genuine = authentik.mint(APP, PERSON)
    assert await app_side.verified(genuine) is not None
    authentik.jwks_up = False
    app_side._fetched_at -= 601
    assert await app_side.verified(genuine) is not None, "a stale key still held answers while Authentik is out"
    authentik.jwks_up = True
    authentik.key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    app_side._fetched_at -= 601
    app_side._fetch_after = 0.0
    assert await app_side.verified(genuine) is None, "a key the JWKS no longer publishes stops verifying"


async def test_no_token_or_secret_reaches_a_log_line(
    authentik: FakeAuthentik, app_side: Exchange, caplog: pytest.LogCaptureFixture
) -> None:
    caplog.set_level(logging.DEBUG)
    issued = await app_side.token(f"as:{PERSON}", "library")
    authentik.signed_out.add(PERSON)
    with pytest.raises(AuthenticationError):
        await app_side.token(f"as:{PERSON}", "library")
    logged = "\n".join(f"{record.getMessage()} {record.__dict__}" for record in caplog.records)
    assert issued not in logged and SECRET not in logged and f"as:{PERSON}" not in logged


async def test_a_service_route_hands_its_handler_the_asker(authentik: FakeAuthentik, library_side: Exchange) -> None:
    """`CurrentAsker` on a route: the person another app asked for, from its bearer alone."""
    service = FastAPI()
    register_exception_handlers(service)
    service.state.exchange = library_side

    @service.get("/caller/whoami")
    def whoami(asker: CurrentAsker) -> dict[str, object]:
        return {"sub": asker.sub, "app": asker.app, "entitlements": list(asker.entitlements)}

    minted = authentik.mint("library", PERSON, asked_by=APP)
    async with AsyncClient(transport=ASGITransport(app=service), base_url="http://localhost") as client:
        answered = await client.get("/caller/whoami", headers={"Authorization": f"Bearer {minted}"})
        refused = await client.get("/caller/whoami", headers={"Authorization": f"Bearer {authentik.mint(APP, PERSON)}"})
        missing = await client.get("/caller/whoami")
    assert answered.status_code == 200
    assert answered.json() == {"sub": PERSON, "app": APP, "entitlements": ["collection-manual"]}
    assert (refused.status_code, missing.status_code) == (401, 401)
