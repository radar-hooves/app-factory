"""Tests for the {{ project_name | upper | replace('-', '_') }}_TEST_POSTGRES_* explicit-server production guard.

Exercises ``tests/support/explicit_server_guard.py`` directly rather than
through ``conftest.py``: ``conftest.py``'s module-level code stands up a
real ephemeral Postgres (or connects to a real explicit server) as a side
effect of import, which is exactly what these tests must not do. A
monkeypatched fake engine stands in for a real second server.
"""

from __future__ import annotations

import pytest

from tests.support import explicit_server_guard as guard

_EXPLICIT = {"host": "db.example", "port": "5432", "user": "tester", "password": "secret"}


class _FakeResult:
    def __init__(self, value: object) -> None:
        self._value = value

    def scalar(self) -> object:
        return self._value


class _FakeConnection:
    def __init__(self, value: object) -> None:
        self._value = value

    def __enter__(self) -> _FakeConnection:
        return self

    def __exit__(self, *exc_info: object) -> bool:
        return False

    def execute(self, *args: object, **kwargs: object) -> _FakeResult:
        return _FakeResult(self._value)


class _FakeEngine:
    def __init__(self, scalar_value: object) -> None:
        self._scalar_value = scalar_value
        self.disposed = False

    def connect(self) -> _FakeConnection:
        return _FakeConnection(self._scalar_value)

    def dispose(self) -> None:
        self.disposed = True


class _BrokenEngine:
    """Simulates a server that cannot be reached at all."""

    def connect(self) -> _FakeConnection:
        raise OSError("connection refused")

    def dispose(self) -> None:
        pass


@pytest.mark.unit
class TestPartialQuartetWarning:
    def test_none_set_returns_none(self):
        assert guard.partial_quartet_warning({"host": None, "port": None, "user": None, "password": None}) is None

    def test_all_set_returns_none(self):
        assert guard.partial_quartet_warning(_EXPLICIT) is None

    def test_partial_set_names_only_the_missing_vars(self):
        partial = {"host": "db.example", "port": "5432", "user": None, "password": None}
        message = guard.partial_quartet_warning(partial)
        assert message is not None
        assert "{{ project_name | upper | replace('-', '_') }}_TEST_POSTGRES_USER" in message
        assert "{{ project_name | upper | replace('-', '_') }}_TEST_POSTGRES_PASSWORD" in message
        assert "{{ project_name | upper | replace('-', '_') }}_TEST_POSTGRES_HOST" not in message
        assert "{{ project_name | upper | replace('-', '_') }}_TEST_POSTGRES_PORT" not in message


@pytest.mark.unit
class TestExplicitServerUrl:
    def test_builds_expected_url_and_quotes_special_characters(self):
        # 12345 rather than a plausible port: the parity gate normalises an app's
        # own answered port wherever it appears, so a literal inside any allocated
        # band reads as drift in exactly the app that answered that number.
        from {{ package_name }}.config.sections.database import SQLALCHEMY_SCHEME

        explicit = {"host": "db.example", "port": "12345", "user": "te st", "password": "p@ss/word"}
        url = guard.explicit_server_url(explicit, "postgres")
        assert url == f"{SQLALCHEMY_SCHEME}://te+st:p%40ss%2Fword@db.example:12345/postgres"

    def test_the_scheme_is_the_one_the_app_itself_connects_with(self):
        """The guard must MIRROR ``DatabaseSettings.database_url``, not merely claim to.

        Both used to hard-code the dialect behind a comment telling the next
        editor not to change it, which is a convention, not a mechanism: an app
        pinning a different driver corrected one literal and left the other, so
        every run that set the quartet died in the guard with ModuleNotFoundError
        before reaching a single test. Nothing caught it, because the
        ephemeral-container path never enters this function and no CI job sets
        the quartet. Asserting the RELATIONSHIP is what makes the docstring true.

        Imported inside the test on purpose: at module level ruff sorts this
        against ``tests.support`` in the same first-party block, so the file's
        import order would depend on the app's own package name and no two apps
        could hold it byte-identical.
        """
        from {{ package_name }}.config.sections.database import DatabaseSettings

        app_scheme = DatabaseSettings(
            postgres_user="u", postgres_password="p", postgres_host="h", postgres_port=5432, postgres_db="d"
        ).database_url.split("://", 1)[0]
        guard_scheme = guard.explicit_server_url(
            {"host": "h", "port": "5432", "user": "u", "password": "p"}, "d"
        ).split("://", 1)[0]

        assert guard_scheme == app_scheme

    def test_the_scheme_names_a_driver_this_app_actually_installs(self):
        """The scheme must name a DBAPI that is importable here, not merely a valid one.

        The test above proves the guard and the app agree; it cannot prove they
        are RIGHT. An app whose pyproject pins one driver while this constant
        names another builds two identical, identically-wrong URLs — both sides
        agree, that test passes, and the failure surfaces as ModuleNotFoundError
        out of create_engine at the moment someone points the suite at a real
        server. This resolves the DBAPI the scheme names without connecting to
        anything, so the pin and the scheme are checked against each other.
        """
        from sqlalchemy.engine.url import make_url

        url = guard.explicit_server_url({"host": "h", "port": "5432", "user": "u", "password": "p"}, "d")
        make_url(url).get_dialect().import_dbapi()


@pytest.mark.unit
class TestRefuseIfExplicitServerIsProduction:
    def test_database_absent_is_not_an_error(self, monkeypatch):
        """A genuine purpose-provisioned server has no application database -- nothing to check."""
        maintenance_engine = _FakeEngine(scalar_value=None)
        monkeypatch.setattr(guard, "create_engine", lambda url: maintenance_engine)

        guard.refuse_if_explicit_server_is_production(_EXPLICIT)  # must not raise

        assert maintenance_engine.disposed

    def test_production_stamped_target_is_refused(self, monkeypatch):
        maintenance_engine = _FakeEngine(scalar_value=True)
        target_engine = _FakeEngine(scalar_value=None)
        made = iter([maintenance_engine, target_engine])

        monkeypatch.setattr(guard, "create_engine", lambda url: next(made))
        monkeypatch.setattr("{{ package_name }}.db.environment.is_production", lambda engine: True)

        with pytest.raises(RuntimeError, match="production"):
            guard.refuse_if_explicit_server_is_production(_EXPLICIT)

        assert maintenance_engine.disposed
        assert target_engine.disposed

    def test_local_stamped_target_is_not_refused(self, monkeypatch):
        maintenance_engine = _FakeEngine(scalar_value=True)
        target_engine = _FakeEngine(scalar_value=None)
        made = iter([maintenance_engine, target_engine])

        monkeypatch.setattr(guard, "create_engine", lambda url: next(made))
        monkeypatch.setattr("{{ package_name }}.db.environment.is_production", lambda engine: False)

        guard.refuse_if_explicit_server_is_production(_EXPLICIT)  # must not raise

    def test_unreachable_server_raises_a_clear_error(self, monkeypatch):
        monkeypatch.setattr(guard, "create_engine", lambda url: _BrokenEngine())

        with pytest.raises(RuntimeError, match="Could not connect"):
            guard.refuse_if_explicit_server_is_production(_EXPLICIT)
