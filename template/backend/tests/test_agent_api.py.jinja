async def test_a_mark_lands_on_the_answer_the_page_meant_past_a_question_stopped_before_it(
    client: AsyncClient, library: fake_library.FakeLibrary, monkeypatch: pytest.MonkeyPatch
) -> None:
    settled: list[tuple[str, str, int]] = []
    monkeypatch.setattr(app_hooks, "agent_turn_settled", lambda *args: settled.append(args), raising=False)
    who = _person("room-manual")
    conversation = _events((await _ask(client, "manual", "first?", who)).text)[0]["session_id"]
    asking, _ = await _asking(client, "manual", fake_library.HANG_TRIGGER, who, resume=conversation)
    await client.post(f"/api/agent/conversations/{conversation}/stop", headers=who)
    await asyncio.wait_for(asking, timeout=10)
    await _ask(client, "manual", "third?", who, resume=conversation)

    read = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert [bool(t["answer"]) for t in read["turns"]] == [True, False, True]
    await _settled()
    # The settled hook counts as the page does: the number a mark takes.
    assert [turn for _, _, turn in settled] == [0, 1, 2]

    marked = await client.put(
        f"/api/agent/conversations/{conversation}/turns/2/mark", json={"helpful": False, "note": "dated"}, headers=who
    )
    assert marked.status_code == 204
    assert (library.marks[-1]["turn_index"], library.marks[-1]["helpful"]) == (1, False)
    unanswered = await client.put(
