async def test_the_collections_are_read_as_the_person_with_a_token_minted_for_the_library(
    client: AsyncClient, library: fake_library.FakeLibrary, authentik: fake_authentik.FakeAuthentik
) -> None:
    """Every library call carries a token for the library naming this person and this app, never a secret of the app's."""
    who = _person("chat-manual")
    conversation = _events((await _ask(client, "manual", "How much leave?", who)).text)[0]["session_id"]
    await client.get("/api/agent/manual/collections", headers=who)
    await client.get(f"/api/agent/manual/documents/{fake_library.DOCUMENT_ID}", headers=who)
    public = authentik.key.public_key()
    issuer = authentik.issuer("library")
    named = {
        (claims["sub"], claims["client_id"])
        for claims in (
            jwt.decode(bearer, public, algorithms=["RS256"], audience="library", issuer=issuer)
            for bearer in library.bearers
        )
    }
    assert named == {(who["x-authentik-uid"], APP)}
    assert len(library.bearers) == 5  # the ask lists, searches and opens a document; the page lists and opens one
    assert (APP, "library") in authentik.exchanged
    assert conversation


async def test_a_chat_without_the_persons_token_is_503_and_a_refused_person_401(
    client: AsyncClient, authentik: fake_authentik.FakeAuthentik
) -> None:
    """A route nginx forwards no `X-authentik-jwt` to cannot carry anyone; an ended sign-in sends the page to sign in again."""
    who = _person("chat-manual")
    unforwarded = {name: value for name, value in who.items() if name != "x-authentik-jwt"}
    assert (await _ask(client, "manual", "leave?", unforwarded)).status_code == 503
    authentik.signed_out.add(who["x-authentik-uid"])
    assert (await _ask(client, "manual", "leave?", who)).status_code == 401
    assert (await client.get("/api/agent/manual/collections", headers=who)).status_code == 401
    # Naming the personas carries nobody anywhere.
    assert (await client.get("/api/agent/personas", headers=who)).status_code == 200


