@pytest.fixture
async def client(app: FastAPI) -> AsyncIterator[AsyncClient]:
    """Real commits, and every turn this test started settled before the next test begins."""
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as http:
        yield http
    await _settled()


async def _settled(timeout: float = 15.0) -> None:
    """Wait for every turn in flight: the correct way to observe a background task from outside it."""
    async with asyncio.timeout(timeout):
        while ask_module._turns:
            await asyncio.sleep(0.02)


def _person(*grants: str) -> dict[str, str]:
    uid = f"asker-{uuid.uuid4().hex[:12]}"
    return {"x-authentik-uid": uid, "x-authentik-username": uid, "x-authentik-entitlements": "|".join(grants)}


def _events(body: str) -> list[dict[str, Any]]:
    """An SSE response body as its JSON frames."""
    return [json.loads(line[6:]) for line in body.splitlines() if line.startswith("data: ")]


def _said(events: list[dict[str, Any]]) -> str:
    whole = next(e for e in events if e.get("type") == "assistant")
    return str(whole["message"]["content"][0]["text"])


def _row(conversation_id: str) -> AgentConversation:
    with get_session_factory()() as db:
        found = db.get(AgentConversation, conversation_id)
    assert found is not None
    return found


async def _ask(client: AsyncClient, room: str, question: str, who: dict[str, str], resume: str | None = None) -> Any:
    return await client.post(f"/api/agent/rooms/{room}/ask", json={"question": question, "resume": resume}, headers=who)


async def _until(predicate: Callable[[], object], timeout: float = 10.0) -> None:
    async with asyncio.timeout(timeout):
        while not predicate():
            await asyncio.sleep(0.02)


def _latest(who: dict[str, str]) -> str | None:
    with get_session_factory()() as db:
        return db.execute(
            select(AgentConversation.id)
            .join(User, User.id == AgentConversation.user_id)
            .where(User.authentik_uid == who["x-authentik-uid"])
            .order_by(AgentConversation.created_at.desc())
        ).scalar()


async def _asking(
    client: AsyncClient, room: str, question: str, who: dict[str, str], resume: str | None = None
) -> tuple[asyncio.Task[Any], str]:
    """An ask left running once the agent has taken it, and the conversation it named."""
    asking = asyncio.create_task(_ask(client, room, question, who, resume))
    await _until(lambda: resume or _latest(who))
    conversation = resume or _latest(who)
    assert conversation is not None
    await _until(lambda: _row(conversation).answering_since is not None and _row(conversation).session_id)
    return asking, conversation


