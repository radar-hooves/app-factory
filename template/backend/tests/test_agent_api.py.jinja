async def test_a_spent_allowance_refuses_the_next_question_429(client: AsyncClient) -> None:
    who = _person("room-helper")
    for question in ("one", "two", "three"):
        assert (await _ask(client, "helper", question, who)).status_code == 200
    quota = (await client.get("/api/agent/quota", headers=who)).json()
    assert (quota["limit"], quota["remaining"], quota["reached"], quota["exempt"]) == (3, 0, True, False)

    refused = await _ask(client, "helper", "four", who)
    assert refused.status_code == 429
    # Until the local day ends, which is never more than a day away.
    assert 0 < int(refused.headers["retry-after"]) <= 25 * 3600


