async def test_the_turn_outlives_the_request_and_its_answer_lands(client: AsyncClient, personas_dir: Path) -> None:
    _write_persona(personas_dir, "helper", fakeAgentPace=0.05)
    who = _person("room-helper")
    asking, conversation = await _asking(client, "helper", "a slow one", who)
    asking.cancel()  # the tab closes; the answer is still being written

    read = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert read["answering_since"] is not None
    assert read["turns"][-1]["question"] == "a slow one"
    assert read["turns"][-1]["at"] >= read["answering_since"]
    listed = (await client.get("/api/agent/rooms/helper/conversations", headers=who)).json()
    assert listed[0]["answering_since"] == read["answering_since"]

    await _settled()
    settled = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert settled["answering_since"] is None
    assert settled["turns"][-1]["answer"].startswith("You asked: a slow one")


async def test_an_ask_on_a_conversation_already_answering_is_refused_409(client: AsyncClient) -> None:
    who = _person("room-helper")
    asking, conversation = await _asking(client, "helper", fake_agent_cli.HANG_TRIGGER, who)

    assert (await _ask(client, "helper", "and now?", who, resume=conversation)).status_code == 409

    assert (await client.post(f"/api/agent/conversations/{conversation}/stop", headers=who)).status_code == 204
    await asyncio.wait_for(asking, timeout=10)
    assert _row(conversation).answering_since is None


async def test_a_stop_ends_the_answer_from_another_request_and_the_question_stays(client: AsyncClient) -> None:
    who = _person("room-helper")
    asking, conversation = await _asking(client, "helper", fake_agent_cli.HANG_TRIGGER, who)

    await client.post(f"/api/agent/conversations/{conversation}/stop", headers=who)
    body = (await asyncio.wait_for(asking, timeout=10)).text
    assert not any(e.get("type") == "result" for e in _events(body))

    read = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert read["answering_since"] is None
    assert [(t["question"], t["answer"]) for t in read["turns"]] == [(fake_agent_cli.HANG_TRIGGER, "")]


async def test_a_worker_that_died_mid_turn_leaves_a_conversation_that_can_be_asked_again(client: AsyncClient) -> None:
    who = _person("room-helper")
    conversation = _events((await _ask(client, "helper", "one", who)).text)[0]["session_id"]
    with get_session_factory()() as db:
        long_ago = conversations.now().replace(year=2020)
        db.execute(
            update(AgentConversation)
            .where(AgentConversation.id == conversation)
            .values(answering_since=long_ago, last_activity_at=long_ago)
        )
        db.commit()
    read = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert read["answering_since"] is None
    assert (await _ask(client, "helper", "two", who, resume=conversation)).status_code == 200


