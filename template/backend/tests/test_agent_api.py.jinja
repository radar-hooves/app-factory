async def test_a_thorough_question_costs_two_of_the_allowance(client: AsyncClient) -> None:
    """`daily_questions=3`: one Thorough (2) plus one Quick (1) spends it all."""
    who = _person("room-helper")
    thorough = await client.post(
        "/api/agent/rooms/helper/ask", json={"question": "read closely", "depth": "thorough"}, headers=who
    )
    assert thorough.status_code == 200
    assert (await client.get("/api/agent/quota", headers=who)).json()["remaining"] == 1

    assert (await _ask(client, "helper", "one more", who)).status_code == 200
    quota = (await client.get("/api/agent/quota", headers=who)).json()
    assert (quota["remaining"], quota["reached"]) == (0, True)


