async def test_an_ask_names_the_conversation_before_the_agent_starts_and_keeps_that_name(
    client: AsyncClient,
) -> None:
    response = await _ask(client, "helper", "what is recreation leave?", _person("room-helper"))
    events = _events(response.text)

    first = events[0]
    assert (first["type"], first["subtype"]) == ("system", "init")
    inits = [e for e in events if e.get("subtype") == "init"]
    assert len(inits) == 2 and {e["session_id"] for e in inits} == {first["session_id"]}

    row = _row(first["session_id"])
    assert row.session_id and row.session_id.startswith("fake-") and row.session_id != row.id
    assert row.title == "what is recreation leave?"
    assert row.answering_since is None and row.turns[0]["answered"] is True


async def test_a_conversation_reads_back_every_turn_with_when_it_was_asked(client: AsyncClient) -> None:
    who = _person("room-helper")
    first = _events((await _ask(client, "helper", "one", who)).text)[0]["session_id"]
    await _ask(client, "helper", "two", who, resume=first)

    read = (await client.get(f"/api/agent/conversations/{first}", headers=who)).json()
    assert [turn["question"] for turn in read["turns"]] == ["one", "two"]
    assert all(turn["at"] for turn in read["turns"])
    assert "question=two" in read["turns"][1]["answer"]
    assert read["answering_since"] is None


async def test_what_the_page_asked_for_is_read_back_with_its_question(client: AsyncClient) -> None:
    who = _person("room-helper")
