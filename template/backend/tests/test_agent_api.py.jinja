async def test_an_edited_question_replaces_it_and_every_turn_after_it(client: AsyncClient) -> None:
    who = _person("chat-helper", "admin")
    conversation = _conversation(_events((await _ask(client, "helper", "one", who)).text))
    await _ask(client, "helper", "two", who, resume=conversation)
    await _ask(client, "helper", "three", who, resume=conversation)
    assert (await client.put(f"/api/agent/conversations/{conversation}/turns/2/share", headers=who)).status_code == 200

    edited = await client.post(
        "/api/agent/helper/ask", json={"question": "two, edited", "resume": conversation, "edit": 1}, headers=who
    )
    turns = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()["turns"]

    assert "resume_at=None" not in _answered(_events(edited.text))
    assert [turn["question"] for turn in turns] == ["one", "two, edited"]
    assert turns[1]["answer"].startswith("question=two, edited")
    assert _row(conversation).shared == []


async def test_editing_the_first_question_starts_the_conversation_over(client: AsyncClient) -> None:
    who = _person("chat-helper")
    conversation = _conversation(_events((await _ask(client, "helper", "one", who)).text))
    await _ask(client, "helper", "two", who, resume=conversation)
    first_session = _row(conversation).session_id

    await client.post(
        "/api/agent/helper/ask", json={"question": "anew", "resume": conversation, "edit": 0}, headers=who
    )
    turns = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()["turns"]

    assert [turn["question"] for turn in turns] == ["anew"]
    assert _row(conversation).session_id not in (None, first_session)


