async def test_a_mark_lands_on_the_answer_the_page_meant_past_a_question_stopped_before_it(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    settled: list[tuple[str, str, int]] = []
    monkeypatch.setattr(app_hooks, "agent_turn_settled", lambda *args: settled.append(args), raising=False)
    who = _person("chat-helper")
    conversation = _events((await _ask(client, "helper", "first?", who)).text)[0]["session_id"]
    asking, _ = await _asking(client, "helper", fake_agent_cli.HANG_TRIGGER, who, resume=conversation)
    await client.post(f"/api/agent/conversations/{conversation}/stop", headers=who)
    await asyncio.wait_for(asking, timeout=10)
    await _ask(client, "helper", "third?", who, resume=conversation)

    read = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert [bool(t["answer"]) for t in read["turns"]] == [True, False, True]
    await _settled()
    # The settled hook counts as the page does: the number a mark takes.
    assert [(persona, turn) for persona, _, turn in settled] == [("helper", 0), ("helper", 1), ("helper", 2)]

    mark = f"/api/agent/conversations/{conversation}/turns/2/mark"
    assert (await client.put(mark, json={"helpful": False, "note": "dated"}, headers=who)).status_code == 204
    read = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert [t["mark"] for t in read["turns"]] == [None, None, {"helpful": False, "note": "dated"}]
    assert _row(conversation).turns[2]["mark"] == {"helpful": False, "note": "dated"}

    assert (await client.put(mark, json={"helpful": True}, headers=who)).status_code == 204
    read = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert read["turns"][2]["mark"] == {"helpful": True, "note": None}
    unanswered = f"/api/agent/conversations/{conversation}/turns/1/mark"
    assert (await client.put(unanswered, json={"helpful": True}, headers=who)).status_code == 404
    assert (await client.put(mark.replace("/2/", "/9/"), json={"helpful": True}, headers=who)).status_code == 404
    stranger = _person("chat-helper")
    assert (await client.put(mark, json={"helpful": True}, headers=stranger)).status_code == 404


