async def test_a_question_retrieves_across_every_collection_the_person_may_read_and_cites_it_first(
    client: AsyncClient, library: fake_library.FakeLibrary
) -> None:
    who = _person("chat-manual")
    events = _events((await _ask(client, "manual", "How much leave?", who)).text)

    [query] = _queries(library, who)
    assert (query["query"], query["collections"], query["top_k"]) == (
        "How much leave?",
        [fake_library.COLLECTION, fake_library.SECOND],
        8,
    )
    assert [e["type"] for e in events[:2]] == ["system", "citations"]
    inits = [i for i, e in enumerate(events) if e.get("subtype") == "init"]
    assert len(inits) == 2 and inits[0] == 0 and inits[1] > 1
    assert events[1]["items"][0] == {
        "n": 1,
        "document_id": str(fake_library.DOCUMENT_ID),
        "title": "The Manual, Part 5: Leave",
        "section": "5.1 Recreation leave",
        "snippet": "In manual, on 'How much leave?': a member accrues four weeks of recreation leave each year of service.",
    }
    assert [item["n"] for item in events[1]["items"]] == [1, 2]
    # The persona answers from the passages, appended to the question.
    said = _said(events)
    assert "[1] The Manual, Part 5: Leave (manual)\n\n— 5.1 Recreation leave\nIn manual" in said
    assert "a member accrues four weeks of recreation leave" in said
    assert "cite each claim by its document's number" in said
    # A short document is opened too, whole, under the same number.
    assert "— 5.2 Long service leave\nAccrues after ten years." in said
    assert "— 5.1 Recreation leave\nA member accrues four weeks a year." in said


