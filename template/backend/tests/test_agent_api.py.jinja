async def test_a_follow_up_is_searched_on_its_own_words_and_told_so(
    client: AsyncClient, library: fake_library.FakeLibrary
) -> None:
    who = _person("chat-manual")
    first = _events((await _ask(client, "manual", "How much leave?", who)).text)[0]["session_id"]
    second = _events((await _ask(client, "manual", "And for reservists?", who, resume=first)).text)

    assert [query["query"] for query in _queries(library, who)] == ["How much leave?", "And for reservists?"]
    assert "searched on its own words" in _said(second)
    assert "searched on its own words" not in _said(_events((await _ask(client, "manual", "Again?", who)).text))
    read = (await client.get(f"/api/agent/conversations/{first}", headers=who)).json()
    assert [turn["question"] for turn in read["turns"]] == ["How much leave?", "And for reservists?"]


async def test_a_follow_up_the_search_misses_still_reads_the_document_the_turn_before_it_cited(
    client: AsyncClient, library: fake_library.FakeLibrary
) -> None:
    who = _person("chat-manual")
    first = _events((await _ask(client, "manual", "How much leave?", who)).text)[0]["session_id"]

    library.silent = {fake_library.COLLECTION}
    asked = _events((await _ask(client, "manual", "And long service?", who, resume=first)).text)
    [found, carried] = asked[1]["items"]
    assert (found["n"], found["document_id"]) == (1, None)
    assert (carried["n"], carried["document_id"], carried["section"]) == (
        2,
        str(fake_library.DOCUMENT_ID),
        "5.2 Long service leave",
    )
    assert "[2] The Manual, Part 5: Leave\n\n— 5.2 Long service leave\nAccrues after ten years." in _said(asked)

    unrelated = _events((await _ask(client, "manual", "can you generate artefacts", who, resume=first)).text)
    assert [item["n"] for item in unrelated[1]["items"]] == [1]


