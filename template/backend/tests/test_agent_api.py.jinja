async def _configured(
    app: FastAPI, agent_settings: AgentSettings, exchange_settings: ExchangeSettings, monkeypatch: pytest.MonkeyPatch
) -> AsyncIterator[None]:
    os.chmod(FAKE_CLI, os.stat(FAKE_CLI).st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)
