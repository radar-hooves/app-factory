class _Recording(BaseHTTPRequestHandler):
    presented: list[str]

    def do_GET(self) -> None:
        self.presented.append(self.headers.get("Authorization") or "")
        self.send_response(200)
        self.send_header("Content-Length", "2")
        self.end_headers()
        self.wfile.write(b"ok")

    def log_message(self, format: str, *args: object) -> None:
        """Silence: the default logs every request to stderr."""


async def test_a_persona_turn_presents_a_token_naming_the_person_who_asked(
    client: AsyncClient, personas_dir: Path, app: FastAPI
) -> None:
    """`ASKER_TOKEN` reaches the turn's environment alone, and its `.mcp.json` presents it: the asker, verified here."""
    presented: list[str] = []
    server = HTTPServer(("127.0.0.1", 0), type("_Recorder", (_Recording,), {"presented": presented}))
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        url = f"http://127.0.0.1:{server.server_port}/mcp/"
        mcp = {"app": {"type": "http", "url": url, "headers": {"Authorization": "Bearer ${ASKER_TOKEN}"}}}
        (personas_dir / "helper" / ".mcp.json").write_text(json.dumps({"mcpServers": mcp}))
        who = _person("chat-helper")
        answered = _said(_events((await _ask(client, "helper", fake_agent_cli.MCP_PROBE_TRIGGER, who)).text))
        assert json.loads(answered)["status_code"] == 200
    finally:
        server.shutdown()
    [bearer] = presented
    assert bearer.startswith("Bearer ")
    asker = await app.state.exchange.verified(bearer.removeprefix("Bearer "))
    assert asker == Asker(
        sub=who["x-authentik-uid"], app=APP, username=who["x-authentik-uid"], groups=(), entitlements=()
    )


# ── what an armed persona makes, and an edited question ──────────────────


def _answered(events: list[dict[str, Any]]) -> str:
    """The text of the turn's last assistant event: the echo, after any tool step."""
    whole = [e for e in events if e.get("type") == "assistant"][-1]
    return str(whole["message"]["content"][0]["text"])


def _conversation(events: list[dict[str, Any]]) -> str:
    return str(next(e for e in events if e.get("subtype") == "init")["session_id"])


async def test_a_document_the_persona_writes_is_announced_recorded_and_downloaded(client: AsyncClient) -> None:
    who = _person("chat-helper")
    events = _events((await _ask(client, "helper", "__write__:brief.md:# Brief", who)).text)
    conversation = _conversation(events)

    [made] = [e for e in events if e.get("type") == "artefact"]
    stored = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()["turns"][0]
    download = await client.get(
        f"/api/agent/conversations/{conversation}/artefact", params={"name": "brief.md", "version": 1}, headers=who
    )

    assert (made["name"], made["version"], made["media_type"]) == ("brief.md", 1, "text/markdown")
    assert stored["artefacts"] == [
        {
            "name": "brief.md",
            "version": 1,
            "media_type": "text/markdown",
            "formats": made["formats"],
            "title": "Brief",
            "kind": None,
            "changes": None,
            "pages": 1,
        }
    ]
    assert [step["name"] for step in stored["steps"]] == ["Write"]
    assert download.status_code == 200 and download.text == "# Brief"
    assert download.headers["content-disposition"] == "attachment; filename*=UTF-8''brief.md"


async def test_word_is_offered_only_where_this_app_renders_it(client: AsyncClient) -> None:
    from agent_common import documents

    who = _person("chat-helper")
    events = _events((await _ask(client, "helper", "__write__:brief.md:# Brief", who)).text)
    word = await client.get(
        f"/api/agent/conversations/{_conversation(events)}/artefact",
        params={"name": "brief.md", "version": 1, "format": "docx"},
        headers=who,
    )

    if documents.available():
        assert word.status_code == 200
        assert word.headers["content-type"] == documents.FORMATS["docx"]
        assert word.headers["content-disposition"] == "attachment; filename*=UTF-8''brief.docx"
    else:
        assert word.status_code == 404


