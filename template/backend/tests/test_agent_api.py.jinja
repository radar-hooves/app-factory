async def test_rename_download_and_delete(client: AsyncClient, agent_settings: AgentSettings) -> None:
    who = _person("room-helper")
    conversation = _events((await _ask(client, "helper", "what is leave?", who)).text)[0]["session_id"]
    session = str(_row(conversation).session_id)
    agent = rooms.agent(agent_settings, rooms.get(agent_settings, "helper"))

    renamed = await client.patch(f"/api/agent/conversations/{conversation}", json={"title": "Leave"}, headers=who)
    assert renamed.json()["title"] == "Leave"

    exported = await client.get(f"/api/agent/conversations/{conversation}/export", headers=who)
    assert exported.headers["content-disposition"] == "attachment; filename*=UTF-8''Leave.md"
    assert exported.text.startswith("# Leave\n\n_The Helper_")
    assert "> what is leave?" in exported.text and "question=what is leave?" in exported.text

    assert await agent.read(session) is not None
    assert (await client.delete(f"/api/agent/conversations/{conversation}", headers=who)).status_code == 204
    assert (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).status_code == 404
    assert await agent.read(session) is None


