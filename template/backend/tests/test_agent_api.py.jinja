async def test_the_hooks_see_the_question_the_events_and_the_settled_answer(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    turned: list[tuple[str, str]] = []
    settled: list[tuple[str, str, int]] = []

    def agent_turn(agent: str, user: str, text: str) -> str:
        turned.append((agent, text))
        return text.replace("secret", "[redacted]")

    def agent_event(agent: str, event: dict[str, Any]) -> dict[str, Any] | None:
        return None if event.get("type") == "result" else event

    monkeypatch.setattr(app_hooks, "agent_turn", agent_turn, raising=False)
    monkeypatch.setattr(app_hooks, "agent_event", agent_event, raising=False)
    monkeypatch.setattr(app_hooks, "agent_turn_settled", lambda *args: settled.append(args), raising=False)

    who = _person("room-helper")
    events = _events((await _ask(client, "helper", "my secret plan", who)).text)
    conversation = events[0]["session_id"]
    await _settled()
    assert "question=my [redacted] plan" in _said(events)
    assert not any(e.get("type") == "result" for e in events)
    assert turned == [("helper", "my secret plan")]
    assert settled == [("helper", conversation, 0)]
    read = (await client.get(f"/api/agent/conversations/{conversation}", headers=who)).json()
    assert read["turns"][0]["question"] == "my [redacted] plan"


# ── The persona's headersHelper presents the bearer its .mcp.json names ────


class _BearerRequired(BaseHTTPRequestHandler):
    expected = ""

    def do_GET(self) -> None:
        body = b"ok" if self.headers.get("Authorization") == f"Bearer {self.expected}" else b"no"
        self.send_response(200 if body == b"ok" else 401)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        """Silence: the default logs every request to stderr."""


async def test_the_headers_helper_presents_the_bearer_the_mcp_server_requires(
    client: AsyncClient, personas_dir: Path
) -> None:
    token = f"tok-{uuid.uuid4().hex}"
    server = HTTPServer(("127.0.0.1", 0), type("_Expecting", (_BearerRequired,), {"expected": token}))
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        token_path = personas_dir / "agent.bearer"
        header_shape = '{"Authorization":"Bearer %s"}'
        helper = f"printf '{header_shape}' \"$(cat {token_path})\""
        url = f"http://127.0.0.1:{server.server_port}/mcp/"
        (personas_dir / "helper" / ".mcp.json").write_text(
            json.dumps({"mcpServers": {"app": {"type": "http", "url": url, "headersHelper": helper}}})
        )
        who = _person("room-helper")
        token_path.write_text(token)
        ok = _said(_events((await _ask(client, "helper", fake_agent_cli.MCP_PROBE_TRIGGER, who)).text))
        token_path.write_text("stale")
        refused = _said(_events((await _ask(client, "helper", fake_agent_cli.MCP_PROBE_TRIGGER, who)).text))
        assert (json.loads(ok)["status_code"], json.loads(refused)["status_code"]) == (200, 401)
    finally:
        server.shutdown()
