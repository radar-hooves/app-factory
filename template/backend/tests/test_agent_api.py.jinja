    unworded = {"question": "x", "kind": "Not A Word"}
    assert (await client.post("/api/agent/rooms/helper/ask", json=unworded, headers=who)).status_code == 422


async def test_a_depth_is_read_back_with_its_question_and_a_bad_one_is_refused(client: AsyncClient) -> None:
