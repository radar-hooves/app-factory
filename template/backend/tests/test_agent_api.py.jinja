@pytest.fixture
def library(authentik: fake_authentik.FakeAuthentik) -> Iterator[fake_library.FakeLibrary]:
    """The caller door, naming the person each bearer was minted for and refusing any other audience or signer."""
    public, issuer = authentik.key.public_key(), authentik.issuer("library")

    def person(bearer: str) -> str:
        return str(jwt.decode(bearer, public, algorithms=["RS256"], audience="library", issuer=issuer)["sub"])

    fake = fake_library.FakeLibrary(person)
    server = fake.serve()
    yield fake
    server.shutdown()


