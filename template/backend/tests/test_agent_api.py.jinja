def _write_persona(root: Path, name: str, **settings: object) -> Path:
    """A minimal persona directory: CLAUDE.md, settings.json, .mcp.json."""
    directory = root / name
    directory.mkdir(parents=True, exist_ok=True)
    (directory / "CLAUDE.md").write_text(f"You are {name}.")
    (directory / "settings.json").write_text(
        json.dumps({"model": "goku/sonnet", "permissions": {"allow": ["Read", "Grep"], "deny": ["Bash"]}, **settings})
    )
    (directory / ".mcp.json").write_text(json.dumps({"mcpServers": {}}))
    return directory


@pytest.fixture
