def test_the_roles_are_named_for_the_app_and_the_bootstrap_is_the_answered_role() -> None:
    fields = DatabaseSettings.model_fields
    assert fields["postgres_user"].default == "{{ project_name | replace('-', '_') }}_owner"
    assert fields["postgres_runtime_user"].default == "{{ project_name | replace('-', '_') }}_runtime"
    assert fields["postgres_bootstrap_user"].default == "{{ postgres_user }}"


def test_each_url_names_its_role_and_percent_encodes_it() -> None:
    settings = DatabaseSettings(
        postgres_user="owner",
        postgres_password="o@w:d",
        postgres_runtime_user="app",
        postgres_runtime_password="p@ss:w/rd",
        postgres_bootstrap_user="boot",
    )
    assert settings.database_url.startswith(f"{SQLALCHEMY_SCHEME}://owner:o%40w%3Ad@")
    assert settings.runtime_database_url.startswith(f"{SQLALCHEMY_SCHEME}://app:p%40ss%3Aw%2Frd@")
    assert settings.bootstrap_database_url.startswith(f"{SQLALCHEMY_SCHEME}://boot:o%40w%3Ad@")


def test_the_runtime_password_vends_under_its_own_credential(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)  # conftest defaults it off for the suite
    calls: list[tuple[str, str]] = []

    def fake_vend(credential: str, field: str) -> str:
        calls.append((credential, field))
        return "vended"

    monkeypatch.setattr(vend_module, "vend", fake_vend)
    settings = DatabaseSettings(postgres_password="owner-pw", postgres_runtime_password="")
    assert calls == [("{{ project_name }}-db-runtime", "password")]
    assert settings.postgres_runtime_password == "vended"
