"""Proofs that workspace scoping is a mechanism, not a discipline.

Each test here corresponds to one clause of `rules-library/platform/tenancy.md`
§Enforcement. Together they are what lets the rule claim a forgotten filter is
impossible rather than merely discouraged — and the shared-visibility test is the
regression test for the defect the primitive exists to fix (master-project#291): a
second household member signing in and seeing an empty app.
"""

import pytest
from httpx import AsyncClient, Response
from sqlalchemy import select
from sqlalchemy.orm import Session

from {{ package_name }}.api.example.models import ExampleItem
from {{ package_name }}.api.users.models import User
from {{ package_name }}.api.workspaces.models import Workspace, WorkspaceMembership, WorkspaceRole
from {{ package_name }}.db.base import Base, WorkspaceScoped
from {{ package_name }}.db.registry import WORKSPACE_EXEMPT
from {{ package_name }}.db.scoping import (
    CrossWorkspaceWriteError,
    UnscopedQueryError,
    bind_session,
    unscoped,
)


def _make_user(session: Session, uid: str) -> User:
    user = User(authentik_uid=uid, username=uid)
    session.add(user)
    session.flush()
    return user


def _make_workspace(session: Session, slug: str, *members: User) -> Workspace:
    workspace = Workspace(slug=slug, name=slug)
    session.add(workspace)
    session.flush()
    for user in members:
        session.add(WorkspaceMembership(workspace_id=workspace.id, user_id=user.id, role=WorkspaceRole.MEMBER))
    session.flush()
    return workspace


# ── 1. Coverage: no model ships without an access predicate ──────────────────


def test_every_model_is_scoped_or_exempt_with_a_reason() -> None:
    """A new model must take the mixin or be argued into the exemption list.

    This is the check that fails the day someone adds a table and forgets, which
    is the only moment the mistake is cheap to fix. An exemption with an empty
    reason is not an exemption.
    """
    unaccounted = []
    for mapper in Base.registry.mappers:
        model = mapper.class_
        if issubclass(model, WorkspaceScoped):
            continue
        if model in WORKSPACE_EXEMPT:
            assert WORKSPACE_EXEMPT[model].strip(), f"{model.__name__} is exempt with no reason given"
            continue
        unaccounted.append(model.__name__)

    assert not unaccounted, (
        f"These models are neither WorkspaceScoped nor in WORKSPACE_EXEMPT: {sorted(unaccounted)}. "
        "A domain model takes the mixin — including a child table, whose workspace_id is "
        "denormalised down. Only identity tables and genuinely global reference data are exempt."
    )


# ── 2. Fail closed: an unbound session refuses, it does not return everything ─


def test_unbound_session_refuses_to_read_a_scoped_model(session: Session) -> None:
    """The failure mode of forgetting is an exception, never all-rows."""
    with pytest.raises(UnscopedQueryError):
        session.execute(select(ExampleItem)).scalars().all()


def test_unbound_session_refuses_to_write_a_scoped_model(session: Session) -> None:
    """The flush guard is the write-side half of the same property."""
    user = _make_user(session, "unbound-writer")
    workspace = _make_workspace(session, "unbound-ws", user)

    session.add(ExampleItem(title="orphan", workspace_id=workspace.id))
    with pytest.raises(UnscopedQueryError):
        session.flush()


def test_unbound_session_still_reads_unscoped_models(session: Session) -> None:
    """Identity tables must stay readable before a workspace has been resolved.

    Workspace resolution reads memberships, so if the guard fired on every model
    the app could never resolve anything — this is the test that keeps the guard
    narrow enough to be usable.
    """
    user = _make_user(session, "identity-reader")
    found = session.execute(select(User).where(User.id == user.id)).scalar_one()
    assert found.authentik_uid == "identity-reader"


# ── 3. Isolation, and the defect's own regression test ───────────────────────


def test_members_of_different_workspaces_see_nothing_of_each_others_rows(session: Session) -> None:
    alice = _make_user(session, "alice")
    bob = _make_user(session, "bob")
    alice_ws = _make_workspace(session, "alice-ws", alice)
    bob_ws = _make_workspace(session, "bob-ws", bob)

    bind_session(session, workspace_id=alice_ws.id, created_by_id=alice.id)
    session.add(ExampleItem(title="alice's note"))
    session.flush()

    bind_session(session, workspace_id=bob_ws.id, created_by_id=bob.id)
    session.add(ExampleItem(title="bob's note"))
    session.flush()

    titles = [item.title for item in session.execute(select(ExampleItem)).scalars().all()]
    assert titles == ["bob's note"]


def test_two_members_of_the_same_workspace_see_the_same_rows(session: Session) -> None:
    """THE regression test for master-project#291.

    Under the per-user model this could never pass: the second household member
    signed in through the same SSO and saw an empty app, because the row belonged
    to whoever created it. Here the row belongs to the workspace, so it does not
    matter which member is looking.
    """
    operator = _make_user(session, "operator")
    partner = _make_user(session, "partner")
    household = _make_workspace(session, "household", operator, partner)

    bind_session(session, workspace_id=household.id, created_by_id=operator.id)
    session.add(ExampleItem(title="the household's note"))
    session.flush()
    session.expunge_all()

    # The same workspace, a different member looking.
    bind_session(session, workspace_id=household.id, created_by_id=partner.id)
    items = session.execute(select(ExampleItem)).scalars().all()
    assert [item.title for item in items] == ["the household's note"]


# ── 4. Stamping and cross-workspace writes ───────────────────────────────────


def test_a_new_row_is_stamped_with_the_bound_workspace_and_creator(session: Session) -> None:
    """The service said nothing about either; the session supplied both."""
    user = _make_user(session, "stamper")
    workspace = _make_workspace(session, "stamp-ws", user)

    bind_session(session, workspace_id=workspace.id, created_by_id=user.id)
    item = ExampleItem(title="stamped")
    session.add(item)
    session.flush()

    assert item.workspace_id == workspace.id
    assert item.created_by_id == user.id


def test_a_write_aimed_at_another_workspace_is_refused(session: Session) -> None:
    """A row is always written to the ACTIVE workspace; there is no other path."""
    user = _make_user(session, "crosser")
    here = _make_workspace(session, "here-ws", user)
    elsewhere = _make_workspace(session, "elsewhere-ws", user)

    bind_session(session, workspace_id=here.id, created_by_id=user.id)
    session.add(ExampleItem(title="misdirected", workspace_id=elsewhere.id))
    with pytest.raises(CrossWorkspaceWriteError):
        session.flush()


# ── 5. The escape hatch is explicit, and it restores what it borrowed ────────


def test_unscoped_sees_every_workspace_and_restores_the_binding(session: Session) -> None:
    alice = _make_user(session, "unscoped-alice")
    bob = _make_user(session, "unscoped-bob")
    alice_ws = _make_workspace(session, "unscoped-alice-ws", alice)
    bob_ws = _make_workspace(session, "unscoped-bob-ws", bob)

    bind_session(session, workspace_id=alice_ws.id, created_by_id=alice.id)
    session.add(ExampleItem(title="a"))
    session.flush()
    bind_session(session, workspace_id=bob_ws.id, created_by_id=bob.id)
    session.add(ExampleItem(title="b"))
    session.flush()

    with unscoped(session):
        assert len(session.execute(select(ExampleItem)).scalars().all()) == 2

    # Still bob's after the block — an escape hatch that leaked its release would
    # be worse than no escape hatch at all.
    assert [i.title for i in session.execute(select(ExampleItem)).scalars().all()] == ["b"]


# ── 6. The same properties, driven through HTTP ──────────────────────────────
#
# The tests above prove the session hooks. These prove the whole chain a real
# request takes — proxy headers, user upsert, personal-workspace provisioning,
# membership resolution, session binding — because that is the chain the defect
# actually lived in, and a green unit test on the hooks would not have caught it.


async def _create_item(client: AsyncClient, uid: str, title: str) -> Response:
    return await client.post(
        "/api/example/",
        json={"title": title},
        headers={"x-authentik-uid": uid, "x-authentik-username": uid},
    )


async def _list_items(client: AsyncClient, uid: str) -> Response:
    return await client.get(
        "/api/example/",
        headers={"x-authentik-uid": uid, "x-authentik-username": uid},
    )


async def test_two_people_signing_in_do_not_see_each_others_items(client: AsyncClient) -> None:
    """Each gets their own auto-provisioned workspace, and the wall holds over HTTP."""
    assert (await _create_item(client, "person-one", "one's item")).status_code == 201
    assert (await _create_item(client, "person-two", "two's item")).status_code == 201

    titles_one = [item["title"] for item in (await _list_items(client, "person-one")).json()]
    titles_two = [item["title"] for item in (await _list_items(client, "person-two")).json()]

    assert titles_one == ["one's item"]
    assert titles_two == ["two's item"]


async def test_a_second_member_of_a_workspace_sees_what_the_first_created(
    client: AsyncClient, session: Session
) -> None:
    """master-project#291, driven end to end.

    The operator creates something; his partner signs in through the same SSO and
    sees it — because he granted her membership. Before the primitive existed she
    saw an empty app and there was no grant to make.
    """
    assert (await _create_item(client, "the-operator", "the household's item")).status_code == 201

    memberships = (
        await client.get(
            "/api/workspaces/me",
            headers={"x-authentik-uid": "the-operator", "x-authentik-username": "the-operator"},
        )
    ).json()
    assert len(memberships) == 1
    household_id = memberships[0]["workspace"]["id"]

    # The partner signs in for the first time: a user row and her own empty workspace.
    assert (await _list_items(client, "the-partner")).json() == []
    partner = session.execute(select(User).where(User.authentik_uid == "the-partner")).scalar_one()

    # The grant — the act the whole primitive exists for.
    granted = await client.post(
        f"/api/workspaces/{household_id}/members",
        json={"user_id": partner.id, "role": "member"},
        headers={"x-authentik-uid": "the-operator", "x-authentik-username": "the-operator"},
    )
    assert granted.status_code == 201

    # She now belongs to two workspaces, so a bare request is ambiguous and is
    # refused with the choices rather than silently defaulted.
    ambiguous = await _list_items(client, "the-partner")
    assert ambiguous.status_code == 409
    assert len(ambiguous.json()["details"]["workspaces"]) == 2

    shared = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "the-partner",
            "x-authentik-username": "the-partner",
            "x-workspace-id": str(household_id),
        },
    )
    assert [item["title"] for item in shared.json()] == ["the household's item"]


async def test_a_non_member_cannot_reach_a_workspace_by_asking_for_it(client: AsyncClient) -> None:
    """The header disambiguates among the caller's OWN memberships; it grants nothing."""
    await _create_item(client, "insider", "private item")
    memberships = (
        await client.get(
            "/api/workspaces/me", headers={"x-authentik-uid": "insider", "x-authentik-username": "insider"}
        )
    ).json()
    insider_workspace = memberships[0]["workspace"]["id"]

    refused = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "outsider",
            "x-authentik-username": "outsider",
            "x-workspace-id": str(insider_workspace),
        },
    )
    assert refused.status_code == 403
