"""Proofs that workspace scoping is a mechanism, not a discipline.

Each test here corresponds to one clause of `rules-library/platform/tenancy.md`
§Enforcement. Together they are what lets the rule claim a forgotten filter is
impossible rather than merely discouraged.

SELF-CONTAINED ON PURPOSE. This file is owed byte-identical by every app, and it
must run in one that is still MIGRATING onto the shape — no `users` table yet, no
`workspaces` table, no `api/example`. So it imports nothing from `api/` and
touches no application table: it declares its own throwaway models and binds
sessions to plain ids. The hooks read exactly two attributes off a scoped
instance, which is why that is enough to prove them.

The slice's own behaviour — proxy headers, user upsert, membership resolution,
the 409 disambiguation, the machine-principal refusal — is HTTP-level and needs
the tables to exist, so it lives in `test_workspaces_api.py`, which an app that
has not finished adopting does not yet carry.
"""

from typing import cast

import pytest
from sqlalchemy import Integer, String, Table, inspect, select
from sqlalchemy.orm import DeclarativeBase, Mapped, Session, mapped_column

from {{ package_name }}.db.base import Base, SharedReference, WorkspaceScoped
from {{ package_name }}.db.registry import WORKSPACE_EXEMPT
from {{ package_name }}.db.scoping import (
    CrossWorkspaceWriteError,
    UnscopedQueryError,
    bind_session,
    unscoped,
)

# Synthetic ids. Nothing here resolves a membership or reads an identity table —
# binding takes an integer, and these stand in for two workspaces and the two
# people who belong to them.
HOUSEHOLD = 1
ELSEWHERE = 2
OPERATOR = 10
PARTNER = 11


class ProbeBase(DeclarativeBase):
    """A declarative base of its own, deliberately NOT the app's.

    Every throwaway model below sits here rather than on ``Base``, and that is
    load-bearing in two directions. It keeps test-only tables out of
    ``Base.metadata``, which an app's own conftest legitimately enumerates — one
    app TRUNCATEs every table in it between tests, and a table that exists only
    inside a single test's transaction made that teardown fail. And it lets
    ``PlainRow`` carry neither mixin without failing the coverage test above,
    which is correct: that sweep exists to grade the APP's models, not the
    suite's fixtures.
    """


class ScopedRow(ProbeBase, WorkspaceScoped):
    """A throwaway workspace-scoped model, so the factory ships no table nobody asked for.

    ``workspace_id`` and ``created_by_id`` are redeclared WITHOUT the mixin's
    foreign keys. That is deliberate and it is the whole reason this file runs
    everywhere: the session hooks read those two attributes and nothing else,
    while the foreign keys are the SCHEMA's business — exercised by the app that
    adopts the slice and has a `workspaces` table for them to point at.

    Alembic never sees it either way — `env.py` imports `db/registry.py`, never
    the suite — but the conftest does, which is why ProbeBase exists.
    """

    __tablename__ = "scoped_rows_test"

    id: Mapped[int] = mapped_column(primary_key=True)
    title: Mapped[str] = mapped_column(String(64), nullable=False)
    workspace_id: Mapped[int] = mapped_column(Integer, nullable=False, index=True)
    created_by_id: Mapped[int | None] = mapped_column(Integer, nullable=True)


class TaxonomyRow(ProbeBase, SharedReference):
    """A shared taxonomy, for proving the third bucket behaves. Same treatment."""

    __tablename__ = "taxonomy_rows_test"

    id: Mapped[int] = mapped_column(primary_key=True)
    label: Mapped[str] = mapped_column(String(64), nullable=False)
    workspace_id: Mapped[int | None] = mapped_column(Integer, nullable=True, index=True)
    created_by_id: Mapped[int | None] = mapped_column(Integer, nullable=True)


class PlainRow(ProbeBase):
    """An unscoped model, standing in for an identity or reference table."""

    __tablename__ = "plain_rows_test"

    id: Mapped[int] = mapped_column(primary_key=True)
    label: Mapped[str] = mapped_column(String(64), nullable=False)


@pytest.fixture
def tables(session: Session) -> None:
    """Create the throwaway tables inside the test's own transaction."""
    # cast: the declarative __table__ is typed as FromClause, which has no create().
    cast(Table, ScopedRow.__table__).create(session.connection())
    cast(Table, TaxonomyRow.__table__).create(session.connection())
    cast(Table, PlainRow.__table__).create(session.connection())


# ── 1. Coverage: no model ships without an access predicate ──────────────────


def test_every_model_is_scoped_or_exempt_with_a_reason() -> None:
    """A new model must take a mixin or be argued into the exemption list.

    This is the check that fails the day someone adds a table and forgets, which
    is the only moment the mistake is cheap to fix. An exemption with an empty
    reason is not an exemption.

    An app with no workspace-scoped models at all passes this by exempting every
    one of its tables with a stated reason, and that is a finished state rather
    than an unfinished migration — the point is that each table was CLASSIFIED,
    never that some of them ended up scoped.
    """
    unaccounted = []
    for mapper in Base.registry.mappers:
        model = mapper.class_
        if issubclass(model, WorkspaceScoped | SharedReference):
            continue
        if model in WORKSPACE_EXEMPT:
            assert WORKSPACE_EXEMPT[model].strip(), f"{model.__name__} is exempt with no reason given"
            continue
        unaccounted.append(model.__name__)

    assert not unaccounted, (
        f"These models are in none of the three buckets: {sorted(unaccounted)}. "
        "A shared domain model takes WorkspaceScoped — including a child table, whose "
        "workspace_id is denormalised down. A taxonomy every workspace reads and any may "
        "add to takes SharedReference. Exemption is for identity tables, reference data "
        "with no per-workspace half, and personal-subject data — see "
        "rules-library/platform/tenancy.md §Classification."
    )


def test_a_personal_subject_exemption_declares_and_carries_its_own_predicate() -> None:
    """The third bucket is the one with an incentive to abuse it, so it is checked.

    Exempting a table as personal-subject removes it from the session hooks
    entirely — which is right for a record OF one person, and is also the
    cheapest way for an agent to dodge a migration: declare every `user_id`
    table personal-subject, write a plausible sentence, go green, and skip the
    operator ratification a disclosure migration needs
    (`rules-library/platform/tenancy.md` §Classification).

    So the claim has to be true rather than merely stated. A personal-subject
    exemption must say WHO the row is about, and the model must actually carry
    the NOT NULL user_id it claims as its predicate. Both are readable off the
    mapper; neither was checked while the rule only asked for them in prose.
    """
    malformed: list[str] = []
    unpredicated: list[str] = []

    for model, reason in WORKSPACE_EXEMPT.items():
        if not reason.strip().startswith("personal-subject:"):
            continue

        if not reason.strip().removeprefix("personal-subject:").strip():
            malformed.append(f"{model.__name__}: says 'personal-subject:' but names nobody")
            continue

        columns = inspect(model).columns
        if "user_id" not in columns:
            unpredicated.append(f"{model.__name__}: no user_id column to scope by")
        elif columns["user_id"].nullable:
            unpredicated.append(f"{model.__name__}: user_id is nullable, so the predicate can be skipped")

    assert not malformed, (
        f"A personal-subject exemption must name whose row it is: {malformed}. "
        "The reason reads 'personal-subject: <who the row is about>'."
    )
    assert not unpredicated, (
        f"These models claim personal-subject but carry no enforced predicate: {unpredicated}. "
        "The exemption records a DIFFERENT declared predicate, never the absence of one — so the "
        "model needs a NOT NULL user_id its service filters on. If it has no such column, the row "
        "is not personal-subject and belongs in WorkspaceScoped."
    )


# ── 2. Fail closed: an unbound session refuses, it does not return everything ─


def test_unbound_session_refuses_to_read_a_scoped_model(session: Session, tables: None) -> None:
    """The failure mode of forgetting is an exception, never all-rows."""
    with pytest.raises(UnscopedQueryError):
        session.execute(select(ScopedRow)).scalars().all()


def test_unbound_session_refuses_to_write_a_scoped_model(session: Session, tables: None) -> None:
    """The flush guard is the write-side half of the same property."""
    session.add(ScopedRow(title="orphan", workspace_id=HOUSEHOLD))
    with pytest.raises(UnscopedQueryError):
        session.flush()


def test_unbound_session_still_reads_unscoped_models(session: Session, tables: None) -> None:
    """Unscoped models must stay readable before a workspace has been resolved.

    Workspace resolution reads the identity and membership tables, so if the
    guard fired on every model the app could never resolve anything — this is the
    test that keeps the guard narrow enough to be usable.
    """
    session.add(PlainRow(label="readable"))
    session.flush()

    found = session.execute(select(PlainRow)).scalars().all()
    assert [row.label for row in found] == ["readable"]


# ── 3. Isolation, and the defect's own regression test ───────────────────────


def test_members_of_different_workspaces_see_nothing_of_each_others_rows(session: Session, tables: None) -> None:
    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    session.add(ScopedRow(title="the household's note"))
    session.flush()

    bind_session(session, workspace_id=ELSEWHERE, created_by_id=PARTNER)
    session.add(ScopedRow(title="somebody else's note"))
    session.flush()

    titles = [row.title for row in session.execute(select(ScopedRow)).scalars().all()]
    assert titles == ["somebody else's note"]


def test_two_members_of_the_same_workspace_see_the_same_rows(session: Session, tables: None) -> None:
    """THE regression test for master-project#291.

    Under the per-user model this could never pass: the second household member
    signed in through the same SSO and saw an empty app, because the row belonged
    to whoever created it. Here the row belongs to the WORKSPACE, so it does not
    matter which member is looking — which is exactly what the two different
    creator ids against one workspace id assert.
    """
    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    session.add(ScopedRow(title="the household's note"))
    session.flush()
    session.expunge_all()

    # The same workspace, a different member looking.
    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=PARTNER)
    rows = session.execute(select(ScopedRow)).scalars().all()
    assert [row.title for row in rows] == ["the household's note"]


# ── 4. Stamping and cross-workspace writes ───────────────────────────────────


def test_a_new_row_is_stamped_with_the_bound_workspace_and_creator(session: Session, tables: None) -> None:
    """The service said nothing about either; the session supplied both."""
    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    row = ScopedRow(title="stamped")
    session.add(row)
    session.flush()

    assert row.workspace_id == HOUSEHOLD
    assert row.created_by_id == OPERATOR


def test_a_write_aimed_at_another_workspace_is_refused(session: Session, tables: None) -> None:
    """A row is always written to the ACTIVE workspace; there is no other path."""
    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    session.add(ScopedRow(title="misdirected", workspace_id=ELSEWHERE))
    with pytest.raises(CrossWorkspaceWriteError):
        session.flush()


def test_an_edit_of_another_workspaces_row_is_refused(session: Session, tables: None) -> None:
    """The guard covers UPDATE as well as INSERT, or the wall has a door in it."""
    with unscoped(session):
        row = ScopedRow(title="theirs", workspace_id=ELSEWHERE)
        session.add(row)
        session.flush()

    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    row.title = "vandalised"
    with pytest.raises(CrossWorkspaceWriteError):
        session.flush()


# ── 5. The escape hatch is explicit, and it restores what it borrowed ────────


def test_unscoped_sees_every_workspace_and_restores_the_binding(session: Session, tables: None) -> None:
    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    session.add(ScopedRow(title="ours"))
    session.flush()
    bind_session(session, workspace_id=ELSEWHERE, created_by_id=PARTNER)
    session.add(ScopedRow(title="theirs"))
    session.flush()

    with unscoped(session):
        assert len(session.execute(select(ScopedRow)).scalars().all()) == 2

    # Still ELSEWHERE after the block — an escape hatch that leaked its release
    # would be worse than no escape hatch at all.
    assert [r.title for r in session.execute(select(ScopedRow)).scalars().all()] == ["theirs"]


def test_unscoped_restores_an_unbound_session_to_unbound(session: Session, tables: None) -> None:
    """Leaving the block must not silently leave a background job scoped."""
    with unscoped(session):
        session.execute(select(ScopedRow)).scalars().all()

    with pytest.raises(UnscopedQueryError):
        session.execute(select(ScopedRow)).scalars().all()


# ── 6. The third bucket: a shared taxonomy, stated rather than inferred ──────


def test_a_shared_reference_shows_global_rows_and_this_workspace_s_own(session: Session, tables: None) -> None:
    """The wider predicate: global rows PLUS the bound workspace's additions."""
    with unscoped(session):
        session.add(TaxonomyRow(label="global", workspace_id=None))
        session.add(TaxonomyRow(label="ours", workspace_id=HOUSEHOLD))
        session.add(TaxonomyRow(label="theirs", workspace_id=ELSEWHERE))
        session.flush()

    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    labels = sorted(row.label for row in session.execute(select(TaxonomyRow)).scalars().all())
    assert labels == ["global", "ours"]


def test_a_bound_session_cannot_edit_a_global_taxonomy_row(session: Session, tables: None) -> None:
    """Editing the estate's shared list is a deliberate unscoped act, not a side effect."""
    with unscoped(session):
        entry = TaxonomyRow(label="global", workspace_id=None)
        session.add(entry)
        session.flush()

    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    entry.label = "vandalised"
    with pytest.raises(CrossWorkspaceWriteError):
        session.flush()


def test_a_new_taxonomy_row_is_stamped_into_the_bound_workspace(session: Session, tables: None) -> None:
    """A workspace adding to the list adds to ITS half; it cannot mint a global row."""
    bind_session(session, workspace_id=HOUSEHOLD, created_by_id=OPERATOR)
    entry = TaxonomyRow(label="ours")
    session.add(entry)
    session.flush()

    assert entry.workspace_id == HOUSEHOLD

    # An EXPLICIT workspace_id=None is stamped exactly the same way, and that is
    # the trap worth naming: code intending to seed a GLOBAL row from a
    # request-bound session silently creates one workspace's private copy
    # instead, with nothing raised. Measured in a live app 2026-08-20, where a
    # category service lazily seeded the estate's 22 ATO rows from a GET path.
    # Seeding global reference data belongs in a migration or an explicit
    # unscoped() block, never on a read path.
    explicit = TaxonomyRow(label="meant-to-be-global", workspace_id=None)
    session.add(explicit)
    session.flush()

    assert explicit.workspace_id == HOUSEHOLD
