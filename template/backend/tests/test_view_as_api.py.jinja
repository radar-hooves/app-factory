"""View as colleague, driven through HTTP.

An admin narrows their own entitlements with ``X-View-As`` to see the app as a
colleague does (``api/users/dependencies.py``). The header can only remove: the
effective set is what the proxy granted intersected with what was asked for.
"""

from httpx import AsyncClient

from {{ package_name }}.api.users.dependencies import Identity
from {{ package_name }}.api.users.models import User

GRANTED = "admin|reports|reports:write|example"


def _headers(entitlements: str, view_as: str | None = None) -> dict[str, str]:
    headers = {
        "x-authentik-uid": "the-admin",
        "x-authentik-username": "the-admin",
        "x-authentik-entitlements": entitlements,
    }
    if view_as is not None:
        headers["x-view-as"] = view_as
    return headers


async def _me(client: AsyncClient, entitlements: str, view_as: str | None = None) -> dict:
    response = await client.get("/api/users/me", headers=_headers(entitlements, view_as))
    assert response.status_code == 200
    return response.json()


async def test_without_the_header_nothing_is_narrowed(client: AsyncClient) -> None:
    me = await _me(client, GRANTED)
    assert me["entitlements"] == ["admin", "reports", "reports:write", "example"]
    assert me["held"] == me["entitlements"]
    assert me["viewing_as"] is False


async def test_an_admin_keeps_the_intersection(client: AsyncClient) -> None:
    me = await _me(client, GRANTED, "reports|example")
    assert me["entitlements"] == ["reports", "example"]
    assert me["held"] == ["admin", "reports", "reports:write", "example"]
    assert me["viewing_as"] is True


async def test_a_name_the_admin_does_not_hold_is_never_added(client: AsyncClient) -> None:
    me = await _me(client, "admin|reports", "reports|payroll|chat-helper")
    assert me["entitlements"] == ["reports"]
    assert me["held"] == ["admin", "reports"]


async def test_an_empty_header_keeps_nothing(client: AsyncClient) -> None:
    me = await _me(client, GRANTED, "")
    assert me["entitlements"] == []
    assert me["held"] == ["admin", "reports", "reports:write", "example"]
    assert me["viewing_as"] is True


async def test_the_header_of_an_account_without_admin_is_ignored(client: AsyncClient) -> None:
    me = await _me(client, "reports|example", "")
    assert me["entitlements"] == ["reports", "example"]
    assert me["viewing_as"] is False

    widened = await _me(client, "reports", "reports|admin")
    assert widened["entitlements"] == ["reports"]
    assert widened["viewing_as"] is False


async def test_a_write_only_admin_may_narrow(client: AsyncClient) -> None:
    me = await _me(client, "admin:write|reports", "reports")
    assert me["entitlements"] == ["reports"]
    assert me["viewing_as"] is True


async def test_a_narrowed_admin_is_refused_the_admin_area_and_can_still_leave(client: AsyncClient) -> None:
    assert (await client.get("/api/admin/users", headers=_headers(GRANTED))).status_code == 200

    narrowed = _headers(GRANTED, "reports|example")
    refused = await client.get("/api/admin/users", headers=narrowed)
    assert refused.status_code == 403
    assert refused.json()["details"] == {"module": "admin", "grade": "read"}

    # /me still names the real set, so the SPA can offer the way back.
    me = (await client.get("/api/users/me", headers=narrowed)).json()
    assert "admin" in me["held"]
    assert me["viewing_as"] is True


async def test_a_narrowed_admin_loses_a_module_gate_too(client: AsyncClient) -> None:
    assert (await client.get("/api/users/", headers=_headers(GRANTED))).status_code == 200
    # Kept only a chat's grant: admitted to chat alone, as a colleague invited to chat is.
    chat_only = _headers(GRANTED + "|chat-helper", "chat-helper")
    assert (await client.get("/api/users/", headers=chat_only)).status_code == 403


def test_an_identity_built_without_held_holds_its_entitlements() -> None:
    identity = Identity(user=User(authentik_uid="u", username="u"), entitlements=("admin", "reports"))
    assert identity.held == ("admin", "reports")
    assert Identity(user=identity.user, entitlements=("reports",), held=("admin", "reports")).held == ("admin", "reports")
