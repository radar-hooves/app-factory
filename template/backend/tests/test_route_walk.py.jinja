"""A person admitted to this app for one thing reaches nothing else.

A colleague invited to a room holds `room-<id>` and no other entitlement,
and signs in like anyone else (`docs/design/agent-console.md`). So every
route outside the person-facing set below must declare a module gate:
`require_module`, or a gate that reads its module off the path (a room, a
persona), marked by `entitlements.gate`. A route this app adds without one
fails here rather than opening its data to every account the identity
provider lets in. The people list is not person-facing: it answers only an
account admitted to the app itself (`entitlements.require_app_module`).

A route this app holds open by design (the caller's own settings, a webhook
a signature over its body guards) is declared in `app_hooks.OPEN_ROUTES`,
with what guards it instead, and matched whole: a route added beside it
still needs a gate.
"""

from collections.abc import Iterator
from typing import Any

from fastapi import APIRouter, Depends, FastAPI
from fastapi.dependencies.models import Dependant
from fastapi.routing import APIRoute
from httpx import AsyncClient

from {{ package_name }} import app_hooks
from {{ package_name }}.entitlements import require_module
from {{ package_name }}.main import _API_PREFIX

#: Routes any signed-in person may reach, each gated by something other than a module.
PERSON_FACING = {
    "/users/me": "who is calling: the caller's own record, and nobody else's",
    "/workspaces": "the caller's own workspaces, gated by membership",
    "/feedback": "how a person reports a problem; reading reports is admin-gated",
    "/system": "health and version, which name nobody",
    "/agent/rooms": "the rooms the caller is granted; each room's routes gate on its own",
    "/agent/conversations": "the caller's own conversations, each gated on its room",
    "/agent/quota": "the caller's own allowance",
}

#: This app's own routes held open by design, each with what guards it (`app_hooks.OPEN_ROUTES`).
OPEN_ROUTES: dict[str, str] = getattr(app_hooks, "OPEN_ROUTES", {})


def _routes(app: FastAPI) -> Iterator[tuple[str, str, Dependant]]:
    """Every API route as served: `app.routes` lists them flat, or (FastAPI 0.139) behind each included router."""
    for route in app.routes:
        contexts: Any = getattr(route, "effective_route_contexts", None)
        if isinstance(route, APIRoute):
            yield ",".join(sorted(route.methods or ())), route.path, route.dependant
        elif callable(contexts):
            for context in contexts():
                if context.dependant is not None and context.methods:
                    yield ",".join(sorted(context.methods)), context.path, context.dependant


def _gates(dependant: Dependant) -> Iterator[str]:
    for dependency in dependant.dependencies:
        if module := getattr(dependency.call, "gates_module", None):
            yield str(module)
        yield from _gates(dependency)


def _ungated(app: FastAPI, open_routes: dict[str, str]) -> list[str]:
    """Every API route outside the person-facing set and `open_routes` that declares no module gate."""
    prefix = _API_PREFIX.rstrip("/")
    person_facing = tuple(f"{prefix}{path}" for path in PERSON_FACING)
    declared = {f"{prefix}{path}" for path in open_routes}
    return [
        f"{methods} {path}"
        for methods, path, dependant in _routes(app)
        if path.startswith(_API_PREFIX)
        and not path.startswith(person_facing)
        and path not in declared
        and not any(_gates(dependant))
    ]


def test_every_route_outside_the_person_facing_set_declares_a_module_gate(app: FastAPI) -> None:
    assert list(_routes(app))
    assert _ungated(app, OPEN_ROUTES) == []


def test_every_route_this_app_holds_open_is_one_it_serves(app: FastAPI) -> None:
    """A declaration naming no route is stale, and would open whatever next took its path."""
    served = {path for _, path, _ in _routes(app)}
    prefix = _API_PREFIX.rstrip("/")
    assert [path for path in OPEN_ROUTES if f"{prefix}{path}" not in served] == []
    assert all(why.strip() for why in OPEN_ROUTES.values())


def test_a_route_held_open_is_passed_whole_and_nothing_beside_it() -> None:
    router = APIRouter()
    router.add_api_route("/support/webhook", lambda: None, methods=["POST"])
    router.add_api_route("/support/webhook/replay", lambda: None, methods=["POST"])
    router.add_api_route("/support/refunds", lambda: None, dependencies=[Depends(require_module("support"))])
    walked = FastAPI()
    walked.include_router(router, prefix=_API_PREFIX.rstrip("/"))
    assert _ungated(walked, {"/support/webhook": "a signature over the raw body"}) == [
        f"POST {_API_PREFIX.rstrip('/')}/support/webhook/replay"
    ]


def test_a_rooms_routes_gate_on_the_room_they_name(app: FastAPI) -> None:
    rooms = [dependant for _, path, dependant in _routes(app) if "{room_id}" in path]
    assert rooms
    assert all("room-{room_id}" in _gates(dependant) for dependant in rooms)


async def test_an_account_admitted_only_to_a_room_reaches_its_own_record_and_not_the_people(
    client: AsyncClient,
) -> None:
    """The people list is for granting a seat; a colleague invited to a room has none to grant."""
    rooms_only = {
        "x-authentik-uid": "rooms-only",
        "x-authentik-username": "rooms-only",
        "x-authentik-entitlements": "room-x",
    }
    assert (await client.get("/api/users/me", headers=rooms_only)).status_code == 200
    assert (await client.get("/api/users/", headers=rooms_only)).status_code == 403
    admitted = {**rooms_only, "x-authentik-entitlements": "room-x|example"}
    assert (await client.get("/api/users/", headers=admitted)).status_code == 200


async def test_an_account_holding_no_entitlement_is_refused_the_people(client: AsyncClient) -> None:
    """Refused, so an account the identity provider admitted without a grant (an invited reviewer, an outpost forwarding no header) never lists everyone. The picker's people hold a non-room entitlement."""
    bare = {"x-authentik-uid": "no-grants", "x-authentik-username": "no-grants", "x-authentik-entitlements": ""}
    assert (await client.get("/api/users/", headers=bare)).status_code == 403
