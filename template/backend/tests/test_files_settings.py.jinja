"""FilesSettings is off by default, and only vends while it is on.

`test_vend.py` proves the `Vended` mechanism itself; this file proves the
files slice's own gate on it — an empty `NEXTCLOUD_URL` must never attempt a
vend, since that is exactly the state a fresh stamp with no Nextcloud service
account enrolled yet is in.
"""

import pytest

from {{ package_name }}.config import vend as vend_module
from {{ package_name }}.config.sections.files import FilesSettings


def _forbidden_vend(credential: str, field: str) -> str:
    raise AssertionError(f"must not vend '{credential}.{field}' while the files slice is off")


def test_an_empty_url_disables_the_slice_and_never_vends(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(vend_module, "vend", _forbidden_vend)
    settings = FilesSettings(nextcloud_url="")
    assert settings.enabled is False
    assert settings.nextcloud_app_password.get_secret_value() == ""


def test_an_explicit_app_password_beats_the_vend(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(vend_module, "vend", _forbidden_vend)
    settings = FilesSettings(nextcloud_url="https://cloud.example.test", nextcloud_app_password="from-the-environment")
    assert settings.enabled is True
    assert settings.nextcloud_app_password.get_secret_value() == "from-the-environment"


def test_an_empty_app_password_vends_under_this_app_s_own_credential_once_enabled(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.delenv(vend_module._VEND_SWITCH_ENV, raising=False)  # conftest defaults it off for the suite
    calls: list[tuple[str, str]] = []

    def fake_vend(credential: str, field: str) -> str:
        calls.append((credential, field))
        return "from-the-broker"

    monkeypatch.setattr(vend_module, "vend", fake_vend)
    settings = FilesSettings(nextcloud_url="https://cloud.example.test", nextcloud_app_password="")
    assert settings.nextcloud_app_password.get_secret_value() == "from-the-broker"
    assert calls == [("{{ project_name }}-nextcloud", "app_password")]
