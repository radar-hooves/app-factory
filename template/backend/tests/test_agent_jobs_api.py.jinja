async def _start(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, workspace_id: int, **kwargs: Any
) -> str:
    kwargs.setdefault("created_by_id", None)
    return await jobs_module.start(get_session_factory(), agent_settings, persona, workspace_id=workspace_id, **kwargs)


async def _message(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, job_id: str, workspace_id: int, text: str
) -> None:
    await jobs_module.send_message(
        get_session_factory(), agent_settings, persona, job_id, text, workspace_id=workspace_id, user_id=None
    )


async def _wait_until(predicate: Callable[[], bool], *, timeout: float = _POLL_TIMEOUT_SECONDS) -> None:
    """Poll `predicate` until it is true -- the correct way to observe a background `asyncio.Task`
    from a test that is not itself inside that task."""
    async with asyncio.timeout(timeout):
        while not predicate():
            await asyncio.sleep(0.02)


def _job(job_id: str, workspace_id: int) -> AgentJob:
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        job = jobs_models.get_job(db, job_id)
    assert job is not None
    return job


def _events(job_id: str, workspace_id: int) -> list[dict[str, Any]]:
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        return [event for _, event in jobs_models.list_events(db, job_id)]


def _answers(job_id: str, workspace_id: int) -> list[str]:
    """Each `assistant` text in the log, in order."""
    return [
        block["text"]
        for event in _events(job_id, workspace_id)
        if event.get("type") == "assistant"
        for block in event["message"]["content"]
        if block.get("type") == "text"
    ]


def _echo_field(answer: str, name: str) -> str:
    """One `name=value` field of the fake CLI's diagnostic echo."""
    return next(part.removeprefix(f"{name}=") for part in answer.split(" | ") if part.startswith(f"{name}="))


async def _wait_until_settled(job_id: str, workspace_id: int) -> AgentJob:
    await _wait_until(lambda: _job(job_id, workspace_id).status != jobs_models.RUNNING)
    return _job(job_id, workspace_id)


async def _wait_until_running(job_id: str) -> None:
    await _wait_until(lambda: (run := jobs_module._runs.get(job_id)) is not None and run.process is not None)


def _http_events(body: str) -> list[dict[str, Any]]:
    frames = []
    for block in body.split("\n\n"):
        for line in block.splitlines():
            if line.startswith("data: "):
                frames.append(json.loads(line.removeprefix("data: ")))
    return frames


# -- Started by the app, with no asker ---------------------------------------


async def test_a_job_id_comes_back_and_the_run_settles_on_its_own(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """The prompt reaches the CLI on stdin -- the only place `--input-format stream-json` reads it
    -- and once it is answered the CLI's stdin closes, so the run ends rather than idling out."""
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt="hello")
    job = await _wait_until_settled(job_id, workspace_id)
    assert job.status == jobs_models.COMPLETED
    answer = _answers(job_id, workspace_id)[0]
    assert _echo_field(answer, "question") == "hello"
    assert _echo_field(answer, "input_format") == "stream-json"


