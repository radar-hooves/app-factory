async def test_two_concurrent_resumes_only_spawn_one_process(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """CRITICAL 2: without the per-job lock, both concurrent calls see `status != running` and
    both spawn a `--resume` process for the SAME Claude Code session."""
    user_id, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt="first")
    await _wait_until_settled(job_id, workspace_id)

    results = await asyncio.gather(
        jobs_module.send_message(
            get_session_factory(), agent_settings, persona, job_id, "a", workspace_id=workspace_id, user_id=user_id
        ),
        jobs_module.send_message(
            get_session_factory(), agent_settings, persona, job_id, "b", workspace_id=workspace_id, user_id=user_id
        ),
        return_exceptions=True,
    )
    successes = [r for r in results if r is None]
    failures = [r for r in results if isinstance(r, BaseException)]
    assert len(successes) == 1
    assert len(failures) == 1
    assert isinstance(failures[0], BadRequestError)

    await _wait_until_settled(job_id, workspace_id)
    inits = [e for _, e in _events(job_id, workspace_id) if e.get("subtype") == "init"]
    assert len(inits) == 2  # the original run, plus exactly ONE resume -- never two racing


async def test_a_stop_issued_the_instant_a_resume_is_scheduled_is_still_honoured(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """CRITICAL 3: `stop()` called in the gap between a resume being scheduled and its process
    actually existing used to no-op silently -- `_run()` now checks its own cancel event the
    moment its process is registered, so a stop that arrived earlier still lands.

    `send_message()` returning hands control back to this test WITHOUT `_run()` having had any
    chance to execute yet (`asyncio.create_task` only schedules it; nothing here yields to the
    event loop in between) -- `stop()` on the very next line deterministically lands in exactly
    the gap this fix closes, not merely near it.
    """
    user_id, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt="first")
    await _wait_until_settled(job_id, workspace_id)

    await jobs_module.send_message(
        get_session_factory(),
        agent_settings,
        persona,
        job_id,
        fake_agent_cli.HANG_TRIGGER,
        workspace_id=workspace_id,
        user_id=user_id,
    )
    await jobs_module.stop(job_id)

    job = await _wait_until_settled(job_id, workspace_id)
    assert job.status == jobs_models.CANCELLED


