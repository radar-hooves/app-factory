def _write_persona(root: Path, name: str) -> Path:
    directory = root / name
    directory.mkdir(parents=True)
    (directory / "CLAUDE.md").write_text(f"You are {name}.")
    (directory / "settings.json").write_text(json.dumps({"model": "goku/sonnet", "permissions": {"allow": ["Read"]}}))
    return directory


