# -- Any worker ------------------------------------------------------------------


def _free_port() -> int:
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return int(probe.getsockname()[1])


@contextlib.asynccontextmanager
async def _second_worker(agent_settings: AgentSettings) -> AsyncIterator[tuple[str, int]]:
    """Another worker process of this deployment: the same app, database and data directory, its
    own process, event loop and children -- what gunicorn's other workers are to the one running a
    job. Yields its base URL and pid."""
    port = _free_port()
    prefix = "{{ project_name | upper | replace('-', '_') }}_AGENT_"
    env = {
        **os.environ,
        f"{prefix}PERSONAS_DIR": str(agent_settings.personas_dir),
        f"{prefix}EXECUTABLE": agent_settings.executable,
        f"{prefix}TIMEOUT_SECONDS": str(agent_settings.timeout_seconds),
        "DATA_DIR": str(data_dir()),
    }
    process = subprocess.Popen(
        [sys.executable, "-m", "uvicorn", "{{ package_name }}.server:app", "--port", str(port), "--log-level", "warning"],
        cwd=BACKEND,
        env=env,
    )
    base_url = f"http://127.0.0.1:{port}"
    try:
        async with asyncio.timeout(60), httpx.AsyncClient(base_url=base_url, timeout=1) as probe:
            while True:
                assert process.poll() is None, "the second worker exited during startup"
                with contextlib.suppress(httpx.TransportError):
                    if (await probe.get("/openapi.json")).status_code == 200:
                        break
                await asyncio.sleep(0.1)
        yield base_url, process.pid
    finally:
        process.terminate()
        process.wait(timeout=30)


async def _collect(stream: AsyncIterator[str], into: list[dict[str, Any]]) -> None:
    async for line in stream:
        if line.startswith("data: "):
            into.append(json.loads(line.removeprefix("data: ")))


async def test_a_second_worker_process_watches_messages_stops_and_resumes_a_job(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """Every request about a job lands on whichever worker the proxy picked, and the job's CLI is
    a child of just one. Here this test process is the worker running the jobs and a real uvicorn
    process is another: it boots beside a live job and leaves it alone, stops one, follows another
    live while messaging it -- answered by this process's CLI, not a resume -- then resumes it
    itself once it has settled."""
    _, workspace_id = identity
    hanging = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.HANG_TRIGGER)
    await _wait_until_running(hanging)

    async with (
        _second_worker(agent_settings) as (base_url, other_pid),
        httpx.AsyncClient(base_url=base_url, headers=ENTITLED, timeout=_POLL_TIMEOUT_SECONDS) as other,
    ):
        # Booted, and swept for dead runs, beside a live one.
        assert _job(hanging, workspace_id).status == jobs_models.RUNNING

        assert (await other.post(f"/api/agent/jobagent/jobs/{hanging}/stop")).status_code == 204
        assert (await _wait_until_settled(hanging, workspace_id)).status == jobs_models.CANCELLED

        job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.AWAIT_MESSAGE_TRIGGER)
        await _wait_until_running(job_id)
        watched: list[dict[str, Any]] = []
        async with other.stream("GET", f"/api/agent/jobagent/jobs/{job_id}/watch") as response:
            assert response.status_code == 200
            follower = asyncio.create_task(_collect(response.aiter_lines(), watched))
            await _wait_until(lambda: any(e.get("isReplay") for e in watched))
            sent = await other.post(f"/api/agent/jobagent/jobs/{job_id}/message", json={"text": "from elsewhere"})
            assert sent.status_code == 204
            await asyncio.wait_for(follower, timeout=_POLL_TIMEOUT_SECONDS)  # ends as the run settles

        assert _job(job_id, workspace_id).status == jobs_models.COMPLETED
        first, second = _answers(job_id, workspace_id)
        assert _echo_field(second, "question") == "from elsewhere"
        assert _echo_field(second, "pid") == _echo_field(first, "pid")
        assert _echo_field(second, "ppid") == str(os.getpid())  # this worker's own CLI answered it
        assert [e.get("type") for e in watched].count("result") == 2

        resumed = await other.post(f"/api/agent/jobagent/jobs/{job_id}/message", json={"text": "resume there"})
        assert resumed.status_code == 204
        await _wait_until(lambda: len(_answers(job_id, workspace_id)) == 3)
        await _wait_until_settled(job_id, workspace_id)
        third = _answers(job_id, workspace_id)[2]
        assert (_echo_field(third, "question"), _echo_field(third, "resumed")) == ("resume there", "True")
        assert _echo_field(third, "ppid") == str(other_pid)  # resumed by the other worker's own child


# -- A job whose process is gone -------------------------------------------------


def _age_heartbeat(job_id: str, workspace_id: int) -> None:
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        job = jobs_models.get_job(db, job_id)
        assert job is not None
        job.heartbeat_at = datetime.datetime.now(datetime.UTC) - datetime.timedelta(hours=1)
        db.commit()


async def _orphan(agent_settings: AgentSettings, persona: persona_module.PersonaConfig, workspace_id: int) -> str:
    """A job whose worker died mid-run: its task destroyed with nothing left to settle the row."""
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.HANG_TRIGGER)
    await _wait_until_running(job_id)
    task = next(t for t in jobs_module._tasks if t.get_name() == f"agent-job-{job_id}")
    task.cancel()
    with contextlib.suppress(asyncio.CancelledError):
        await task
    jobs_module._runs.pop(job_id, None)
    assert _job(job_id, workspace_id).status == jobs_models.RUNNING
    return job_id


async def test_a_sweep_leaves_a_job_whose_process_is_alive_alone(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """Every worker sweeps as it boots and every minute after; a job another worker is running
    keeps its heartbeat fresh, so no sweep, from any worker, ever fails it."""
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.HANG_TRIGGER)
    await _wait_until_running(job_id)

    await jobs_module.reconcile_orphaned_jobs(get_session_factory())
    assert _job(job_id, workspace_id).status == jobs_models.RUNNING

    await jobs_module.stop(get_session_factory(), job_id, workspace_id=workspace_id)
    await _wait_until_settled(job_id, workspace_id)


async def test_a_running_process_keeps_its_heartbeat_fresh(
    agent_settings: AgentSettings,
    persona: persona_module.PersonaConfig,
    identity: tuple[uuid.UUID, int],
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setattr(jobs_module, "_HEARTBEAT_SECONDS", 0.1)
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.HANG_TRIGGER)
    await _wait_until_running(job_id)
    first = _job(job_id, workspace_id).heartbeat_at
    await _wait_until(lambda: _job(job_id, workspace_id).heartbeat_at != first)
    await jobs_module.stop(get_session_factory(), job_id, workspace_id=workspace_id)
    await _wait_until_settled(job_id, workspace_id)


async def test_a_sweep_settles_a_job_whose_heartbeat_went_stale(
    agent_settings: AgentSettings,
    persona: persona_module.PersonaConfig,
    identity: tuple[uuid.UUID, int],
    settled_calls: list[JobOutcome],
) -> None:
    _, workspace_id = identity
    job_id = await _orphan(agent_settings, persona, workspace_id)
    _age_heartbeat(job_id, workspace_id)

    assert await jobs_module.reconcile_orphaned_jobs(get_session_factory()) >= 1
    job = _job(job_id, workspace_id)
    assert job.status == jobs_models.FAILED
    assert job.error is not None and "orphaned" in job.error
    assert [c.status for c in settled_calls if c.job_id == job_id] == [jobs_models.FAILED]


async def test_a_message_to_a_job_whose_process_is_gone_resumes_it(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """A stale `running` row is no live run: the message resumes the job rather than waiting on nothing."""
    _, workspace_id = identity
    job_id = await _orphan(agent_settings, persona, workspace_id)
    _age_heartbeat(job_id, workspace_id)

    await _message(agent_settings, persona, job_id, workspace_id, "are you there")
    job = await _wait_until_settled(job_id, workspace_id)
    assert job.status == jobs_models.COMPLETED
    assert _echo_field(_answers(job_id, workspace_id)[-1], "resumed") == "True"


async def test_shutdown_ends_this_workers_runs_as_failed(
    agent_settings: AgentSettings,
    persona: persona_module.PersonaConfig,
    identity: tuple[uuid.UUID, int],
    settled_calls: list[JobOutcome],
) -> None:
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.HANG_TRIGGER)
    await _wait_until_running(job_id)

