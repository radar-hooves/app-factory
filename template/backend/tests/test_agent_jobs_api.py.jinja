async def test_a_still_running_job_is_caught_up_and_then_watched_live(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """`watch()` subscribes before it reads the persisted tail, so nothing published in between is lost."""
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.AWAIT_STDIN_TRIGGER)

    collected: list[dict[str, object]] = []

    async def _drain() -> None:
        async for event in jobs_module.watch(get_session_factory(), job_id, workspace_id=workspace_id):
            collected.append(event)
            if event.get("type") == "result":
                return

    drain_task = asyncio.create_task(_drain())
    await asyncio.sleep(0.1)  # let watch() subscribe and read the init-only tail before the reply unblocks it
    await jobs_module.send_message(
        get_session_factory(), agent_settings, persona, job_id, "live reply", workspace_id=workspace_id, user_id=None
    )
    await asyncio.wait_for(drain_task, timeout=_POLL_TIMEOUT_SECONDS)

    assert collected[0].get("subtype") == "init"
    result = next(e for e in collected if e.get("type") == "result")
    assert result.get("structured_output") is None  # no json_schema on this job -- see the schema test above instead


