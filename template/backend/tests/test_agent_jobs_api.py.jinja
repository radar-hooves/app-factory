async def test_a_message_sent_after_the_job_has_finished_resumes_it(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """Need 4's second case: "its session must outlive the run" -- the SAME job id, a second round of events."""
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt="first turn")
    await _wait_until_settled(job_id, workspace_id)

    await jobs_module.send_message(
        get_session_factory(), agent_settings, persona, job_id, "second turn", workspace_id=workspace_id, user_id=None
    )
    await _wait_until_settled(job_id, workspace_id)

    events = _events(job_id, workspace_id)
    inits = [e for _, e in events if e.get("subtype") == "init"]
    assert len(inits) == 2
    # The fake CLI re-emits the ORIGINAL id on `--resume`, exactly as the real CLI does (`ownership.py`'s
    # own measurement, and the reason a job's id can double as its Claude Code session id at all).
    assert {i["session_id"] for i in inits} == {job_id}
    questions = [e for _, e in events if e.get("type") == "assistant"]
    assert "question=first turn" in questions[0]["message"]["content"][0]["text"]
    assert "question=second turn" in questions[1]["message"]["content"][0]["text"]


