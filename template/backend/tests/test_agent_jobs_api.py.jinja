    refused = await client.post(f"/api/agent/jobagent/jobs/{job_id}/stop", headers=OTHER_WORKSPACE)
    assert refused.status_code == 404
    assert _job_status(job_id, workspace_id).status == jobs_models.RUNNING  # the foreign caller's attempt had no effect
    await jobs_module.stop(job_id)  # cleanup


# -- HIGH 5: a restart leaves no orphaned `running` row ----------------------


async def test_reconcile_orphaned_jobs_fails_a_row_a_restart_left_running(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """A genuine restart destroys the `_run()` task along with the whole process, mid-flight,
    with nothing left to settle the row. Cancelling the task (rather than merely forgetting our
    own dict entries) is what actually reproduces that: the `CancelledError` propagates PAST
    `_run()`'s own `_finish()` call once its `finally` block has killed the subprocess and swept
    `_processes`/`_cancel_events`, leaving the DB row `running` with nothing live behind it --
    exactly the shape a restart leaves, and without leaking the underlying OS process either.
    """
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.HANG_TRIGGER)
    await _wait_until(lambda: job_id in jobs_module._processes)

    task = jobs_module._tasks[job_id]
    task.cancel()
    with contextlib.suppress(asyncio.CancelledError):
        await task

    assert _job_status(job_id, workspace_id).status == jobs_models.RUNNING

    reconciled = await jobs_module.reconcile_orphaned_jobs(get_session_factory())
    assert reconciled >= 1
    job = _job_status(job_id, workspace_id)
    assert job.status == jobs_models.FAILED
    assert "restarted" in job.error


# -- HIGH 6: bounded storage under `--include-partial-messages` --------------


async def test_partial_message_chunks_are_broadcast_live_but_never_persisted(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.PARTIAL_TRIGGER)

    collected: list[dict[str, object]] = []

    async def _drain() -> None:
        async for event in jobs_module.watch(get_session_factory(), job_id, workspace_id=workspace_id):
            collected.append(event)
            if event.get("type") == "result":
                return

    await asyncio.wait_for(_drain(), timeout=_POLL_TIMEOUT_SECONDS)

    live_assistants = [e for e in collected if e.get("type") == "assistant"]
    assert [a["message"]["content"][0]["text"] for a in live_assistants] == ["growing", "growing, then settled"]

    persisted_assistants = [e for _, e in _events(job_id, workspace_id) if e.get("type") == "assistant"]
    assert [a["message"]["content"][0]["text"] for a in persisted_assistants] == ["growing, then settled"]


