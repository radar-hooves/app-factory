async def test_the_app_starts_while_the_sweep_cannot_reach_the_database(
    app: FastAPI, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A worker boots with no database (the image smoke does exactly that): the sweep runs beside
    the app, and a failed one is logged and retried rather than failing startup."""

