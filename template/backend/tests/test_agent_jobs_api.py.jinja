async def test_the_settle_hook_hears_every_run_that_settles_including_a_resumed_one(
    agent_settings: AgentSettings,
    persona: persona_module.PersonaConfig,
    identity: tuple[uuid.UUID, int],
    settled_calls: list[JobOutcome],
) -> None:
    """A resumed answer reaches the app that started the job without it polling the row."""
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt="first", json_schema=JOB_SCHEMA)

    def ours() -> list[JobOutcome]:
        return [call for call in settled_calls if call.job_id == job_id]

    await _wait_until(lambda: len(ours()) == 1)
    await _message(agent_settings, persona, job_id, workspace_id, "second")
    await _wait_until(lambda: len(ours()) == 2)

    first, second = ours()
    assert (first.job_id, first.status, first.workspace_id) == (job_id, jobs_models.COMPLETED, workspace_id)
    assert first.structured_output is not None and "question=first" in first.structured_output["text"]
    assert second.structured_output is not None and "question=second" in second.structured_output["text"]


# -- Watched by an entitled member of its workspace, at any time -------------


async def test_watching_a_finished_job_replays_both_sides_of_the_conversation_in_order(
    client: AsyncClient,
    agent_settings: AgentSettings,
    persona: persona_module.PersonaConfig,
    identity: tuple[uuid.UUID, int],
) -> None:
    """What the agent was asked is in the log beside what it answered: the prompt and each
    message, as the CLI's own `isReplay` echo at the start of the turn that consumed it."""
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt="the prompt")
    await _wait_until_settled(job_id, workspace_id)
    await _message(agent_settings, persona, job_id, workspace_id, "a follow-up")
    await _wait_until_settled(job_id, workspace_id)

    response = await client.get(f"/api/agent/jobagent/jobs/{job_id}/watch", headers=ENTITLED)
    assert response.status_code == 200
    spoken = [
        ("asked", e["message"]["content"][0]["text"])
        if e.get("type") == "user"
        else ("answered", _echo_field(e["message"]["content"][0]["text"], "question"))
        for e in _http_events(response.text)
        if (e.get("type") == "user" and e.get("isReplay")) or e.get("type") == "assistant"
    ]
    assert spoken == [
        ("asked", "the prompt"),
        ("answered", "the prompt"),
        ("asked", "a follow-up"),
        ("answered", "a follow-up"),
    ]


