async def test_two_watchers_on_one_job_each_see_the_whole_stream(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.AWAIT_MESSAGE_TRIGGER)
    await _wait_until_running(job_id)

    async def _drain() -> list[dict[str, object]]:
        return [event async for event in jobs_module.watch(get_session_factory(), job_id, workspace_id=workspace_id)]

    watchers = [asyncio.create_task(_drain()), asyncio.create_task(_drain())]
    await asyncio.sleep(0.2)
    await _message(agent_settings, persona, job_id, workspace_id, "seen by both")
    first, second = await asyncio.wait_for(asyncio.gather(*watchers), timeout=_POLL_TIMEOUT_SECONDS)

    assert first == second
    assert [e.get("type") for e in first].count("result") == 2


async def test_a_still_running_job_is_caught_up_and_then_followed_until_it_settles(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.AWAIT_MESSAGE_TRIGGER)
    await _wait_until_running(job_id)

    collected: list[dict[str, object]] = []

    async def _drain() -> None:
        async for event in jobs_module.watch(get_session_factory(), job_id, workspace_id=workspace_id):
            collected.append(event)

    drain_task = asyncio.create_task(_drain())
    await _wait_until(lambda: any(e.get("isReplay") for e in collected))  # caught up on the turn in progress
    await _message(agent_settings, persona, job_id, workspace_id, "live reply")
    await asyncio.wait_for(drain_task, timeout=_POLL_TIMEOUT_SECONDS)  # the stream ends as the run settles

    assert collected[0].get("subtype") == "init"
    assert [e.get("type") for e in collected].count("result") == 2


# -- Messaged while it works, and resumed once it has finished ---------------


async def test_a_message_sent_while_a_turn_is_working_is_answered_by_the_same_run(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """Queued on the row, written onto the running CLI's stdin by its own process, answered as
    the next turn -- by the same CLI process, never a resume."""
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt=fake_agent_cli.AWAIT_MESSAGE_TRIGGER)
    await _wait_until_running(job_id)

    await _message(agent_settings, persona, job_id, workspace_id, "the human's answer")
    job = await _wait_until_settled(job_id, workspace_id)
    assert job.status == jobs_models.COMPLETED

    first, second = _answers(job_id, workspace_id)
    assert _echo_field(second, "question") == "the human's answer"
    assert _echo_field(second, "pid") == _echo_field(first, "pid")
    assert _echo_field(second, "resumed") == "False"


async def test_a_message_sent_after_the_job_has_finished_resumes_it(
    agent_settings: AgentSettings, persona: persona_module.PersonaConfig, identity: tuple[uuid.UUID, int]
) -> None:
    """The SAME job id, the same Claude Code session, a second run."""
    _, workspace_id = identity
    job_id = await _start(agent_settings, persona, workspace_id, prompt="first turn")
    await _wait_until_settled(job_id, workspace_id)

    await _message(agent_settings, persona, job_id, workspace_id, "second turn")
    await _wait_until_settled(job_id, workspace_id)

    inits = [e for e in _events(job_id, workspace_id) if e.get("subtype") == "init"]
    assert {i["session_id"] for i in inits} == {job_id}
    first, second = _answers(job_id, workspace_id)
    assert _echo_field(first, "question") == "first turn"
    assert (_echo_field(second, "question"), _echo_field(second, "resumed")) == ("second turn", "True")


