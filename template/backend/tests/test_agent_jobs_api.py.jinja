# -- A job's own MCP identity --------------------------------------------------
#
# A job's `/mcp` calls must act as the job's own user and workspace, which a
# persona's static `.mcp.json` cannot express. `start()`'s `mcp_config` is how
# a caller binds that in -- proven here against a real local HTTP server exactly
# as `test_agent_api.py`'s own headersHelper test proves the persona-level
# mechanism.


class _BearerRequiredHandler(BaseHTTPRequestHandler):
    """A real HTTP server that 401s any request lacking `expected_bearer`."""

    expected_bearer = ""

    def do_GET(self) -> None:
        body = b"ok" if self.headers.get("Authorization") == f"Bearer {self.expected_bearer}" else b"unauthorized"
        self.send_response(200 if body == b"ok" else 401)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        """Silence: the default logs every request to stderr."""


@pytest.fixture
def fake_mcp_server() -> Iterator[tuple[str, str]]:
    """A real loopback HTTP server requiring a freshly generated bearer -- standing in for the
    job's own `/mcp` surface, bound to a specific identity by the token it demands."""
    token = f"tok-{uuid.uuid4().hex}"
    handler = type("_ExpectingHandler", (_BearerRequiredHandler,), {"expected_bearer": token})
    server = HTTPServer(("127.0.0.1", 0), handler)
    thread = __import__("threading").Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        yield f"http://127.0.0.1:{server.server_port}/mcp/", token
    finally:
        server.shutdown()
        thread.join()


async def test_a_jobs_own_mcp_config_binds_its_identity_and_is_reused_on_resume(
    agent_settings: AgentSettings,
    persona: persona_module.PersonaConfig,
    identity: tuple[uuid.UUID, int],
    fake_mcp_server: tuple[str, str],
    tmp_path: Path,
) -> None:
    """The credential is minted at spawn by `headersHelper`: `mcp_config` is kept on the job row
    and in its folder for as long as the job exists, so it carries a recipe, never a secret."""
    _, workspace_id = identity
    url, token = fake_mcp_server
    token_path = tmp_path / "job.bearer"
    token_path.write_text(token)
    header_shape = '{"Authorization":"Bearer %s"}'
    helper = f"printf '{header_shape}' \"$(cat {token_path})\""
    mcp_config = {"mcpServers": {"app": {"type": "http", "url": url, "headersHelper": helper}}}

    job_id = await _start(
        agent_settings, persona, workspace_id, prompt=fake_agent_cli.MCP_PROBE_TRIGGER, mcp_config=mcp_config
    )
    await _wait_until_settled(job_id, workspace_id)
    assert json.loads(_answers(job_id, workspace_id)[0])["status_code"] == 200

    # A resumed run reaches the same server under the same identity -- the caller never
    # re-supplies `mcp_config`; `jobs.py` reused what `start()` persisted on the job row.
    await _message(agent_settings, persona, job_id, workspace_id, fake_agent_cli.MCP_PROBE_TRIGGER)
    await _wait_until_settled(job_id, workspace_id)
    assert json.loads(_answers(job_id, workspace_id)[-1])["status_code"] == 200


@pytest.mark.parametrize(
    "server",
    [
        {"type": "http", "url": "http://127.0.0.1:1/mcp/", "headers": {"Authorization": "Bearer literal"}},
        {"type": "stdio", "command": "some-server", "env": {"SOME_SERVER_API_TOKEN": "literal"}},
    ],
    ids=["http-header", "stdio-env"],
)
async def test_a_literal_credential_in_mcp_config_is_refused(
    agent_settings: AgentSettings,
    persona: persona_module.PersonaConfig,
    identity: tuple[uuid.UUID, int],
    server: dict[str, object],
) -> None:
    _, workspace_id = identity
    with pytest.raises(BadRequestError):
        await _start(agent_settings, persona, workspace_id, prompt="hi", mcp_config={"mcpServers": {"app": server}})


@pytest.mark.parametrize(
    "env",
    [
        {"PORTCULLIS_KEY_FILE": "/secrets/app.key"},
        {"SOME_SERVER_API_TOKEN_FILE": "/secrets/some-server.token"},
        {"SOME_SERVER_API_TOKEN_PATH": "/secrets/some-server.token"},
    ],
    ids=["portcullis-key-file", "token-file-suffix", "token-path-suffix"],
)
def test_a_key_file_path_in_mcp_config_env_is_not_refused(env: dict[str, str]) -> None:
    """`PORTCULLIS_KEY_FILE` names WHERE a stdio server's own identity key lives, not the key
    itself -- exactly what the refusal's own message asks a caller to do instead of a literal
    header: have the server vend its own from the broker (radar-hooves/godswood#839)."""
    jobs_module._refuse_literal_mcp_credentials(
        {"mcpServers": {"app": {"type": "stdio", "command": "some-server", "env": env}}}
    )


def test_a_secret_under_a_file_shaped_name_is_still_refused() -> None:
    """Only an absolute path passes as a location; a literal value under a `_FILE` name is refused."""
    with pytest.raises(BadRequestError):
        jobs_module._refuse_literal_mcp_credentials(
            {"mcpServers": {"app": {"type": "stdio", "command": "s", "env": {"API_TOKEN_FILE": "sk-live-abc"}}}}
        )
