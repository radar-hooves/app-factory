# -- A job's own MCP identity --------------------------------------------------
#
# godswood's own adoption need: a job's `/mcp` calls must act as the job's own
# user and workspace, which a persona's static `.mcp.json` cannot express.
# `start()`'s `mcp_config` is how a caller binds that in -- proven here against
# a real local HTTP server exactly as `test_agent_api.py`'s own headersHelper
# test proves the persona-level mechanism, so this is the job-level sibling of
# that proof, not a second design.


class _BearerRequiredHandler(BaseHTTPRequestHandler):
    """A real HTTP server that 401s any request lacking `expected_bearer`."""

    expected_bearer = ""

    def do_GET(self) -> None:
        body = b"ok" if self.headers.get("Authorization") == f"Bearer {self.expected_bearer}" else b"unauthorized"
        self.send_response(200 if body == b"ok" else 401)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        """Silence: the default logs every request to stderr."""


@pytest.fixture
def fake_mcp_server() -> Iterator[tuple[str, str]]:
    """A real loopback HTTP server requiring a freshly generated bearer -- standing in for the
    job's own `/mcp` surface, bound to a specific identity by the token it demands."""
    token = f"tok-{uuid.uuid4().hex}"
    handler = type("_ExpectingHandler", (_BearerRequiredHandler,), {"expected_bearer": token})
    server = HTTPServer(("127.0.0.1", 0), handler)
    thread = __import__("threading").Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        yield f"http://127.0.0.1:{server.server_port}/mcp/", token
    finally:
        server.shutdown()
        thread.join()


def _probe_result(text: str) -> dict[str, object]:
    result: dict[str, object] = json.loads(text)
    return result


async def test_a_jobs_own_mcp_config_binds_its_identity_and_is_reused_on_resume(
    agent_settings: AgentSettings,
    persona: persona_module.PersonaConfig,
    identity: tuple[uuid.UUID, int],
    fake_mcp_server: tuple[str, str],
) -> None:
    _, workspace_id = identity
    url, token = fake_mcp_server
    mcp_config = {"mcpServers": {"app": {"type": "http", "url": url, "headers": {"Authorization": f"Bearer {token}"}}}}

    job_id = await _start(
        agent_settings, persona, workspace_id, prompt=fake_agent_cli.MCP_PROBE_TRIGGER, mcp_config=mcp_config
    )
    await _wait_until_settled(job_id, workspace_id)

    first = next(e for _, e in _events(job_id, workspace_id) if e.get("type") == "assistant")
    assert _probe_result(first["message"]["content"][0]["text"])["status_code"] == 200

    # A resumed run reaches the same server under the same identity -- the caller never
    # re-supplies `mcp_config`; `jobs.py` reused what `start()` persisted on the job row.
    await jobs_module.send_message(
        get_session_factory(),
        agent_settings,
        persona,
        job_id,
        fake_agent_cli.MCP_PROBE_TRIGGER,
        workspace_id=workspace_id,
        user_id=None,
    )
    await _wait_until_settled(job_id, workspace_id)

    second = [e for _, e in _events(job_id, workspace_id) if e.get("type") == "assistant"][-1]
    assert _probe_result(second["message"]["content"][0]["text"])["status_code"] == 200
