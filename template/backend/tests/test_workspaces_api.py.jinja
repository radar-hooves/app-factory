"""The workspace SLICE, driven through HTTP.

`test_workspace_scoping.py` proves the session hooks and is owed by every app.
This file proves the whole chain a real request takes — proxy headers, user
upsert, personal-workspace provisioning, membership resolution, session binding —
because that is the chain the defect actually lived in, and a green unit test on
the hooks would not have caught it.

It needs the `users` and `workspaces` tables, so it exists only once an app has
finished adopting, and is sanctioned per-app in `canonical-app-shape.md` for the
same reason `test_example.py` is: an app that does not carry the code does not
carry its test.
"""

import asyncio
import logging
import threading
import uuid

import pytest
from fastapi import FastAPI
from httpx import ASGITransport, AsyncClient, Response
from sqlalchemy import delete, select
from sqlalchemy.orm import Session

from {{ package_name }}.api.users import service as users_service
from {{ package_name }}.api.users.models import User
from {{ package_name }}.api.workspaces.models import Workspace, WorkspaceMembership
from {{ package_name }}.db.session import get_session, get_session_factory


async def _create_item(client: AsyncClient, uid: str, title: str) -> Response:
    return await client.post(
        "/api/example/",
        json={"title": title},
        headers={"x-authentik-uid": uid, "x-authentik-username": uid, "x-authentik-entitlements": "example"},
    )


async def _list_items(client: AsyncClient, uid: str) -> Response:
    return await client.get(
        "/api/example/",
        headers={"x-authentik-uid": uid, "x-authentik-username": uid, "x-authentik-entitlements": "example"},
    )


def _identity(uid: str) -> dict[str, str]:
    return {"x-authentik-uid": uid, "x-authentik-username": uid, "x-authentik-entitlements": "example"}


async def _workspace_of(client: AsyncClient, uid: str) -> str:
    return (await client.get("/api/workspaces/me", headers=_identity(uid))).json()[0]["workspace"]["id"]


async def _user_id(client: AsyncClient, session: Session, uid: str) -> str:
    await client.get("/api/workspaces/me", headers=_identity(uid))
    return str(session.execute(select(User).where(User.authentik_uid == uid)).scalar_one().id)


async def _invite(client: AsyncClient, owner: str, workspace_id: str, user_id: str, role: str = "member") -> Response:
    return await client.post(
        f"/api/workspaces/{workspace_id}/members",
        json={"user_id": user_id, "role": role},
        headers=_identity(owner),
    )


async def _accept(client: AsyncClient, uid: str, workspace_id: str | uuid.UUID) -> Response:
    return await client.post(f"/api/workspaces/{workspace_id}/invitation/accept", headers=_identity(uid))


# ── The wall, over HTTP ──────────────────────────────────────────────────────


async def test_two_people_signing_in_do_not_see_each_others_items(client: AsyncClient) -> None:
    """Each gets their own auto-provisioned workspace, and the wall holds over HTTP."""
    assert (await _create_item(client, "person-one", "one's item")).status_code == 201
    assert (await _create_item(client, "person-two", "two's item")).status_code == 201

    titles_one = [item["title"] for item in (await _list_items(client, "person-one")).json()]
    titles_two = [item["title"] for item in (await _list_items(client, "person-two")).json()]

    assert titles_one == ["one's item"]
    assert titles_two == ["two's item"]


async def test_a_second_member_of_a_workspace_sees_what_the_first_created(
    client: AsyncClient, session: Session
) -> None:
    """master-project#291, driven end to end.

    The operator creates something; his partner signs in through the same SSO and
    sees it — because he granted her membership. Before the primitive existed she
    saw an empty app and there was no grant to make.
    """
    assert (await _create_item(client, "the-operator", "the household's item")).status_code == 201

    memberships = (
        await client.get(
            "/api/workspaces/me",
            headers={"x-authentik-uid": "the-operator", "x-authentik-username": "the-operator"},
        )
    ).json()
    assert len(memberships) == 1
    household_id = memberships[0]["workspace"]["id"]

    # The partner signs in for the first time: a user row and her own empty workspace.
    assert (await _list_items(client, "the-partner")).json() == []
    partner = session.execute(select(User).where(User.authentik_uid == "the-partner")).scalar_one()

    # The offer, then her yes — the two acts the whole primitive exists for.
    invited = await client.post(
        f"/api/workspaces/{household_id}/members",
        # str(): user ids are UUIDs, which the JSON encoder will not take raw.
        json={"user_id": str(partner.id), "role": "member"},
        headers={"x-authentik-uid": "the-operator", "x-authentik-username": "the-operator"},
    )
    assert invited.status_code == 201
    assert (await _accept(client, "the-partner", household_id)).status_code == 200

    # She now belongs to two workspaces, so a bare request is ambiguous and is
    # refused with the choices rather than silently defaulted.
    ambiguous = await _list_items(client, "the-partner")
    assert ambiguous.status_code == 409
    assert len(ambiguous.json()["details"]["workspaces"]) == 2

    shared = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "the-partner",
            "x-authentik-username": "the-partner",
            "x-authentik-entitlements": "example",
            "x-workspace-id": str(household_id),
        },
    )
    assert [item["title"] for item in shared.json()] == ["the household's item"]


async def test_a_member_can_see_who_shares_the_workspace_and_a_stranger_cannot(
    client: AsyncClient, session: Session
) -> None:
    """The members surface's two reads: who is in here, and who may I add.

    Both are what makes the grant something a person can do from the app rather
    than something an agent does with a UUID read off the database.
    """
    # Holds the app's own module: the picker is for people who use the app.
    operator = {
        "x-authentik-uid": "the-operator",
        "x-authentik-username": "the-operator",
        "x-authentik-entitlements": "example",
    }
    partner = {"x-authentik-uid": "the-partner", "x-authentik-username": "the-partner"}
    stranger = {"x-authentik-uid": "a-stranger", "x-authentik-username": "a-stranger"}

    household_id = (await client.get("/api/workspaces/me", headers=operator)).json()[0]["workspace"]["id"]
    # Everyone signs in once, so the app knows them.
    assert (await client.get("/api/workspaces/me", headers=partner)).status_code == 200
    assert (await client.get("/api/workspaces/me", headers=stranger)).status_code == 200

    # The grant picker: the people the app has seen, and ONLY the three fields a
    # picker needs. Email and last-seen are deliberately not here.
    people = (await client.get("/api/users/", headers=operator)).json()
    by_username = {person["username"]: person for person in people}
    assert {"the-operator", "the-partner", "a-stranger"} <= set(by_username)
    assert set(by_username["the-partner"]) == {"id", "username", "display_name"}

    invited = await client.post(
        f"/api/workspaces/{household_id}/members",
        json={"user_id": by_username["the-partner"]["id"], "role": "member"},
        headers=operator,
    )
    assert invited.status_code == 201
    assert (await client.post(f"/api/workspaces/{household_id}/invitation/accept", headers=partner)).status_code == 200

    # A member — not only an owner — may see who shares the data.
    members = (await client.get(f"/api/workspaces/{household_id}/members", headers=partner)).json()
    assert [(m["user"]["username"], m["role"]) for m in members] == [
        ("the-operator", "owner"),
        ("the-partner", "member"),
    ]

    # A stranger gets the same 403 the owner-only routes give, never a 404.
    assert (await client.get(f"/api/workspaces/{household_id}/members", headers=stranger)).status_code == 403


async def test_a_non_member_cannot_reach_a_workspace_by_asking_for_it(client: AsyncClient) -> None:
    """The header disambiguates among the caller's OWN memberships; it grants nothing."""
    await _create_item(client, "insider", "private item")
    memberships = (
        await client.get(
            "/api/workspaces/me", headers={"x-authentik-uid": "insider", "x-authentik-username": "insider"}
        )
    ).json()
    insider_workspace = memberships[0]["workspace"]["id"]

    refused = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "outsider",
            "x-authentik-username": "outsider",
            "x-authentik-entitlements": "example",
            "x-workspace-id": str(insider_workspace),
        },
    )
    assert refused.status_code == 403


# ── Membership is a grant the person takes ──────────────────────────────────


async def test_an_invitation_grants_nothing_until_the_invitee_accepts(client: AsyncClient, session: Session) -> None:
    """The M7 fault: an owner could force a membership on any user id with no consent.

    A forced second membership made every call the invitee sent without
    `X-Workspace-Id` a 409, which broke machine acts-as callers. Pending changes
    nothing for them, and reads as an invitation only to the invitee.
    """
    await _create_item(client, "owner", "owner's item")
    owner_ws = await _workspace_of(client, "owner")
    target = await _user_id(client, session, "target")

    assert (await _invite(client, "owner", owner_ws, target)).status_code == 201

    # No second membership, no 409, no access to the owner's data.
    assert len((await client.get("/api/workspaces/me", headers=_identity("target"))).json()) == 1
    assert (await _list_items(client, "target")).status_code == 200
    forced = await client.get("/api/example/", headers={**_identity("target"), "x-workspace-id": owner_ws})
    assert forced.status_code == 403
    assert (await client.get(f"/api/workspaces/{owner_ws}/members", headers=_identity("target"))).status_code == 403

    # The invitee sees it, and only the invitee.
    waiting = (await client.get("/api/workspaces/invitations", headers=_identity("target"))).json()
    assert [(i["workspace"]["id"], i["role"]) for i in waiting] == [(owner_ws, "member")]
    assert (await client.get("/api/workspaces/invitations", headers=_identity("owner"))).json() == []

    # The owner sees it as pending and cannot invite twice.
    members = (await client.get(f"/api/workspaces/{owner_ws}/members", headers=_identity("owner"))).json()
    assert [(m["user"]["username"], m["status"]) for m in members] == [("owner", "accepted"), ("target", "pending")]
    assert (await _invite(client, "owner", owner_ws, target)).status_code == 409

    assert (await _accept(client, "target", owner_ws)).status_code == 200
    assert (await client.get("/api/workspaces/invitations", headers=_identity("target"))).json() == []
    assert len((await client.get("/api/workspaces/me", headers=_identity("target"))).json()) == 2


async def test_only_the_invitee_can_accept_or_decline(client: AsyncClient, session: Session) -> None:
    """An owner cannot accept for the invitee, and a third party finds no invitation."""
    await _create_item(client, "owner", "x")
    owner_ws = await _workspace_of(client, "owner")
    target = await _user_id(client, session, "target")
    await _user_id(client, session, "bystander")
    await _invite(client, "owner", owner_ws, target)

    assert (await _accept(client, "owner", owner_ws)).status_code == 404
    assert (await _accept(client, "bystander", owner_ws)).status_code == 404
    declined_by_other = await client.post(
        f"/api/workspaces/{owner_ws}/invitation/decline", headers=_identity("bystander")
    )
    assert declined_by_other.status_code == 404

    declined = await client.post(f"/api/workspaces/{owner_ws}/invitation/decline", headers=_identity("target"))
    assert declined.status_code == 204
    assert (await client.get("/api/workspaces/invitations", headers=_identity("target"))).json() == []
    assert len((await client.get("/api/workspaces/me", headers=_identity("target"))).json()) == 1
    # Declined means gone: an owner may ask again, and the answer is still the invitee's.
    assert (await _invite(client, "owner", owner_ws, target)).status_code == 201


async def test_a_pending_owner_invitation_confers_no_owner_rights_and_is_not_an_owner_to_count(
    client: AsyncClient, session: Session
) -> None:
    """An invited owner administers nothing, and the sole real owner still cannot leave or be removed."""
    await _create_item(client, "owner", "x")
    owner_ws = await _workspace_of(client, "owner")
    target = await _user_id(client, session, "target")
    owner_id = await _user_id(client, session, "owner")
    await _invite(client, "owner", owner_ws, target, role="owner")

    renamed = await client.patch(f"/api/workspaces/{owner_ws}", json={"name": "mine now"}, headers=_identity("target"))
    assert renamed.status_code == 403
    # A second workspace so the sole owner is stopped by the owner rule, not the last-workspace rule.
    second = await client.post("/api/workspaces/", json={"name": "second"}, headers=_identity("owner"))
    assert second.status_code == 201
    left = await client.post(f"/api/workspaces/{owner_ws}/leave", headers=_identity("owner"))
    assert left.status_code == 409
    removed = await client.delete(f"/api/workspaces/{owner_ws}/members/{owner_id}", headers=_identity("owner"))
    assert removed.status_code == 409


async def test_a_member_can_leave_but_never_as_the_last_owner_nor_from_their_last_workspace(
    client: AsyncClient, session: Session
) -> None:
    """M7's other half: a `member` could not leave, because removal was owner-only."""
    await _create_item(client, "owner", "x")
    owner_ws = await _workspace_of(client, "owner")
    guest = await _user_id(client, session, "guest")
    await _invite(client, "owner", owner_ws, guest)
    await _accept(client, "guest", owner_ws)

    left = await client.post(f"/api/workspaces/{owner_ws}/leave", headers=_identity("guest"))
    assert left.status_code == 204
    assert [
        m["workspace"]["id"] for m in (await client.get("/api/workspaces/me", headers=_identity("guest"))).json()
    ] == [await _workspace_of(client, "guest")]

    # Not a member any more: the same refusal a stranger gets.
    assert (await client.post(f"/api/workspaces/{owner_ws}/leave", headers=_identity("guest"))).status_code == 403
    # The last workspace is never left, and the last owner never leaves.
    own = await _workspace_of(client, "guest")
    assert (await client.post(f"/api/workspaces/{own}/leave", headers=_identity("guest"))).status_code == 409
    assert (await client.post(f"/api/workspaces/{owner_ws}/leave", headers=_identity("owner"))).status_code == 409


async def test_an_owner_can_withdraw_a_pending_invitation(client: AsyncClient, session: Session) -> None:
    await _create_item(client, "owner", "x")
    owner_ws = await _workspace_of(client, "owner")
    target = await _user_id(client, session, "target")
    await _invite(client, "owner", owner_ws, target)

    withdrawn = await client.delete(f"/api/workspaces/{owner_ws}/members/{target}", headers=_identity("owner"))

    assert withdrawn.status_code == 204
    assert (await client.get("/api/workspaces/invitations", headers=_identity("target"))).json() == []


# ── First sight is race-safe ────────────────────────────────────────────────


# Each request holds a pooled connection and a worker thread while it waits, so
# this must stay below the engine's pool (SQLAlchemy's 5 + 10 overflow) and
# anyio's 40-thread limiter, or the barrier times out instead of the race running.
FAN_OUT = 8


async def test_a_fanned_out_first_load_creates_one_user_and_every_request_succeeds(
    app: FastAPI, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
) -> None:
    """A dashboard's first load fires eight requests before any of them has inserted.

    Driven, not constructed: eight real requests, each on its own session from
    the app's own pool, committing for real — so this bypasses the `client`
    fixture, whose one shared rollback session would serialise them. Each request
    is held after its own lookup until all eight have looked, which is the
    interleaving a fan-out produces and the one a test left to chance mostly
    misses: every lookup misses, every request inserts, Postgres holds seven on
    the unique index until the first commits and then refuses them. All eight
    must answer 200 as the one person, with one user row and one personal
    workspace between them (full-stack-app-template#17).
    """
    assert get_session not in app.dependency_overrides, "a leftover override would serialise every request"
    uid = f"fan-out-{uuid.uuid4()}"
    real_lookup = users_service.get_by_uid
    everyone_has_looked = threading.Barrier(FAN_OUT, timeout=10)
    this_request = threading.local()

    def lookup_then_wait_for_the_rest(db: Session, authentik_uid: str) -> User | None:
        user = real_lookup(db, authentik_uid)
        # Only a request's first lookup waits; the loser's recovery read after
        # the refused insert runs on the same thread and must go straight through.
        if not getattr(this_request, "waited", False):
            this_request.waited = True
            everyone_has_looked.wait()
        return user

    monkeypatch.setattr(users_service, "get_by_uid", lookup_then_wait_for_the_rest)
    caplog.set_level(logging.INFO, logger=users_service.__name__)

    headers = {"x-authentik-uid": uid, "x-authentik-username": "fanned-out"}
    try:
        async with AsyncClient(
            transport=ASGITransport(app=app, raise_app_exceptions=False), base_url="http://test"
        ) as client:
            responses = await asyncio.gather(*(client.get("/api/users/me", headers=headers) for _ in range(FAN_OUT)))

        assert [response.status_code for response in responses] == [200] * FAN_OUT
        assert len({response.json()["id"] for response in responses}) == 1
        # The race was run, not dodged: seven inserts were refused and recovered.
        recovered = [r for r in caplog.records if r.getMessage() == "A concurrent request created this user first"]
        assert len(recovered) == FAN_OUT - 1

        with get_session_factory()() as db:
            user_ids = db.execute(select(User.id).where(User.authentik_uid == uid)).scalars().all()
            assert len(user_ids) == 1
            memberships = db.execute(select(WorkspaceMembership).where(WorkspaceMembership.user_id == user_ids[0]))
            assert len(memberships.scalars().all()) == 1
    finally:
        with get_session_factory()() as db, db.begin():
            this_user = select(User.id).where(User.authentik_uid == uid)
            held = select(WorkspaceMembership.workspace_id).where(WorkspaceMembership.user_id.in_(this_user))
            workspace_ids = db.execute(held).scalars().all()
            db.execute(delete(WorkspaceMembership).where(WorkspaceMembership.user_id.in_(this_user)))
            db.execute(delete(Workspace).where(Workspace.id.in_(workspace_ids)))
            db.execute(delete(User).where(User.authentik_uid == uid))


# ── A machine principal may use an identity, never mint one ─────────────────


async def test_a_declared_machine_principal_is_not_given_a_user_row(client: AsyncClient) -> None:
    """The just-in-time machine principal tenancy.md forbids, refused at the factory rather than per app."""
    refused = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "some-service-account",
            "x-authentik-username": "some-service-account",
            "x-authentik-user-type": "service_account",
        },
    )
    assert refused.status_code == 401


async def test_a_caller_with_no_declared_type_is_still_treated_as_a_person(client: AsyncClient) -> None:
    """The header is absent on exactly the request it exists to catch, so its
    absence must never narrow the ordinary human path."""
    admitted = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "an-ordinary-person",
            "x-authentik-username": "an-ordinary-person",
            "x-authentik-entitlements": "example",
        },
    )
    assert admitted.status_code == 200


async def test_a_caller_in_the_machine_group_is_not_given_a_user_row(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    """The second marker: present even when an under-scoped token carries no custom claims."""
    from {{ package_name }}.config import get_settings

    settings = get_settings()
    monkeypatch.setattr(settings.identity, "authentik_machine_group", "app-machines")

    refused = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "under-scoped-token",
            "x-authentik-username": "under-scoped-token",
            "x-authentik-groups": "everyone|app-machines",
        },
    )
    assert refused.status_code == 401
