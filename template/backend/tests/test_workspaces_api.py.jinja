"""The workspace SLICE, driven through HTTP.

`test_workspace_scoping.py` proves the session hooks and is owed by every app.
This file proves the whole chain a real request takes — proxy headers, user
upsert, personal-workspace provisioning, membership resolution, session binding —
because that is the chain the defect actually lived in, and a green unit test on
the hooks would not have caught it.

It needs the `users` and `workspaces` tables, so it exists only once an app has
finished adopting, and is sanctioned per-app in `canonical-app-shape.md` for the
same reason `test_example.py` is: an app that does not carry the code does not
carry its test.
"""

import pytest
from httpx import AsyncClient, Response
from sqlalchemy import select
from sqlalchemy.orm import Session

from {{ package_name }}.api.users import service as users_service
from {{ package_name }}.api.users.models import User


async def _create_item(client: AsyncClient, uid: str, title: str) -> Response:
    return await client.post(
        "/api/example/",
        json={"title": title},
        headers={"x-authentik-uid": uid, "x-authentik-username": uid},
    )


async def _list_items(client: AsyncClient, uid: str) -> Response:
    return await client.get(
        "/api/example/",
        headers={"x-authentik-uid": uid, "x-authentik-username": uid},
    )


# ── The wall, over HTTP ──────────────────────────────────────────────────────


async def test_two_people_signing_in_do_not_see_each_others_items(client: AsyncClient) -> None:
    """Each gets their own auto-provisioned workspace, and the wall holds over HTTP."""
    assert (await _create_item(client, "person-one", "one's item")).status_code == 201
    assert (await _create_item(client, "person-two", "two's item")).status_code == 201

    titles_one = [item["title"] for item in (await _list_items(client, "person-one")).json()]
    titles_two = [item["title"] for item in (await _list_items(client, "person-two")).json()]

    assert titles_one == ["one's item"]
    assert titles_two == ["two's item"]


async def test_a_second_member_of_a_workspace_sees_what_the_first_created(
    client: AsyncClient, session: Session
) -> None:
    """master-project#291, driven end to end.

    The operator creates something; his partner signs in through the same SSO and
    sees it — because he granted her membership. Before the primitive existed she
    saw an empty app and there was no grant to make.
    """
    assert (await _create_item(client, "the-operator", "the household's item")).status_code == 201

    memberships = (
        await client.get(
            "/api/workspaces/me",
            headers={"x-authentik-uid": "the-operator", "x-authentik-username": "the-operator"},
        )
    ).json()
    assert len(memberships) == 1
    household_id = memberships[0]["workspace"]["id"]

    # The partner signs in for the first time: a user row and her own empty workspace.
    assert (await _list_items(client, "the-partner")).json() == []
    partner = session.execute(select(User).where(User.authentik_uid == "the-partner")).scalar_one()

    # The grant — the act the whole primitive exists for.
    granted = await client.post(
        f"/api/workspaces/{household_id}/members",
        # str(): user ids are UUIDs, which the JSON encoder will not take raw.
        json={"user_id": str(partner.id), "role": "member"},
        headers={"x-authentik-uid": "the-operator", "x-authentik-username": "the-operator"},
    )
    assert granted.status_code == 201

    # She now belongs to two workspaces, so a bare request is ambiguous and is
    # refused with the choices rather than silently defaulted.
    ambiguous = await _list_items(client, "the-partner")
    assert ambiguous.status_code == 409
    assert len(ambiguous.json()["details"]["workspaces"]) == 2

    shared = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "the-partner",
            "x-authentik-username": "the-partner",
            "x-workspace-id": str(household_id),
        },
    )
    assert [item["title"] for item in shared.json()] == ["the household's item"]


async def test_a_member_can_see_who_shares_the_workspace_and_a_stranger_cannot(
    client: AsyncClient, session: Session
) -> None:
    """The members surface's two reads: who is in here, and who may I add.

    Both are what makes the grant something a person can do from the app rather
    than something an agent does with a UUID read off the database.
    """
    operator = {"x-authentik-uid": "the-operator", "x-authentik-username": "the-operator"}
    partner = {"x-authentik-uid": "the-partner", "x-authentik-username": "the-partner"}
    stranger = {"x-authentik-uid": "a-stranger", "x-authentik-username": "a-stranger"}

    household_id = (await client.get("/api/workspaces/me", headers=operator)).json()[0]["workspace"]["id"]
    # Everyone signs in once, so the app knows them.
    assert (await client.get("/api/workspaces/me", headers=partner)).status_code == 200
    assert (await client.get("/api/workspaces/me", headers=stranger)).status_code == 200

    # The grant picker: the people the app has seen, and ONLY the three fields a
    # picker needs. Email and last-seen are deliberately not here.
    people = (await client.get("/api/users/", headers=operator)).json()
    by_username = {person["username"]: person for person in people}
    assert {"the-operator", "the-partner", "a-stranger"} <= set(by_username)
    assert set(by_username["the-partner"]) == {"id", "username", "display_name"}

    granted = await client.post(
        f"/api/workspaces/{household_id}/members",
        json={"user_id": by_username["the-partner"]["id"], "role": "member"},
        headers=operator,
    )
    assert granted.status_code == 201

    # A member — not only an owner — may see who shares the data.
    members = (await client.get(f"/api/workspaces/{household_id}/members", headers=partner)).json()
    assert [(m["user"]["username"], m["role"]) for m in members] == [
        ("the-operator", "owner"),
        ("the-partner", "member"),
    ]

    # A stranger gets the same 403 the owner-only routes give, never a 404.
    assert (await client.get(f"/api/workspaces/{household_id}/members", headers=stranger)).status_code == 403


async def test_a_non_member_cannot_reach_a_workspace_by_asking_for_it(client: AsyncClient) -> None:
    """The header disambiguates among the caller's OWN memberships; it grants nothing."""
    await _create_item(client, "insider", "private item")
    memberships = (
        await client.get(
            "/api/workspaces/me", headers={"x-authentik-uid": "insider", "x-authentik-username": "insider"}
        )
    ).json()
    insider_workspace = memberships[0]["workspace"]["id"]

    refused = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "outsider",
            "x-authentik-username": "outsider",
            "x-workspace-id": str(insider_workspace),
        },
    )
    assert refused.status_code == 403


# ── First sight is race-safe ────────────────────────────────────────────────


def test_two_first_sight_requests_racing_share_one_user_row(session: Session, monkeypatch: pytest.MonkeyPatch) -> None:
    """The SPA's two startup calls both arrive before either has inserted.

    Reproduced deterministically: the row exists, but this request's own
    lookup is made to miss it — exactly what the loser of the race sees — so
    its insert is refused by the unique index. It must recover onto the
    existing row rather than 500, and leave the session usable afterwards.
    """
    winner = users_service.upsert_from_identity(session, authentik_uid="raced-uid", username="raced")
    session.flush()

    real_lookup = users_service.get_by_uid
    misses = iter([True])

    def lookup_that_misses_once(db: Session, authentik_uid: str) -> User | None:
        if next(misses, False):
            return None
        return real_lookup(db, authentik_uid)

    monkeypatch.setattr(users_service, "get_by_uid", lookup_that_misses_once)

    loser = users_service.upsert_from_identity(session, authentik_uid="raced-uid", username="raced")

    assert loser.id == winner.id
    # The session survived the refused insert: a further statement still works.
    assert session.execute(select(User).where(User.authentik_uid == "raced-uid")).scalar_one().id == winner.id


# ── A machine principal may use an identity, never mint one ─────────────────


async def test_a_declared_machine_principal_is_not_given_a_user_row(client: AsyncClient) -> None:
    """The just-in-time machine principal tenancy.md forbids, refused at the factory rather than per app."""
    refused = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "some-service-account",
            "x-authentik-username": "some-service-account",
            "x-authentik-user-type": "service_account",
        },
    )
    assert refused.status_code == 401


async def test_a_caller_with_no_declared_type_is_still_treated_as_a_person(client: AsyncClient) -> None:
    """The header is absent on exactly the request it exists to catch, so its
    absence must never narrow the ordinary human path."""
    admitted = await client.get(
        "/api/example/",
        headers={"x-authentik-uid": "an-ordinary-person", "x-authentik-username": "an-ordinary-person"},
    )
    assert admitted.status_code == 200


async def test_a_caller_in_the_machine_group_is_not_given_a_user_row(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    """The second marker: present even when an under-scoped token carries no custom claims."""
    from {{ package_name }}.config import get_settings

    settings = get_settings()
    monkeypatch.setattr(settings.identity, "authentik_machine_group", "app-machines")

    refused = await client.get(
        "/api/example/",
        headers={
            "x-authentik-uid": "under-scoped-token",
            "x-authentik-username": "under-scoped-token",
            "x-authentik-groups": "everyone|app-machines",
        },
    )
    assert refused.status_code == 401
