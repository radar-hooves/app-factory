"""Pytest fixtures for {{ project_name }} tests.

Fixture hierarchy:
    _engine (session) ─→ _session_factory (session)
    client (function) ─→ session (function)

The transaction-rollback fixture (session) wraps each test in a savepoint and
rolls back after the test, leaving the database clean without a teardown script.
Uses httpx.AsyncClient + ASGITransport for async endpoint tests.
"""

import os

import pytest

# Set required env vars before importing application modules so Settings
# can instantiate without a real .env file present in CI.
os.environ.setdefault("POSTGRES_USER", "postgres")
os.environ.setdefault("POSTGRES_HOST", "localhost")
os.environ.setdefault("POSTGRES_PORT", "5432")
os.environ.setdefault("POSTGRES_DB", "{{ project_name | replace('-', '_') }}_test")
os.environ.setdefault("SECRET_KEY", "test-secret-key")
os.environ.setdefault("DEBUG", "true")
# POSTGRES_PASSWORD must be set in the shell (e.g. via .envrc.local) before
# running tests. Exit cleanly with a clear message instead of a cryptic
# Pydantic failure buried in fixture setup.
if "POSTGRES_PASSWORD" not in os.environ:
    pytest.exit(
        "Required test env vars not set: POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST, "
        "POSTGRES_PORT, POSTGRES_DB. Add POSTGRES_PASSWORD to your .envrc.local or export it in "
        "your shell; adjust to your app's settings surface if it differs.",
        returncode=1,
    )

