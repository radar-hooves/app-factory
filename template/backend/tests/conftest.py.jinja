from collections.abc import AsyncGenerator

import pytest_asyncio
from httpx import ASGITransport, AsyncClient
from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine

from {{ package_name }}.config import get_settings
from {{ package_name }}.db.base import Base
from {{ package_name }}.db.registry import Base as _registry_base  # noqa: F401 — registers models
from {{ package_name }}.deps import get_session
from {{ package_name }}.main import create_app


@pytest.fixture(scope="session")
def anyio_backend() -> str:
    return "asyncio"


@pytest_asyncio.fixture(scope="session")
async def _engine():
    """Session-scoped async engine; creates schema once, drops on teardown."""
    settings = get_settings()
    engine = create_async_engine(settings.database.async_database_url, echo=False)
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
    yield engine
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)
    await engine.dispose()


@pytest_asyncio.fixture(scope="session")
async def _session_factory(_engine):
    return async_sessionmaker(bind=_engine, expire_on_commit=False, autoflush=False)


@pytest_asyncio.fixture(scope="function")
async def session(_session_factory) -> AsyncGenerator[AsyncSession, None]:
    """Per-test async session with transaction rollback for isolation."""
    async with _session_factory() as s:
        async with s.begin():
            yield s
            await s.rollback()


@pytest_asyncio.fixture(scope="function")
async def client(session: AsyncSession) -> AsyncGenerator[AsyncClient, None]:
    """httpx.AsyncClient wired to the FastAPI app with DB override."""
    app = create_app()
    app.dependency_overrides[get_session] = lambda: session
    transport = ASGITransport(app=app)
    async with AsyncClient(
        transport=transport,
        base_url="http://test",
        headers={
            "x-authentik-uid": "test-uid",
            "x-authentik-username": "testuser",
        },
    ) as ac:
        yield ac
    app.dependency_overrides.clear()
