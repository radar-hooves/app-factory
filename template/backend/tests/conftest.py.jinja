from collections.abc import Generator

from httpx import ASGITransport, AsyncClient
from sqlalchemy import create_engine
from sqlalchemy.orm import Session, sessionmaker

from {{ package_name }}.config import get_settings
from {{ package_name }}.db.base import Base
from {{ package_name }}.db.registry import Base as _registry_base  # noqa: F401 — registers models
from {{ package_name }}.deps import get_session
from {{ package_name }}.main import create_app


@pytest.fixture(scope="session")
def _engine():
    """Session-scoped sync engine; creates schema once, drops on teardown."""
    settings = get_settings()
    engine = create_engine(settings.database.database_url, echo=False)
    Base.metadata.create_all(engine)
    yield engine
    Base.metadata.drop_all(engine)
    engine.dispose()


@pytest.fixture(scope="session")
def _session_factory(_engine):
    return sessionmaker(bind=_engine, autoflush=False, expire_on_commit=False)


@pytest.fixture(scope="function")
def session(_session_factory) -> Generator[Session, None, None]:
    """Per-test sync session with transaction rollback for isolation."""
    with _session_factory() as s:
        s.begin_nested()  # savepoint — rollback after test
        yield s
        s.rollback()


@pytest.fixture(scope="function")
async def client(session: Session) -> AsyncClient:
    """httpx.AsyncClient wired to the FastAPI app with DB override."""
    app = create_app()
    app.dependency_overrides[get_session] = lambda: session
    transport = ASGITransport(app=app)
    async with AsyncClient(
        transport=transport,
        base_url="http://test",
        headers={
            "x-authentik-uid": "test-uid",
            "x-authentik-username": "testuser",
        },
    ) as ac:
        yield ac
    app.dependency_overrides.clear()
