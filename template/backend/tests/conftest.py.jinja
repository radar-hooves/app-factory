def pytest_configure(config: pytest.Config) -> None:
    """Refuse a run that read any pytest config but backend/pyproject.toml.

    Run from the repo root, pytest finds no config beside it and takes whichever
    lies above the checkout, or none: the suite then runs without its own
    options (asyncio and import mode, markers) and skips what it cannot run.
    """
    own = Path(__file__).resolve().parents[1] / "pyproject.toml"
    if config.inipath is None or config.inipath.resolve() != own:
        raise pytest.UsageError(f"this suite's config is {own}, not {config.inipath}: run pytest from backend/")


# Fixtures that reach the database; a test's closure naming one needs the server.
_DATABASE_FIXTURES = frozenset({"session", "client", "app", "server_url", "make_user"})


def _needs_database(item: pytest.Item) -> bool:
    """Whether a test asks, directly or through other fixtures, for the factory's or the app's database surface.

    Walks the fixtures the test requests (its arguments and `usefixtures`, never an autouse one,
    which every test carries) down their own arguments: a name in `_DATABASE_FIXTURES`, or any
    fixture `tests/app_fixtures.py` defines, counts. An app's engine, session or user fixture lives
    there, so a test reaching the database through it binds the server like one asking for `session`.
    """
    info = getattr(item, "_fixtureinfo", None)
    if info is None:
        return False
    pending = list(info.argnames)
    for mark in item.iter_markers("usefixtures"):
        pending.extend(mark.args)
    seen: set[str] = set()
    while pending:
        name = pending.pop()
        if name in seen:
            continue
        seen.add(name)
        if name in _DATABASE_FIXTURES:
            return True
        for fixturedef in info.name2fixturedefs.get(name, ())[-1:]:
            if getattr(fixturedef.func, "__module__", None) == _app_fixtures.__name__:
                return True
            pending.extend(fixturedef.argnames)
    return False


_BOUND = False


def _bind_test_server(session) -> None:
    """Resolve the Postgres, point POSTGRES_* at it and build the test database, once.

    Not at import and not in a fixture: the application lifespan runs its own database
    connectivity check when the app is first created, and fixture ordering does not
    guarantee a schema-building fixture wins that race. This runs before any test, and
    only when the run selects one that needs a database.

    Under xdist the migrations run ONCE, in the controller, and each worker
    copies the result (`CREATE DATABASE … TEMPLATE`) rather than migrating its
    own. Workers migrating at the same moment share one lock table on the one
    server: 64 slots per connection, 7,808 in all on postgres:17's defaults, and
    one of a fleet app's migrations holds about 3,000 until it commits, so workers
    in step died "out of shared memory" (that app's CI at `-n 8`, 27/09/2026; 14
    of 20 on atlas). The controller collects nothing, so it binds at session start,
    before xdist spawns a worker from a `trylast` sessionstart of its own;
    `pytest_configure_node` hands each the name, and a worker handed none migrates
    its own.
    """
    global _TEST_SERVER, _BOUND
    if _BOUND:
        return
    _BOUND = True
    _TEST_SERVER = _resolve_test_server()
    os.environ["POSTGRES_HOST"] = _TEST_SERVER["host"]
    os.environ["POSTGRES_PORT"] = _TEST_SERVER["port"]
    os.environ["POSTGRES_PASSWORD"] = _role_password(TEST_OWNER)
    os.environ["POSTGRES_RUNTIME_PASSWORD"] = _role_password(TEST_RUNTIME)
    # Anything the app read from the placeholders at import is stale: its settings, and an engine built on them.
    from {{ package_name }}.config import get_settings
    from {{ package_name }}.db import session as db_session

    get_settings.cache_clear()
    db_session._engine = None
    if session.config.pluginmanager.hasplugin("dsession"):  # xdist registers it in the controller only
        _ensure_test_database_ready()
        return
    template = getattr(session.config, "workerinput", {}).get("test_database_template")
    if template:
        _copy_test_database(template)
    else:
        _ensure_test_database_ready()
    # Whatever this app needs doing once, after the schema exists and before any
    # test runs (tests/app_fixtures.py). No-op unless the app defines one.
    app_session_start()


def pytest_sessionstart(session) -> None:
    """The xdist controller collects no tests, so it cannot know whether one needs a database: it binds now."""
    if session.config.pluginmanager.hasplugin("dsession"):
        _bind_test_server(session)


def pytest_collection_finish(session) -> None:
    """Bind the test server when a selected test needs a database; a run of none starts nothing."""
    if not session.config.option.collectonly and any(_needs_database(item) for item in session.items):
        _bind_test_server(session)


@pytest.hookimpl(optionalhook=True)  # xdist's hook; optional, so the file still loads without xdist
def pytest_configure_node(node) -> None:
    """Hand each xdist worker the controller's migrated database to copy (`pytest_sessionstart`)."""
    node.workerinput["test_database_template"] = TEST_DATABASE_NAME


def pytest_sessionfinish(session, exitstatus) -> None:
    """Stop the ephemeral Postgres, if this run started one.

    The ordinary path. The same stop is registered with ``atexit`` by
    ``_start_ephemeral_postgres`` for the exits that never reach this hook, and
    it is a no-op once either caller has run.
    """
    _stop_ephemeral_postgres()


