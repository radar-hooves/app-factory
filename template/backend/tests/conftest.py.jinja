"""Pytest fixtures for {{ project_name }} tests.

Uses httpx.AsyncClient + ASGITransport for endpoint tests, over an ephemeral
per-session Postgres testcontainer — the household hermetic-test pattern
(`rules-library/stacks/python-testing.md` §Database Integration Tests).
"""

import atexit
import json
import logging
import os
import secrets
import subprocess
import sys
import tempfile
from collections.abc import AsyncGenerator, Generator
from pathlib import Path

import pytest
from filelock import FileLock

os.environ.setdefault("DEBUG", "true")

# The suite must never depend on a live broker being reachable: the database
# credential above is always an ephemeral testcontainer's, never vended, and any
# OTHER `Vended` field an app's own domain settings declare has no software
# identity key to attest with here either — this process runs as CI does, not
# as a developer session. `config/vend.py`'s `<APP>_VEND=off` is the declared way to
# say so; test_vend.py itself proves the mechanism by monkeypatching `vend`
# directly, so it is unaffected by the default set here. `setdefault`, not a
# plain assignment: a developer deliberately exercising a real vend for one
# test session sets `{{ package_name | upper }}_VEND=on` first and this leaves
# that alone.
os.environ.setdefault("{{ package_name | upper }}_VEND", "off")

# The rate limiter keys on the caller's address, and the whole suite presents as
# one synthetic client — so an enabled default limit would eventually throttle
# the suite against itself as the number of endpoint tests grows. Off by default
# here; test_rate_limit.py turns it on explicitly, with its own low limit, to
# prove the default actually binds.
os.environ.setdefault("{{ project_name | upper | replace('-', '_') }}_RATE_LIMIT_ENABLED", "false")

# ── Required env vars — set BEFORE any {{ package_name }} import ────────────
# The suite brings its OWN database server and never inherits one. Deferring
# to whatever a developer's shell happens to export made every run depend on
# ambient state nobody chose here, and left the door open for POSTGRES_* to
# one day point somewhere real.
#
# So the server is resolved here, authoritatively, and the resolved values are
# ASSIGNED over anything the shell exports:
#
#   1. {{ project_name | upper | replace('-', '_') }}_TEST_POSTGRES_* when set — an explicit,
#      purpose-provisioned test server (a CI service container).
#   2. Otherwise an ephemeral Docker container — ONE per run, shared by every
#      xdist worker (see below) — that `pytest_sessionfinish` removes. Nothing
#      ambient can reach it and it dies with the run.
#
# POSTGRES_DB stays forced as defence in depth: belt and braces now that the
# server is guaranteed not to be anything but a throwaway.
_TEST_ENV_PREFIX = "{{ project_name | upper | replace('-', '_') }}_TEST_POSTGRES_"

# ── ONE Postgres per run, not per process ───────────────────────────────────
# Every pytest process imports this module, so a container started here is a
# container per PROCESS — and under pytest-xdist that is the controller plus one
# per worker. On a 28-core runner a `-n auto` suite therefore asked the daemon
# for 29 Postgres containers and 29 reapers per run; after a morning of them the
# runner held 155 test containers, 309 dead reapers and a load average of 56,
# and no suite could start a container at all (pebblestone#762).
#
# So the container is shared, by pytest-xdist's own documented recipe: a lock
# file and a settings file somewhere every process of the run agrees on, the
# first process in starts the container and writes the settings, the rest read
# them. The recipe's directory — `tmp_path_factory.getbasetemp().parent` —
# belongs to a fixture, and this runs at IMPORT, which the POSTGRES_* assignment
# below has to (it must precede the first app import). So the run is keyed by
# the controller's pid instead: an xdist worker is a direct child of the
# controller, and a live pid is unique, so two runs on one machine never collide
# and a settings file left behind by a killed run is never mistaken for this
# one's (the controller always starts fresh and overwrites).
_WORKER_ID = os.environ.get("PYTEST_XDIST_WORKER", "master")  # the value xdist's `worker_id` fixture reports
_RUN_ID = os.getpid() if _WORKER_ID == "master" else os.getppid()
_SHARED_SERVER_FILE = Path(tempfile.gettempdir()) / f"{{ package_name }}-test-postgres-{_RUN_ID}.json"

# One database per worker ON that shared server, which is exactly the isolation
# a container per worker used to buy: no worker can see another's schema or
# rows, and within a worker the `session` fixture's transaction rollback still
# owns isolation between tests. Only the server is shared.
TEST_DATABASE_NAME = "{{ package_name }}_test" if _WORKER_ID == "master" else f"{{ package_name }}_test_{_WORKER_ID}"

_EPHEMERAL_POSTGRES = None
_PUBLISHED_SHARED_SERVER = False


def _shared_ephemeral_postgres() -> dict[str, str]:
    """Return the run's one ephemeral Postgres, starting it if nobody has yet.

    The lock is held ACROSS the start, so a worker arriving mid-start waits for
    the container rather than starting a second one.

    Only a process that is NOT an xdist worker ever publishes a container for
    others to use, and that is what makes the teardown safe by construction
    rather than by luck: a publisher outlives every worker, so its stop cannot
    pull the database out from under a worker still running. A worker finishes
    its own share of the files and exits while its siblings are still going —
    were it the publisher, that exit would stop their database mid-suite.

    In practice the controller imports this module before it spawns a single
    worker, so it publishes and the workers only ever read. A worker that finds
    no file is in a run whose controller never imported this module: it keeps a
    container to itself, which is what every process did before sharing, and
    says so rather than sharing something nothing can own safely.
    """
    global _PUBLISHED_SHARED_SERVER

    with FileLock(f"{_SHARED_SERVER_FILE}.lock"):
        if _WORKER_ID != "master":
            if _SHARED_SERVER_FILE.is_file():
                return dict(json.loads(_SHARED_SERVER_FILE.read_text()))
            logging.warning(
                "%s: the pytest controller did not import conftest.py, so there is no process that "
                "outlives this run to hold a shared Postgres — starting one for this worker alone, "
                "as every worker now will. Check that testpaths (or the path argument) reaches the "
                "tests directory.",
                _WORKER_ID,
            )
            return _start_ephemeral_postgres()
        settings = _start_ephemeral_postgres()
        # 0600 and opened that way rather than chmod'ed after: the file carries
        # the container's password, and /tmp is world-readable on Linux.
        descriptor = os.open(_SHARED_SERVER_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            json.dump(settings, handle)
        _PUBLISHED_SHARED_SERVER = True
        return settings


def _start_ephemeral_postgres() -> dict[str, str]:
    """Start a throwaway Postgres via testcontainers and return its settings.

    Called once per run, under the lock `_shared_ephemeral_postgres` holds.

    testcontainers owns the parts that are easy to get subtly wrong: the
    readiness protocol, a random free host port, socket differences across
    Docker/Colima/Podman, and a reaper sidecar (Ryuk) that removes the container
    when pytest is SIGKILLed — a ``pytest_sessionfinish`` hook cannot do that
    one, so a hand-rolled ``docker run`` leaks on every hard kill.

    The reaper covers ONLY the hard kill, and that is narrower than it sounds.
    ``testcontainers.core.container`` registers ``Reaper.delete_instance`` with
    ``atexit``, and that handler STOPS the Ryuk container — so on any exit that
    runs Python's shutdown, testcontainers destroys its own reaper before the
    reaper can reap. A run that dies between this function and
    ``pytest_sessionfinish`` therefore leaves the container running with nothing
    to reclaim it: pytest's usage-error exit (a conftest or collection failure,
    exit code 4) never reaches ``pytest_sessionfinish``, and a cancelled CI job
    arrives as a signal Python turns into a clean shutdown. Both happened on the
    fleet's runner and both leaked (yggdrasil#276).

    So the teardown is registered here with ``atexit`` as well, next to the
    ``start()`` it undoes. Registered AFTER the reaper's own handler, it runs
    BEFORE it (atexit is LIFO), so the container is stopped while Ryuk is still
    alive to catch anything this misses.

    Random host port also sidesteps a CI runner's fixed-port collisions with
    always-on shared services (`core/ci-workflow-standard.md` §Shared Host
    Services vs CI Service Containers) — nothing here claims 5432.
    """
    global _EPHEMERAL_POSTGRES
    from testcontainers.community.postgres import PostgresContainer

    container = PostgresContainer(
        image="postgres:17-alpine",
        username="postgres",
        password=secrets.token_urlsafe(16),
        dbname="postgres",
        driver=None,
    )
    try:
        container.start()
    except Exception as exc:  # any startup failure needs the same actionable message
        raise RuntimeError(
            "The test suite provisions its own Postgres via testcontainers, and it could not start.\n"
            f"  {type(exc).__name__}: {exc}\n"
            "Either start Docker, or point the suite at a purpose-provisioned test server with\n"
            f"{_TEST_ENV_PREFIX}{% raw %}{{HOST,PORT,USER,PASSWORD}}{% endraw %}.\n"
            "It deliberately will NOT use POSTGRES_* from your shell."
        ) from exc

    _EPHEMERAL_POSTGRES = container
    atexit.register(_stop_ephemeral_postgres)
    return {
        "host": container.get_container_host_ip(),
        "port": str(container.get_exposed_port(5432)),
        "user": container.username,
        "password": container.password,
    }


def _stop_ephemeral_postgres() -> None:
    """Stop the ephemeral Postgres if one is still running. Idempotent.

    Claims the container before stopping it, so ``pytest_sessionfinish`` and the
    ``atexit`` registration cannot both act on it and so a second call after a
    successful stop is silent rather than a NotFound traceback on the way out.

    Only the process that STARTED the container holds one to stop, so a worker
    that merely read the settings file never reaches past the guard below, and
    only the process that PUBLISHED one clears the file.

    Best-effort: a failure to tear down must not change the exit status of a run
    whose tests have already passed.
    """
    global _EPHEMERAL_POSTGRES
    container, _EPHEMERAL_POSTGRES = _EPHEMERAL_POSTGRES, None
    if container is None:
        return
    if _PUBLISHED_SHARED_SERVER:
        # Under the lock and before the stop, so no process can read settings
        # for a container that is being torn down.
        with FileLock(f"{_SHARED_SERVER_FILE}.lock"):
            _SHARED_SERVER_FILE.unlink(missing_ok=True)
        Path(f"{_SHARED_SERVER_FILE}.lock").unlink(missing_ok=True)
    try:
        container.stop()
    except Exception as exc:  # teardown must never fail a passing run
        logging.warning("Could not stop the ephemeral test Postgres: %s", exc)


def _resolve_test_server() -> dict[str, str]:
    """Resolve the Postgres the suite will use, never inheriting POSTGRES_*."""
    from tests.support.explicit_server_guard import (
        TEST_POSTGRES_KEYS,
        partial_quartet_warning,
        refuse_if_explicit_server_is_production,
    )

    explicit = {key: os.environ.get(f"{_TEST_ENV_PREFIX}{key.upper()}") for key in TEST_POSTGRES_KEYS}

    warning = partial_quartet_warning(explicit)
    if warning:
        logging.warning(warning)

    if all(explicit.values()):
        resolved = {key: value for key, value in explicit.items() if value is not None}
        # An explicit quartet is meant for a purpose-provisioned test server,
        # but the four vars are otherwise unvalidated — this is the one guard
        # standing between a typo'd host/port and running the suite against
        # the real database (`tests/support/explicit_server_guard.py`).
        refuse_if_explicit_server_is_production(resolved)
        return resolved

    return _shared_ephemeral_postgres()


_TEST_SERVER = _resolve_test_server()
os.environ["POSTGRES_USER"] = _TEST_SERVER["user"]
os.environ["POSTGRES_HOST"] = _TEST_SERVER["host"]
os.environ["POSTGRES_PORT"] = _TEST_SERVER["port"]
os.environ["POSTGRES_PASSWORD"] = _TEST_SERVER["password"]
os.environ["POSTGRES_DB"] = TEST_DATABASE_NAME

# ── THE extension point for this file (canonical-app-shape.md §Extension Points)
# conftest.py is the factory's and is owed byte-identical, so an app's own test
# surface lives in tests/app_fixtures.py. Imported HERE, deliberately: after the
# test server is resolved and every POSTGRES_* is assigned, so a module that
# imports the app gets the throwaway database — and before the first app import
# below, so a module that must set an environment variable ahead of the app
# reading it still can. The module body runs once, at this line.
from tests import app_fixtures as _app_fixtures  # noqa: E402

# Imported by NAME, not left to the namespace copy below, so a linter can see
# it: `globals().update()` is invisible to static analysis, and ruff rejected
# the call site as an undefined name. Naming it also makes the contract
# explicit — every app's app_fixtures.py defines this, the factory stamps a
# no-op, and an app that deletes it breaks its own suite loudly rather than
# silently skipping its setup.
from tests.app_fixtures import app_session_start  # noqa: E402


def _adopt_app_fixtures() -> None:
    """Bind the app's own test surface into this module's namespace.

    Not `from … import *`, which was the first attempt: star-import skips every
    underscore-prefixed name, and an autouse fixture is conventionally named
    `_like_this`, so exactly the fixtures that must apply to every test were the
    ones that silently did not arrive.

    `pytest_*` is refused on purpose. A hook defined in the app's module would
    REPLACE the factory's — measured 2026-08-20, an app file that accidentally
    carried `pytest_sessionfinish` took the factory's teardown with it and every
    test in the suite errored. App work that must run once belongs in
    `app_session_start()`, which the factory calls at a defined point.
    """
    globals().update(
        {
            name: value
            for name, value in vars(_app_fixtures).items()
            if not name.startswith("__") and not name.startswith("pytest_")
        }
    )


_adopt_app_fixtures()

from httpx import ASGITransport, AsyncClient  # noqa: E402 -- must follow the env-var resolution above
from sqlalchemy.orm import Session, sessionmaker  # noqa: E402

from {{ package_name }}.db.session import get_engine, get_session  # noqa: E402
from {{ package_name }}.main import create_app  # noqa: E402

# Default Tier 1a identity headers (rules-library/platform/proxy-delegated-auth.md
# §Tests: "inject default identity headers in the test client fixture").
DEFAULT_IDENTITY_HEADERS = {"x-authentik-uid": "test-uid", "x-authentik-username": "testuser"}


def _ensure_test_database_ready() -> None:
    """Create and migrate the test database before anything can connect to it.

    Runs `alembic upgrade head` — not a `create_all` + stamp — so the app's
    real migrations stay genuinely exercised by the suite rather than trusted
    on the strength of a matching model definition. Migrations run through
    the ordinary alembic CLI in a subprocess: alembic/env.py calls
    `fileConfig()`, which reconfigures logging for the whole process — a
    subprocess contains that side effect instead of letting it break every
    test that asserts on a captured warning.
    """
    from sqlalchemy import create_engine, text

    from {{ package_name }}.config import get_settings

    settings = get_settings().database
    maintenance_url = settings.database_url.rsplit("/", 1)[0] + "/postgres"
    engine = create_engine(maintenance_url, isolation_level="AUTOCOMMIT")
    try:
        with engine.connect() as conn:
            exists = conn.execute(
                text("SELECT 1 FROM pg_database WHERE datname = :name"), {"name": TEST_DATABASE_NAME}
            ).scalar()
            if not exists:
                logging.info("Creating test database %s", TEST_DATABASE_NAME)
                conn.execute(text(f'CREATE DATABASE "{TEST_DATABASE_NAME}"'))
    finally:
        engine.dispose()

    backend_root = Path(__file__).resolve().parent.parent
    result = subprocess.run(  # fixed argv, no user input reaches it
        [sys.executable, "-m", "alembic", "upgrade", "head"],
        cwd=backend_root,
        env={**os.environ, "POSTGRES_DB": TEST_DATABASE_NAME},
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"Could not migrate the test database {TEST_DATABASE_NAME!r}.\nstdout: {result.stdout}\nstderr: {result.stderr}"
        )

    from alembic.config import Config
    from alembic.script import ScriptDirectory

    alembic_cfg = Config(str(backend_root / "alembic.ini"))
    head_revision = ScriptDirectory.from_config(alembic_cfg).get_current_head()

    schema_engine = create_engine(settings.database_url)
    try:
        with schema_engine.connect() as conn:
            current_revision = conn.execute(text("SELECT version_num FROM alembic_version")).scalar()
    finally:
        schema_engine.dispose()

    if current_revision != head_revision:
        raise RuntimeError(
            f"Test database {TEST_DATABASE_NAME!r} is at alembic revision {current_revision!r}, "
            f"expected head {head_revision!r}. `alembic upgrade head` did not leave the database "
            "where it should be."
        )


def pytest_sessionstart(session) -> None:
    """Build the test database before anything can try to connect to it.

    Not inside a fixture: the application lifespan runs its own database
    connectivity check when the app is first created, and fixture ordering
    does not guarantee a schema-building fixture wins that race. A
    session-start hook precedes every fixture, so there is no race to lose.

    Under xdist the controller runs no tests and needs no database: each worker
    builds its own on the shared server. It still resolved that server at
    import, because it is the process that started the container.
    """
    if session.config.pluginmanager.hasplugin("dsession"):  # xdist registers it in the controller only
        return
    _ensure_test_database_ready()
    # Whatever this app needs doing once, after the schema exists and before any
    # test runs (tests/app_fixtures.py). No-op unless the app defines one.
    app_session_start()


def pytest_sessionfinish(session, exitstatus) -> None:
    """Stop the ephemeral Postgres, if this run started one.

    The ordinary path. The same stop is registered with ``atexit`` by
    ``_start_ephemeral_postgres`` for the exits that never reach this hook, and
    it is a no-op once either caller has run.
    """
    _stop_ephemeral_postgres()


@pytest.fixture(scope="session")
def app():
    return create_app()


@pytest.fixture
def session() -> Generator[Session]:
    """A real Postgres session bound to a connection-level transaction, rolled
    back at teardown (`rules-library/stacks/python-testing.md` §Transaction
    Rollback Fixture, sync form).

    A service that calls `session.commit()` explicitly would, on a session
    bound to a plain connection, commit the OUTER transaction this fixture
    opens, leaving nothing for teardown's rollback to undo and leaking test
    rows into the database permanently. `join_transaction_mode="create_savepoint"`
    is SQLAlchemy 2.0's native answer: the session opens a SAVEPOINT and
    reopens one after every commit, so commits release/restart SAVEPOINTs
    instead of ever reaching the outer connection transaction, which is the
    only thing teardown rolls back.
    """
    engine = get_engine()
    connection = engine.connect()
    outer_transaction = connection.begin()
    session_factory = sessionmaker(
        bind=connection,
        autoflush=False,
        expire_on_commit=False,
        join_transaction_mode="create_savepoint",
    )
    db_session = session_factory()

    try:
        yield db_session
    finally:
        db_session.close()
        outer_transaction.rollback()
        connection.close()


@pytest.fixture
async def client(app, session: Session) -> AsyncGenerator[AsyncClient]:
    """httpx.AsyncClient wired to the FastAPI app with the rollback session and a default identity."""
    app.dependency_overrides[get_session] = lambda: session
    transport = ASGITransport(app=app)
    async with AsyncClient(
        transport=transport,
        base_url="http://test",
        headers=DEFAULT_IDENTITY_HEADERS,
    ) as ac:
        yield ac
    app.dependency_overrides.pop(get_session, None)


# ── The app's surface, bound a second time (see _adopt_app_fixtures above) ────
# Nothing re-runs; this only re-binds the names. It is what lets an app REPLACE
# one of the factory's defaults rather than only add beside it — the identity
# headers its client fixture sends, say. At the first call the factory's own
# definitions land afterwards and win; here the app's win, which is the right way
# round for a file the app is extending. Two calls because an app's suite has two
# needs at two different moments, and one seam cannot serve both.
_adopt_app_fixtures()
