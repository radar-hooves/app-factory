# -- retry_unsettled: the only thing that ever calls core-memory ------------


async def test_retry_unsettled_records_a_decision_then_an_outcome(
    workspace_id: int, with_core_memory: AgentSettings, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1, BELIEF_2])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.insert_lesson_report_if_absent(
            db, job_id, workspace_id=workspace_id, domain_name=DOMAIN, context_key=CONTEXT, result=lessons.CONFIRM
        )
        db.commit()

    await lessons.retry_unsettled(get_session_factory(), with_core_memory)

    assert [tool for tool, _ in calls] == ["decision_record", "outcome_record"]
    assert calls[0][1] == {
        "domain_name": DOMAIN,
        "context_key": CONTEXT,
        "cites": [BELIEF_1, BELIEF_2],
        "payload": {"job_id": job_id},
    }
    assert calls[1][1] == {"domain_name": DOMAIN, "decision_id": "decision-1", "result": lessons.CONFIRM}
    report = _report(job_id, workspace_id)
    assert report is not None
    assert (report.decision_id, report.refused, report.recorded_at is not None) == ("decision-1", None, True)


async def test_retry_unsettled_resumes_a_saved_decision(
    workspace_id: int, with_core_memory: AgentSettings, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.insert_lesson_report_if_absent(
            db, job_id, workspace_id=workspace_id, domain_name=DOMAIN, context_key=CONTEXT, result=lessons.CONFIRM
        )
        db.commit()
        # A negative lease is already-expired the moment it's set -- deterministic, not a sleep --
        # so the sweep below finds this report reclaimable exactly as a lapsed real lease would.
        won, _, token = jobs_models.claim_lesson_report(db, job_id, lease_seconds=-1.0)
        assert won
        jobs_models.set_lesson_decision(db, job_id, "decision-1", claim_token=token)

    await lessons.retry_unsettled(get_session_factory(), with_core_memory)

    assert [tool for tool, _ in calls] == ["outcome_record"]
    assert calls[0][1]["decision_id"] == "decision-1"


async def test_retry_unsettled_settles_core_memorys_own_refusal(
    workspace_id: int,
    with_core_memory: AgentSettings,
    calls: list[tuple[str, dict[str, Any]]],
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    async def _refuse(settings: AgentSettings, tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
        raise ToolError(f"belief {BELIEF_1} is not active")

    monkeypatch.setattr(lessons, "_call", _refuse)
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.insert_lesson_report_if_absent(
            db, job_id, workspace_id=workspace_id, domain_name=DOMAIN, context_key=CONTEXT, result=lessons.CONFIRM
        )
        db.commit()

    await lessons.retry_unsettled(get_session_factory(), with_core_memory)

    report = _report(job_id, workspace_id)
    assert report is not None
    assert report.recorded_at is not None
    assert report.refused is not None and "not active" in report.refused


async def test_retry_unsettled_treats_a_masked_tool_error_as_transient(
    workspace_id: int, with_core_memory: AgentSettings, monkeypatch: pytest.MonkeyPatch
) -> None:
    """FastMCP's own masking turns ANY unhandled server exception into this exact shape -- a
    refusal and an unrelated bug are indistinguishable, so it must be retried, not settled."""

    async def _masked(settings: AgentSettings, tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
        raise ToolError(f"Error calling tool {tool!r}")

    monkeypatch.setattr(lessons, "_call", _masked)
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.insert_lesson_report_if_absent(
            db, job_id, workspace_id=workspace_id, domain_name=DOMAIN, context_key=CONTEXT, result=lessons.CONFIRM
        )
        db.commit()

    await lessons.retry_unsettled(get_session_factory(), with_core_memory)

    report = _report(job_id, workspace_id)
    assert report is not None and report.recorded_at is None


