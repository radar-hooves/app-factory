DOMAIN = "example/lessons-test"
CONTEXT = "unit-test"


@pytest.fixture(autouse=True)
def _isolate_the_sweep() -> None:
    """`retry_unsettled` scans every workspace for unsettled rows, and its own alert is one fixed
    key shared by every test -- both would otherwise let one test's leftovers affect another's
    assertions (`test_agent_jobs_api.py`'s convention: rows this file commits are real)."""
    with get_session_factory()() as db, unscoped(db):
        db.execute(delete(AgentJobLessonReport).where(AgentJobLessonReport.recorded_at.is_(None)))
        db.execute(delete(Alert).where(Alert.key == lessons._FAILING_ALERT_KEY))
        db.commit()


def _provision(authentik_uid: str, username: str) -> int:
    with get_session_factory()() as db:
        user = users_service.upsert_from_identity(db, authentik_uid=authentik_uid, username=username)
        db.commit()
        return workspaces_service.ensure_personal_workspace(db, user).workspace_id


@pytest.fixture
def workspace_id() -> int:
    return _provision(f"lessons-{uuid.uuid4()}", "lessons-tester")


def _seed_job(workspace_id: int, *, lessons_used: list[str] | None) -> str:
    """A settled job whose structured answer cites `lessons_used` (`None` = the key is absent)."""
    job_id = str(uuid.uuid4())
    structured_output: dict[str, Any] = {"data": {}}
    if lessons_used is not None:
        structured_output["lessons_used"] = lessons_used
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.create_job(
            db,
            RunSpec(
                job_id=job_id,
                persona="jobagent",
                workspace_id=workspace_id,
                created_by_id=None,
                run_id=str(uuid.uuid4()),
                json_schema=None,
                append_system_prompt=None,
                mcp_config=None,
                model=None,
            ),
        )
        job = jobs_models.get_job(db, job_id)
        assert job is not None
        job.status = jobs_models.COMPLETED
        job.structured_output = structured_output
        db.commit()
    return job_id


#: Two 32-char hex ids -- what `cited()` keeps.
BELIEF_1, BELIEF_2 = "a" * 32, "b" * 32


def _seed_report(workspace_id: int, *, lessons_used: list[str], result: str = lessons.CONFIRM) -> tuple[str, list[str]]:
    """A job citing `lessons_used`, and its already-inserted, still-unsettled report row."""
    job_id = _seed_job(workspace_id, lessons_used=lessons_used)
    cites = lessons.cited(jobs_models.AgentJob(structured_output={"lessons_used": lessons_used}))
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.insert_lesson_report_if_absent(
            db, job_id, cites=cites, domain_name=DOMAIN, context_key=CONTEXT, result=result
        )
        db.commit()
    return job_id, cites


def _report(job_id: str, workspace_id: int) -> AgentJobLessonReport | None:
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        return db.get(AgentJobLessonReport, job_id)


def _backdate(job_id: str, workspace_id: int, age: datetime.timedelta) -> None:
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        db.execute(
            update(AgentJobLessonReport)
            .where(AgentJobLessonReport.job_id == job_id)
            .values(created_at=datetime.datetime.now(datetime.UTC) - age)
        )
        db.commit()


def _failing_alert() -> Alert | None:
    with get_session_factory()() as db:
        return db.execute(select(Alert).where(Alert.key == lessons._FAILING_ALERT_KEY)).scalar_one_or_none()


