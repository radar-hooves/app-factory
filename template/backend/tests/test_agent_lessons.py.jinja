async def test_a_refusal_keeps_the_alert_up_despite_another_rows_success_in_the_same_sweep(
    workspace_id: int, with_core_memory: AgentSettings, monkeypatch: pytest.MonkeyPatch
) -> None:
    """The bug this guards: `_deliver_or_abandon` used to clear the shared alert on its OWN
    success, even when a DIFFERENT row in the same sweep had just raised it."""

    async def _refuse_belief_2(tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
        if arguments["cited"] == [BELIEF_2]:
            raise ToolError(f"belief {BELIEF_2} is not active")
        return SimpleNamespace(structured_content={"decision_id": "decision-1"})

    monkeypatch.setattr(lessons, "Client", _fake_client(_refuse_belief_2))
    _seed_report(workspace_id, lessons_used=[BELIEF_1])  # succeeds
    _seed_report(workspace_id, lessons_used=[BELIEF_2])  # refused

    await lessons.retry_unsettled(get_session_factory(), with_core_memory, asyncio.Event())

    assert _failing_alert() is not None


def test_raise_failing_alert_does_not_undo_a_dismissal_for_an_unchanged_reason() -> None:
    """The bug this guards: `raise_alert` marks an alert unread on every call, so re-raising the
    SAME reason every sweep (the misconfiguration check runs on every one) would undo an
    operator's own dismissal within a minute."""
    factory = get_session_factory()
    lessons._raise_failing_alert(factory, "still broken")
    raised = _failing_alert()
    assert raised is not None
    with factory() as db:
        alerts_service.mark_read(db, raised.id)
        db.commit()

    lessons._raise_failing_alert(factory, "still broken")  # unchanged -- must not re-mark unread

    dismissed = _failing_alert()
    assert dismissed is not None and dismissed.read_at is not None


