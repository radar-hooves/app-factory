@pytest.fixture
def calls(monkeypatch: pytest.MonkeyPatch) -> Iterator[list[tuple[str, dict[str, Any]]]]:
    """Every call `lessons._call` would have made to core-memory, without a real one."""
    made: list[tuple[str, dict[str, Any]]] = []

    async def _fake(settings: AgentSettings, tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
        made.append((tool, arguments))
        return {"id": "decision-1"} if tool == "decision_record" else {"outcome": {"id": "outcome-1"}}

    monkeypatch.setattr(lessons, "_call", _fake)
    yield made


# -- report_outcome: insert-only, atomic with the caller's own commit -------


def test_report_outcome_inserts_the_intent_row_for_the_callers_own_commit(
    workspace_id: int, with_core_memory: AgentSettings
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        lessons.report_outcome(db, job_id, domain_name=DOMAIN, context_key=CONTEXT, result=lessons.CONFIRM)
        db.commit()
    report = _report(job_id, workspace_id)
    assert report is not None
    assert (report.domain_name, report.context_key, report.result) == (DOMAIN, CONTEXT, lessons.CONFIRM)
    assert report.decision_id is None and report.recorded_at is None and report.claimed_until is None


