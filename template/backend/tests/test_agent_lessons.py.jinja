def _fake_client(tool_call: Any) -> type:
    """A stand-in for `fastmcp.Client`: real construction args accepted and ignored, `call_tool`
    delegates to `tool_call(tool, arguments)`. Monkeypatched in as `lessons.Client` for every test
    except the two that verify real-network fault classification."""

    class _FakeClient:
        def __init__(self, *args: object, **kwargs: object) -> None:
            pass

        async def __aenter__(self) -> _FakeClient:
            return self

        async def __aexit__(self, *exc_info: object) -> bool:
            return False

        async def call_tool(self, tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
            result: SimpleNamespace = await tool_call(tool, arguments)
            return result

    return _FakeClient


@pytest.fixture(autouse=True)
def _fake_vend(monkeypatch: pytest.MonkeyPatch) -> None:
    """No real broker in tests: every test but the two real-network ones also fakes the Client, so
    this never actually reaches core-memory either way."""
    monkeypatch.setattr(lessons, "vend_envelope", lambda credential: {"material": {"access_token": "fake-token"}})


@pytest.fixture
def calls(monkeypatch: pytest.MonkeyPatch) -> Iterator[list[tuple[str, dict[str, Any]]]]:
    """Every tool call a fake core-memory `Client` would have received, without a real one."""
    made: list[tuple[str, dict[str, Any]]] = []

    async def _tool_call(tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
        made.append((tool, arguments))
        if arguments["action"] == "load":
            # The live server's shape: FastMCP wraps the payload under one `result` key.
            return SimpleNamespace(
                structured_content={
                    "result": {
                        "situation": SITUATION,
                        "lessons": [{"id": BELIEF_1, "statement": "Zero-dollar interest lines are not rows."}],
                        "brief": f"Lessons from earlier work.\n- [{BELIEF_1}] Zero-dollar interest lines are not rows.",
                    }
                }
            )
        return SimpleNamespace(structured_content={"result": {"decision_id": "decision-1", "duplicate": False}})

    monkeypatch.setattr(lessons, "Client", _fake_client(_tool_call))
    yield made


# -- report_outcome: insert-only, atomic with the caller's own commit -------


def _file(workspace_id: int, job_id: str, **kwargs: Any) -> None:
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        lessons.report_outcome(db, job_id, **kwargs)
        db.commit()


def test_report_outcome_inserts_the_report_for_the_callers_own_commit(
    workspace_id: int, with_core_memory: AgentSettings
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1], declared=_declared(loaded=[BELIEF_1, BELIEF_2]))
    corrections = [{"statement": "Zero-dollar interest lines are not rows."}, {"statement": "x", "key": "reading"}]
    _file(workspace_id, job_id, accepted=False, attempts=2, corrections=corrections)
    report = _report(job_id, workspace_id)
    assert report is not None
    assert (report.domain_name, report.situation, report.accepted) == (DOMAIN, SITUATION, False)
    assert (report.loaded, report.cites, report.attempts, report.model) == (
        [BELIEF_1, BELIEF_2],
        [BELIEF_1],
        2,
        "example/deep",
    )
    assert report.corrections == corrections
    assert report.seconds is not None and report.seconds >= 0
    assert report.recorded_at is None and report.claimed_until is None


def test_report_outcome_is_filed_even_when_the_job_cited_nothing(
    workspace_id: int, with_core_memory: AgentSettings
) -> None:
    """core-memory's stats set runs with lessons against runs without: a run that cited nothing still counts."""
    job_id = _seed_job(workspace_id, lessons_used=[])
    _file(workspace_id, job_id, accepted=True)
    report = _report(job_id, workspace_id)
    assert report is not None and report.cites == [] and report.accepted is True


def test_report_outcome_drops_corrections_for_a_job_that_must_not_propose(
    workspace_id: int, with_core_memory: AgentSettings
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1], declared=_declared(propose=False))
    _file(workspace_id, job_id, accepted=False, corrections=[{"statement": "A child's name is Sam."}])
    report = _report(job_id, workspace_id)
    assert report is not None and report.accepted is False and report.corrections == []
    assert report.cites == [BELIEF_1]  # it still learns from the run, it only proposes nothing


