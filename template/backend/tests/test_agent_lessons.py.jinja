async def test_retry_unsettled_treats_a_masked_tool_error_as_transient(
    workspace_id: int, with_core_memory: AgentSettings, monkeypatch: pytest.MonkeyPatch
) -> None:
    """FastMCP's own masking turns ANY unhandled server exception into this exact shape -- a
    refusal and an unrelated bug are indistinguishable, so it must be retried, not settled."""

    async def _masked(tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
        raise ToolError(f"Error calling tool {tool!r}")

    monkeypatch.setattr(lessons, "Client", _fake_client(_masked))
    job_id, _ = _seed_report(workspace_id, lessons_used=[BELIEF_1])

    await lessons.retry_unsettled(get_session_factory(), with_core_memory, asyncio.Event())

    report = _report(job_id, workspace_id)
    assert report is not None and report.recorded_at is None
    assert _failing_alert() is None  # under a day old -- not yet worth an alert


