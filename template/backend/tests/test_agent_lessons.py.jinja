async def test_retry_unsettled_abandons_a_stale_report_and_raises_an_alert(
    workspace_id: int, with_core_memory: AgentSettings, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.insert_lesson_report_if_absent(
            db, job_id, workspace_id=workspace_id, domain_name=DOMAIN, context_key=CONTEXT, result=lessons.CONFIRM
        )
        db.commit()
    _backdate(job_id, workspace_id, datetime.timedelta(days=15))

    await lessons.retry_unsettled(get_session_factory(), with_core_memory)

    assert calls == []  # abandoned before ever reaching core-memory
    report = _report(job_id, workspace_id)
    assert report is not None
    assert report.recorded_at is not None
    assert report.refused is not None and "abandoned" in report.refused
    with get_session_factory()() as db:
        alert = db.execute(select(Alert).where(Alert.key == f"agent-lessons:abandoned:{job_id}")).scalar_one_or_none()
    assert alert is not None


def test_a_lease_already_held_refuses_a_second_claim(workspace_id: int) -> None:
    """Deterministic: claim once (wins), then claim again at once -- the row no longer matches
    the unclaimed condition, so the second call loses without any timing involved."""
    job_id = _seed_job(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.insert_lesson_report_if_absent(
            db, job_id, workspace_id=workspace_id, domain_name=DOMAIN, context_key=CONTEXT, result=lessons.CONFIRM
        )
        db.commit()
        won1, _, _ = jobs_models.claim_lesson_report(db, job_id, lease_seconds=300.0)
        won2, decision2, token2 = jobs_models.claim_lesson_report(db, job_id, lease_seconds=300.0)
    assert won1 is True
    assert (won2, decision2, token2) == (False, None, None)
