def test_a_stale_claim_tokens_writes_land_nowhere(workspace_id: int) -> None:
    job_id, _ = _seed_report(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        won, _, stale_token = jobs_models.claim_lesson_report(db, job_id, lease_seconds=-1.0)
        assert won
        # The lease has already lapsed (negative, deterministic); someone else reclaims it.
        won2, _, fresh_token = jobs_models.claim_lesson_report(db, job_id, lease_seconds=300.0)
        assert won2 and fresh_token != stale_token
        # The ORIGINAL holder, unaware its lease lapsed, tries to write with its now-stale token.
        jobs_models.set_lesson_decision(db, job_id, "stale-decision", claim_token=stale_token)
        jobs_models.settle_lesson_report(db, job_id, claim_token=stale_token, refused="stale")
    report = _report(job_id, workspace_id)
    assert report is not None
    assert report.decision_id is None
    assert report.recorded_at is None


def test_a_lease_already_held_refuses_a_second_claim(workspace_id: int) -> None:
    """Deterministic: claim once (wins), then claim again at once -- the row no longer matches
    the unclaimed condition, so the second call loses without any timing involved."""
    job_id, _ = _seed_report(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        won1, _, _ = jobs_models.claim_lesson_report(db, job_id, lease_seconds=300.0)
        won2, decision2, token2 = jobs_models.claim_lesson_report(db, job_id, lease_seconds=300.0)
    assert won1 is True
    assert (won2, decision2, token2) == (False, None, None)


# -- retry_unsettled: the only thing that ever calls core-memory ------------


async def test_retry_unsettled_records_a_decision_then_an_outcome(
    workspace_id: int, with_core_memory: AgentSettings, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id, cites = _seed_report(workspace_id, lessons_used=[BELIEF_1, BELIEF_2])

    await lessons.retry_unsettled(get_session_factory(), with_core_memory, asyncio.Event())

    assert [tool for tool, _ in calls] == ["decision_record", "outcome_record"]
    assert calls[0][1] == {"domain_name": DOMAIN, "context_key": CONTEXT, "cites": cites, "payload": {"job_id": job_id}}
    assert calls[1][1] == {"domain_name": DOMAIN, "decision_id": "decision-1", "result": lessons.CONFIRM}
    report = _report(job_id, workspace_id)
    assert report is not None
    assert (report.decision_id, report.refused, report.recorded_at is not None) == ("decision-1", None, True)
    assert _failing_alert() is None


async def test_retry_unsettled_resumes_a_saved_decision(
    workspace_id: int, with_core_memory: AgentSettings, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id, _ = _seed_report(workspace_id, lessons_used=[BELIEF_1])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        # A negative lease is already-expired the moment it's set -- deterministic, not a sleep --
        # so the sweep below finds this report reclaimable exactly as a lapsed real lease would.
        won, _, token = jobs_models.claim_lesson_report(db, job_id, lease_seconds=-1.0)
        assert won
        jobs_models.set_lesson_decision(db, job_id, "decision-1", claim_token=token)

    await lessons.retry_unsettled(get_session_factory(), with_core_memory, asyncio.Event())

    assert [tool for tool, _ in calls] == ["outcome_record"]
    assert calls[0][1]["decision_id"] == "decision-1"


