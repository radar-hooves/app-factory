async def test_load_passes_the_declared_bounds_and_reports_total_and_omitted(
    with_core_memory: AgentSettings, monkeypatch: pytest.MonkeyPatch
) -> None:
    seen: list[dict[str, Any]] = []

    async def _bounded(tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
        seen.append(arguments)
        return SimpleNamespace(
            structured_content={"result": {"lessons": [{"id": BELIEF_1}], "brief": "b", "total": 75, "omitted": 74}}
        )

    monkeypatch.setattr(lessons, "Client", _fake_client(_bounded))
    declared = lessons.Lessons(DOMAIN, SITUATION, focus=" ING bank statement ", limit=5, max_chars=4000)
    loaded = await lessons.load(with_core_memory, declared)
    assert seen == [
        {
            "action": "load",
            "domain_name": DOMAIN,
            "situation": SITUATION,
            "focus": "ING bank statement",
            "limit": 5,
            "max_chars": 4000,
        }
    ]
    assert (loaded.total, loaded.omitted) == (75, 74)
    assert lessons.record(declared, loaded) == {
        "domain": DOMAIN,
        "situation": SITUATION,
        "propose": True,
        "loaded": [BELIEF_1],
        "total": 75,
        "omitted": 74,
    }


async def test_load_retries_unbounded_against_a_core_memory_that_refuses_the_bounds(
    with_core_memory: AgentSettings, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
) -> None:
    seen: list[dict[str, Any]] = []

    async def _old_server(tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
        seen.append(arguments)
        if "limit" in arguments:
            raise ToolError("Unexpected keyword argument: limit")
        return SimpleNamespace(structured_content={"result": {"lessons": [{"id": BELIEF_1}], "brief": "b"}})

    monkeypatch.setattr(lessons, "Client", _fake_client(_old_server))
    with caplog.at_level(logging.WARNING):
        loaded = await lessons.load(with_core_memory, lessons.Lessons(DOMAIN, SITUATION, limit=5))
    assert [("limit" in call) for call in seen] == [True, False]
    assert loaded.ids == [BELIEF_1] and loaded.total is None
    assert "loading unbounded" in caplog.text


async def test_load_fails_open_when_core_memory_cannot_be_reached(
    with_core_memory: AgentSettings, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
) -> None:
    async def _unreachable(tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
        raise RuntimeError("Client failed to connect: connection refused")

    monkeypatch.setattr(lessons, "Client", _fake_client(_unreachable))
    with caplog.at_level(logging.WARNING):
        assert await lessons.load(with_core_memory, lessons.Lessons(DOMAIN, SITUATION)) == lessons.Loaded()
    assert "starts without them" in caplog.text


async def test_load_accepts_an_unwrapped_payload_and_warns_with_the_cause_on_a_bad_one(
    with_core_memory: AgentSettings, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
) -> None:
    async def _flat(tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
        return SimpleNamespace(structured_content={"lessons": [{"id": BELIEF_1}], "brief": "b"})

    monkeypatch.setattr(lessons, "Client", _fake_client(_flat))
    assert await lessons.load(with_core_memory, lessons.Lessons(DOMAIN, SITUATION)) == lessons.Loaded("b", [BELIEF_1])

    async def _odd(tool: str, arguments: dict[str, Any]) -> SimpleNamespace:
