# -- real network: what a real fastmcp client actually raises ---------------


async def test_retry_unsettled_treats_a_closed_port_as_transient(
    workspace_id: int, with_core_memory: AgentSettings
) -> None:
    """A real client, not a monkeypatched exception type: fastmcp wraps connection-refused as a
    bare `RuntimeError`, which must still classify as transient."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()  # nothing listens here now
    settings = with_core_memory.model_copy(update={"core_memory_url": f"http://127.0.0.1:{port}/mcp"})
    job_id, _ = _seed_report(workspace_id, lessons_used=[BELIEF_1])

    await lessons.retry_unsettled(get_session_factory(), settings, asyncio.Event())

    report = _report(job_id, workspace_id)
    assert report is not None
    assert report.recorded_at is None
    assert report.claimed_until is not None


async def test_retry_unsettled_treats_a_server_that_never_answers_as_transient(
    workspace_id: int, with_core_memory: AgentSettings, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A real server that accepts the connection and then says nothing: the client's own init/read
    timeout fires, which on some fastmcp versions is a bare `httpx.ReadTimeout`."""
    monkeypatch.setattr(lessons, "_INIT_TIMEOUT_SECONDS", 0.3)
    monkeypatch.setattr(lessons, "_CALL_TIMEOUT_SECONDS", 0.3)
    monkeypatch.setattr(lessons, "_DELIVER_TIMEOUT_SECONDS", 2.0)

    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listener.bind(("127.0.0.1", 0))
    listener.listen(1)
    port = listener.getsockname()[1]

    def _accept_and_say_nothing() -> None:
        try:
            conn, _ = listener.accept()
            conn.recv(65536)  # read the request, then never respond
        except OSError:
            pass

    thread = threading.Thread(target=_accept_and_say_nothing, daemon=True)
    thread.start()
    try:
        settings = with_core_memory.model_copy(update={"core_memory_url": f"http://127.0.0.1:{port}/mcp"})
        job_id, _ = _seed_report(workspace_id, lessons_used=[BELIEF_1])

        await lessons.retry_unsettled(get_session_factory(), settings, asyncio.Event())

        report = _report(job_id, workspace_id)
        assert report is not None
        assert report.recorded_at is None
        assert report.claimed_until is not None
    finally:
        listener.close()
