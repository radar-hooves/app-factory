    job_id, _ = _seed_report(workspace_id, lessons_used=[BELIEF_1])

    await lessons.retry_unsettled(get_session_factory(), with_core_memory, asyncio.Event())

    report = _report(job_id, workspace_id)
    assert report is not None and report.recorded_at is not None
    assert report.refused is not None and "unexpected" in report.refused
    assert _failing_alert() is not None


