"""`api/agent/lessons.py`: the standard report of a job's cited lessons to core-memory
(`docs/design/agent-lessons.md`). core-memory itself is out of scope — the
factory owns the resume-safe, refusal-is-final shape of the two-call sequence,
never core-memory's own tool behaviour — so `lessons._call` is monkeypatched
throughout, the same boundary `test_agent_jobs_api.py` draws around a real CLI
versus the app's own job machinery.

Jobs are seeded directly through `jobs_models.create_job` rather than run
through a real persona spawn: what these tests exercise is what happens to a
job's ALREADY-SETTLED `structured_output`, not how it got there.
"""

import uuid
from collections.abc import Iterator
from typing import Any

import httpx
import pytest
from fastmcp.exceptions import ToolError

from {{ package_name }}.api.agent import jobs_models, lessons
from {{ package_name }}.api.agent.jobs_models import RunSpec
from {{ package_name }}.api.users import service as users_service
from {{ package_name }}.api.workspaces import service as workspaces_service
from {{ package_name }}.config.sections.agent import AgentSettings
from {{ package_name }}.db.scoping import bind_session
from {{ package_name }}.db.session import get_session_factory

DOMAIN = "example/lessons-test"
CONTEXT = "unit-test"


def _provision(authentik_uid: str, username: str) -> int:
    with get_session_factory()() as db:
        user = users_service.upsert_from_identity(db, authentik_uid=authentik_uid, username=username)
        db.commit()
        membership = workspaces_service.ensure_personal_workspace(db, user)
        return membership.workspace_id


@pytest.fixture
def workspace_id() -> int:
    return _provision(f"lessons-{uuid.uuid4()}", "lessons-tester")


def _seed_job(workspace_id: int, *, lessons_used: list[str] | None) -> str:
    """A settled job whose structured answer cites `lessons_used` (`None` means the key is absent)."""
    job_id = str(uuid.uuid4())
    structured_output: dict[str, Any] = {"data": {}}
    if lessons_used is not None:
        structured_output["lessons_used"] = lessons_used
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.create_job(
            db,
            RunSpec(
                job_id=job_id,
                persona="jobagent",
                workspace_id=workspace_id,
                created_by_id=None,
                run_id=str(uuid.uuid4()),
                json_schema=None,
                append_system_prompt=None,
                mcp_config=None,
                model=None,
            ),
        )
        job = jobs_models.get_job(db, job_id)
        assert job is not None
        job.status = jobs_models.COMPLETED
        job.structured_output = structured_output
        db.commit()
    return job_id


def _report(job_id: str, workspace_id: int) -> jobs_models.AgentJobLessonReport | None:
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        return db.get(jobs_models.AgentJobLessonReport, job_id)


@pytest.fixture
def calls(monkeypatch: pytest.MonkeyPatch) -> Iterator[list[tuple[str, dict[str, Any]]]]:
    """Every call `lessons._call` would have made to core-memory, without a real one."""
    made: list[tuple[str, dict[str, Any]]] = []

    async def _fake(settings: AgentSettings, tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
        made.append((tool, arguments))
        if tool == "decision_record":
            return {"id": "decision-1"}
        return {"outcome": {"id": "outcome-1"}}

    monkeypatch.setattr(lessons, "_call", _fake)
    yield made


async def test_a_deployment_naming_no_core_memory_is_a_no_op(
    workspace_id: int, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=["belief-1"])
    await lessons.report_outcome(
        get_session_factory(),
        AgentSettings(core_memory_url=""),
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONFIRM,
    )
    assert calls == []
    assert _report(job_id, workspace_id) is None


async def test_a_job_that_cited_no_lessons_is_a_no_op(
    workspace_id: int, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=[])
    await lessons.report_outcome(
        get_session_factory(),
        AgentSettings(core_memory_url="https://core-memory.example/mcp"),
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONFIRM,
    )
    assert calls == []
    assert _report(job_id, workspace_id) is None


async def test_cited_lessons_are_recorded_as_a_decision_then_an_outcome(
    workspace_id: int, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=["belief-1", "belief-2"])
    await lessons.report_outcome(
        get_session_factory(),
        AgentSettings(core_memory_url="https://core-memory.example/mcp"),
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONFIRM,
    )
    assert [tool for tool, _ in calls] == ["decision_record", "outcome_record"]
    decision_args = calls[0][1]
    assert decision_args == {"domain_name": DOMAIN, "context_key": CONTEXT, "cites": ["belief-1", "belief-2"]}
    outcome_args = calls[1][1]
    assert outcome_args == {"domain_name": DOMAIN, "decision_id": "decision-1", "result": lessons.CONFIRM}
    report = _report(job_id, workspace_id)
    assert report is not None
    assert report.decision_id == "decision-1"
    assert report.recorded_at is not None
    assert report.refused is None


async def test_a_call_repeated_once_recorded_reports_nothing_again(
    workspace_id: int, calls: list[tuple[str, dict[str, Any]]]
) -> None:
    job_id = _seed_job(workspace_id, lessons_used=["belief-1"])
    settings = AgentSettings(core_memory_url="https://core-memory.example/mcp")
    await lessons.report_outcome(
        get_session_factory(),
        settings,
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONFIRM,
    )
    calls.clear()
    await lessons.report_outcome(
        get_session_factory(),
        settings,
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONFIRM,
    )
    assert calls == []


async def test_a_call_interrupted_after_the_decision_resumes_at_the_outcome(
    workspace_id: int, calls: list[tuple[str, dict[str, Any]]], monkeypatch: pytest.MonkeyPatch
) -> None:
    """A network fault between the two calls is resumed, not restarted -- the decision is never recorded twice."""
    job_id = _seed_job(workspace_id, lessons_used=["belief-1"])
    with get_session_factory()() as db:
        bind_session(db, workspace_id=workspace_id)
        jobs_models.ensure_lesson_report(db, job_id, domain_name=DOMAIN, context_key=CONTEXT, result=lessons.CONTRADICT)
        jobs_models.set_lesson_decision(db, job_id, "decision-1")

    await lessons.report_outcome(
        get_session_factory(),
        AgentSettings(core_memory_url="https://core-memory.example/mcp"),
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONTRADICT,
    )
    assert [tool for tool, _ in calls] == ["outcome_record"]
    assert calls[0][1] == {"domain_name": DOMAIN, "decision_id": "decision-1", "result": lessons.CONTRADICT}
    report = _report(job_id, workspace_id)
    assert report is not None and report.recorded_at is not None


async def test_core_memorys_refusal_is_final_and_never_retried(
    workspace_id: int, calls: list[tuple[str, dict[str, Any]]], monkeypatch: pytest.MonkeyPatch
) -> None:
    async def _refuse(settings: AgentSettings, tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
        calls.append((tool, arguments))
        raise ToolError("belief-1 is not active")

    monkeypatch.setattr(lessons, "_call", _refuse)
    job_id = _seed_job(workspace_id, lessons_used=["belief-1"])
    settings = AgentSettings(core_memory_url="https://core-memory.example/mcp")

    await lessons.report_outcome(
        get_session_factory(),
        settings,
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONFIRM,
    )
    report = _report(job_id, workspace_id)
    assert report is not None
    assert report.refused is not None and "not active" in report.refused
    assert report.recorded_at is not None

    calls.clear()
    await lessons.report_outcome(
        get_session_factory(),
        settings,
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONFIRM,
    )
    assert calls == []


async def test_a_transport_fault_leaves_the_report_unsettled_until_the_supervisors_retry(
    workspace_id: int, calls: list[tuple[str, dict[str, Any]]], monkeypatch: pytest.MonkeyPatch
) -> None:
    """`report_outcome` never raises a network fault to its caller -- the report stays unsettled,
    and `jobs.supervise()`'s own sweep (`lessons.retry_unsettled`) is what retries it, resuming
    from `decision_id` exactly as a repeated direct call would, never re-recording the decision."""

    async def _unreachable(settings: AgentSettings, tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
        raise httpx.ConnectError("connection refused")

    monkeypatch.setattr(lessons, "_call", _unreachable)
    job_id = _seed_job(workspace_id, lessons_used=["belief-1"])
    settings = AgentSettings(core_memory_url="https://core-memory.example/mcp")

    await lessons.report_outcome(
        get_session_factory(),
        settings,
        job_id,
        workspace_id=workspace_id,
        domain_name=DOMAIN,
        context_key=CONTEXT,
        result=lessons.CONFIRM,
    )
    unsettled = _report(job_id, workspace_id)
    assert unsettled is not None
    assert unsettled.decision_id is None
    assert unsettled.recorded_at is None

    async def _recovered(settings: AgentSettings, tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
        calls.append((tool, arguments))
        return {"id": "decision-1"} if tool == "decision_record" else {"outcome": {"id": "outcome-1"}}

    monkeypatch.setattr(lessons, "_call", _recovered)
    retried = await lessons.retry_unsettled(get_session_factory(), settings)
    assert retried == 1
    assert [tool for tool, _ in calls] == ["decision_record", "outcome_record"]

    settled = _report(job_id, workspace_id)
    assert settled is not None
    assert settled.decision_id == "decision-1"
    assert settled.recorded_at is not None
    assert settled.refused is None
