[project]
name = "{{ project_name }}"
version = "2026.1.0"
description = "{{ description }}"
requires-python = ">=3.14"
dependencies = [
    "fastapi>=0.136.3",
    "uvicorn[standard]>=0.49.0",
    "fastmcp>=3.4.2",
    "pydantic>=2.13.4",
    "pydantic-settings>=2.14.2",
    "sqlalchemy>=2.0.50",
    "alembic>=1.18.4",
    "psycopg[binary]>=3.3.4",
    # httpx: the MCP bearer gate's userinfo client (mcp/http_auth.py).
    "httpx>=0.28.1",
    # pyyaml: the MCP actor allow-list loader (mcp/actors.py).
    "pyyaml>=6.0.2",
    # slowapi: the app's one rate limiter (rate_limit.py). Storage is chosen at
    # deploy time — a Redis URL shares counters across workers, empty is
    # in-memory — so no app needs a Redis dependency it does not want.
    "slowapi>=0.1.10",
    # gunicorn: production process manager (entrypoint.sh, gunicorn.conf.py).
    "gunicorn>=26.0.0",
    # api-common: logging.py's one telemetry call; the extra adds the OTLP exporter and instrumentation.
    "api-common[telemetry]>=2026.9.4",
    # redactyl-core is api-common's redaction floor and transitive-only here, but
    # under an explicit index a [tool.uv.sources] pin reaches only a DECLARED
    # dependency — undeclared it resolves against PyPI and is not found.
    "redactyl-core>=2026.7.0",
    # nextcloud: the household api-client's WebDAV wrapper and generated OCS Share
    # API, bound in files/storage.py — the files slice's whole WebDAV layer, so no
    # app carries its own put/get/list/move/delete/share code.
    "nextcloud>=2026.6.0",
]

[dependency-groups]
dev = [
    "ruff>=0.15.16",
    "mypy>=2.1.0",
    "mypy-baseline>=0.7.4",
    "pytest>=9.0.3",
    "pytest-asyncio>=1.4.0",
    "pytest-cov>=7.1.0",
    "httpx>=0.28.1",
    # filelock: conftest.py's cross-process lock, so one pytest run starts ONE
    # Postgres container and every xdist worker shares it.
    "filelock>=3.20.3",
    # 4.15.0 is the first release carrying testcontainers.community.postgres,
    # which conftest.py imports; 4.13/4.14 ship only the deprecated alias.
    "testcontainers[postgres]>=4.15.0",
    "types-PyYAML>=6.0.12.20260518",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.uv]
default-groups = ["dev"]
environments = ["sys_platform == 'darwin'", "sys_platform == 'linux'"]

# Household private package index (devpi). explicit = true → ONLY the packages
# pinned to it below resolve here; everything else stays on PyPI, so a private
# name can never be satisfied by a same-named public package
# (core/supply-chain.md). Auth is ambient: the atlas CI runner authenticates via
# the runner's netrc, the Docker build mounts one as a BuildKit secret and points
# NETRC at it, and a dev machine uses ~/.netrc — no per-repo GitHub secret.
[[tool.uv.index]]
name = "godswood"
url = "https://pypi.example.com/poodle64/prod/+simple/"
explicit = true

# Every private package is pinned to that index here: under an explicit index an
# unpinned private name resolves nowhere, and a pin reaches only a DECLARED
# dependency — a transitive-only private name still resolves against PyPI and is
# not found, so it must also be declared above. Do NOT add a path override; it
# would be written into the committed uv.lock and break every other checkout.
[tool.uv.sources]
api-common = { index = "godswood" }
redactyl-core = { index = "godswood" }
nextcloud = { index = "godswood" }

[tool.ruff]
line-length = 120
target-version = "py314"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "C4", "UP", "SIM", "RUF"]
ignore = ["E501", "B008"]

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["F401"]

[tool.mypy]
python_version = "3.14"
strict = true
# mypy-baseline matches on the rendered error line, so these must stay off:
# `pretty` reflows it and `color_output` injects escape codes.
pretty = false
color_output = false
show_error_codes = true

[tool.mypy-baseline]
# A freshly-stamped app has no debt, so this file is empty and the gate is a
# plain "no type errors". An app carrying debt records it here and the gate
# then fails only on errors the change itself introduced — shrink it as debt
# is paid, never grow it — a resolved entry left in the file FAILS the gate by
# default, which is what keeps it shrinking and stops a fixed error silently
# becoming permitted again. Do not pass `--allow-unsynced`; it opts out of that.
baseline_path = "mypy-baseline.txt"
sort_baseline = true

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "session"
asyncio_default_test_loop_scope = "session"
addopts = "--import-mode=importlib --strict-markers"
testpaths = ["tests"]
markers = [
    "unit: fast, isolated, no external dependencies",
    "integration: exercises multiple components; may need fixtures or services",
]

[tool.coverage.run]
source = ["src/{{ package_name }}"]
omit = ["*/tests/*", "*/migrations/*"]
branch = true

[tool.coverage.report]
fail_under = 70
