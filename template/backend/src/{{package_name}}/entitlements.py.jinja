"""Module entitlements — may this ACCOUNT use module M, and at what grade.

The middle of the three layers (`rules-library/platform/tenancy.md`): identity
answers who is calling, this answers what they may use, and workspace membership
answers whose data is in scope. Entitlement is per ACCOUNT and does not vary by
workspace — it is licensing, not scoping. What a caller sees is the intersection:
a module they are entitled to, showing rows of the workspace they are in.

Grades are provisioned at the identity provider as Application Entitlements and
arrive pipe-delimited on every request:

    property                 -> may READ the property module
    property:write           -> may read AND mutate it

DEFAULT-DENY IS THE POINT. A bare key grants read only, and mutation needs the
explicit ``:write`` grade, so a grant issued in a hurry gives away the smaller
thing. The inverse (bare = read+write, ``:read`` for read-only) needs no
re-provisioning on cutover day and was rejected for that reason: forgetting to
add ``:read`` would silently hand someone write access to a household ledger,
where forgetting ``:write`` merely produces a 403 someone reports.

The module name ``admin`` is RESERVED by the factory: the admin area
(``api/admin/``) is gated by ``require_module("admin")`` exactly as a domain
module is gated by its own name, and ``admin:write`` is what acting there needs.
Admin is deliberately NOT a stored flag. A boolean column is a second
authorisation mechanism beside this one; it needs bootstrap machinery the day
the database is fresh (and on a fresh database the first caller can be a
machine); and it keeps working after the operator revokes it at the identity
provider. Provisioned as an Application Entitlement like every other module, a
grant or a revocation is effective on the caller's next request — and no admin
grant bypasses any other module's gate, because a super-role is exactly the
shape this file exists to avoid.
"""

import logging
from collections.abc import Callable

from fastapi import Depends, params

from {{ package_name }}.api.users.dependencies import CurrentIdentity, Identity
from {{ package_name }}.exceptions import ForbiddenError

logger = logging.getLogger(__name__)

WRITE_SUFFIX = ":write"


def has_module(entitlements: tuple[str, ...], module: str, *, write: bool = False) -> bool:
    """True when these entitlements admit ``module`` at the requested grade.

    The write grade implies read, so a caller holding only ``property:write`` can
    read the property module — the alternative would make every write grant a
    two-key affair for no gain.
    """
    if write:
        return f"{module}{WRITE_SUFFIX}" in entitlements
    return module in entitlements or f"{module}{WRITE_SUFFIX}" in entitlements


def require_module(module: str, *, write: bool = False) -> Callable[[Identity], Identity]:
    """FastAPI dependency factory gating a route on a module entitlement.

    Usage:
        router = APIRouter(dependencies=[Depends(require_module("property"))])

        @router.post("/", dependencies=[Depends(require_module("property", write=True))])
        def create_property(...): ...

    Gate the ROUTER on read and each mutating route on write, so a new route
    added to an existing router inherits the read gate rather than none.
    """

    def _check(identity: CurrentIdentity) -> Identity:
        if has_module(identity.entitlements, module, write=write):
            return identity

        if not identity.entitlements:
            # Names the likely cause: an outpost not configured to forward
            # entitlements looks identical to a user with none, and the second
            # explanation sends someone hunting in the wrong system.
            # The key is gated_module, not module: `module` is one of logging's
            # own LogRecord attributes, and an extra that collides with one
            # raises KeyError instead of logging.
            logger.warning(
                "Refused a module the caller has no entitlements at all for — is the "
                "identity provider forwarding the entitlements header?",
                extra={"gated_module": module, "user_id": identity.user.id},
            )

        grade = "write" if write else "read"
        raise ForbiddenError(
            f"You do not have {grade} access to the {module} module",
            details={"module": module, "grade": grade},
        )

    return _check


def module_dependency(module: str, *, write: bool = False) -> params.Depends:
    """``Depends(require_module(...))``, for a router's ``dependencies=[…]`` list.

    Returns ``params.Depends`` — what ``Depends(...)`` actually constructs —
    rather than ``object``, because a ``dependencies=[…]`` list is typed for it
    and an opaque return makes every call site a type error.
    """
    return Depends(require_module(module, write=write))
