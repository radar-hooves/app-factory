from contextlib import asynccontextmanager
from pathlib import Path
from typing import Any

from api_common.telemetry import instrument_app
from fastapi import Depends, FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from starlette.exceptions import HTTPException as StarletteHTTPException
from starlette.responses import Response
from starlette.routing import Match, Mount
from starlette.types import Scope

from {{ package_name }} import app_hooks
from {{ package_name }}.api.agent import ask as agent_turns
from {{ package_name }}.api.agent import jobs as agent_jobs
from {{ package_name }}.api.agent import rooms as agent_rooms
from {{ package_name }}.api.main import api_router
from {{ package_name }}.app_hooks import API_DESCRIPTION, OPENAPI_TAGS, lifespan_tasks, register
from {{ package_name }}.config import Settings, get_settings
from {{ package_name }}.config.paths import frontend_build_dir
from {{ package_name }}.db.session import get_engine, get_session_factory
from {{ package_name }}.exceptions import register_exception_handlers
from {{ package_name }}.logging import app_version, configure_logging
from {{ package_name }}.mcp.http_auth import require_bearer_auth
from {{ package_name }}.mcp.server import create_mcp_server
from {{ package_name }}.middleware import RequestIDMiddleware, RequestLoggingMiddleware, SecurityHeadersMiddleware
from {{ package_name }}.rate_limit import RateLimitExceeded, enforce_default_rate_limit, limiter, rate_limit_handler

_log = logging.getLogger(__name__)

# This app's one-line copier description — the default when app_hooks has not
# supplied a long form. A module constant rather than a literal inside the
# FastAPI() call, because the rendered length varies per app and `ruff format`
# wraps a call argument that passes the line limit: an app with a long
# description got a two-line `description=API_DESCRIPTION\n or "..."` where a
# short one got a single line, and main.py stopped being byte-identical for the
# length of a sentence. A lone string assignment is never wrapped, at any length.
_COPIER_DESCRIPTION = "{{ description }}"

# Resolved from the source tree, not the working directory: uvicorn is launched
# from backend/ in dev (.envrc, .vscode/launch.json) and from the repo root in a
# container, and a CWD-relative path silently serves no SPA in one of the two.
_FRONTEND_BUILD: Path = frontend_build_dir()

# SvelteKit writes its hashed build output under this prefix. A miss there is a
# genuine missing asset, never a route.
_IMMUTABLE_ASSET_PREFIX = "_app/"

# Every vertical slice mounts under this; an app with an older consumer contract names its own in app_hooks.
_API_PREFIX: str = getattr(app_hooks, "API_PREFIX", "/api")

# Nor is a path under an API namespace a client-side route. Derived from what is mounted.
_API_PREFIXES = tuple(f"/{prefix.strip('/')}" for prefix in (_API_PREFIX, "/mcp") if prefix.strip("/"))

# Nor is a miss on one of these a client-side route. FastAPI serves all three
# itself when openapi_enabled is True, so this branch only ever fires when it
# is False — and OPENAPI_ENABLED's whole point is that they answer 404, not the
# SPA shell with a 200 a scanner reads as "reachable, docs hidden".
_DOCUMENT_ROUTES = ("openapi.json", "docs", "redoc")


class _SPAStaticFiles(StaticFiles):
    """Serve the built SPA, falling back to index.html for client-side routes.

    The SPA router owns paths that have no file on disk, and `html=True` alone
    does not cover them: it serves index.html for a directory, so a deep link
    into a client route 404s and the app is reachable only from its root.
    Catching the 404 hands the path to the client router instead. A miss under
    the immutable-asset prefix stays a 404, so a broken build surfaces rather
    than returning HTML to something expecting a script.
    """

    async def get_response(self, path: str, scope: Scope) -> Response:
        try:
            return await super().get_response(path, scope)
        except StarletteHTTPException as exc:
            if exc.status_code == 404 and path not in _DOCUMENT_ROUTES and not path.startswith(_IMMUTABLE_ASSET_PREFIX):
                return await super().get_response("index.html", scope)
            raise


class _SPAMount(Mount):
    """Mount the SPA at `/` for every path but those under an API namespace.

    A mount at `/` matches every path, and the router tries a path's other
    trailing-slash form only once no route matches it, so the SPA would answer
    a client's `/api/items/` with a 404 where the route `/api/items` exists.
    Declined, an API path is the router's: a redirect to the form that exists,
    or its JSON 404, never HTTP 200 and a page of HTML.
    """

    def matches(self, scope: Scope) -> tuple[Match, Scope]:
        path = scope.get("path", "")
        if any(path == prefix or path.startswith(f"{prefix}/") for prefix in _API_PREFIXES):
            return Match.NONE, {}
        return super().matches(scope)


@asynccontextmanager
async def _db_lifespan(app: FastAPI, settings: Settings) -> AsyncGenerator[None]:
    """Refuse to start on a room this app cannot open, warm the database engine,
    supervise agent jobs for the life of the worker, end this worker's own
    runs and turns on shutdown, then dispose the engine.

    The supervisor settles a job whose process has died, in whichever worker
    sweeps first (`jobs.supervise`, which also retries an unsettled lesson
    report — `api/agent/lessons.py`); `jobs.shutdown` ends the runs THIS
    worker holds, while the engine they settle through is still open. Both
    are factory-owned (never an `app_hooks.lifespan_tasks` default) so every
    app that carries the agent-jobs slice gets them via `copier update`
    picking up this file, not only a fresh stamp — an app's own
    `app_hooks.py` is sanctioned-per-app and copier never overwrites it, so a
    default living there would reach nobody who already has one.
    """
    agent_rooms.load(settings.agent)
    engine = get_engine()
    app.state.engine = engine
    stopping = asyncio.Event()
    supervisor = asyncio.create_task(agent_jobs.supervise(get_session_factory(), settings.agent, stopping))
    try:
        yield
    finally:
        stopping.set()
        # A sweep stuck on an unreachable database is not waited on for long.
        with contextlib.suppress(TimeoutError):
            await asyncio.wait_for(supervisor, timeout=10)
        await agent_jobs.shutdown()
        await agent_turns.shutdown()
        engine.dispose()


def create_app(settings: Settings | None = None) -> FastAPI:
    """Create and configure the FastAPI application.

    `settings` is a test seam; production passes nothing and gets the cached instance.
    """
    if settings is None:
        settings = get_settings()
    configure_logging(debug=settings.debug)

    # raw_mcp_app carries the FastMCP lifespan (the streamable-HTTP session
    # manager's task group lives there), so the lifespan must be chained from
    # the RAW app while the GATED wrapper is what gets mounted. Wrapping the
    # wrong one either leaves the session manager unstarted or leaves /mcp open.
    # gated_mcp_app is held as Any because require_bearer_auth returns a bare
    # ASGI callable carrying an .aclose attribute; the module is a byte-identical
    # copy of the household's canonical gate and is not edited per app.
    mcp = create_mcp_server()
    # stateless_http: the streamable-HTTP session manager keeps each session's
    # live transport (an anyio task group plus in-memory object streams) in a
    # per-PROCESS dict, keyed by Mcp-Session-Id. Gunicorn runs a worker POOL
    # (WEB_CONCURRENCY, default 5) with no shared store and no sticky routing, so
    # a request carrying a session id only succeeds on the worker that created it
    # — roughly 1-in-workers — and every other worker returns JSON-RPC -32600
    # "Session not found". A shared backing store cannot fix this: the transport
    # holds a running task and memory streams, not serialisable state, so it can
    # never leave the process that owns it. Single-worker would fix /mcp but throw
    # away the pool the human /api + SPA surface needs; proxy stickiness is
    # cross-repo and still drops sessions on worker recycle (max_requests).
    # Stateless mode removes the coupling entirely — a fresh transport per request,
    # no session to lose — and is correct here because the embedded /mcp is a
    # request/response tool surface: no cross-request session state, no
    # server-initiated streaming. (In-request progress still works.)
    raw_mcp_app = mcp.http_app(path="/", stateless_http=True)
    # app_hooks.mcp_auth gates /mcp for an app that is its own machine-identity
    # authority; every other app gets the Authentik bearer gate.
    app_mcp_auth = getattr(app_hooks, "mcp_auth", None)
    gated_mcp_app: Any
    if app_mcp_auth is not None:
        gated_mcp_app = app_mcp_auth(raw_mcp_app)
    else:
        gated_mcp_app = require_bearer_auth(
            raw_mcp_app,
            userinfo_url=settings.mcp.oidc_userinfo_url,
            identity_claim=settings.mcp.oidc_identity_claim,
            resource_metadata_url=settings.mcp.oidc_resource_metadata_url,
        )
        if not settings.mcp.oidc_userinfo_url:
            _log.warning(
                "{{ project_name | upper | replace('-', '_') }}_OIDC_USERINFO_URL is unset: the /mcp surface is closed "
                "(every HTTP request 401s). Set it to your Authentik userinfo endpoint to open it."
            )

    @asynccontextmanager
    async def lifespan(app: FastAPI) -> AsyncGenerator[None]:
        try:
            # app_hooks.lifespan_tasks is composed INNERMOST: the engine is warm
            # and /mcp is up before this app's own pollers start, and they are
            # torn down before either goes away.
            async with (
                _db_lifespan(app, settings),
                raw_mcp_app.lifespan(raw_mcp_app),
                lifespan_tasks(app),
            ):
                yield
        finally:
            # Close the gate's userinfo httpx client so its connection pool does
            # not leak across app-factory lifecycles (tests, hot reload). Logged
            # rather than raised: an exception from a finally block REPLACES the
            # one propagating out of the try, so a failure here would hide the
            # startup error that actually matters; an app-supplied gate may hold no client.
            aclose = getattr(gated_mcp_app, "aclose", None)
            if aclose is not None:
                try:
                    await aclose()
                except Exception:
                    _log.exception("Failed to close the MCP bearer gate's userinfo client")

    app = FastAPI(
        title="{{ project_title }}",
        # app_hooks supplies the long form once this app has enough surface to
        # want one; the one-line copier description is the default.
        description=API_DESCRIPTION or _COPIER_DESCRIPTION,
        openapi_tags=OPENAPI_TAGS or None,
        version=app_version(),
        lifespan=lifespan,
        # OPENAPI_ENABLED=false closes the schema and both UIs for an app reachable
        # without the ingress proxy; its healthcheck then has no route to poll.
        docs_url="/docs" if settings.openapi_enabled else None,
        redoc_url="/redoc" if settings.openapi_enabled else None,
        openapi_url="/openapi.json" if settings.openapi_enabled else None,
        # Hardcoded, not settings.debug: the flag installs Starlette's
        # interactive error page, which ServerErrorMiddleware checks BEFORE the
        # Exception handler registered below, so a DEBUG=true process renders a
        # full traceback to the caller — `core/security-standards.md` forbids
        # exposing stack traces. settings.debug still drives logging verbosity
        # through configure_logging() above.
        debug=False,
    )
    # FastAPI server spans, whenever OTEL_EXPORTER_OTLP_ENDPOINT is set; a no-op otherwise.
    instrument_app(app)
    register_exception_handlers(app)

    # The one rate limiter. The configured default limit is
    # applied by enforce_default_rate_limit, wired as a dependency on the API
    # router below; @limiter.limit() opts a route out with its own limit. This is
    # NOT slowapi's SlowAPIMiddleware: that scans the app's top-level routes for a
    # handler to limit, and by FastAPI 0.139 an include_router() is one opaque
    # _IncludedRouter with no handler to find (absent at 0.136.3; the exact
    # minor version in between is untested), so the middleware limits nothing.
    # app.state.limiter and the RateLimitExceeded handler
    # are still registered here — the handler turns the dependency's 429 into a
    # response wrapped by RequestID and the security headers.
    app.state.limiter = limiter
    app.add_exception_handler(RateLimitExceeded, rate_limit_handler)

    # Middleware order: added last wraps outermost (runs first). Execution
    # order is RequestID -> RequestLogging -> SecurityHeaders -> CORS -> handler,
    # so the correlation id is bound before anything downstream logs.
    # CORS only where an origin is configured; the console is same-origin.
    if settings.cors_origins_list:
        app.add_middleware(
            CORSMiddleware,
            allow_origins=settings.cors_origins_list,
            allow_credentials=True,
            allow_methods=["*"],
            allow_headers=["*"],
        )
    app.add_middleware(SecurityHeadersMiddleware, is_production=not settings.debug)
    app.add_middleware(RequestLoggingMiddleware)
    app.add_middleware(RequestIDMiddleware)

    # MCP surface at /mcp — the GATED app, never raw_mcp_app. Every HTTP request
    # must carry a valid Authentik Bearer token or it 401s before reaching a tool.
    # The agent endpoint is POST /mcp/ (trailing slash required).
    app.mount("/mcp", gated_mcp_app)

    # API routes at _API_PREFIX. The default rate limit binds here, once, for
    # every vertical slice the router aggregates — no per-route opt-in. Routes
    # that need a different limit carry their own @limiter.limit(); the
    # dependency defers to them. The /mcp and SPA surfaces below are mounted
    # sub-apps, not router routes, and are gated on their own terms rather than
    # by this limit.
    app.include_router(api_router, prefix=_API_PREFIX, dependencies=[Depends(enforce_default_rate_limit)])

    # This app's own middleware and exception handlers. Last, so anything added
    # wraps outermost and runs first — a Host-header or body-size guard has to
    # see the request before the factory's stack does. An app with nothing to add
    # calls a function that does nothing, which is why main.py stays identical.
    register(app, settings)

    # Serve the SPA — must be last so API routes take precedence.
    # Skip mounting if the frontend has not been built yet (dev-only path).
    if _FRONTEND_BUILD.is_dir():
        app.router.routes.append(
            _SPAMount("/", app=_SPAStaticFiles(directory=str(_FRONTEND_BUILD), html=True), name="frontend")
        )
    else:
        _log.warning("frontend/build not found; SPA not mounted. Run `pnpm build` in frontend/.")

    return app
