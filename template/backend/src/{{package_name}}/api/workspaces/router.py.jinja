"""HTTP routes for the workspace primitive.

None of these routes depends on ``CurrentWorkspace``: they are how a caller
discovers and administers the workspaces they belong to, so they run before a
workspace has been chosen. They are also the only routes in the app that read
across workspaces, and they do it through membership rather than through the
scoping hooks — which is why no ``unscoped()`` block appears here.
"""

import uuid

from fastapi import APIRouter, status

from {{ package_name }}.api.workspaces import service
from {{ package_name }}.api.workspaces.schemas import (
    InvitationRead,
    MemberAdd,
    MemberRead,
    MembershipRead,
    WorkspaceCreate,
    WorkspaceRead,
    WorkspaceRename,
)
from {{ package_name }}.deps import CurrentIdentity, SessionDep

router = APIRouter()


@router.get("/me", response_model=list[MembershipRead], operation_id="listMyWorkspaces")
def list_my_workspaces(session: SessionDep, identity: CurrentIdentity) -> list[MembershipRead]:
    """List the workspaces the caller belongs to, with their role in each.

    Always at least one — every user is provisioned a personal workspace on first
    sight. The SPA calls this at startup and renders a switcher only when the
    list has more than one entry.
    """
    memberships = service.list_memberships(session, identity.user.id)
    return [MembershipRead.model_validate(m) for m in memberships]


@router.post("/", response_model=MembershipRead, status_code=status.HTTP_201_CREATED, operation_id="createWorkspace")
def create_workspace(data: WorkspaceCreate, session: SessionDep, identity: CurrentIdentity) -> MembershipRead:
    """Create a workspace. The caller becomes its owner."""
    membership = service.create_workspace(session, owner=identity.user, name=data.name)
    return MembershipRead.model_validate(membership)


@router.patch("/{workspace_id}", response_model=WorkspaceRead, operation_id="renameWorkspace")
def rename_workspace(
    workspace_id: uuid.UUID, data: WorkspaceRename, session: SessionDep, identity: CurrentIdentity
) -> WorkspaceRead:
    """Rename a workspace. Owner only. The slug is stable and does not follow."""
    service.require_owner(session, workspace_id=workspace_id, user_id=identity.user.id)
    workspace = service.rename_workspace(session, workspace_id=workspace_id, name=data.name)
    return WorkspaceRead.model_validate(workspace)


@router.get("/{workspace_id}/members", response_model=list[MemberRead], operation_id="listWorkspaceMembers")
def list_members(workspace_id: uuid.UUID, session: SessionDep, identity: CurrentIdentity) -> list[MemberRead]:
    """List who shares a workspace. Any member may look.

    Membership, not ownership, is the gate: the people whose data you share are
    not a secret from you. A non-member gets the same 403 a non-owner gets from
    the routes below, so the answer never confirms a workspace exists.
    """
    service.require_member(session, workspace_id=workspace_id, user_id=identity.user.id)
    return [MemberRead.model_validate(m) for m in service.list_members(session, workspace_id)]


@router.post(
    "/{workspace_id}/members",
    response_model=MemberRead,
    status_code=status.HTTP_201_CREATED,
    operation_id="addWorkspaceMember",
)
def invite_member(
    workspace_id: uuid.UUID, data: MemberAdd, session: SessionDep, identity: CurrentIdentity
) -> MemberRead:
    """Invite someone to a workspace. Owner only; the invitee must accept.

    Sharing is a grant the person takes, never something done to them: the row is
    pending, grants no access and changes nobody's workspace resolution until the
    invitee accepts it (``acceptWorkspaceInvitation``).
    """
    service.require_owner(session, workspace_id=workspace_id, user_id=identity.user.id)
    membership = service.invite_member(session, workspace_id=workspace_id, user_id=data.user_id, role=data.role)
    return MemberRead.model_validate(membership)


@router.get("/invitations", response_model=list[InvitationRead], operation_id="listMyWorkspaceInvitations")
def list_my_invitations(session: SessionDep, identity: CurrentIdentity) -> list[InvitationRead]:
    """List the invitations waiting on the caller, the workspace and the role offered."""
    invitations = service.list_invitations(session, identity.user.id)
    return [InvitationRead.model_validate(m) for m in invitations]


@router.post(
    "/{workspace_id}/invitation/accept",
    response_model=MembershipRead,
    operation_id="acceptWorkspaceInvitation",
)
def accept_invitation(workspace_id: uuid.UUID, session: SessionDep, identity: CurrentIdentity) -> MembershipRead:
    """Accept the caller's own pending invitation. The workspace joins their switcher."""
    membership = service.accept_invitation(session, workspace_id=workspace_id, user_id=identity.user.id)
    return MembershipRead.model_validate(membership)


@router.post(
    "/{workspace_id}/invitation/decline",
    status_code=status.HTTP_204_NO_CONTENT,
    operation_id="declineWorkspaceInvitation",
)
def decline_invitation(workspace_id: uuid.UUID, session: SessionDep, identity: CurrentIdentity) -> None:
    """Decline the caller's own pending invitation."""
    service.decline_invitation(session, workspace_id=workspace_id, user_id=identity.user.id)


@router.post(
    "/{workspace_id}/leave",
    status_code=status.HTTP_204_NO_CONTENT,
    operation_id="leaveWorkspace",
)
def leave_workspace(workspace_id: uuid.UUID, session: SessionDep, identity: CurrentIdentity) -> None:
    """Leave a workspace. Any member; never the last owner, never the caller's last workspace."""
    service.leave_workspace(session, workspace_id=workspace_id, user_id=identity.user.id)


@router.delete(
    "/{workspace_id}/members/{user_id}",
    status_code=status.HTTP_204_NO_CONTENT,
    operation_id="removeWorkspaceMember",
)
def remove_member(workspace_id: uuid.UUID, user_id: uuid.UUID, session: SessionDep, identity: CurrentIdentity) -> None:
    """Retract someone's membership, or withdraw a pending invitation. Owner only.

    Their rows stay with the workspace and their attribution stays on them; only
    the grant goes.
    """
    service.require_owner(session, workspace_id=workspace_id, user_id=identity.user.id)
    service.remove_member(session, workspace_id=workspace_id, user_id=user_id)
