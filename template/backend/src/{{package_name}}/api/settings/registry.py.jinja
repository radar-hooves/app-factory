"""Import every domain's `settings` module, so the settings route sees every declaration.

A declaration lives with the domain code it governs, in `api/<domain>/settings.py`
(`declare.py`'s `declare_setting`, called at import time). This file finds those
modules by that one convention instead of listing them, so adding a domain, or
deleting the scaffold's `api/example/`, never edits it. A glob rather than
`pkgutil`, because the domain folders are namespace packages it does not list.
"""

import importlib
from pathlib import Path

from {{ package_name }} import api

for _root in api.__path__:
    for _module in sorted(Path(_root).glob("*/settings.py")):
        importlib.import_module(f"{api.__name__}.{_module.parent.name}.settings")
