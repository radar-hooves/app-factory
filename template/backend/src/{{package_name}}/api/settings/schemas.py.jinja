"""Pydantic schemas for the settings slice."""

import datetime
from typing import Annotated

from pydantic import BaseModel, Field


class SettingsDocument(BaseModel):
    """What `<SchemaForm>` needs to render the whole page: a JSON Schema and a value.

    No UI Schema travels alongside it — `@poodle64/ui/schema-form` generates
    its own layout from the JSON Schema alone (`docs/design/settings.md`
    §The page), which is the only mode in which a declared setting cannot be
    missing from the rendered form.
    """

    schema_: dict = Field(serialization_alias="schema")
    value: dict[str, bool | int | float | str]
    defaults: dict[str, bool | int | float | str]
    overridden: list[str]


class SettingUpdate(BaseModel):
    """Request body for `PATCH /api/admin/settings/{key}` — one field's next value."""

    value: bool | int | float | str


class SettingRead(BaseModel):
    """One setting's effective state, returned after a write or a reset."""

    key: str
    value: bool | int | float | str
    default: bool | int | float | str
    overridden: bool


class SettingChangeRead(BaseModel):
    """One row of the append-only history — who changed what, when."""

    id: int
    key: str
    old_value: bool | int | float | str | None
    new_value: bool | int | float | str
    changed_by: str | None
    changed_at: datetime.datetime


class SettingHistoryList(BaseModel):
    """One page of the settings history, newest first."""

    changes: list[SettingChangeRead]
    total: int
    limit: Annotated[int, Field(ge=1, le=200)]
    offset: Annotated[int, Field(ge=0)]
