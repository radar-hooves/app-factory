"""HTTP routes for runtime settings: the operator's page (`docs/design/settings.md`).

Gated by the reserved `admin` entitlement, the identical dependency
`api/admin/router.py` already uses — never a second one — so an app that has
not yet taken the factory's entitlement-based admin gate swaps one dependency
on convergence, with nothing else in this slice to change alongside it.

Mounted at `/api/settings`, a sibling of `/api/admin` rather than nested
under it: `alerts` is admin-gated the same way and is not nested either, and
this keeps every admin-gated slice's own prefix free of the others'.
"""

from fastapi import APIRouter, Query

from {{ package_name }}.api.settings import (
    registry,  # noqa: F401 — import side effect: every declared setting
    service,
)
from {{ package_name }}.api.settings.declare import all_settings
from {{ package_name }}.api.settings.schemas import (
    SettingHistoryList,
    SettingRead,
    SettingsDocument,
    SettingUpdate,
)
from {{ package_name }}.deps import CurrentIdentity, SessionDep
from {{ package_name }}.entitlements import module_dependency

router = APIRouter(dependencies=[module_dependency("admin")])

MAX_HISTORY_PAGE_SIZE = 200


@router.get("/", response_model=SettingsDocument, operation_id="getSettings")
def get_settings_document(session: SessionDep) -> SettingsDocument:
    """The JSON Schema, the effective values, and their declared defaults.

    Everything `<SchemaForm>` needs to render the page, and everything the
    "overridden from default" panel needs beside it — which keys are
    overridden is left for the frontend to derive from `value`/`defaults`.
    """
    values = service.get_effective_values(session)
    defaults = {setting.key: setting.default for setting in all_settings()}
    return SettingsDocument(schema_=service.build_schema(), value=values, defaults=defaults)


@router.patch(
    "/{key}",
    response_model=SettingRead,
    dependencies=[module_dependency("admin", write=True)],
    operation_id="updateSetting",
)
def update_setting(key: str, data: SettingUpdate, session: SessionDep, identity: CurrentIdentity) -> SettingRead:
    """Set `key`'s override to `data.value`.

    Raises:
        NotFoundError: nothing declared `key`.
        ValidationError: the value fails the declared type, bounds, choices,
            or (for `model_alias`) a reachable gateway's own alias list.
    """
    value, default = service.set_value(session, key, data.value, actor_user_id=identity.user.id)
    return SettingRead(key=key, value=value, default=default, overridden=value != default)


@router.post(
    "/{key}/reset",
    response_model=SettingRead,
    dependencies=[module_dependency("admin", write=True)],
    operation_id="resetSetting",
)
def reset_setting(key: str, session: SessionDep, identity: CurrentIdentity) -> SettingRead:
    """Delete `key`'s override, reverting it to its declared default.

    Raises:
        NotFoundError: nothing declared `key`.
    """
    default = service.reset_value(session, key, actor_user_id=identity.user.id)
    return SettingRead(key=key, value=default, default=default, overridden=False)


@router.get("/history", response_model=SettingHistoryList, operation_id="listSettingHistory")
def get_history(
    session: SessionDep,
    limit: int = Query(default=50, ge=1, le=MAX_HISTORY_PAGE_SIZE, description="Page size"),
    offset: int = Query(default=0, ge=0, description="Page offset"),
) -> SettingHistoryList:
    """The append-only change log, newest first — who changed what, when."""
    changes, total = service.list_history(session, limit=limit, offset=offset)
    return SettingHistoryList(changes=changes, total=total, limit=limit, offset=offset)
