"""Pydantic schemas for the local user record."""

import datetime

from pydantic import BaseModel, ConfigDict


class UserRead(BaseModel):
    """A user as the API exposes them.

    ``authentik_uid`` is deliberately absent: it is the identity provider's key,
    of no use to a client, and echoing it back widens what a compromised browser
    session learns.
    """

    model_config = ConfigDict(from_attributes=True)

    id: int
    username: str
    email: str | None
    is_admin: bool
    last_seen_at: datetime.datetime | None


class CurrentUserRead(UserRead):
    """The caller's own record, plus the entitlements this request carried.

    Entitlements are NOT persisted — they arrive in a header on every request and
    are true only of the request that carried them. Serving them here is what lets
    the SPA hide a module the caller cannot reach; it is a convenience for the UI,
    never the gate. The gate is ``require_module()`` on the server.
    """

    entitlements: list[str]
