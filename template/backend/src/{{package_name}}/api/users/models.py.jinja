"""ORM model for the local user record.

The app owns no passwords and no sessions (`rules-library/platform/authentication.md`
Tier 1, proxy-delegated): Authentik is the identity provider and this row is the
app's local projection of it, existing so other tables have something stable to
point at. It is upserted from the forward-auth headers on every authenticated
request.
"""

import datetime

from sqlalchemy import Boolean, DateTime, String
from sqlalchemy.orm import Mapped, mapped_column

from {{ package_name }}.db.base import Base, TimestampMixin


class User(Base, TimestampMixin):
    """A person Authentik has authenticated, projected locally.

    NOT workspace-scoped: a user exists before any workspace resolution has
    happened, and identity is what workspace membership is resolved FROM. It is
    named in the identity exemption in db/registry.py for that reason.
    """

    __tablename__ = "users"

    id: Mapped[int] = mapped_column(primary_key=True)

    # The stable, immutable key Authentik asserts. Unique and never reused:
    # every other field on this row may change over an account's life, so
    # matching on any of them would silently split or merge people.
    authentik_uid: Mapped[str] = mapped_column(String(255), unique=True, nullable=False, index=True)

    # Mutable display fields, re-synced from the headers on every request.
    username: Mapped[str] = mapped_column(String(255), nullable=False)
    email: Mapped[str | None] = mapped_column(String(320), nullable=True)

    # Estate-wide administration of GLOBAL reference data only — never a stand-in
    # for a workspace role, which is the membership row's job
    # (`rules-library/platform/tenancy.md`). The first user to authenticate on a
    # fresh database gets it, which is the whole bootstrap; behind the forward-auth
    # proxy only an entitled person can be first.
    is_admin: Mapped[bool] = mapped_column(Boolean, nullable=False, default=False, server_default="false")

    # Set false to refuse a person the app still knows about. Deleting the row
    # is the wrong tool: domain rows reference it for attribution.
    is_active: Mapped[bool] = mapped_column(Boolean, nullable=False, default=True, server_default="true")

    last_seen_at: Mapped[datetime.datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
