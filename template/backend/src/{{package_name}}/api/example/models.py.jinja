"""ORM model for the example domain.

One models.py per domain slice. Import this in db/registry.py so Alembic
includes the table in autogenerate.
"""

from sqlalchemy import String, Text
from sqlalchemy.orm import Mapped, mapped_column

from {{ package_name }}.db.base import Base, TimestampMixin


class ExampleItem(Base, TimestampMixin):
    """Example item — replace with the first real domain entity."""

    __tablename__ = "example_items"

    id: Mapped[int] = mapped_column(primary_key=True)
    title: Mapped[str] = mapped_column(String(255), nullable=False)
    body: Mapped[str | None] = mapped_column(Text, nullable=True)
