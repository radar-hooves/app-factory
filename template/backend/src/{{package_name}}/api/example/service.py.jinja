"""Business logic for the example domain.

Services contain no FastAPI/HTTP concerns — only domain logic and DB queries.
This makes them testable without an HTTP layer.
"""

import logging

{% if db_mode == "async" -%}
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession
{% else -%}
from sqlalchemy import select
from sqlalchemy.orm import Session
{% endif %}
from {{ package_name }}.api.example.models import ExampleItem
from {{ package_name }}.api.example.schemas import ExampleItemCreate
from {{ package_name }}.exceptions import NotFoundError

logger = logging.getLogger(__name__)

{% if db_mode == "async" %}
async def list_items(session: AsyncSession) -> list[ExampleItem]:
    """Return all ExampleItems ordered by id."""
    result = await session.execute(select(ExampleItem).order_by(ExampleItem.id))
    return list(result.scalars().all())


async def get_item(session: AsyncSession, item_id: int) -> ExampleItem:
    """Return a single ExampleItem by id.

    Raises:
        NotFoundError: when the item does not exist.
    """
    result = await session.execute(select(ExampleItem).where(ExampleItem.id == item_id))
    item = result.scalar_one_or_none()
    if item is None:
        raise NotFoundError(f"ExampleItem {item_id} not found")
    return item


async def create_item(session: AsyncSession, data: ExampleItemCreate) -> ExampleItem:
    """Persist a new ExampleItem and return the created instance."""
    item = ExampleItem(title=data.title, body=data.body)
    session.add(item)
    await session.flush()  # populate id without committing (commit is in get_session)
    await session.refresh(item)
    logger.info("Created ExampleItem id=%d", item.id)
    return item
{% else %}
def list_items(session: Session) -> list[ExampleItem]:
    """Return all ExampleItems ordered by id."""
    return list(session.execute(select(ExampleItem).order_by(ExampleItem.id)).scalars().all())


def get_item(session: Session, item_id: int) -> ExampleItem:
    """Return a single ExampleItem by id.

    Raises:
        NotFoundError: when the item does not exist.
    """
    item = session.execute(select(ExampleItem).where(ExampleItem.id == item_id)).scalar_one_or_none()
    if item is None:
        raise NotFoundError(f"ExampleItem {item_id} not found")
    return item


def create_item(session: Session, data: ExampleItemCreate) -> ExampleItem:
    """Persist a new ExampleItem and return the created instance."""
    item = ExampleItem(title=data.title, body=data.body)
    session.add(item)
    session.flush()
    session.refresh(item)
    logger.info("Created ExampleItem id=%d", item.id)
    return item
{% endif -%}
