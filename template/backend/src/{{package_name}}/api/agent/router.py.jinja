logger = logging.getLogger(__name__)

#: What one question may carry, as the composer allows it (`@poodle64/librarian`'s `attachments.ts`).
ATTACHMENTS = 10
ATTACHMENT_BYTES = 20 * 2**20
#: All of a question's files together, as the proxy in front of the app caps the body.
ATTACHMENTS_BYTES = 50 * 2**20
#: A body past its files by this much (the form's fields, each part's headers) is refused unread.
BODY_OVERHEAD = 2**20
#: The file types the composer offers and the persona can read: images and PDFs as they are, Word as text, plain text.
ATTACHMENT_TYPES = (".png", ".jpg", ".jpeg", ".webp", ".pdf", ".docx", ".txt", ".md")
#: A form's fields: the question, `resume`, `kind`, `collection` and `edit`, with room over.
FORM_FIELDS = 10

router = APIRouter()


@dataclasses.dataclass(frozen=True, slots=True)
class Owned:
    conversation: AgentConversation
    persona: Persona


def entered(persona: str, identity: CurrentIdentity, settings: SettingsDep) -> Persona:
    """The persona `persona`, for a caller granted `chat-<persona>`."""
    require_module(f"chat-{persona}")(identity)
    return chat.get(settings.agent, persona)


def owned(conversation_id: str, identity: CurrentIdentity, settings: SettingsDep, db: SessionDep) -> Owned:
    """This person's conversation, with a persona they are still granted."""
    conversation = conversations.owned(db, conversation_id, identity.user.id)
    if conversation is None:
        raise NotFoundError(ask_module.DENIAL)
    return Owned(conversation, entered(conversation.persona, identity, settings))


def watching(persona: str, identity: CurrentIdentity) -> Identity:
    return require_module(f"agent-{persona}")(identity)


gate(entered, "chat-{persona}")
gate(owned, "chat-{conversation.persona}")
gate(watching, "agent-{persona}")
EnteredPersona = Annotated[Persona, Depends(entered)]
OwnedConversation = Annotated[Owned, Depends(owned)]


def shared(persona: EnteredPersona, conversation_id: str, turn: int, db: SessionDep) -> Owned:
    """A conversation with this persona whose answer `turn` its asker shared; one answer for any other."""
    conversation = db.get(AgentConversation, conversation_id)
    if conversation is None or conversation.persona != persona.id or turn not in conversation.shared:
        raise NotFoundError("That answer is not shared")
    return Owned(conversation, persona)


SharedAnswer = Annotated[Owned, Depends(shared)]


@router.get("/personas", operation_id="listPersonas")
def list_personas(identity: CurrentIdentity, settings: SettingsDep) -> list[PersonaRead]:
    """The personas this app offers for chat that this caller is granted; none when the app offers none."""
    return [
        PersonaRead(
            id=persona.id,
            name=persona.name,
            blurb=persona.blurb,
            examples=list(persona.examples),
            not_held=persona.not_held,
            collections=persona.collections,
            visuals=list(persona.visuals),
            attachments=persona.attachments,
        )
        for persona in chat.load(settings.agent).values()
        if has_module(identity.entitlements, persona.entitlement)
    ]


@router.get("/conversations/{conversation_id}", operation_id="getConversation")
async def read(owned: OwnedConversation, settings: SettingsDep, asking: CurrentAsking) -> ConversationRead:
    """The conversation, every question asked, each with the answer the agent holds."""
    turns = await _turns(owned, settings, asking)
    return ConversationRead(
        **_summary(owned.conversation).model_dump(),
        turns=[_stored(owned.conversation, turns, position) for position in range(len(turns))],
    )


@router.patch("/conversations/{conversation_id}", operation_id="renameConversation")
def rename(owned: OwnedConversation, body: RenameRequest, db: SessionDep) -> ConversationSummary:
    owned.conversation.title = body.title.strip()
    db.commit()
    return _summary(owned.conversation)


@router.delete("/conversations/{conversation_id}", operation_id="deleteConversation", status_code=204)
async def delete(owned: OwnedConversation, settings: SettingsDep, db: SessionDep) -> None:
    """Forget the conversation: the agent's transcript and files first, then the row, so a failure leaves it listed."""
    if not await retention.erase(db, settings.agent, [owned.conversation]):
        raise ServiceUnavailableError("That conversation could not be deleted just now")


@router.get("/conversations/{conversation_id}/export", operation_id="exportConversation")
async def export(owned: OwnedConversation, settings: SettingsDep, asking: CurrentAsking) -> Response:
    """The conversation as Markdown, as a file to keep."""
    text = conversations.markdown(
        owned.conversation.title,
        owned.persona.name,
        await _turns(owned, settings, asking),
        ZoneInfo(settings.agent.quota_timezone),
    )
    name = urllib.parse.quote(f"{owned.conversation.title[:60].strip() or 'Conversation'}.md")
    return Response(
        text,
        media_type="text/markdown; charset=utf-8",
        headers={"Content-Disposition": f"attachment; filename*=UTF-8''{name}"},
    )


@router.get("/conversations/{conversation_id}/artefact", operation_id="getArtefact")
async def artefact(
    owned: OwnedConversation,
    name: str,
    version: int,
    settings: SettingsDep,
    asking: CurrentAsking,
    format: Literal["source", "docx", "pdf"] = "source",
) -> Response:
    """A version of a document the agent wrote, as a file: as it was written, or rendered in the persona's brand.

    HTML is served to be saved, never rendered in this app's origin.
    """
    session = owned.conversation.session_id
    found = (
        await (await chat.agent(settings.agent, owned.persona, asking)).artefact(session, name, version)
        if session
        else None
    )
    if found is None:
        raise NotFoundError("No such document")
    content, media_type = found
    stem = PurePosixPath(name).name
    if format != "source":
        if not documents.available():
            raise NotFoundError("Word and PDF are not made here")
        try:
            content = await run_in_threadpool(
                documents.render, content, media_type, format, chat.documents(settings.agent, owned.persona)
            )
        except documents.Unrenderable as exc:
            logger.exception("Could not render %s as %s", name, format)
            raise ValidationError("That document could not be made in that format") from exc
        media_type, stem = documents.FORMATS[format], f"{PurePosixPath(stem).stem}.{format}"
    headers = {"Content-Disposition": f"attachment; filename*=UTF-8''{urllib.parse.quote(stem)}"}
    if media_type == "text/html":
        headers["Content-Security-Policy"] = "sandbox"
    return Response(content, media_type=media_type, headers=headers)


@router.post("/conversations/{conversation_id}/stop", operation_id="stopConversation", status_code=204)
def stop(owned: OwnedConversation, db: SessionDep) -> None:
    """End the answer being written, from whichever worker holds it. Nothing when none is."""
    conversations.request_stop(db, owned.conversation)


@router.put("/conversations/{conversation_id}/turns/{turn}/mark", operation_id="markAnswer", status_code=204)
async def mark(
    owned: OwnedConversation, turn: int, body: MarkRequest, settings: SettingsDep, db: SessionDep, asking: CurrentAsking
) -> None:
    """Mark answer `turn` (its place in the conversation as read) helpful or not; a second mark replaces the first.

    The app keeps the mark on the turn's own record. A settled answer only:
    one the agent holds, and not the one still being written.
    """
    await _settled_answer(owned, turn, settings, asking)
    await run_in_threadpool(
        conversations.mark, db, owned.conversation, turn, helpful=body.helpful, note=(body.note or "").strip() or None
    )


@router.put("/conversations/{conversation_id}/turns/{turn}/share", operation_id="shareAnswer")
async def share(
    owned: OwnedConversation, turn: int, settings: SettingsDep, db: SessionDep, asking: CurrentAsking
) -> StoredTurn:
    """Share answer `turn` read-only with whoever may chat with this persona; nothing is shared until asked.

    A settled answer only: one the agent holds, and not the one still being
    written. Its `shared` is the page that reads it.
    """
    turns = await _settled_answer(owned, turn, settings, asking)
    await run_in_threadpool(conversations.share, db, owned.conversation, turn, shared=True)
    return _stored(owned.conversation, turns, turn)


@router.delete("/conversations/{conversation_id}/turns/{turn}/share", operation_id="unshareAnswer", status_code=204)
def unshare(owned: OwnedConversation, turn: int, db: SessionDep) -> None:
    """Stop sharing answer `turn`: its link answers as one never shared."""
    conversations.share(db, owned.conversation, turn, shared=False)


@router.get("/quota", operation_id="getAgentQuota")
def get_quota(identity: CurrentIdentity, settings: SettingsDep, db: SessionDep) -> QuotaRead:
    """Today's allowance across every persona."""
    allowance = quota.allowance(db, settings.agent, identity.user.id, exempt=has_module(identity.entitlements, "admin"))
    return QuotaRead(**dataclasses.asdict(allowance), support_url=settings.agent.support_url or None)


@router.get("/{persona}/collections", operation_id="listCollections")
async def list_collections(
    persona: EnteredPersona, settings: SettingsDep, asking: CurrentAsking
) -> list[CollectionRead]:
    """The collections this person may read, as the library lists them; none for a persona that chats without any."""
    if not persona.collections:
        return []
    listed = chat.held_listing(settings.agent, asking)
    if listed is None:
        listed = await _read((await chat.collections(settings.agent, persona, asking)).list())
    return [
        CollectionRead(
            name=found.name,
            title=found.title,
            description=found.description,
            short_title=found.short_title,
            subject=SubjectRead(name=found.subject.name, title=found.subject.title) if found.subject else None,
            documents_to=found.documents_to,
        )
        for found in listed
    ]


def _person(request: Request) -> str:
    """The rate limit's key for an ask: the person, who the proxy has already authenticated; the address otherwise."""
    return request.headers.get("x-authentik-uid") or (request.client.host if request.client else "unknown")


def _ask_rate() -> str:
    return get_settings().agent.ask_rate_limit


@router.post("/{persona}/ask", operation_id="askPersona")
@limiter.limit(_ask_rate, key_func=_person)
async def ask(
    persona: EnteredPersona, request: Request, identity: CurrentIdentity, settings: SettingsDep, asking: CurrentAsking
) -> StreamingResponse:
    """Ask the persona, streaming its events; JSON, or multipart with `files[]`.

    The stream opens by naming the conversation. A persona that chats with
    collections then sends a `citations` frame before its own events; a
    `collection` the library does not list for this person ends the turn
    with an `agent_error` frame, unasked and uncharged. Refused before it
    opens: 404 for a `resume` that is not this person's conversation with
    this persona, or any `collection` for a persona that reads none; 409
    while that conversation is being answered; 429 once today's allowance
    is spent or this person asks too often; 503 with `Retry-After` while
    the ceiling on turns in flight is reached. Attachments are refused
    unread: 413 for a body or a file too large, 415 for a type not read,
    400 for too many. Read, they are then checked by their bytes (`content`):
    415 for a file that is not what its name says, 422 for one the
    scanner names, 503 when a scanner is configured and cannot answer. A
    persona that takes none (`attachments: false`) refuses any multipart body
    unread, 400.
    """
    if not persona.attachments and request.headers.get("content-type", "").startswith("multipart/form-data"):
        raise BadRequestError(f"{persona.name} takes no attachments")
    body, files = await _asked(request, settings.agent)
    agent, collections = await chat.for_turn(
        settings.agent, persona, asking, model=chat.model_for(persona, identity.entitlements)
    )
    return await ask_module.ask(
        get_session_factory(),
        settings.agent,
        persona,
        agent,
        collections,
        user_id=identity.user.id,
        exempt=has_module(identity.entitlements, "admin"),
        question=body.question,
        resume=body.resume,
        kind=body.kind,
        collection=body.collection,
        group=body.group,
        files=files,
        edit=body.edit,
    )


@router.get("/{persona}/conversations", operation_id="listConversations")
def list_conversations(persona: EnteredPersona, identity: CurrentIdentity, db: SessionDep) -> list[ConversationSummary]:
    """This person's conversations with the persona, most recently active first."""
    return [_summary(conversation) for conversation in conversations.listed(db, identity.user.id, persona.id)]


@router.delete("/{persona}/conversations", operation_id="clearConversations", status_code=204)
async def clear_conversations(
    persona: EnteredPersona, identity: CurrentIdentity, settings: SettingsDep, db: SessionDep
) -> None:
    """Forget every one of this person's conversations with the persona, as `delete` forgets one.

    Only the caller's own, and never one still being answered: its turn is
    writing to it, and it stays listed until it settles.
    """
    listed = await run_in_threadpool(conversations.listed, db, identity.user.id, persona.id)
    await retention.erase(db, settings.agent, [row for row in listed if conversations.answering(row) is None])


@router.get("/{persona}/documents/{document_id}", operation_id="getDocument")
async def document(
    persona: EnteredPersona, document_id: int, settings: SettingsDep, asking: CurrentAsking
) -> DocumentRead:
    """A document the persona cited, section by section; absent when the library has none this person may read."""
    found = (
        await _read((await chat.collections(settings.agent, persona, asking)).document(document_id))
        if persona.collections
        else None
    )
    if found is None:
        raise NotFoundError("No such document")
    return DocumentRead.model_validate(dataclasses.asdict(found))


@router.get("/{persona}/answers/{conversation_id}/{turn}", operation_id="readSharedAnswer")
async def read_shared(answer: SharedAnswer, turn: int, settings: SettingsDep, asking: CurrentAsking) -> StoredTurn:
    """A shared answer, read-only: the question, the answer and its sources."""
    turns = await _turns(answer, settings, asking)
    if turn >= len(turns) or turns[turn].agent_index is None:
        raise NotFoundError("That answer is not shared")
    return _stored(answer.conversation, turns, turn)


@router.get("/{persona}/jobs/{job_id}/watch", operation_id="watchAgentJob", dependencies=[Depends(watching)])
async def watch_job(persona: str, job_id: str, workspace: CurrentWorkspace) -> StreamingResponse:
    """Watch `job_id`'s events from the first, then follow them until its run settles, from any worker.

    The same frames a chat's ask streams, so `@poodle64/librarian` renders
    either with one code path.

    Raises:
        NotFoundError: no such job, or it belongs to a different workspace
            or persona (`jobs.authorize`, one answer for all three, checked
            before the stream opens).
    """
    db_session_factory = get_session_factory()
    await jobs_module.authorize(db_session_factory, job_id, workspace.id, persona)

    async def frames() -> AsyncIterator[str]:
        async for event in jobs_module.watch(db_session_factory, job_id, workspace_id=workspace.id):
            yield sse.frame(event)

    return StreamingResponse(frames(), media_type=sse.MEDIA_TYPE, headers=sse.HEADERS)


@router.post(
    "/{persona}/jobs/{job_id}/message",
    operation_id="messageAgentJob",
    status_code=204,
    dependencies=[Depends(watching)],
)
async def message_job(
    persona: str,
    job_id: str,
    identity: CurrentIdentity,
    workspace: CurrentWorkspace,
    settings: SettingsDep,
    request: AgentJobMessageRequest,
) -> None:
    """Send `request.text` to `job_id`: onto its stdin while it works, a resumed run once it has finished."""
    db_session_factory = get_session_factory()
    await jobs_module.authorize(db_session_factory, job_id, workspace.id, persona)
    config = persona_module.load(settings.agent, persona)
    await jobs_module.send_message(
        db_session_factory,
        settings.agent,
        config,
        job_id,
        request.text,
        workspace_id=workspace.id,
        user_id=identity.user.id,
    )


@router.post(
    "/{persona}/jobs/{job_id}/stop", operation_id="stopAgentJob", status_code=204, dependencies=[Depends(watching)]
)
async def stop_job(persona: str, job_id: str, workspace: CurrentWorkspace) -> None:
    """Stop `job_id`. A no-op once it has already finished on its own."""
    db_session_factory = get_session_factory()
    await jobs_module.authorize(db_session_factory, job_id, workspace.id, persona)
    await jobs_module.stop(db_session_factory, job_id, workspace_id=workspace.id)


def _summary(conversation: AgentConversation) -> ConversationSummary:
    return ConversationSummary(
        id=conversation.id,
        title=conversation.title,
        last_activity_at=conversation.last_activity_at,
        answering_since=conversations.answering(conversation),
    )


def _stored(conversation: AgentConversation, turns: list[conversations.Turn], position: int) -> StoredTurn:
    t = turns[position]
    address = f"/chat/{conversation.persona}/answers/{conversation.id}/{position}"
    return StoredTurn(
        question=t.question,
        answer=t.answer,
        at=t.at,
        citations=t.citations,
        kind=t.kind,
        collection=t.collection,
        group=t.group,
        mark=MarkRead.model_validate(t.mark) if t.mark else None,
        shared=address if position in conversation.shared else None,
        files=t.files,
        artefacts=[ArtefactRead.model_validate(made) for made in t.artefacts],
        steps=[StepRead.model_validate(dataclasses.asdict(step)) for step in t.steps],
    )


async def _turns(owned: Owned, settings: SettingsDep, asking: Asking) -> list[conversations.Turn]:
    session = owned.conversation.session_id
    held = await (await chat.agent(settings.agent, owned.persona, asking)).read(session) if session else None
    return conversations.merged(owned.conversation, held or [])


async def _settled_answer(owned: Owned, turn: int, settings: SettingsDep, asking: Asking) -> list[conversations.Turn]:
    """The conversation's turns, once `turn` is one the agent has answered and is no longer writing.

    Raises:
        NotFoundError: there is no such answer yet.
    """
    turns = await _turns(owned, settings, asking)
    writing = turn == len(turns) - 1 and conversations.answering(owned.conversation) is not None
    if not 0 <= turn < len(turns) or turns[turn].agent_index is None or writing:
        raise NotFoundError("No such answer")
    return turns


async def _read[T](read: Awaitable[T]) -> T:
    """Await a read of the library, whose failure of any kind is one 503 and not this app's 500."""
    try:
        return await read
    except Exception as exc:
        logger.exception("Could not read the collections")
        raise ServiceUnavailableError("The collections could not be read") from exc


def _unique(name: str, taken: dict[str, bytes]) -> str:
    """`name`, or `name (2)` and on, where an earlier file of the question took it."""
    stem, dot, suffix = name.rpartition(".") if "." in name.strip(".") else (name, "", "")
    found, n = name, 1
    while found in taken:
        n += 1
        found = f"{stem} ({n}){dot}{suffix}"
    return found


async def _asked(request: Request, settings: AgentSettings) -> tuple[AskRequest, dict[str, bytes]]:
    """The question, as JSON or as multipart with its attachments, refused unread when over what a question may carry."""
    multipart = request.headers.get("content-type", "").startswith("multipart/form-data")
    cap = ATTACHMENTS_BYTES + BODY_OVERHEAD if multipart else BODY_OVERHEAD
    declared = request.headers.get("content-length", "")
    if declared.isdigit() and int(declared) > cap:
        raise PayloadTooLargeError(f"That is more than a question may carry: {cap // 2**20} MB in all")
    request = _capped(request, cap)
    try:
        if multipart:
            try:
                # Parsed to disk, and bounded in parts as in bytes; one file over ATTACHMENTS lets the count be ours to refuse.
                form = await request.form(max_files=ATTACHMENTS + 1, max_fields=FORM_FIELDS)
            except HTTPException as exc:
                raise BadRequestError(
                    f"Attach at most {ATTACHMENTS} files" if "files" in str(exc.detail) else str(exc.detail)
                ) from exc
            try:
                body = AskRequest.model_validate(
                    {
                        "question": str(form.get("question") or ""),
                        "resume": str(form.get("resume") or "") or None,
                        "kind": str(form.get("kind") or "") or None,
                        "collection": str(form.get("collection") or "") or None,
                        "group": str(form.get("group") or "") or None,
                        "edit": str(form.get("edit") or "") or None,
                    }
                )
                # Starlette's class, which a parsed form yields: none is an instance of FastAPI's subclass.
                uploads = [upload for upload in form.getlist("files[]") if isinstance(upload, UploadFile)]
                _checked(uploads)
                files: dict[str, bytes] = {}
                for upload in uploads:
                    files[_unique(upload.filename or "attachment", files)] = await upload.read()
                await content.checked(settings, files)
                return body, files
            finally:
                await form.close()
        return AskRequest.model_validate(await request.json()), {}
    except pydantic.ValidationError as exc:
        raise RequestValidationError(exc.errors()) from exc
    except ValueError as exc:  # a body that is not JSON at all
        raise RequestValidationError([{"type": "json_invalid", "loc": ("body",), "msg": str(exc)}]) from exc


def _capped(request: Request, cap: int) -> Request:
    """`request` whose body is refused once it runs past `cap` bytes, whatever its Content-Length said (or omitted)."""
    seen = 0

    async def receive() -> Message:
        nonlocal seen
        message = await request.receive()
        seen += len(message.get("body", b""))
        if seen > cap:
            raise PayloadTooLargeError(f"That is more than a question may carry: {cap // 2**20} MB in all")
        return message

    return Request(request.scope, receive)


def _checked(uploads: list[UploadFile]) -> None:
    """Refuse the files a question may not carry, by what the parser has spooled and before any is read into memory."""
    if len(uploads) > ATTACHMENTS:
        raise BadRequestError(f"Attach at most {ATTACHMENTS} files")
    for upload in uploads:
        filename = upload.filename or "attachment"
        name = filename[:100]
        if PurePosixPath(filename.lower()).suffix not in ATTACHMENT_TYPES:
            raise UnsupportedMediaTypeError(
                f"{name} is not a type that can be read; attach {', '.join(ATTACHMENT_TYPES)}"
            )
        if (upload.size or 0) > ATTACHMENT_BYTES:
            raise PayloadTooLargeError(f"{name} is over {ATTACHMENT_BYTES // 2**20} MB")
    if sum(upload.size or 0 for upload in uploads) > ATTACHMENTS_BYTES:
        raise PayloadTooLargeError(f"Those files are over {ATTACHMENTS_BYTES // 2**20} MB together")
