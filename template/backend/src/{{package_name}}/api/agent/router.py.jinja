"""The agent slice: list personas, ask one, and watch/message/stop an
app-started job (`docs/design/agent-jobs.md`).

`POST /{persona}/ask` is gated on a per-persona module entitlement
(`agent-<persona>`) rather than a router-level dependency, because the module
name is not known until the path parameter is: `require_module` is called
directly as the plain function it already is, inside the route, instead of
through `Depends()` (`entitlements.py`'s own factory shape covers both). The
three job routes below take the same gate, AND `CurrentWorkspace`: a job acts
on behalf of a workspace as much as a persona entitlement, and
`jobs.authorize()` is what actually enforces the second half — the
entitlement alone would let anyone holding it read or steer another
workspace's job (fresh-context review, CRITICAL 1).

There is no `POST /{persona}/jobs` here — starting a job is need 1's own
point ("started by the app itself, with no person asking"): `jobs.start()`
is a plain function app code calls from wherever a job's own trigger lives
(a document arriving, a scheduled sweep), never a route a person calls. What
IS a person's is watching, messaging and stopping one already running.
"""

import json
from collections.abc import AsyncIterator

from fastapi import APIRouter
from fastapi.responses import StreamingResponse

from {{ package_name }}.api.agent import ask as ask_module
from {{ package_name }}.api.agent import jobs as jobs_module
from {{ package_name }}.api.agent import persona as persona_module
from {{ package_name }}.api.agent.schemas import AgentJobMessageRequest, AskRequest
from {{ package_name }}.db.session import get_session_factory
from {{ package_name }}.deps import CurrentIdentity, CurrentWorkspace, SessionDep, SettingsDep
from {{ package_name }}.entitlements import has_module, require_module

router = APIRouter()


@router.get("/personas", operation_id="listAgentPersonas")
async def personas(identity: CurrentIdentity, settings: SettingsDep) -> list[str]:
    """Personas this deployment carries AND this caller is entitled to ask.

    An app with no persona directory returns an empty list here, which is
    what tells the Console to render nothing rather than a chat that fails on
    the first question.
    """
    names = persona_module.list_personas(settings.agent)
    return [name for name in names if has_module(identity.entitlements, f"agent-{name}")]


@router.post("/{persona}/ask", operation_id="askAgent")
async def ask(
    persona: str, db: SessionDep, identity: CurrentIdentity, settings: SettingsDep, request: AskRequest
) -> StreamingResponse:
    """Ask `persona`, bounded by the caller's own entitlement for it.

    Raises:
        NotFoundError: `persona` names no directory under `config/personas/`.
    """
    require_module(f"agent-{persona}")(identity)
    config = persona_module.load(settings.agent, persona)
    return ask_module.stream(db, settings.agent, config, request, user_id=identity.user.id)


@router.get("/{persona}/jobs/{job_id}/watch", operation_id="watchAgentJob")
async def watch_job(
    persona: str, job_id: str, identity: CurrentIdentity, workspace: CurrentWorkspace, settings: SettingsDep
) -> StreamingResponse:
    """Watch `job_id`'s events from the first, live if it is still running (need 3).

    The SAME frame shape `ask`'s stream produces — one Claude Code event per
    frame, no `event:` name, `library_error` the one synthetic addition — so
    `@poodle64/librarian`'s transcript renderer needs no second code path for
    a job it opens instead of a chat turn.

    Raises:
        NotFoundError: no such job, or it belongs to a different workspace
            (`jobs.authorize`, one answer for both — checked before the
            stream opens, so a bad or foreign id 404s rather than opening an
            SSE response with nothing in it).
    """
    require_module(f"agent-{persona}")(identity)
    db_session_factory = get_session_factory()
    await jobs_module.authorize(db_session_factory, job_id, workspace.id)

    async def frames() -> AsyncIterator[str]:
        async for event in jobs_module.watch(db_session_factory, job_id, workspace_id=workspace.id):
            yield f"data: {json.dumps(event)}\n\n"

    return StreamingResponse(
        frames(), media_type="text/event-stream", headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"}
    )


@router.post("/{persona}/jobs/{job_id}/message", operation_id="messageAgentJob", status_code=204)
async def message_job(
    persona: str,
    job_id: str,
    identity: CurrentIdentity,
    workspace: CurrentWorkspace,
    settings: SettingsDep,
    request: AgentJobMessageRequest,
) -> None:
    """Send `request.text` to `job_id` (need 4): onto its stdin if it is still working, a resumed run if it has finished."""
    require_module(f"agent-{persona}")(identity)
    db_session_factory = get_session_factory()
    await jobs_module.authorize(db_session_factory, job_id, workspace.id)
    config = persona_module.load(settings.agent, persona)
    await jobs_module.send_message(
        db_session_factory,
        settings.agent,
        config,
        job_id,
        request.text,
        workspace_id=workspace.id,
        user_id=identity.user.id,
    )


@router.post("/{persona}/jobs/{job_id}/stop", operation_id="stopAgentJob", status_code=204)
async def stop_job(
    persona: str, job_id: str, identity: CurrentIdentity, workspace: CurrentWorkspace, settings: SettingsDep
) -> None:
    """Stop `job_id` (need 5). A no-op once it has already finished on its own."""
    require_module(f"agent-{persona}")(identity)
    await jobs_module.authorize(get_session_factory(), job_id, workspace.id)
    await jobs_module.stop(job_id)
