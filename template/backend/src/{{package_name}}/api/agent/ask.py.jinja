logger = logging.getLogger(__name__)

#: Taken for the length of a claim, so counting the turns in flight and stamping one is a single step across workers.
TURNS_LOCK = 0x7475726E73

#: What the next ask is told to wait, when the ceiling on turns in flight is reached.
BUSY_RETRY_SECONDS = 15

#: How often the task holding a turn looks for a stop.
STOP_POLL_SECONDS = 1.0

#: The longest a citation's quoted snippet runs, in characters.
SNIPPET_CHARACTERS = 300

#: What a turn says when the library could not be read.
COLLECTIONS_UNREAD = "the collections could not be read"

#: What a persona that reads no collections says when a question names one.
NO_COLLECTION = "No such collection"

#: What a turn says when its question names a collection the library does not list for this person.
NOT_LISTED = "that collection is not one you can read"

#: One answer for a conversation that is another person's and one that never
#: existed: telling them apart is itself a disclosure.
DENIAL = "That conversation is not one you can continue; ask again without it to start a new one"

#: What an edit of a question the conversation does not hold says.
NO_SUCH_QUESTION = "That question is not one you can edit"

_turns: set[asyncio.Task[None]] = set()


@dataclass(frozen=True, slots=True)
class _Turn:
    persona: Persona
    agent: Agent
    #: The library as the person asking, for a persona that chats with collections.
    collections: Collections | None
    conversation_id: str
    #: The question's place in the conversation's record.
    position: int
    question: str
    #: The agent's own session, to resume; None for the first question.
    resume: str | None
    files: dict[str, bytes]
    user_id: uuid.UUID
    charged: bool
    #: The one collection the question is narrowed to; None asks across every one the person may read.
    collection: str | None
    #: Whether the conversation has an earlier question: a follow-up, searched on its own words.
    follow_up: bool
    #: The documents the previous turn cited, which a follow-up may lean on though its own search misses them.
    earlier: tuple[int, ...]
    #: The place of the question an edited one replaces; `position` is where it waits until the agent takes it.
    edit: int | None = None
    #: For an edited question, how many of the agent's answers it is asked after; none starts a new session.
    keep: int = 0


@dataclass(slots=True)
class _Place:
    """Where the turn's question is in the record: it moves when an edit is taken, and goes when one is not."""

    position: int | None


class _Unread(Exception):
    """The collections could not be read for this turn; `str()` is what the turn says."""


async def ask(
    db_session_factory: sessionmaker[Session],
    settings: AgentSettings,
    persona: Persona,
    agent: Agent,
    collections: Collections | None,
    *,
    user_id: uuid.UUID,
    exempt: bool,
    question: str,
    resume: str | None,
    files: dict[str, bytes],
    kind: str | None = None,
    collection: str | None = None,
    edit: int | None = None,
) -> StreamingResponse:
    """Stamp the conversation answering, start its turn, and stream it; `edit` replaces the question at that place.

    Raises:
        NotFoundError: `resume` is not one of this person's conversations with
            this persona, or `collection` names one for a persona that reads none,
            or `edit` names no question of it.
        ConflictError: that conversation is already being answered.
        AllowanceSpentError: today's allowance is spent.
        BusyError: as many turns are in flight, on every worker, as the ceiling allows.
    """
    if collection is not None and collections is None:
        raise NotFoundError(NO_COLLECTION)
    question = await run_in_threadpool(redact, persona.id, user_id, question)
    keep = await _kept(db_session_factory, agent, persona, user_id, resume, edit) if edit is not None else 0

    def begin() -> conversations.AgentConversation:
        with db_session_factory() as db:
            conversation = conversations.owned(db, resume, user_id) if resume else None
            if resume and (conversation is None or conversation.persona != persona.id):
                raise NotFoundError(DENIAL)
            if edit is not None and (conversation is None or edit >= len(conversation.turns)):
                raise NotFoundError(NO_SUCH_QUESTION)
            if conversation is not None and conversations.answering(conversation) is not None:
                raise ConflictError("That conversation is still being answered")
            allowance = quota.allowance(db, settings, user_id, exempt=exempt)
            if allowance.reached:
                raise AllowanceSpentError(
                    "Today's questions are used up; there are more tomorrow",
                    retry_after=max(1, math.ceil((allowance.resets_at - conversations.now()).total_seconds())),
                )
            if settings.max_concurrent_turns:
                db.execute(select(func.pg_advisory_xact_lock(TURNS_LOCK)))  # released by `begin`'s commit
                if conversations.in_flight(db) >= settings.max_concurrent_turns:
                    raise BusyError(
                        "The assistant is busy answering other people; try again shortly",
                        retry_after=BUSY_RETRY_SECONDS,
                    )
            started = conversations.begin(
                db,
                user_id=user_id,
                persona=persona.id,
                question=question,
                conversation=conversation,
                kind=kind,
                collection=collection,
                files=[Path(name).name or "attachment" for name in files],
                edit=edit,
            )
            if started is None:
                raise ConflictError("That conversation is still being answered")
            return started

    started = await run_in_threadpool(begin)
    position = len(started.turns) - 1
    place = position if edit is None else edit
    turn = _Turn(
        persona=persona,
        agent=agent,
        collections=collections,
        conversation_id=started.id,
        position=position,
        question=question,
        resume=started.session_id if edit is None or keep else None,
        files=files,
        user_id=user_id,
        charged=not exempt,
        collection=collection,
        follow_up=bool(place),
        earlier=_cited(started.turns[place - 1], collection) if place else (),
        edit=edit,
        keep=keep,
    )
    listening: list[asyncio.Queue[dict[str, Any] | None]] = [asyncio.Queue()]
    task = asyncio.create_task(_run(db_session_factory, settings, turn, listening), name=f"agent-turn-{started.id}")
    _turns.add(task)
    task.add_done_callback(_turns.discard)
    task.add_done_callback(_log_failure)

    async def frames() -> AsyncIterator[str]:
        queue = listening[0]
        yield sse.frame({"type": "system", "subtype": "init", "session_id": started.id})
        try:
            while (event := await queue.get()) is not None:
                yield sse.frame(event)
        finally:
            # The asker left; the turn goes on without them.
            listening.clear()

    return StreamingResponse(frames(), media_type=sse.MEDIA_TYPE, headers=sse.HEADERS)


async def shutdown() -> None:
    """End every turn this worker holds, settling each, before the worker exits."""
    loop = asyncio.get_running_loop()
    ours = {task for task in _turns if task.get_loop() is loop}
    for task in ours:
        task.cancel()
    if ours:
        await asyncio.wait(ours, timeout=10)


async def _run(
    db_session_factory: sessionmaker[Session],
    settings: AgentSettings,
    turn: _Turn,
    listening: list[asyncio.Queue[dict[str, Any] | None]],
) -> None:
    def emit(event: dict[str, Any] | None) -> None:
        for queue in listening:
            queue.put_nowait(event)

    async def db[T](work: Callable[[Session], T]) -> T:
        return await _in_db(db_session_factory, work)

    place = _Place(turn.position)
    answering = asyncio.create_task(_answer(db_session_factory, settings, turn, emit, place))
    try:
        beat = time.monotonic()
        while not answering.done():
            await asyncio.wait({answering}, timeout=STOP_POLL_SECONDS)
            if answering.done():
                break
            if time.monotonic() - beat >= conversations.HEARTBEAT_SECONDS:
                beat = time.monotonic()
                stop = await db(lambda s: conversations.beat(s, turn.conversation_id))
            else:
                stop = await db(lambda s: conversations.stop_wanted(s, turn.conversation_id))
            if stop:
                answering.cancel()
                break
    finally:
        if not answering.done():
            answering.cancel()
        with contextlib.suppress(asyncio.CancelledError):
            await answering
        await db(lambda s: conversations.settle(s, turn.conversation_id))
        emit(None)
        if place.position is not None:
            await _settled(turn, place.position)


async def _in_db[T](db_session_factory: sessionmaker[Session], work: Callable[[Session], T]) -> T:
    def run() -> T:
        with db_session_factory() as db:
            return work(db)

    return await run_in_threadpool(run)


async def _answer(
    db_session_factory: sessionmaker[Session],
    settings: AgentSettings,
    turn: _Turn,
    emit: Callable[[dict[str, Any] | None], None],
    place: _Place,
) -> None:
    """Ask the agent and pass on each event; claim, charge and record the answer as they happen.

    An edited question takes its place when the agent takes it, and leaves
    the record if the agent never does.
    """

    async def db(work: Callable[[Session], object]) -> None:
        await _in_db(db_session_factory, work)

    accepted = held = False
    passages = asyncio.create_task(_passages(settings, turn, emit, db)) if turn.collections is not None else None
    try:
        asked = turn.agent.ask(
            turn.question, resume=turn.resume, files=turn.files or None, passages=passages, keep=turn.keep or None
        )
        async with contextlib.aclosing(asked) as events:
            async for event in events:
                if event.get("type") == "system" and event.get("subtype") == "init":
                    if not accepted and isinstance(event.get("session_id"), str):
                        accepted = True
                        session = str(event["session_id"])
                        replaced = await _in_db(db_session_factory, functools.partial(_accept, settings, turn, session))
                        place.position = turn.position if turn.edit is None else turn.edit
                        if replaced and replaced != session:
                            await turn.agent.forget(replaced)
                    event = {**event, "session_id": turn.conversation_id}
                answered_at = place.position
                if not held and _speaks(event) and answered_at is not None:
                    held = True
                    await db(functools.partial(_answered, turn, answered_at))
                if event.get("type") == ARTEFACT_EVENT and answered_at is not None:
                    made = {
                        key: event.get(key)
                        for key in ("name", "version", "media_type", "formats", "title", "kind", "changes", "pages")
                    }
                    await db(functools.partial(_made, turn, answered_at, made))
                rewritten = redact_event(turn.persona.id, event)
                if rewritten is not None:
                    emit(rewritten)
    except _Unread as unread:
        emit({"type": cli.ERROR_EVENT, "error": str(unread)})
    except Exception:
        logger.exception("Agent turn failed in conversation %s", turn.conversation_id)
        emit({"type": cli.ERROR_EVENT, "error": "the agent failed to answer"})
    finally:
        _settle(passages)
        if turn.edit is not None and not accepted:
            place.position = None
            await db(lambda s: conversations.withdraw(s, turn.conversation_id, turn.position))


async def _passages(
    settings: AgentSettings,
    turn: _Turn,
    emit: Callable[[dict[str, Any] | None], None],
    db: Callable[[Callable[[Session], object]], Awaitable[None]],
) -> str:
    """The passages block the persona answers from, once retrieved; the page has their citations first.

    A task beside the agent's start-up, which takes the block when it
    resolves (`LocalAgent.ask`). The block passes the app's `agent_turn`
    hook, as the question does.

    Raises:
        _Unread: the collections could not be read, or the question names one this person may not read.
    """
    found = await _retrieve(settings, turn)
    shown = redact_event(turn.persona.id, {"type": "citations", "items": _citations(found)})
    if shown is not None:
        emit(shown)
    items = shown.get("items") if shown else None
    await db(
        lambda s: conversations.cite(s, turn.conversation_id, turn.position, items if isinstance(items, list) else [])
    )
    block = passages_block(found, follow_up=turn.follow_up)
    return await run_in_threadpool(redact, turn.persona.id, turn.user_id, block)


async def _retrieve(settings: AgentSettings, turn: _Turn) -> list[Source]:
    """The documents that answer this question from the collections in scope, each with its passages.

    Across every collection the person may read, they are listed first and
    named: the library's search drops the person's cut when given no names.
    A question narrowed to one searches it while the listing confirms the
    person may read it, so neither waits on the other. A person who can read
    none searches nothing. A follow-up is searched on its own words, never
    glued to the question before it, which drags the search back to the last
    subject after the person has moved on. What the previous turn cited is
    opened beside the search, so "and in Brisbane?" still finds its row in the
    table just read; and the documents the search returned are opened too
    (`Collections.opened`), since their chunks may miss the row asked for.

    Raises:
        _Unread: as `_passages`.
    """
    assert turn.collections is not None
    reader = turn.collections
    query = turn.question
    searching = (
        asyncio.create_task(reader.search(query, [turn.collection], settings.passages))
        if turn.collection is not None
        else None
    )
    earlier = {document_id: asyncio.ensure_future(reader.document(document_id)) for document_id in turn.earlier}
    try:
        try:
            names = [found.name for found in await reader.list()]
            if searching is None:
                found = await reader.search(query, names, settings.passages) if names else []
            elif turn.collection not in names:
                raise _Unread(NOT_LISTED)
            else:
                found = await searching
            return await reader.opened(found, query, earlier=earlier)
        except _Unread:
            raise
        except Exception as exc:
            logger.exception("Could not read the collections for conversation %s", turn.conversation_id)
            raise _Unread(COLLECTIONS_UNREAD) from exc
    finally:
        _settle(searching)
        for task in earlier.values():
            _settle(task)


def _settle(task: asyncio.Task[Any] | None) -> None:
    """End a helper task this turn no longer waits on, and take any error it left so none is logged as unretrieved."""
    if task is None:
        return
    if not task.done():
        task.cancel()
    elif not task.cancelled():
        task.exception()


def _citations(sources: list[Source]) -> list[dict[str, Any]]:
    """The documents as the page cites them: a number to match `[n]` in the answer, and where each came from.

    One item per document, however many passages it gave: `section` names
    each of them, `snippet` opens with the first.
    """
    items = []
    for source in sources:
        shown = source.passages or source.excerpts
        items.append(
            {
                "n": source.n,
                "document_id": None if source.document_id is None else str(source.document_id),
                "title": source.title,
                "section": "; ".join(dict.fromkeys(p.locator for p in shown if p.locator)) or None,
                "snippet": " ".join(shown[0].text.split())[:SNIPPET_CHARACTERS] if shown else "",
            }
        )
    return items


def _cited(previous: dict[str, Any], collection: str | None) -> tuple[int, ...]:
    """The library documents a recorded turn cited, in its order, where this question's scope still holds them.

    A question across every collection holds whatever an earlier turn cited,
    as does one narrowed to the collection the earlier turn was narrowed to;
    a question narrowed anywhere else holds none, so the scope the person
    chose is never widened by what they read before.
    """
    if collection is not None and previous.get("collection") != collection:
        return ()
    ids = (item.get("document_id") for item in previous.get("citations") or [] if isinstance(item, dict))
    return tuple(dict.fromkeys(int(i) for i in ids if isinstance(i, str) and i.isdecimal()))


async def _kept(
    db_session_factory: sessionmaker[Session],
    agent: Agent,
    persona: Persona,
    user_id: uuid.UUID,
    resume: str | None,
    edit: int,
) -> int:
    """How many of the agent's answers come before question `edit`, counted against its transcript as the page reads it.

    Raises:
        NotFoundError: there is no such conversation of this person's, or no such question in it.
    """

    def found() -> conversations.AgentConversation:
        with db_session_factory() as db:
            conversation = conversations.owned(db, resume, user_id) if resume else None
            if conversation is None or conversation.persona != persona.id or edit >= len(conversation.turns):
                raise NotFoundError(NO_SUCH_QUESTION)
            return conversation

    conversation = await run_in_threadpool(found)
    held = await agent.read(conversation.session_id) if conversation.session_id else None
    return sum(turn.agent_index is not None for turn in conversations.merged(conversation, held or [])[:edit])


def _answered(turn: _Turn, position: int, db: Session) -> None:
    conversations.answered(db, turn.conversation_id, position)


def _made(turn: _Turn, position: int, artefact: dict[str, Any], db: Session) -> None:
    conversations.made(db, turn.conversation_id, position, artefact)


def _accept(settings: AgentSettings, turn: _Turn, session_id: str, db: Session) -> str | None:
    """The agent took the question: the conversation is its session's now, and the question is charged.

    An edited question takes its place, and a session it left behind is returned to be forgotten.
    """
    replaced = None
    if turn.edit is None:
        conversations.claim(db, turn.conversation_id, session_id)
    else:
        replaced = conversations.replace(
            db, turn.conversation_id, turn.position, turn.edit, None if turn.keep else session_id
        )
    if turn.charged:
        quota.charge(db, settings, turn.user_id)
    return replaced


def _speaks(event: dict[str, Any]) -> bool:
    """The agent said something a reader reads: its transcript now holds an answer to the question."""
    message = event.get("message") if event.get("type") == "assistant" else None
    content = message.get("content") if isinstance(message, dict) else None
    return isinstance(content, list) and any(
        isinstance(block, dict) and block.get("type") == "text" and str(block.get("text") or "").strip()
        for block in content
    )


async def _settled(turn: _Turn, position: int) -> None:
    """Call `app_hooks.agent_turn_settled(persona, conversation, turn)`, if this app defines one.

    `position` is the question's place as the page counts it, the same
    number an answer mark is addressed by. A hook that raises is logged,
    never re-raised: the turn has settled regardless.
    """
    from {{ package_name }} import app_hooks

    hook = getattr(app_hooks, "agent_turn_settled", None)
    if hook is None:
        return
    try:
        await run_in_threadpool(hook, turn.persona.id, turn.conversation_id, position)
    except Exception:
        logger.exception("app_hooks.agent_turn_settled failed for conversation %s", turn.conversation_id)


def _log_failure(task: asyncio.Task[None]) -> None:
    if not task.cancelled() and (exc := task.exception()) is not None:
        logger.error("Agent turn %s failed", task.get_name(), exc_info=exc)
