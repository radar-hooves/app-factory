"""Ask a persona, and stream Claude Code's own events verbatim.

For a chatbot the leak is not only in the citation: everything past ownership
is one straight line — spawn the CLI, forward its events, claim the session as
soon as its id is known — because there is nothing here to branch on. The
library's own version of this module additionally resolves a scoped view and
composes a per-question system prompt; a persona has neither (`persona.py`),
so this is the orchestration with both removed rather than a parallel one.
"""

import json
import uuid
from collections.abc import AsyncIterator

from fastapi.responses import StreamingResponse
from sqlalchemy.orm import Session
from starlette.concurrency import run_in_threadpool

from {{ package_name }}.api.agent import ownership
from {{ package_name }}.api.agent import session as agent_session
from {{ package_name }}.api.agent.persona import PersonaConfig
from {{ package_name }}.api.agent.redact import redact
from {{ package_name }}.api.agent.schemas import AskRequest
from {{ package_name }}.config.sections.agent import AgentSettings


class AskRefused(Exception):
    """Carries the message an error frame shows the asker; never raised past `stream`."""


def stream(
    db: Session,
    settings: AgentSettings,
    persona: PersonaConfig,
    request: AskRequest,
    *,
    user_id: uuid.UUID,
) -> StreamingResponse:
    """Ask `persona`, attributing the issued session to `user_id`.

    A required keyword because the caller — the route — is the only thing
    that knows whose identity resolved the request; this function stays
    ignorant of how that identity was established.
    """

    async def frames() -> AsyncIterator[str]:
        try:
            if request.resume and not await run_in_threadpool(ownership.may_resume, db, request.resume, user_id):
                # Here rather than in the route body: a status code that
                # distinguishes a real session from an absent one is an
                # enumeration oracle, and an error FRAME is what this surface
                # already declines with once the stream has started.
                raise AskRefused(ownership.DENIAL)

            question = await run_in_threadpool(redact, persona.name, user_id, request.question)

            async for event in agent_session.ask(settings, persona, question, resume=request.resume):
                # Claimed as the frame arrives, not at the end of the stream:
                # the client is handed the id in this very frame, so a claim
                # that waited would leave it unowned in between.
                if event.get("subtype") == "init" and isinstance(event.get("session_id"), str):
                    await run_in_threadpool(ownership.claim, db, str(event["session_id"]), user_id)
                # One event per frame, verbatim, with no `event:` name — the
                # type is inside the payload where Claude Code puts it, and
                # inventing a second place for it is the translation this
                # slice refuses.
                yield f"data: {json.dumps(event)}\n\n"
        except AskRefused as refused:
            yield f"data: {json.dumps({'type': agent_session.ERROR_EVENT, 'error': str(refused)})}\n\n"

    return StreamingResponse(
        frames(),
        media_type="text/event-stream",
        headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"},
    )
