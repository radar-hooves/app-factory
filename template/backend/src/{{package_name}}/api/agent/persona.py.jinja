"""This app's personas: `agent_common.persona` bound to `config/personas/` and `data/agent-homes/`.

The kit loads a persona and seeds its writable home from any two directories
(`docs/design/agent-console.md` §The persona contract); which two is this
app's, and so is the 404 a missing persona answers with.
"""

from pathlib import Path

from agent_common import persona
from agent_common.persona import Persona

from {{ package_name }}.config.paths import data_dir
from {{ package_name }}.config.sections.agent import AgentSettings
from {{ package_name }}.exceptions import NotFoundError


def homes() -> Path:
    """Where every persona's writable home lives: its seeded files and the CLI's own state.

    Under data/, resolved through config/paths.py's data_dir() — the one
    place this app writes state it did not receive from its database
    (`rules-library/platform/canonical-app-shape.md` §Development launch).
    """
    return data_dir() / "agent-homes"


def load(settings: AgentSettings, name: str) -> Persona:
    """Load `name` from `settings.personas_dir` and ensure its writable home is seeded.

    Raises:
        NotFoundError: no persona directory named `name` carries a CLAUDE.md.
    """
    try:
        return persona.load(settings.personas_dir, name, homes())
    except persona.PersonaNotFound as exc:
        raise NotFoundError(str(exc)) from exc
