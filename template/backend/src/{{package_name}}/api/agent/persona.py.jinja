"""Load a persona from `config/personas/<name>/`, and seed its writable home.

The persona contract (`docs/design/agent-console.md` §The persona contract): a
directory shaped as a Claude Code home — `CLAUDE.md` (who it is), `settings.json`
(`model`, `permissions.allow`, `permissions.deny`, hooks) and `.mcp.json` (the
servers it holds). Nothing here caches a persona between requests: it is read
fresh on every spawn, so an edit reaches the very next turn with no restart.

Generalises `library.api.agent.session.prepare_home` from one image-shipped
template directory to N persona directories, each app-owned rather than
baked into the image — the only change the library's own version needed to
become this one.
"""

import json
import shutil
from dataclasses import dataclass
from pathlib import Path

from {{ package_name }}.config.paths import data_dir
from {{ package_name }}.config.sections.agent import AgentSettings
from {{ package_name }}.exceptions import NotFoundError

#: The files a persona directory may carry, copied into its writable home in
#: this order. CLAUDE.md is the only one a persona MUST have — it is what
#: marks a directory as a persona at all (`list_personas`).
SOURCE_FILES = ("CLAUDE.md", "settings.json", ".mcp.json")


@dataclass(frozen=True, slots=True)
class PersonaConfig:
    """One persona's identity and permissions, and where its writable home is.

    `allowed_tools` and `disallowed_tools` are comma-joined tool lists,
    already shaped for `--allowedTools`/`--disallowedTools` — derived from
    settings.json's own `permissions.allow`/`permissions.deny` so the file
    and the flags that enforce it under `--permission-mode bypassPermissions`
    can never disagree.
    """

    name: str
    home: Path
    allowed_tools: str
    disallowed_tools: str

    @property
    def mcp_config(self) -> Path | None:
        """The seeded `.mcp.json`, or None when this persona shipped none."""
        candidate = self.home / ".mcp.json"
        return candidate if candidate.is_file() else None


def list_personas(settings: AgentSettings) -> list[str]:
    """Every persona this deployment carries. Empty means no console renders.

    A directory counts only once it has a `CLAUDE.md` — the one file that is
    not optional, because it is what says the directory is a persona rather
    than stray content under `config/personas/`.
    """
    if not settings.personas_dir.is_dir():
        return []
    return sorted(
        child.name for child in settings.personas_dir.iterdir() if child.is_dir() and (child / "CLAUDE.md").is_file()
    )


def _seed(source: Path, home: Path) -> None:
    """Copy a persona's shipped files into its writable home. Only ever ADDS.

    A file already in the home was put there by Claude Code itself (it WRITES
    to its own config directory) or by an operator, and overwriting it would
    discard that state on every restart — the same rule the library's
    `prepare_home` enforces on its one shared home, generalised here to each
    persona's own.
    """
    home.mkdir(parents=True, exist_ok=True)
    for filename in SOURCE_FILES:
        candidate = source / filename
        target = home / filename
        if candidate.is_file() and not target.exists():
            shutil.copy2(candidate, target)


def _tool_list(settings_json: dict[str, object], key: str) -> str:
    permissions = settings_json.get("permissions", {})
    names = permissions.get(key, []) if isinstance(permissions, dict) else []
    return ",".join(str(name) for name in names) if isinstance(names, list) else ""


def load(settings: AgentSettings, name: str) -> PersonaConfig:
    """Load `name`'s config and ensure its writable home is seeded.

    Raises:
        NotFoundError: no persona directory named `name` carries a CLAUDE.md.
    """
    source = settings.personas_dir / name
    if not (source / "CLAUDE.md").is_file():
        raise NotFoundError(f"no such persona: {name}")

    # Under data/, resolved through config/paths.py's data_dir() — the one
    # place this app writes state it did not receive from its database
    # (`rules-library/platform/canonical-app-shape.md` §Development launch).
    home = data_dir() / "agent-homes" / name
    _seed(source, home)

    settings_path = home / "settings.json"
    settings_json = json.loads(settings_path.read_text()) if settings_path.is_file() else {}

    return PersonaConfig(
        name=name,
        home=home,
        allowed_tools=_tool_list(settings_json, "allow"),
        disallowed_tools=_tool_list(settings_json, "deny"),
    )
