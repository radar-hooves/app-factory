logger = logging.getLogger(__name__)

#: How often a running process looks at its own row for messages and a stop,
#: and how often `watch()` reads the event log forward.
_POLL_SECONDS = 0.5
#: How often a running process refreshes its heartbeat.
_HEARTBEAT_SECONDS = 10.0
#: How old a heartbeat must be before its run counts as dead. Past gunicorn's
#: own worker timeout (60 s) plus a heartbeat: a worker whose event loop is
#: blocked that long is killed by the arbiter anyway, so a live run is never
#: this quiet.
_STALE_SECONDS = 90.0
#: How often every worker sweeps for dead runs (`supervise`).
_SWEEP_SECONDS = 60.0

_ORPHANED = "orphaned: the process running this job stopped before it finished"
_SHUT_DOWN = "stopped: the worker process running this job shut down"


@dataclass(slots=True)
class _LocalRun:
    """This process's handle on a run it is working, for the same-process fast paths.

    Everything another process might need lives on the job row instead; this
    only lets a stop that lands on the owning process kill at once rather than
    at the next poll, and lets `shutdown()` find what to kill.
    """

    process: asyncio.subprocess.Process | None = None
    stopping: bool = False
    shutting_down: bool = False


#: The run this process is working on, per job.
_runs: dict[str, _LocalRun] = {}
#: Held so a running task is never garbage-collected mid-run (`asyncio`'s own
#: warning: "Task was destroyed but it is pending"). Discarded by the task's
#: own done callback, never by whoever started it — a job outlives the request
#: that started it.
_tasks: set[asyncio.Task[None]] = set()


def new_job_id() -> str:
    """A fresh job id, for a caller that must know its job's folder before starting it (`job_dir`)."""
    return str(uuid.uuid4())


def job_dir(job_id: str) -> Path:
    """This job's own working folder: its `cwd`, the files it was seeded with, and its `.mcp.json`.

    Public so a starter can name a seeded file by absolute path in the job's
    own prompt — Claude Code's Read tool takes nothing else — before the job
    exists: mint the id with `new_job_id()`, build the prompt from this
    folder, then pass both to `start()`.

    Under `data_dir()`, alongside the personas' seeded homes — an app's own
    runtime state, never the repo (`platform/canonical-app-shape.md`
    §Development launch). Left on disk after the job finishes: a watcher may
    open it hours later and a message may resume it. `cleanup()` is how an app
    that wants it gone removes it.
    """
    return data_dir() / "agent-jobs" / job_id


def _write_mcp_config(folder: Path, mcp_config: dict[str, object]) -> None:
    (folder / ".mcp.json").write_text(json.dumps(mcp_config))


#: Header names a credential is ever named under, matched case-insensitively.
_CREDENTIAL_HEADER_NAMES = frozenset({"authorization", "x-api-key", "api-key", "x-auth-token", "cookie"})
#: What a stdio server's environment variable carrying a credential is named with.
_CREDENTIAL_ENV_NAME = re.compile(r"(?i)key|token|secret|passw|auth|credential|cookie")
#: A `_FILE`/`_PATH` suffix names a filesystem location, not the value itself — the shape
#: every app's own `PORTCULLIS_KEY_FILE` (`config/vend.py`) already takes to tell a stdio
#: server where its identity key lives, so it can vend its own secrets from the broker.
_ENV_NAME_IS_PATH = re.compile(r"(?i)_(file|path)$")


def _names_a_path(name: str, value: object) -> bool:
    """A `_FILE`/`_PATH` variable whose value is an absolute path: a location, never the secret."""
    return bool(_ENV_NAME_IS_PATH.search(name)) and isinstance(value, str) and value.startswith("/")


def _refuse_literal_mcp_credentials(mcp_config: dict[str, object]) -> None:
    """Refuse an `mcp_config` that carries a credential as a literal value.

    A job's `mcp_config` is persisted on its row and written to its folder on
    every run, so a literal credential would sit on disk and in the database
    for as long as the job exists. An HTTP server's credential is minted by a
    `headersHelper` command at spawn — a recipe, not a secret — the contract a
    persona's own `.mcp.json` is held to; a stdio server vends its own from
    the broker, as every household process does — which means it must be told
    where its own identity lives. A `_FILE`/`_PATH`-suffixed name is that
    coordinate, not a secret (`PORTCULLIS_KEY_FILE` names a path, never a key),
    and stays exempt even where the rest of its name is credential-shaped. A
    credential in a server's `args` cannot be told from any other argument, and
    is the caller's to keep out.

    Raises:
        BadRequestError: a server entry sets a credential-shaped header or
            environment variable directly.
    """
    servers = mcp_config.get("mcpServers")
    if not isinstance(servers, dict):
        return
    for name, server in servers.items():
        if not isinstance(server, dict):
            continue
        headers = server.get("headers")
        env = server.get("env")
        literal = sorted(
            [key for key in headers if key.lower() in _CREDENTIAL_HEADER_NAMES] if isinstance(headers, dict) else []
        ) + sorted(
            [key for key in env if _CREDENTIAL_ENV_NAME.search(key) and not _names_a_path(key, env[key])]
            if isinstance(env, dict)
            else []
        )
        if literal:
            raise BadRequestError(
                f"mcp_config server {name!r} sets {literal!r} as a literal value — mint a header with "
                "headersHelper, or have the server vend its own; a job never persists a credential"
            )


def _seed_files(folder: Path, files: dict[str, bytes]) -> None:
    folder.mkdir(parents=True, exist_ok=True)
    for relative, content in files.items():
        path = folder / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(content)


def _without_bytes(value: Any) -> Any:
    """``value`` with the bytes of every image or document emptied out.

    A Read of a page image returns it twice — once as the Messages API's
    `{"type": "base64", "data": ...}` source inside the `tool_result`, once as
    `tool_use_result.file.base64` (the CLI's own Read output schema) — and a
    200-DPI page is megabytes either way. Everything else stays: the
    `tool_use` block naming the file it was read from, and the media type and
    pixel dimensions beside the bytes, which is the image by reference.
    """
    if isinstance(value, dict):
        emptied = {key: _without_bytes(item) for key, item in value.items()}
        if emptied.get("type") == "base64" and isinstance(emptied.get("data"), str):
            emptied["data"] = ""
        if isinstance(emptied.get("base64"), str):
            emptied["base64"] = ""
        return emptied
    if isinstance(value, list):
        return [_without_bytes(item) for item in value]
    return value


async def start(
    db_session_factory: sessionmaker[Session],
    settings: AgentSettings,
    persona: Persona,
    *,
    workspace_id: int,
    created_by_id: uuid.UUID | None,
    prompt: str,
    job_id: str | None = None,
    files: dict[str, bytes] | None = None,
    json_schema: dict[str, object] | None = None,
    append_system_prompt: str | None = None,
    mcp_config: dict[str, object] | None = None,
    model: str | None = None,
) -> str:
    """Start a persona session with no asker, and return its job id at once.

    `workspace_id` is the workspace this job's data belongs to — the caller's
    own `CurrentWorkspace.id`, since a job started from a request handler has
    one, or another value the app is confident is correct for a job started
    from elsewhere (a scheduled sweep). `created_by_id` is attribution only
    (`platform/tenancy.md`): `None` is fine for a job with no real asker and
    never gates who may later watch, message or stop it — that is
    `workspace_id` plus the caller's own persona entitlement, checked by
    `authorize()` and the router.

    `job_id` is minted here unless the caller minted it (`new_job_id()`) so
    it could name the job's folder (`job_dir`) in `prompt`,
    `append_system_prompt` or `mcp_config` before calling this. `files`
    seeds that folder before the CLI ever runs — every key is a path relative
    to it. `mcp_config`, if given, becomes the job's own `.mcp.json`
    (`--strict-mcp-config`'d exactly as a persona's own is,
    `agent_common.cli.argv`) — how a caller binds the job's own identity into the
    MCP servers it reaches, with any credential minted by a `headersHelper`
    command, never a literal header (`_refuse_literal_mcp_credentials`).
    `model` is `--model` for this job, on every run
    including a resume; omitted, the persona's `settings.json` decides.
    All four are persisted on the job row and replayed on every resumed run,
    so a later `send_message()` from any worker reaches the same servers
    under the same identity on the same model without knowing any of it.

    Returns immediately — the caller gets `job_id` back before the CLI has
    even spawned. The structured answer arrives on the job row once the run
    settles, and `app_hooks.agent_job_settled` is called with it then.

    Raises:
        BadRequestError: `job_id` is not a UUID — it doubles as Claude Code's
            own `--session-id`, which takes nothing else — or `mcp_config`
            sets a literal credential header.
    """
    if mcp_config is not None:
        _refuse_literal_mcp_credentials(mcp_config)
    if job_id is None:
        job_id = new_job_id()
    else:
        try:
            uuid.UUID(job_id)
        except ValueError as exc:
            raise BadRequestError(f"a job id must be a UUID: {job_id!r}") from exc
    folder = job_dir(job_id)
    prompt = await run_in_threadpool(redact, persona.name, created_by_id, prompt)
    await run_in_threadpool(_seed_files, folder, files or {})
    if mcp_config is not None:
        await run_in_threadpool(_write_mcp_config, folder, mcp_config)

    spec = RunSpec(
        job_id=job_id,
        persona=persona.name,
        workspace_id=workspace_id,
        created_by_id=created_by_id,
        run_id=str(uuid.uuid4()),
        json_schema=json_schema,
        append_system_prompt=append_system_prompt,
        mcp_config=mcp_config,
        model=model,
    )

    def _create() -> None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=workspace_id, created_by_id=created_by_id)
            jobs_models.create_job(db, spec)

    await run_in_threadpool(_create)
    _spawn(db_session_factory, settings, persona, spec, [prompt], resume=False)
    return job_id


def _spawn(
    db_session_factory: sessionmaker[Session],
    settings: AgentSettings,
    persona: Persona,
    spec: RunSpec,
    messages: list[str],
    *,
    resume: bool,
) -> None:
    """Create and hold the `_run()` task, so nothing about a caller's own lifetime bounds it.

    The run's local handle is registered synchronously, before the task can
    run, so a same-process `stop()` arriving before its CLI exists still has
    something to mark.
    """
    local = _LocalRun()
    _runs[spec.job_id] = local
    run = _run(db_session_factory, settings, persona, spec, local, messages, resume=resume)
    task = asyncio.create_task(run, name=f"agent-job-{spec.job_id}")
    _tasks.add(task)
    task.add_done_callback(_tasks.discard)
    task.add_done_callback(_log_failure)


def _log_failure(task: asyncio.Task[None]) -> None:
    """Log a run that raised, which leaves its row `running` for the sweep to settle once its heartbeat is stale."""
    if not task.cancelled() and (exc := task.exception()) is not None:
        logger.error("Agent job run %s failed", task.get_name(), exc_info=exc)


@dataclass(slots=True)
class _Turns:
    """What `_run`'s stdout loop and `_control` share about the frames on stdin."""

    written: int = 0
    echoed: int = 0
    #: A `result` arrived after every frame written had been echoed: the CLI
    #: has nothing left to answer, so stdin may close.
    idle: bool = False


async def _write_frames(process: asyncio.subprocess.Process, turns: _Turns, messages: list[str]) -> int:
    """Write ``messages`` onto the CLI's stdin; return how many were written before the pipe broke."""
    assert process.stdin is not None
    for written, message in enumerate(messages):
        try:
            process.stdin.write(cli.user_frame(message))
            await process.stdin.drain()
        except BrokenPipeError, ConnectionResetError:
            return written
        turns.written += 1
        turns.idle = False
    return len(messages)


async def _beat(db_session_factory: sessionmaker[Session], spec: RunSpec) -> None:
    """Keep the run's heartbeat fresh for as long as this worker's event loop runs it.

    Its own task rather than a step of `_control`: a heartbeat says the worker
    is alive, and a control loop waiting on a slow write to stdin is not a dead
    worker.
    """
    while True:
        await asyncio.sleep(_HEARTBEAT_SECONDS)

        def _write() -> None:
            with db_session_factory() as db:
                bind_session(db, workspace_id=spec.workspace_id, created_by_id=spec.created_by_id)
                jobs_models.beat(db, spec.job_id, spec.run_id)

        try:
            await run_in_threadpool(_write)
        except Exception:
            logger.exception("Refreshing agent job %s's heartbeat failed; retrying", spec.job_id)


async def _put_back(db_session_factory: sessionmaker[Session], spec: RunSpec, messages: list[str]) -> None:
    """Return messages this run took but could not write to its row, where its end resumes with them.

    Retried through a database blip; a message still not put back after that is
    logged as lost, by count, since nothing else holds it.
    """

    def _requeue() -> None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=spec.workspace_id, created_by_id=spec.created_by_id)
            jobs_models.requeue(db, spec.job_id, spec.run_id, messages)

    for attempt in range(3):
        try:
            await run_in_threadpool(_requeue)
            return
        except Exception:
            if attempt == 2:
                logger.exception(
                    "Agent job %s lost %d message(s) its CLI exited before reading", spec.job_id, len(messages)
                )
                return
            await asyncio.sleep(_POLL_SECONDS * 2**attempt)


async def _control(
    db_session_factory: sessionmaker[Session],
    spec: RunSpec,
    local: _LocalRun,
    process: asyncio.subprocess.Process,
    turns: _Turns,
) -> None:
    """The running process's side of the job row: messages in, a stop, and closing stdin.

    Runs beside `_run`'s stdout loop and ends on its own the moment the CLI
    exits, so a message it has taken off the row is always either written or
    put back. Closing stdin is decided here and only here, AFTER a poll that
    found no message to write, so a message is either written before the
    close or still pending on the row when the run ends — where
    `settle_or_continue` resumes with it.
    """
    assert process.stdin is not None
    while True:
        try:
            await asyncio.wait_for(process.wait(), timeout=_POLL_SECONDS)
            return
        except TimeoutError:
            pass
        stdin_open = not process.stdin.is_closing()

        def _poll(take: bool = stdin_open) -> tuple[bool, list[str]] | None:
            with db_session_factory() as db:
                bind_session(db, workspace_id=spec.workspace_id, created_by_id=spec.created_by_id)
                return jobs_models.poll_run(db, spec.job_id, spec.run_id, take_messages=take)

        try:
            polled = await run_in_threadpool(_poll)
        except Exception:
            # A database blip: the run carries on, and the next poll asks again.
            logger.exception("Polling agent job %s's row failed; retrying", spec.job_id)
            continue
        if polled is None or polled[0]:
            # A stop from any worker, or the row is no longer this run's.
            local.stopping = True
            cli.kill(process)
            return
        messages = polled[1]
        written = await _write_frames(process, turns, messages)
        if written < len(messages):
            # The CLI's stdin broke: it is exiting.
            await _put_back(db_session_factory, spec, messages[written:])
            return
        if not messages and turns.idle and stdin_open:
            process.stdin.close()


async def _run(
    db_session_factory: sessionmaker[Session],
    settings: AgentSettings,
    persona: Persona,
    spec: RunSpec,
    local: _LocalRun,
    messages: list[str],
    *,
    resume: bool,
) -> None:
    """Spawn the CLI with ``messages`` as its first turns, record every event, then end the run.

    The per-line read timeout (`settings.timeout_seconds`, the same knob
    a chat turn is bounded by) is an IDLE timeout, not a
    total wall clock: it fires only when the child has gone quiet while it
    still owes an answer. A child with nothing left to answer is never quiet
    for long, because `_control` closes its stdin and it exits.

    Every event, the driver's own synthetic `ERROR_EVENT` included, goes
    through `_record`: the app's `agent_event` hook first, then `_without_bytes`,
    then the log. The run's outcome is read off what the hook returned, so
    `job.error` and `job.structured_output` carry nothing the log does not.
    """
    folder = job_dir(spec.job_id)
    if spec.mcp_config is not None:
        await run_in_threadpool(_write_mcp_config, folder, spec.mcp_config)
    mcp_config_path = folder / ".mcp.json"
    driver = settings.driver()
    argv = cli.argv(
        driver,
        persona,
        None,
        resume=spec.job_id if resume else None,
        session_id=None if resume else spec.job_id,
        mcp_config=mcp_config_path if mcp_config_path.is_file() else None,
        append_system_prompt=spec.append_system_prompt,
        json_schema=spec.json_schema,
        input_format="stream-json",
        model=spec.model,
        partial_messages=False,
    )

    def _bound(db: Session) -> Session:
        bind_session(db, workspace_id=spec.workspace_id, created_by_id=spec.created_by_id)
        return db

    async def _record(event: dict[str, Any]) -> dict[str, Any] | None:
        def _write() -> dict[str, Any] | None:
            rewritten = redact_event(persona.name, event)
            if rewritten is not None:
                with db_session_factory() as db:
                    jobs_models.record_event(_bound(db), spec.job_id, _without_bytes(rewritten))
            return rewritten

        return await run_in_threadpool(_write)

    async def _failure(error: str) -> str:
        """Record the slice's own error event; `job.error` is whatever of it the app's hook kept."""
        recorded = await _record({"type": cli.ERROR_EVENT, "error": error})
        return str(recorded.get("error") or "agent failed") if recorded is not None else "agent failed"

    status, error, structured_output = jobs_models.COMPLETED, None, None
    try:
        # A stdin pipe: every turn is a frame on stdin, the prompt included
        # (`--input-format stream-json` ignores one on the command line), and
        # a message sent while it works is another.
        process = await cli.spawn(driver, persona, argv, cwd=folder, stdin=True)
    except OSError as exc:
        status, error = jobs_models.FAILED, await _failure(f"agent could not start: {exc}")
    else:
        local.process = process
        if local.stopping or local.shutting_down:
            cli.kill(process)
        assert process.stderr is not None
        turns = _Turns()
        stderr_task = asyncio.create_task(cli.drain(process.stderr))
        delivered = await _write_frames(process, turns, messages)
        turns.written += len(messages) - delivered  # a frame it never got is a turn it never answered
        control_task = asyncio.create_task(_control(db_session_factory, spec, local, process, turns))
        beat_task = asyncio.create_task(_beat(db_session_factory, spec))
        try:
            async for event in cli.events(process, driver.timeout_seconds):
                recorded = await _record(event)
                if event.get("type") == "user" and event.get("isReplay"):
                    turns.echoed += 1
                elif event.get("type") == "result":
                    turns.idle = turns.echoed >= turns.written
                    if event.get("is_error"):
                        answer = (recorded or {}).get("result")
                        status, error = jobs_models.FAILED, str(answer or "agent reported an error")
                    else:
                        status, error = jobs_models.COMPLETED, None
                        structured_output = (recorded or {}).get("structured_output")
        except cli.IdleTimeout:
            status, error = jobs_models.FAILED, await _failure("agent exceeded its wall clock")
        finally:
            cli.kill(process)
            with contextlib.suppress(TimeoutError):
                await asyncio.wait_for(process.wait(), timeout=5)
            # Left to end on its own, so a message it took is written or put back.
            try:
                await asyncio.wait_for(control_task, timeout=30)
            except TimeoutError:
                logger.warning("Agent job %s's control loop outlived its CLI by 30s; cancelled", spec.job_id)
            except Exception:
                logger.exception("Agent job %s's control loop failed", spec.job_id)
            beat_task.cancel()
            with contextlib.suppress(asyncio.CancelledError):
                await beat_task
            try:
                stderr_tail = await asyncio.wait_for(stderr_task, timeout=5)
            except Exception:
                # A timeout or a read error loses the diagnostic tail, never
                # the run's settling. This run's own cancellation is a
                # BaseException and propagates.
                stderr_task.cancel()
                stderr_tail = b""
        killed = local.stopping or local.shutting_down
        if status == jobs_models.COMPLETED and process.returncode not in (0, None) and not killed:
            tail = cli.scrub_credentials(stderr_tail.decode(errors="replace"))
            status, error = jobs_models.FAILED, await _failure(f"agent exited {process.returncode}: {tail}")
        elif status == jobs_models.COMPLETED and turns.echoed < turns.written and not killed:
            # Its stdin broke before it read them, or it exited without
            # answering: a turn it was given is not one it took.
            answered = f"answered {turns.echoed} of the {turns.written} turn(s) it was given"
            status, error = jobs_models.FAILED, await _failure(f"agent exited having {answered}")

    if _runs.get(spec.job_id) is local:
        del _runs[spec.job_id]
    if local.shutting_down:
        status, error, structured_output = jobs_models.FAILED, _SHUT_DOWN, None

    def _end() -> tuple[RunSpec, list[str]] | JobOutcome | None:
        with db_session_factory() as db:
            return jobs_models.settle_or_continue(
                _bound(db),
                spec.job_id,
                spec.run_id,
                status=status,
                structured_output=structured_output,
                error=error,
                next_run_id=None if local.shutting_down else str(uuid.uuid4()),
            )

    ended = await run_in_threadpool(_end)
    if isinstance(ended, tuple):
        next_spec, pending = ended
        _spawn(db_session_factory, settings, persona, next_spec, pending, resume=True)
    elif ended is not None:
        await _settled(ended)


async def _settled(outcome: JobOutcome) -> None:
    """Call `app_hooks.agent_job_settled`, if this app defines one, in whichever process settled the job.

    That is not necessarily the process that started it: a run resumed by a
    message settles where the message landed, and a dead one settles in
    whichever worker's sweep found it. A hook that raises is logged, never
    re-raised — the job is settled on its row regardless, and the app reads
    it from there.
    """
    from {{ package_name }} import app_hooks

    hook = getattr(app_hooks, "agent_job_settled", None)
    if hook is None:
        return
    try:
        await run_in_threadpool(hook, outcome)
    except Exception:
        logger.exception("app_hooks.agent_job_settled failed for job %s", outcome.job_id)


async def send_message(
    db_session_factory: sessionmaker[Session],
    settings: AgentSettings,
    persona: Persona,
    job_id: str,
    text: str,
    *,
    workspace_id: int,
    user_id: uuid.UUID | None,
) -> None:
    """Send `text` to `job_id`, from any worker: queued for its running process, or a resumed run.

    While a live process is running the job, the message is queued on the job
    row and that process writes it onto its CLI's stdin within a poll; the
    answer arrives as further events in the same log. Once nothing is running
    it, this call reopens the job and starts a NEW run under the SAME job id,
    here, via `--resume`, replaying the `json_schema`/`append_system_prompt`/
    `mcp_config`/`model` the job started with. Both decisions are one
    transaction on the job row (`jobs_models.enqueue_or_reopen`), so two
    messages arriving together from two workers start at most one run.
    `workspace_id` binds every session this call opens; the caller (the
    router, via `authorize()`) has already checked it matches the job's own.

    Raises:
        NotFoundError: no such job.
        BadRequestError: the job's running process has been asked to stop.
    """
    text = await run_in_threadpool(redact, persona.name, user_id, text)
    run_id = str(uuid.uuid4())

    def _enqueue() -> RunSpec | str | None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=workspace_id)
            return jobs_models.enqueue_or_reopen(db, job_id, text, run_id=run_id, stale_seconds=_STALE_SECONDS)

    outcome = await run_in_threadpool(_enqueue)
    if outcome is None:
        raise NotFoundError(f"no such job: {job_id}")
    if outcome == jobs_models.STOPPING:
        raise BadRequestError("this job is stopping; send the message again once it has stopped")
    if isinstance(outcome, RunSpec):
        _spawn(db_session_factory, settings, persona, outcome, [text], resume=True)


async def stop(db_session_factory: sessionmaker[Session], job_id: str, *, workspace_id: int) -> None:
    """Stop `job_id`, from any worker. A job with nothing running is a no-op.

    Flags the row, which the running process acts on at its next poll. When
    that process is this one, its CLI is killed now as well, rather than a
    poll later.
    """

    def _flag() -> None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=workspace_id)
            jobs_models.request_stop(db, job_id)

    await run_in_threadpool(_flag)
    local = _runs.get(job_id)
    if local is not None:
        local.stopping = True
        if local.process is not None:
            cli.kill(local.process)


async def watch(
    db_session_factory: sessionmaker[Session], job_id: str, *, workspace_id: int
) -> AsyncIterator[dict[str, object]]:
    """Yield `job_id`'s events from the first, then follow them until its run settles.

    Reads the event log forward from the database, whichever worker is
    running the job, so a watcher on any worker sees the same stream. The
    stream ends once no live process is running the job — settled, or dead —
    after one last read that catches everything that run recorded
    (`jobs_models.read_progress`). A watcher that sends a message starts a
    new watch to follow the run it may resume.

    The caller (the router, via `authorize()`) has already checked `job_id`
    belongs to `workspace_id`; this only needs it to bind the sessions it
    opens itself.
    """
    last_seq = 0
    while True:

        def _read(after: int = last_seq) -> tuple[bool, list[tuple[int, dict[str, Any]]]]:
            with db_session_factory() as db:
                bind_session(db, workspace_id=workspace_id)
                return jobs_models.read_progress(db, job_id, after=after, stale_seconds=_STALE_SECONDS)

        live, events = await run_in_threadpool(_read)
        for seq, event in events:
            yield event
            last_seq = seq
        if not live:
            return
        await asyncio.sleep(_POLL_SECONDS)


async def authorize(
    db_session_factory: sessionmaker[Session], job_id: str, workspace_id: int, persona: str
) -> AgentJob:
    """Return `job_id`'s row if it belongs to `workspace_id` AND `persona`, else refuse.

    `persona` matters as much as `workspace_id`: a caller's `agent-<name>`
    entitlement and workspace membership say nothing about a different
    persona's job in the same workspace, and the URL's `{persona}` segment is
    a path the caller chose, not a claim this slice verified.

    The one place this slice reads a job with NO workspace bound yet
    (`jobs_models.get_job_unscoped`) — the caller's own workspace is exactly
    what this call is deciding whether to trust, so binding to it first would
    be circular; the read is confined to that one `unscoped()` block, per
    `platform/tenancy.md`, and never reused as a way around the check it
    exists to make. One answer covers every way to fail this check, the same
    choice `ownership.DENIAL` makes for a private chat session: a status code
    that told "no such job" apart from "not yours" or "wrong persona" would
    let an entitled caller enumerate the ids and personas of jobs it cannot reach.

    Raises:
        NotFoundError: no such job, or it belongs to a different workspace or persona.
    """

    def _load() -> AgentJob | None:
        with db_session_factory() as db:
            return jobs_models.get_job_unscoped(db, job_id)

    job = await run_in_threadpool(_load)
    if job is None or job.workspace_id != workspace_id or job.persona != persona:
        raise NotFoundError(f"no such job: {job_id}")
    return job


async def cleanup(db_session_factory: sessionmaker[Session], job_id: str, *, workspace_id: int, persona: str) -> None:
    """Remove everything `job_id` left on disk, once it is no longer resumable.

    Its working folder, and what the CLI itself kept under the persona's
    shared home: the session transcript (`projects/<cwd>/<job_id>.jsonl`,
    holding every string and image the agent read, for as long as it exists)
    and any other per-session artefact. Each is named by the job id — the
    session id, and a working folder no other job shares — so a match on it
    touches nothing of any other job's. Nothing calls this automatically: an
    app calls it once its own record of the job is settled and it knows no
    later `send_message()` will need to resume it.

    Raises:
        NotFoundError: no such job in `workspace_id` under `persona`.
        BadRequestError: the job is still running — stop it first.
    """
    job = await authorize(db_session_factory, job_id, workspace_id, persona)
    if job.status == jobs_models.RUNNING:
        raise BadRequestError("this job is still running; stop it before cleaning up its files")
    await run_in_threadpool(_remove_job_files, job_id, persona_module.homes() / job.persona)


def _remove_job_files(job_id: str, persona_home: Path) -> None:
    shutil.rmtree(job_dir(job_id), ignore_errors=True)
    for path in persona_home.glob(f"*/*{glob.escape(job_id)}*"):
        if path.is_dir():
            shutil.rmtree(path, ignore_errors=True)
        else:
            path.unlink(missing_ok=True)


async def reconcile_orphaned_jobs(db_session_factory: sessionmaker[Session]) -> int:
    """Settle every `running` job whose heartbeat has gone stale as `failed`. Returns how many.

    A job's CLI is a child of the worker that spawned it and does not survive
    that worker, so a stale heartbeat means no process will ever move the row
    out of `running` on its own. A LIVE job held by another worker keeps its
    heartbeat fresh and is never touched, whichever worker sweeps and
    whenever — so a worker booting or recycling beside a running job leaves
    it alone. Each job settled here reaches `app_hooks.agent_job_settled`.
    """

    def _sweep() -> list[JobOutcome]:
        with db_session_factory() as db:
            return jobs_models.fail_orphans(db, stale_seconds=_STALE_SECONDS, error=_ORPHANED)

    outcomes = await run_in_threadpool(_sweep)
    if outcomes:
        logger.warning("Settled %d agent job(s) left running by a process that stopped", len(outcomes))
    for outcome in outcomes:
        await _settled(outcome)
    return len(outcomes)


async def supervise(
    db_session_factory: sessionmaker[Session], settings: AgentSettings, stopping: asyncio.Event
) -> None:
    """Sweep for dead runs and unsettled lesson reports at startup and every `_SWEEP_SECONDS` after,
    until ``stopping`` is set.

    Every worker runs it (`main.py`'s lifespan): a run whose worker died
    becomes stale some time after the survivors booted, so one sweep at
    startup alone would leave it `running` until the next deploy. A failed
    sweep is logged and retried at the next interval. Stopped by the event
    rather than cancelled, so a sweep in flight finishes on its database
    thread before the lifespan disposes the engine under it.

    `lessons.retry_unsettled` rides the same sweep (`docs/design/agent-lessons.md`).
    """
    while not stopping.is_set():
        try:
            await reconcile_orphaned_jobs(db_session_factory)
        except Exception:
            logger.exception("Sweeping for agent jobs left running failed; retrying in %.0fs", _SWEEP_SECONDS)
        try:
            await lessons.retry_unsettled(db_session_factory, settings, stopping)
        except Exception:
            logger.exception("Retrying unsettled lesson reports failed; retrying in %.0fs", _SWEEP_SECONDS)
        with contextlib.suppress(TimeoutError):
            await asyncio.wait_for(stopping.wait(), timeout=_SWEEP_SECONDS)


async def shutdown() -> None:
    """Kill every run this worker is working and settle each `failed`, before the worker exits.

    Its CLIs cannot outlive it usefully — their stdout is this process's pipe
    — so each run ends now, recorded as the worker's shutdown rather than left
    for a sweep to find stale. An app that starts long jobs keeps gunicorn's
    worker recycling off (`GUNICORN_MAX_REQUESTS=0`, `gunicorn.conf.py`), so
    this runs at a deploy rather than every thousand requests.
    """
    for local in list(_runs.values()):
        local.shutting_down = True
        if local.process is not None:
            cli.kill(local.process)
    loop = asyncio.get_running_loop()
    ours = {task for task in _tasks if task.get_loop() is loop}
    if ours:
        await asyncio.wait(ours, timeout=10)
