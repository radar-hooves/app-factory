"""core-memory's learning loop needs one moment from every persona job: whether a person accepted
or corrected its cited lessons. `report_outcome()` records that intent in the caller's own
transaction; `retry_unsettled()`, run from `jobs.supervise()`'s sweep, is the only thing that ever
calls core-memory. Full account: `docs/design/agent-lessons.md`.
"""

from __future__ import annotations

import asyncio
import datetime
import logging
import re
from typing import Any

import httpx
from fastmcp import Client
from fastmcp.client.auth import BearerAuth
from fastmcp.exceptions import McpError, ToolError
from sqlalchemy import func, or_, select
from sqlalchemy.orm import Session, sessionmaker
from starlette.concurrency import run_in_threadpool

from {{ package_name }}.api.agent import jobs_models
from {{ package_name }}.api.agent.jobs_models import AgentJob, AgentJobLessonReport
from {{ package_name }}.api.alerts import service as alerts_service
from {{ package_name }}.api.alerts.schemas import AlertRaise
from {{ package_name }}.config import get_settings
from {{ package_name }}.config.sections.agent import AgentSettings
from {{ package_name }}.config.vend import VendError, vend_envelope
from {{ package_name }}.db.scoping import bind_session, unscoped
from {{ package_name }}.exceptions import BadRequestError

logger = logging.getLogger(__name__)

CONFIRM = "confirm"
CONTRADICT = "contradict"

#: The lease, and so a persistently-failing report's own retry backoff (>=3x `_DELIVER_TIMEOUT_SECONDS`).
_LEASE_SECONDS = 300.0
_DELIVER_TIMEOUT_SECONDS = 90
_CALL_TIMEOUT_SECONDS = 30
_INIT_TIMEOUT_SECONDS = 15
_ABANDON_AFTER = datetime.timedelta(days=14)
#: Rows delivered per sweep tick, so an outage cannot starve `reconcile_orphaned_jobs`.
_MAX_PER_SWEEP = 5

#: A belief id, as `belief_retrieve` mints one — nothing else survives into `cited()`.
_BELIEF_ID = re.compile(r"^[0-9a-f]{32}$", re.IGNORECASE)
#: FastMCP's masked generic shape for an unhandled tool exception — ambiguous, so transient.
_MASKED_TOOL_ERROR = re.compile(r"^Error calling tool '[^']*'$")

_TRANSIENT, _REFUSED, _UNEXPECTED = "transient", "refused", "unexpected"


def cited(job: AgentJob) -> list[str]:
    """Belief ids `job` named in `lessons_used`, kept only where they look like one."""
    lessons = (job.structured_output or {}).get("lessons_used")
    if not isinstance(lessons, list):
        return []
    return [item for item in (str(entry) for entry in lessons) if _BELIEF_ID.match(item)]


def report_outcome(db: Session, job_id: str, *, domain_name: str, context_key: str, result: str) -> None:
    """Record, in `db`'s own transaction, that a person accepted or corrected `job_id`'s result.

    Insert-only and synchronous: no network call, no vend, ever happens here. `db` must already be
    bound to the job's workspace; the caller commits. A no-op when this deployment names no
    core-memory or the job cited nothing.
    """
    if result not in (CONFIRM, CONTRADICT):
        raise BadRequestError(f"result must be {CONFIRM!r} or {CONTRADICT!r}, not {result!r}")
    if len(domain_name) > 255 or len(context_key) > 255:
        raise BadRequestError("domain_name and context_key must be at most 255 characters")
    if not get_settings().agent.core_memory_url:
        return
    job = jobs_models.get_job(db, job_id)
    if job is None or not cited(job):
        return
    jobs_models.insert_lesson_report_if_absent(
        db, job_id, workspace_id=job.workspace_id, domain_name=domain_name, context_key=context_key, result=result
    )


async def _call(settings: AgentSettings, tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
    """Call one core-memory tool, bearer vended fresh and held nowhere, bounded so a hung server
    cannot stall the sweep."""
    envelope = await run_in_threadpool(vend_envelope, settings.core_memory_credential)
    token = envelope["material"]["access_token"]
    async with Client(
        settings.core_memory_url,
        auth=BearerAuth(token),
        timeout=_CALL_TIMEOUT_SECONDS,
        init_timeout=_INIT_TIMEOUT_SECONDS,
    ) as memory:
        result = await memory.call_tool(tool, arguments)
    return dict(result.structured_content or {})


def _classify(exc: Exception) -> str:
    """TRANSIENT (retry later), REFUSED (core-memory's own final word), or UNEXPECTED (settle
    anyway, logged loud, rather than retry a fault this slice does not recognise forever)."""
    if isinstance(exc, ToolError):
        return _TRANSIENT if _MASKED_TOOL_ERROR.match(str(exc)) else _REFUSED
    if isinstance(exc, httpx.HTTPError | McpError | TimeoutError | OSError | VendError):
        return _TRANSIENT
    return _UNEXPECTED


def _raise_abandoned_alert(
    db_session_factory: sessionmaker[Session], job_id: str, domain_name: str, context_key: str
) -> None:
    with db_session_factory() as db:
        alerts_service.raise_alert(
            db,
            AlertRaise(
                key=f"agent-lessons:abandoned:{job_id}",
                title="A persona job's lesson report to core-memory was abandoned",
                body=f"job {job_id} ({domain_name}/{context_key}) stayed unsettled past {_ABANDON_AFTER.days} days.",
            ),
        )
        db.commit()


async def _deliver_or_abandon(
    db_session_factory: sessionmaker[Session],
    settings: AgentSettings,
    job_id: str,
    workspace_id: int,
    domain_name: str,
    context_key: str,
    result: str,
    created_at: datetime.datetime,
) -> None:
    """Claim `job_id`'s report, then abandon it past `_ABANDON_AFTER` or attempt one delivery."""

    def _claim() -> tuple[bool, str | None, datetime.datetime | None]:
        with db_session_factory() as db:
            bind_session(db, workspace_id=workspace_id)
            return jobs_models.claim_lesson_report(db, job_id, lease_seconds=_LEASE_SECONDS)

    won, decision_id, token = await run_in_threadpool(_claim)
    if not won or token is None:
        return

    def _settle(refused: str | None) -> None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=workspace_id)
            jobs_models.settle_lesson_report(db, job_id, claim_token=token, refused=refused)

    if created_at < datetime.datetime.now(datetime.UTC) - _ABANDON_AFTER:
        reason = f"abandoned: unsettled for over {_ABANDON_AFTER.days} days"
        await run_in_threadpool(_settle, reason)
        logger.error("Abandoned job %s's lesson report: %s", job_id, reason)
        await run_in_threadpool(_raise_abandoned_alert, db_session_factory, job_id, domain_name, context_key)
        return

    def _load_job() -> AgentJob | None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=workspace_id)
            return jobs_models.get_job(db, job_id)

    job = await run_in_threadpool(_load_job)
    belief_ids = cited(job) if job is not None else []
    if not belief_ids:
        return

    def _save_decision(new_decision_id: str) -> None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=workspace_id)
            jobs_models.set_lesson_decision(db, job_id, new_decision_id, claim_token=token)

    try:
        async with asyncio.timeout(_DELIVER_TIMEOUT_SECONDS):
            if decision_id is None:
                decision = await _call(
                    settings,
                    "decision_record",
                    {
                        "domain_name": domain_name,
                        "context_key": context_key,
                        "cites": belief_ids,
                        "payload": {"job_id": job_id},
                    },
                )
                decision_id = str(decision["id"])
                await run_in_threadpool(_save_decision, decision_id)
            await _call(
                settings, "outcome_record", {"domain_name": domain_name, "decision_id": decision_id, "result": result}
            )
    except Exception as exc:
        fault = _classify(exc)
        if fault == _TRANSIENT:
            logger.warning("Reporting job %s's lesson outcome failed transiently; will retry: %s", job_id, exc)
            return
        reason = str(exc)[:500]
        await run_in_threadpool(_settle, reason)
        (logger.error if fault == _UNEXPECTED else logger.warning)(
            "Settled job %s's lesson report as %s: %s", job_id, fault, reason
        )
        return

    await run_in_threadpool(_settle, None)


async def retry_unsettled(db_session_factory: sessionmaker[Session], settings: AgentSettings) -> None:
    """Deliver up to `_MAX_PER_SWEEP` unsettled lesson reports to core-memory. Run from
    `jobs.supervise()`'s sweep — the only place this slice ever calls core-memory.
    """
    if not settings.core_memory_url:
        return

    def _pending() -> list[tuple[str, int, str, str, str, datetime.datetime]]:
        with db_session_factory() as db, unscoped(db):
            rows = db.execute(
                select(
                    AgentJobLessonReport.job_id,
                    AgentJobLessonReport.workspace_id,
                    AgentJobLessonReport.domain_name,
                    AgentJobLessonReport.context_key,
                    AgentJobLessonReport.result,
                    AgentJobLessonReport.created_at,
                )
                .where(
                    AgentJobLessonReport.recorded_at.is_(None),
                    or_(AgentJobLessonReport.claimed_until.is_(None), AgentJobLessonReport.claimed_until < func.now()),
                )
                .order_by(AgentJobLessonReport.created_at)
                .limit(_MAX_PER_SWEEP)
            ).all()
        return list(rows)

    for job_id, workspace_id, domain_name, context_key, result, created_at in await run_in_threadpool(_pending):
        await _deliver_or_abandon(
            db_session_factory, settings, job_id, workspace_id, domain_name, context_key, result, created_at
        )
