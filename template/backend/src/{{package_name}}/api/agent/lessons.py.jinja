"""core-memory's `lesson` tool is a persona job's whole learning loop, and this module drives both ends
of it so no job depends on the model choosing to look: `load()` puts a situation's approved lessons in the
job's system prompt before it runs, and `report_outcome()` records, in the caller's own transaction, the
moment a person accepted or corrected the result, which `retry_unsettled()` (run from `jobs.supervise()`'s
sweep, the only other thing that calls core-memory) delivers as `lesson report`. Full account:
`docs/design/agent-lessons.md`.
"""

from __future__ import annotations

import asyncio
import datetime
import logging
import re
from dataclasses import dataclass, field
from typing import Any

from fastmcp import Client
from fastmcp.client.auth import BearerAuth
from fastmcp.exceptions import ToolError
from sqlalchemy import func, or_, select
from sqlalchemy.orm import Session, sessionmaker
from starlette.concurrency import run_in_threadpool

from {{ package_name }}.api.agent import jobs_models
from {{ package_name }}.api.agent.jobs_models import AgentJob, AgentJobLessonReport
from {{ package_name }}.api.alerts import service as alerts_service
from {{ package_name }}.api.alerts.models import Alert
from {{ package_name }}.api.alerts.schemas import AlertRaise
from {{ package_name }}.config import get_settings
from {{ package_name }}.config.sections.agent import AgentSettings
from {{ package_name }}.config.vend import vend_envelope
from {{ package_name }}.db.scoping import bind_session, unscoped
