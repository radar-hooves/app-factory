logger = logging.getLogger(__name__)

#: The lease, and so a persistently-failing report's own retry backoff (>=3x `_DELIVER_TIMEOUT_SECONDS`).
_LEASE_SECONDS = 300.0
_DELIVER_TIMEOUT_SECONDS = 90
#: `load` is on the job's start path, so a slow core-memory costs the job its lessons, never its start.
_LOAD_TIMEOUT_SECONDS = 20
_CALL_TIMEOUT_SECONDS = 30
_INIT_TIMEOUT_SECONDS = 15
_ABANDON_AFTER = datetime.timedelta(days=14)
#: Below this age a transient fault is just noise (every deploy risks one); past it, the operator sees it.
_STALE_TRANSIENT_AFTER = datetime.timedelta(days=1)
#: Rows delivered per sweep tick, so an outage cannot starve `reconcile_orphaned_jobs`.
_MAX_PER_SWEEP = 5
#: One alert for the whole pipeline's health, upserted by key -- never one per job.
_FAILING_ALERT_KEY = "agent-lessons:failing"

#: core-memory's own bounds (`core_memory.lessons`), refused here at the call that is wrong, not days later in the sweep.
_MAX_SITUATION = 8
_MAX_CORRECTIONS = 20
_MAX_KEY = 255
_MAX_STATEMENT = 500
_MAX_FOCUS = 500

#: A belief id, as core-memory mints one — nothing else survives into `cited()`.
_BELIEF_ID = re.compile(r"[0-9a-f]{32}")
#: FastMCP's own wrapper shape for an unhandled tool exception, masked or not (a genuine refusal
#: comes through core-memory's `_typed` path and never carries this prefix) — so always transient.
_WRAPPED_TOOL_ERROR = re.compile(r"^Error calling tool '[^']*'(: .*)?$")
#: FastMCP's own literal messages for the two faults it recognises and always lets through as
#: actionable, even with masking on.
_TRANSIENT_TOOL_MESSAGES = frozenset(
    {"Rate limited by upstream API, please retry later", "Upstream request timed out, please retry"}
)


def _is_transient_tool_error(message: str) -> bool:
    return bool(_WRAPPED_TOOL_ERROR.match(message)) or message in _TRANSIENT_TOOL_MESSAGES


@dataclass(frozen=True, slots=True)
class Lessons:
    """The learning loop a job declares at `jobs.start(lessons=...)`.

    `domain` is core-memory's domain for this kind of job (`godswood/fat-controller`); `situation` is
    the context keys the job's lessons are stored under, general to specific. A key is opaque to this
    module and to core-memory, so an existing store's keys (`bank_statement`) are valid layers as they
    stand: no `doc:` form is required. The run is filed under the last key. `propose=False` makes the
    job load lessons but never propose one: a person's corrections to it are dropped at `report_outcome`,
    for a job whose pages can carry what must not reach the free-text proposal queue.

    `focus`, `limit` and `max_chars` bound what `load` puts in the prompt, for a job that knows its
    specifics before it starts (the issuer, the document type): `focus` is free text, lessons sharing
    a whole word with it rank first, then the more specific layer, then confidence; `limit` caps the
    count; `max_chars` caps the brief's lesson lines, a ranked prefix. All unset loads every lesson.
    """

    domain: str
    situation: list[str]
    propose: bool = True
    focus: str = ""
    limit: int | None = None
    max_chars: int | None = None

    def __post_init__(self) -> None:
        # Stripped and deduped as core-memory does, so a correction's key is checked against the keys it will see.
        keys = list(dict.fromkeys(key.strip() for key in self.situation))
        object.__setattr__(self, "situation", keys)
        if not self.domain or len(self.domain) > _MAX_KEY:
            raise BadRequestError(f"lessons domain must be 1 to {_MAX_KEY} characters")
        if not 0 < len(keys) <= _MAX_SITUATION:
            raise BadRequestError(f"lessons situation must hold 1 to {_MAX_SITUATION} keys, general to specific")
        if any(not key or len(key) > _MAX_KEY for key in keys):
            raise BadRequestError(f"every lessons situation key must be 1 to {_MAX_KEY} characters")
        object.__setattr__(self, "focus", self.focus.strip())
        if len(self.focus) > _MAX_FOCUS:
            raise BadRequestError(f"lessons focus must be at most {_MAX_FOCUS} characters")
        if (self.limit is not None and self.limit < 1) or (self.max_chars is not None and self.max_chars < 1):
            raise BadRequestError("lessons limit and max_chars must each be at least 1")

    @property
    def bounded(self) -> bool:
        return bool(self.focus) or self.limit is not None or self.max_chars is not None


def declare_lessons_used(schema: dict[str, Any]) -> dict[str, Any]:
    """`schema` with the reserved `lessons_used` property added — `jobs.start` does this for a job that
    declares `lessons`, since a schema carrying `additionalProperties: False` would otherwise refuse the
    key the brief asks for."""
    return {
        **schema,
        "properties": {**schema.get("properties", {}), "lessons_used": {"type": "array", "items": {"type": "string"}}},
    }


def cited(job: AgentJob) -> list[str]:
    """Belief ids `job` named in `lessons_used` — lowercased, deduped, kept only where they look
    like one."""
    lessons = (job.structured_output or {}).get("lessons_used")
    if not isinstance(lessons, list):
        return []
    seen: set[str] = set()
    kept: list[str] = []
    for entry in lessons:
        candidate = str(entry).lower()
        if _BELIEF_ID.fullmatch(candidate) and candidate not in seen:
            seen.add(candidate)
            kept.append(candidate)
    return kept


async def _call(settings: AgentSettings, arguments: dict[str, Any], *, timeout: float) -> dict[str, Any]:
    """One `lesson` call on a freshly vended bearer. Raises whatever the call raises: the caller
    classifies it by when it happened, not by type."""
    async with asyncio.timeout(timeout):
        envelope = await run_in_threadpool(vend_envelope, settings.core_memory_credential)
        bearer = envelope["material"]["access_token"]
        async with Client(
            settings.core_memory_url,
            auth=BearerAuth(bearer),
            timeout=_CALL_TIMEOUT_SECONDS,
            init_timeout=_INIT_TIMEOUT_SECONDS,
        ) as memory:
            raw = await memory.call_tool("lesson", arguments)
    content = dict(raw.structured_content or {})
    # FastMCP wraps a tool's non-object-schema return (`lesson` returns a dict-or-list union) under one `result` key.
    return dict(content["result"]) if set(content) == {"result"} and isinstance(content["result"], dict) else content


@dataclass(frozen=True, slots=True)
class Loaded:
    """What `load` brought back. `total` and `omitted` are core-memory's count of the situation's
    lessons and of those a bound cut; `None` when the server did not report them."""

    brief: str = ""
    ids: list[str] = field(default_factory=list)
    total: int | None = None
    omitted: int | None = None


async def load(settings: AgentSettings, declared: Lessons) -> Loaded:
    """The brief to put in the job's system prompt, and the lesson ids it carries.

    Fails open: no core-memory configured, or any fault reaching it, gives an empty `Loaded` and a
    warning, so a job starts without its lessons rather than not at all. The job's report then says
    it ran with none. A bound core-memory does not yet know (it refuses the argument) is dropped and
    the load retried once unbounded.
    """
    if not settings.core_memory_url or not settings.core_memory_credential:
        return Loaded()
    arguments: dict[str, Any] = {"action": "load", "domain_name": declared.domain, "situation": declared.situation}
    bounds = {
        name: value
        for name, value in (("focus", declared.focus), ("limit", declared.limit), ("max_chars", declared.max_chars))
        if value
    }
    try:
        try:
            answer = await _call(settings, {**arguments, **bounds}, timeout=_LOAD_TIMEOUT_SECONDS)
        except ToolError as exc:
            if not bounds:
                raise
            logger.warning("core-memory refused the lesson bounds %s (%s); loading unbounded", sorted(bounds), exc)
            answer = await _call(settings, arguments, timeout=_LOAD_TIMEOUT_SECONDS)
        return Loaded(
            brief=str(answer["brief"]),
            ids=[str(item["id"]) for item in answer["lessons"]],
            total=answer.get("total"),
            omitted=answer.get("omitted"),
        )
    except Exception as exc:
        logger.warning(
            "Loading lessons for %s %s failed (%s); the job starts without them: %s",
            declared.domain,
            declared.situation,
            type(exc).__name__,
            exc,
        )
        return Loaded()


def record(declared: Lessons, loaded: Loaded) -> dict[str, Any]:
    """The declaration as the job row holds it: what the report needs after the process that started the job is gone.
    `total` and `omitted` ride along when core-memory reported them, so a bound's cost is readable per job."""
    row: dict[str, Any] = {
        "domain": declared.domain,
        "situation": declared.situation,
        "propose": declared.propose,
        "loaded": loaded.ids,
    }
    if loaded.total is not None:
        row |= {"total": loaded.total, "omitted": loaded.omitted}
    return row


def _corrections(raw: list[dict[str, str]], situation: list[str]) -> list[dict[str, str]]:
    if len(raw) > _MAX_CORRECTIONS:
        raise BadRequestError(f"at most {_MAX_CORRECTIONS} corrections per job")
    kept: list[dict[str, str]] = []
    for item in raw:
        statement = str(item.get("statement", "")).strip()
        if not statement or len(statement) > _MAX_STATEMENT:
            raise BadRequestError(f"a correction needs a statement of 1 to {_MAX_STATEMENT} characters")
        key = item.get("key")
        if key is not None and key not in situation:
            raise BadRequestError(f"correction key {key!r} is not one of the job's situation keys {situation}")
        kept.append({"statement": statement} if key is None else {"statement": statement, "key": key})
    return kept


def _contradicts(raw: list[str], cites: list[str], *, accepted: bool) -> list[str]:
    blamed = list(dict.fromkeys(str(item).lower() for item in raw))
    if blamed and accepted:
        raise BadRequestError("an accepted report cannot contradict a lesson")
    if unknown := [item for item in blamed if item not in cites]:
        raise BadRequestError(f"contradicts {unknown} are not lessons the job cited")
    return blamed


def report_outcome(
    db: Session,
    job_id: str,
    *,
    accepted: bool,
    attempts: int = 1,
    corrections: list[dict[str, str]] | None = None,
    contradicts: list[str] | None = None,
) -> None:
    """Record, in `db`'s own transaction, how a person took `job_id`'s result: `accepted` as it
    stood, or corrected (`accepted=False`) with `corrections` as `[{"statement", "key"?}]`, each a
    short testable lesson the correction teaches, `key` one of the job's situation keys (default the
    most specific). Corrections are dropped when the job declared `propose=False`.

    `contradicts` names the lessons the job cited that the correction showed wrong, and only those
    are blamed: a corrected report without it moves no posterior. Refused here, as core-memory would
    at delivery, on an accepted report or an id the job did not cite. Unlike corrections it is kept
    under `propose=False`: it names lesson ids, never the person's words.

    Insert-only and synchronous: no network call, no vend, ever happens here. `db` must already be
    bound to the job's workspace; the caller commits. A no-op when this deployment names no
    core-memory or the job declared no `lessons`. Filed for every such job, citing nothing or not, so
    core-memory's stats can set runs with lessons against runs without. First write wins: a later
    call for the same job is silently dropped.
    """
    if attempts < 1:
        raise BadRequestError("attempts must be at least 1")
    if not get_settings().agent.core_memory_url:
        return
    job = jobs_models.get_job(db, job_id)
    if job is None or job.lessons is None:
        return
    declared = job.lessons
    cites = cited(job)
    blamed = _contradicts(contradicts or [], cites, accepted=accepted)
    if job.structured_output is not None and "lessons_used" not in job.structured_output:
        logger.warning("Job %s's structured answer has no lessons_used key", job_id)
    settled = job.updated_at - job.created_at if job.updated_at and job.created_at else None
    jobs_models.insert_lesson_report_if_absent(
        db,
        job_id,
        workspace_id=job.workspace_id,
        domain_name=declared["domain"],
        situation=declared["situation"],
        accepted=accepted,
        loaded=declared["loaded"],
        cites=cites,
        attempts=attempts,
        seconds=settled.total_seconds() if settled is not None else None,
        model=job.model or job.persona,
        corrections=_corrections(corrections or [], declared["situation"]) if declared["propose"] else [],
        contradicts=blamed,
    )


@dataclass(frozen=True, slots=True)
class _Pending:
    """An unsettled report as the sweep reads it, detached from its session."""

    job_id: str
    workspace_id: int
    domain_name: str
    situation: list[str]
    accepted: bool
    loaded: list[str]
    cites: list[str]
    attempts: int
    seconds: float | None
    model: str
    corrections: list[dict[str, str]]
    contradicts: list[str]
    created_at: datetime.datetime


def _raise_failing_alert(db_session_factory: sessionmaker[Session], reason: str) -> None:
    """Raise or refresh the one pipeline-health alert — but never re-raise it UNCHANGED: `raise_alert`
    marks it unread on every call, so doing that on an unchanged reason would undo an operator's own
    dismissal every time a still-ongoing, already-known failure (or the misconfiguration check, which
    runs every sweep) repeats the same reason."""
    body = reason[:2000]
    with db_session_factory() as db:
        existing = db.execute(select(Alert.body).where(Alert.key == _FAILING_ALERT_KEY)).scalar_one_or_none()
        if existing == body:
            return
        alerts_service.raise_alert(
            db,
            AlertRaise(
                key=_FAILING_ALERT_KEY, title="The agent-jobs lesson report to core-memory is failing", body=body
            ),
        )
        db.commit()


def _clear_failing_alert(db_session_factory: sessionmaker[Session]) -> None:
    with db_session_factory() as db:
        alerts_service.clear_alert(db, _FAILING_ALERT_KEY)
        db.commit()


async def _note_transient(
    db_session_factory: sessionmaker[Session], job_id: str, created_at: datetime.datetime, exc: Exception
) -> bool:
    """A fault raised while a call was in flight — connection, DNS, an init or read timeout, a
    vend failure, or a `ToolError` FastMCP's own wrapper made ambiguous. Left unsettled; alerted,
    and reported as a failure to the caller's sweep, only once it has been failing long enough to
    matter."""
    logger.warning("Reporting job %s's lesson outcome failed transiently; will retry: %s", job_id, exc)
    stale = created_at < datetime.datetime.now(datetime.UTC) - _STALE_TRANSIENT_AFTER
    if stale:
        await run_in_threadpool(_raise_failing_alert, db_session_factory, f"still failing: {exc}"[:500])
    return stale


async def _deliver_or_abandon(
    db_session_factory: sessionmaker[Session], settings: AgentSettings, report: _Pending
) -> bool:
    """Claim `report`, then abandon it past `_ABANDON_AFTER` or attempt one delivery.
    Returns whether this report is (still) a failure, for the caller's sweep to decide whether ANY
    row failed this tick — a lone success must not clear the pipeline alert out from under a
    DIFFERENT row's refusal in the same sweep."""

    def _claim() -> datetime.datetime | None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=report.workspace_id)
            return jobs_models.claim_lesson_report(db, report.job_id, lease_seconds=_LEASE_SECONDS)

    token = await run_in_threadpool(_claim)
    if token is None:
        return False

    def _settle(refused: str | None) -> None:
        with db_session_factory() as db:
            bind_session(db, workspace_id=report.workspace_id)
            jobs_models.settle_lesson_report(db, report.job_id, claim_token=token, refused=refused)

    if report.created_at < datetime.datetime.now(datetime.UTC) - _ABANDON_AFTER:
        reason = f"abandoned: unsettled for over {_ABANDON_AFTER.days} days"
        await run_in_threadpool(_raise_failing_alert, db_session_factory, reason)
        await run_in_threadpool(_settle, reason)
        logger.error("Abandoned job %s's lesson report: %s", report.job_id, reason)
        return True

    arguments: dict[str, Any] = {
        "action": "report",
        "domain_name": report.domain_name,
        "situation": report.situation,
        "run_ref": report.job_id,
        "accepted": report.accepted,
        "loaded": report.loaded,
        "cited": report.cites,
        "attempts": report.attempts,
        "seconds": report.seconds,
        "model": report.model,
        "corrections": report.corrections,
            }
    if report.contradicts:
        arguments["contradicts"] = report.contradicts
    try:
        # Idempotent on run_ref (the job id): a retry after a lost response counts once.
        await _call(settings, arguments, timeout=_DELIVER_TIMEOUT_SECONDS)
    except ToolError as exc:
        if _is_transient_tool_error(str(exc)):
            return await _note_transient(db_session_factory, report.job_id, report.created_at, exc)
        reason = str(exc)[:500]
        await run_in_threadpool(_raise_failing_alert, db_session_factory, reason)
        await run_in_threadpool(_settle, reason)
        logger.warning("core-memory refused job %s's lesson report: %s", report.job_id, reason)
        return True
    except Exception as exc:
        return await _note_transient(db_session_factory, report.job_id, report.created_at, exc)

    await run_in_threadpool(_settle, None)
    return False


async def retry_unsettled(
    db_session_factory: sessionmaker[Session], settings: AgentSettings, stopping: asyncio.Event
) -> None:
    """Deliver up to `_MAX_PER_SWEEP` unsettled lesson reports to core-memory. Run from
    `jobs.supervise()`'s sweep — the only place this slice ever reports to core-memory.
    """
    if not settings.core_memory_url:
        return
    if not settings.core_memory_credential:
        await run_in_threadpool(
            _raise_failing_alert,
            db_session_factory,
            "misconfigured: core_memory_url is set but core_memory_credential is empty",
        )
        return

    def _pending() -> list[_Pending]:
        with db_session_factory() as db, unscoped(db):
            rows = (
                db.execute(
                    select(AgentJobLessonReport)
                    .where(
                        AgentJobLessonReport.recorded_at.is_(None),
                        or_(
                            AgentJobLessonReport.claimed_until.is_(None),
                            AgentJobLessonReport.claimed_until < func.now(),
                        ),
                    )
                    .order_by(AgentJobLessonReport.created_at)
                    .limit(_MAX_PER_SWEEP)
                )
                .scalars()
                .all()
            )
            return [
                _Pending(
                    job_id=row.job_id,
                    workspace_id=row.workspace_id,
                    domain_name=row.domain_name,
                    situation=list(row.situation),
                    accepted=row.accepted,
                    loaded=list(row.loaded),
                    cites=list(row.cites),
                    attempts=row.attempts,
                    seconds=row.seconds,
                    model=row.model,
                    corrections=list(row.corrections),
                    contradicts=list(row.contradicts),
                    created_at=row.created_at,
                )
                for row in rows
            ]

    failed = False
    for report in await run_in_threadpool(_pending):
        if stopping.is_set():
            return
        if await _deliver_or_abandon(db_session_factory, settings, report):
            failed = True
    if not failed:
        await run_in_threadpool(_clear_failing_alert, db_session_factory)
