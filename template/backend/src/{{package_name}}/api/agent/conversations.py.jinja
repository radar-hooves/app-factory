"""A person's conversations with a persona: `agent_conversations`.

The agent keeps every word in its own transcript (Claude Code's), so a row
here holds only what the agent cannot: whose the conversation is, which
persona it is with, its title, and whether an answer is being written.
`--resume` resolves a session for whoever presents its id
(radar-hooves/library#125, measured), so a conversation is reached only
through its row, and a foreign or unknown id gets one answer.

The public id is this slice's own, minted before the agent starts, so a stop
has an address from the first second; the agent's own session id is claimed
from its `init` event into `session_id`.

`turns` is this slice's record of every question asked: when, its words as
the agent was sent them, whether the agent holds an answer to it, what the
page asked for when it was not a plain question (a briefing), the one
collection it was narrowed to, the passages retrieved for it (`citations`),
the names of the files that came with it (`files`), each version of a
document the agent wrote answering it (`artefacts`) and the person's mark
on the answer. An edited question waits at the end of the record, marked
with the place it `replaces`, until the agent takes it; it then replaces
that record and every one after it (`replace`), or, if the agent never
takes it, goes (`withdraw`). The agent's transcript lists only
answered questions; the page counts every question it asked. `merged`
reconciles the two, so a question stopped before the agent took it neither
vanishes from a reopened conversation nor shifts a mark or a share onto
every answer after it.

`shared` lists the answers, by that same count, that the person has shared
read-only with whoever may enter the persona's chat. Nothing is shared by
default, and the words stay in the agent's transcript: a share is a place in
this list, never a copy, so a deleted conversation takes its shares with it.
"""

import datetime
import uuid
from dataclasses import dataclass, field
from typing import Any

from sqlalchemy import JSON, Boolean, DateTime, ForeignKey, Index, String, false, func, or_, select, update
from sqlalchemy.orm import Mapped, Session, mapped_column

from {{ package_name }}.db.base import Base, TimestampMixin

#: How often the worker holding a turn says it is still alive.
HEARTBEAT_SECONDS = 10.0
#: A stamp this old belongs to a worker that died mid-turn: not answering.
STALE_SECONDS = 90.0
TITLE_LENGTH = 80


class AgentConversation(Base, TimestampMixin):
    """One person's conversation with one persona."""

    __tablename__ = "agent_conversations"
    __table_args__ = (Index("ix_agent_conversations_owner", "user_id", "persona", "last_activity_at"),)

    #: A UUID minted here; a conversation carried over from `agent_sessions` keeps its agent's id.
    id: Mapped[str] = mapped_column(String(128), primary_key=True)
    #: The agent's own id, a string because its format is the agent's to change.
    session_id: Mapped[str | None] = mapped_column(String(128))
    #: CASCADE: personal-subject to whoever asked, so a deleted account takes its conversations.
    user_id: Mapped[uuid.UUID] = mapped_column(ForeignKey("users.id", ondelete="CASCADE"), nullable=False)
    persona: Mapped[str] = mapped_column(String(64), nullable=False)
    title: Mapped[str] = mapped_column(String(200), nullable=False)
    #: Also the heartbeat while an answer is being written.
    last_activity_at: Mapped[datetime.datetime] = mapped_column(
        DateTime(timezone=True), nullable=False, server_default=func.now()
    )
    turns: Mapped[list[dict[str, Any]]] = mapped_column(JSON, nullable=False, default=list, server_default="[]")
    answering_since: Mapped[datetime.datetime | None] = mapped_column(DateTime(timezone=True))
    stop_requested: Mapped[bool] = mapped_column(Boolean, nullable=False, default=False, server_default=false())
    #: The answers shared read-only, by the page's count.
    shared: Mapped[list[int]] = mapped_column(JSON, nullable=False, default=list, server_default="[]")


@dataclass(frozen=True, slots=True)
class Turn:
    """One question as the page reads it back, and the agent's own position for its answer."""

    question: str
    answer: str
    at: datetime.datetime | None
    citations: list[dict[str, Any]] = field(default_factory=list)
    #: Where the agent lists this answer; None when it holds none.
    agent_index: int | None = None
    #: What the page asked for (`briefing`); None for a question.
    kind: str | None = None
    #: The one collection the question was narrowed to; None asked across every one.
    collection: str | None = None
    #: The person's mark on the answer: `{"helpful": bool, "note": str | None}`.
    mark: dict[str, Any] | None = None
    #: The names of the files the question came with.
    files: list[str] = field(default_factory=list)
    #: Each document version the agent wrote answering it: `{"name", "version", "media_type", "formats", "title", "kind", "changes", "pages"}`.
    artefacts: list[dict[str, Any]] = field(default_factory=list)
    #: Every tool the agent called answering it, from its transcript.
    steps: tuple[Any, ...] = ()
    #: The one subject the question was narrowed to; None where it was not.
    group: str | None = None


def now() -> datetime.datetime:
    return datetime.datetime.now(datetime.UTC)


def owned(db: Session, conversation_id: str, user_id: uuid.UUID) -> AgentConversation | None:
    """The conversation, if it is `user_id`'s; None for another person's and for none alike."""
    found = db.get(AgentConversation, conversation_id)
    return found if found is not None and found.user_id == user_id else None


def answering(conversation: AgentConversation) -> datetime.datetime | None:
    """When the answer being written began, or None: nothing is, or the worker writing it is gone."""
    since = conversation.answering_since
    if since is None or conversation.last_activity_at < now() - datetime.timedelta(seconds=STALE_SECONDS):
        return None
    return since


def in_flight(db: Session) -> int:
    """How many turns are being answered, on every worker: stamped, and its worker still beating."""
    stale = now() - datetime.timedelta(seconds=STALE_SECONDS)
    return db.execute(
        select(func.count())
        .select_from(AgentConversation)
        .where(AgentConversation.answering_since.is_not(None), AgentConversation.last_activity_at >= stale)
    ).scalar_one()


def begin(
    db: Session,
    *,
    user_id: uuid.UUID,
    persona: str,
    question: str,
    conversation: AgentConversation | None,
    kind: str | None = None,
    collection: str | None = None,
    group: str | None = None,
    files: list[str] | None = None,
    edit: int | None = None,
) -> AgentConversation | None:
    """Stamp a turn as being answered and record its question; a new conversation when `conversation` is None.

    `edit` is the place of the question this one replaces, recorded beside
    it until the agent takes it (`replace`). Commits, so a stop landing on
    any worker finds the row. None when the conversation is already being
    answered: the stamp is taken by one conditional UPDATE, so two asks
    racing on two workers cannot both win.
    """
    at = now()
    record: dict[str, Any] = {"at": at.isoformat(), "question": question, "answered": False}
    if kind:
        record["kind"] = kind
    if collection:
        record["collection"] = collection
    if group:
        record["group"] = group
    if files:
        record["files"] = files
    if edit is not None:
        record["replaces"] = edit
    if conversation is None:
        conversation = AgentConversation(
            id=str(uuid.uuid4()),
            user_id=user_id,
            persona=persona,
            title=" ".join(question.split())[:TITLE_LENGTH],
            last_activity_at=at,
            turns=[record],
            answering_since=at,
            stop_requested=False,
        )
        db.add(conversation)
        db.commit()
        return conversation
    stale = at - datetime.timedelta(seconds=STALE_SECONDS)
    taken = db.execute(
        update(AgentConversation)
        .where(
            AgentConversation.id == conversation.id,
            or_(AgentConversation.answering_since.is_(None), AgentConversation.last_activity_at < stale),
        )
        .values(answering_since=at, last_activity_at=at, stop_requested=False)
        .execution_options(synchronize_session=False)
    )
    if taken.rowcount != 1:  # type: ignore[attr-defined]
        db.rollback()
        return None
    db.refresh(conversation)
    conversation.turns = [*conversation.turns, record]
    db.commit()
    return conversation


def replace(db: Session, conversation_id: str, position: int, edit: int, session_id: str | None) -> str | None:
    """The edited question at `position`, taken by the agent, replaces question `edit` and every one after it.

    Their shares go with them. `session_id` is a new session the agent
    started for a conversation it kept no answer of; the one it replaces is
    returned, to be forgotten.
    """
    conversation = db.get(AgentConversation, conversation_id, with_for_update=True)
    if conversation is None or position >= len(conversation.turns):
        return None
    record = {key: value for key, value in conversation.turns[position].items() if key != "replaces"}
    conversation.turns = [*conversation.turns[:edit], record]
    conversation.shared = [place for place in conversation.shared if place < edit]
    replaced = None
    if session_id is not None:
        replaced, conversation.session_id = conversation.session_id, session_id
    db.commit()
    return replaced


def withdraw(db: Session, conversation_id: str, position: int) -> None:
    """Take back an edited question the agent never took: the conversation stays as it was."""
    conversation = db.get(AgentConversation, conversation_id, with_for_update=True)
    if conversation is None or position >= len(conversation.turns) or "replaces" not in conversation.turns[position]:
        return
    conversation.turns = [*conversation.turns[:position], *conversation.turns[position + 1 :]]
    db.commit()


def claim(db: Session, conversation_id: str, session_id: str) -> None:
    """Record the agent's own id for the conversation, the first time it names one."""
    db.execute(
        update(AgentConversation)
        .where(AgentConversation.id == conversation_id, AgentConversation.session_id.is_(None))
        .values(session_id=session_id)
    )
    db.commit()


def answered(db: Session, conversation_id: str, position: int) -> None:
    """The agent holds an answer to question `position`: its transcript lists it."""
    _record(db, conversation_id, position, answered=True)


def made(db: Session, conversation_id: str, position: int, artefact: dict[str, Any]) -> None:
    """Record a version of a document the agent wrote answering question `position`."""
    conversation = db.get(AgentConversation, conversation_id)
    if conversation is None or position >= len(conversation.turns):
        return
    _record(db, conversation_id, position, artefacts=[*conversation.turns[position].get("artefacts", []), artefact])


def cite(db: Session, conversation_id: str, position: int, citations: list[dict[str, Any]]) -> None:
    """Record the passages retrieved for question `position`, as the page was shown them."""
    _record(db, conversation_id, position, citations=citations)


def mark(db: Session, conversation: AgentConversation, position: int, *, helpful: bool, note: str | None) -> None:
    """Mark answer `position` helpful or not; a second mark replaces the first."""
    _record(db, conversation.id, position, mark={"helpful": helpful, "note": note})


def _record(db: Session, conversation_id: str, position: int, **fields: Any) -> None:
    """Set `fields` on question `position`'s record; nothing when the conversation or the question is gone."""
    conversation = db.get(AgentConversation, conversation_id)
    if conversation is None or position >= len(conversation.turns):
        return
    turns = [dict(turn) for turn in conversation.turns]
    turns[position].update(fields)
    conversation.turns = turns
    db.commit()


def beat(db: Session, conversation_id: str) -> bool:
    """Say the turn is alive; True when a stop has been asked for."""
    db.execute(update(AgentConversation).where(AgentConversation.id == conversation_id).values(last_activity_at=now()))
    db.commit()
    return stop_wanted(db, conversation_id)


def stop_wanted(db: Session, conversation_id: str) -> bool:
    return bool(
        db.execute(
            select(AgentConversation.stop_requested).where(AgentConversation.id == conversation_id)
        ).scalar_one_or_none()
    )


def request_stop(db: Session, conversation: AgentConversation) -> None:
    """Ask whichever worker holds the turn to end it; nothing when none is being answered."""
    if answering(conversation) is not None:
        conversation.stop_requested = True
        db.commit()


def settle(db: Session, conversation_id: str) -> None:
    db.execute(
        update(AgentConversation)
        .where(AgentConversation.id == conversation_id)
        .values(answering_since=None, stop_requested=False, last_activity_at=now())
    )
    db.commit()


def share(db: Session, conversation: AgentConversation, position: int, *, shared: bool) -> None:
    """Share answer `position` read-only with whoever may enter the persona's chat, or stop sharing it."""
    db.refresh(conversation, with_for_update=True)  # two taps racing cannot lose one
    rest = [p for p in conversation.shared if p != position]
    conversation.shared = sorted([*rest, position]) if shared else rest
    db.commit()


def listed(db: Session, user_id: uuid.UUID, persona: str) -> list[AgentConversation]:
    """`user_id`'s conversations with `persona`, most recently active first."""
    return list(
        db.execute(
            select(AgentConversation)
            .where(AgentConversation.user_id == user_id, AgentConversation.persona == persona)
            .order_by(AgentConversation.last_activity_at.desc())
        ).scalars()
    )


def merged(conversation: AgentConversation, agent_turns: list[Any]) -> list[Turn]:
    """Every question asked, each with the agent's answer where it holds one.

    The agent's words are its transcript's; everything else (the question,
    its time, the passages, the collection, the mark) is this record's, since
    each is known before the agent is, or is the app's alone.
    """
    turns = []
    index = 0
    for record in conversation.turns:
        at = datetime.datetime.fromisoformat(record["at"])
        answered = record.get("answered") and index < len(agent_turns)
        turns.append(
            Turn(
                record["question"],
                agent_turns[index].answer if answered else "",
                at,
                list(record.get("citations") or []),
                index if answered else None,
                record.get("kind"),
                record.get("collection"),
                record.get("mark"),
                list(record.get("files") or []),
                list(record.get("artefacts") or []),
                tuple(getattr(agent_turns[index], "steps", ())) if answered else (),
                record.get("group"),
            )
        )
        index += bool(answered)
    return turns


def markdown(title: str, persona_name: str, turns: list[Turn], zone: datetime.tzinfo) -> str:
    """The conversation as a reader keeps it: each question, quoted, then its answer."""
    lines = [f"# {title}", "", f"_{persona_name}_", ""]
    for turn in turns:
        when = f" · {turn.at.astimezone(zone):%d/%m/%Y %H:%M}" if turn.at else ""
        quoted = "\n".join(f"> {line}" for line in turn.question.splitlines() or [""])
        lines += [f"**Asked**{when}", "", quoted, "", turn.answer or "_No answer._", ""]
    return "\n".join(lines)
