"""A person's conversations with a room's agent: `agent_conversations`.

The agent keeps every word in its own transcript (Claude Code's, or the
library's), so a row here holds only what the agent cannot: whose the
conversation is, which room it is in, its title, and whether an answer is
being written. `--resume` resolves a session for whoever presents its id
(radar-hooves/library#125, measured), so a conversation is reached only
through its row, and a foreign or unknown id gets one answer.

The public id is this slice's own, minted before the agent starts, so a stop
has an address from the first second; the agent's own session id is claimed
from its `init` event into `session_id`. A local persona and the library mint
theirs at different moments, and the library only once the question leaves
its queue, which is why the two are not the same column.

`turns` is this slice's record of every question asked: when, its words as
the agent was sent them, whether the agent holds an answer to it, and what
the page asked for when it was not a plain question (a briefing). The
agent's transcript lists only answered questions, and the library keys an
answer mark by that list's position; the page counts every question it
asked. `merged` reconciles the two, so a question stopped before the agent
took it neither vanishes from a reopened conversation nor shifts the mark on
every answer after it.

`shared` lists the answers, by that same count, that the person has shared
read-only with whoever may enter the room. Nothing is shared by default, and
the words stay in the agent's transcript: a share is a place in this list,
never a copy, so a deleted conversation takes its shares with it.
"""

import datetime
import uuid
from dataclasses import dataclass, field
from typing import Any, Literal

from sqlalchemy import JSON, Boolean, DateTime, ForeignKey, Index, String, false, func, or_, select, update
from sqlalchemy.orm import Mapped, Session, mapped_column

from {{ package_name }}.db.base import Base, TimestampMixin

#: How often the worker holding a turn says it is still alive.
HEARTBEAT_SECONDS = 10.0
#: A stamp this old belongs to a worker that died mid-turn: not answering.
STALE_SECONDS = 90.0
TITLE_LENGTH = 80


class AgentConversation(Base, TimestampMixin):
    """One person's conversation in one room."""

    __tablename__ = "agent_conversations"
    __table_args__ = (Index("ix_agent_conversations_owner", "user_id", "room", "last_activity_at"),)

    #: A UUID minted here; a conversation carried over from `agent_sessions` keeps its agent's id.
    id: Mapped[str] = mapped_column(String(128), primary_key=True)
    #: The agent's own id, a string because its format is the agent's to change.
    session_id: Mapped[str | None] = mapped_column(String(128))
    #: CASCADE: personal-subject to whoever asked, so a deleted account takes its conversations.
    user_id: Mapped[uuid.UUID] = mapped_column(ForeignKey("users.id", ondelete="CASCADE"), nullable=False)
    room: Mapped[str] = mapped_column(String(64), nullable=False)
    title: Mapped[str] = mapped_column(String(200), nullable=False)
    #: Also the heartbeat while an answer is being written.
    last_activity_at: Mapped[datetime.datetime] = mapped_column(
        DateTime(timezone=True), nullable=False, server_default=func.now()
    )
    turns: Mapped[list[dict[str, Any]]] = mapped_column(JSON, nullable=False, default=list, server_default="[]")
    answering_since: Mapped[datetime.datetime | None] = mapped_column(DateTime(timezone=True))
    stop_requested: Mapped[bool] = mapped_column(Boolean, nullable=False, default=False, server_default=false())
    #: The answers shared read-only, by the page's count.
    shared: Mapped[list[int]] = mapped_column(JSON, nullable=False, default=list, server_default="[]")


@dataclass(frozen=True, slots=True)
class Turn:
    """One question as the page reads it back, and the agent's own position for its answer."""

    question: str
    answer: str
    at: datetime.datetime | None
    citations: list[dict[str, Any]] = field(default_factory=list)
    #: Where the agent lists this answer; None when it holds none.
    agent_index: int | None = None
    #: What the page asked for (`briefing`); None for a question.
    kind: str | None = None
    #: How hard the agent was asked to work; None for a room that offers no choice.
    depth: Literal["quick", "thorough"] | None = None


def now() -> datetime.datetime:
    return datetime.datetime.now(datetime.UTC)


def owned(db: Session, conversation_id: str, user_id: uuid.UUID) -> AgentConversation | None:
    """The conversation, if it is `user_id`'s; None for another person's and for none alike."""
    found = db.get(AgentConversation, conversation_id)
    return found if found is not None and found.user_id == user_id else None


def answering(conversation: AgentConversation) -> datetime.datetime | None:
    """When the answer being written began, or None: nothing is, or the worker writing it is gone."""
    since = conversation.answering_since
    if since is None or conversation.last_activity_at < now() - datetime.timedelta(seconds=STALE_SECONDS):
        return None
    return since


def begin(
    db: Session,
    *,
    user_id: uuid.UUID,
    room: str,
    question: str,
    conversation: AgentConversation | None,
    kind: str | None = None,
    depth: Literal["quick", "thorough"] | None = None,
) -> AgentConversation | None:
    """Stamp a turn as being answered and record its question; a new conversation when `conversation` is None.

    Commits, so a stop landing on any worker finds the row. None when the
    conversation is already being answered: the stamp is taken by one
    conditional UPDATE, so two asks racing on two workers cannot both win.
    """
    at = now()
    record: dict[str, Any] = {"at": at.isoformat(), "question": question, "answered": False}
    if kind:
        record["kind"] = kind
    if depth:
        record["depth"] = depth
    if conversation is None:
        conversation = AgentConversation(
            id=str(uuid.uuid4()),
            user_id=user_id,
            room=room,
            title=" ".join(question.split())[:TITLE_LENGTH],
            last_activity_at=at,
            turns=[record],
            answering_since=at,
            stop_requested=False,
        )
        db.add(conversation)
        db.commit()
        return conversation
    stale = at - datetime.timedelta(seconds=STALE_SECONDS)
    taken = db.execute(
        update(AgentConversation)
        .where(
            AgentConversation.id == conversation.id,
            or_(AgentConversation.answering_since.is_(None), AgentConversation.last_activity_at < stale),
        )
        .values(answering_since=at, last_activity_at=at, stop_requested=False)
        .execution_options(synchronize_session=False)
    )
    if taken.rowcount != 1:  # type: ignore[attr-defined]
        db.rollback()
        return None
    db.refresh(conversation)
    conversation.turns = [*conversation.turns, record]
    db.commit()
    return conversation


def claim(db: Session, conversation_id: str, session_id: str) -> None:
    """Record the agent's own id for the conversation, the first time it names one."""
    db.execute(
        update(AgentConversation)
        .where(AgentConversation.id == conversation_id, AgentConversation.session_id.is_(None))
        .values(session_id=session_id)
    )
    db.commit()


def answered(db: Session, conversation_id: str, position: int) -> None:
    """The agent holds an answer to question `position`: its transcript lists it."""
    conversation = db.get(AgentConversation, conversation_id)
    if conversation is None or position >= len(conversation.turns):
        return
    turns = [dict(turn) for turn in conversation.turns]
    turns[position]["answered"] = True
    conversation.turns = turns
    db.commit()


def beat(db: Session, conversation_id: str) -> bool:
    """Say the turn is alive; True when a stop has been asked for."""
    db.execute(update(AgentConversation).where(AgentConversation.id == conversation_id).values(last_activity_at=now()))
    db.commit()
    return stop_wanted(db, conversation_id)


def stop_wanted(db: Session, conversation_id: str) -> bool:
    return bool(
        db.execute(
            select(AgentConversation.stop_requested).where(AgentConversation.id == conversation_id)
        ).scalar_one_or_none()
    )


def request_stop(db: Session, conversation: AgentConversation) -> None:
    """Ask whichever worker holds the turn to end it; nothing when none is being answered."""
    if answering(conversation) is not None:
        conversation.stop_requested = True
        db.commit()


def settle(db: Session, conversation_id: str) -> None:
    db.execute(
        update(AgentConversation)
        .where(AgentConversation.id == conversation_id)
        .values(answering_since=None, stop_requested=False, last_activity_at=now())
    )
    db.commit()


def share(db: Session, conversation: AgentConversation, position: int, *, shared: bool) -> None:
    """Share answer `position` read-only with whoever may enter the room, or stop sharing it."""
    db.refresh(conversation, with_for_update=True)  # two taps racing cannot lose one
    rest = [p for p in conversation.shared if p != position]
    conversation.shared = sorted([*rest, position]) if shared else rest
    db.commit()


def listed(db: Session, user_id: uuid.UUID, room: str) -> list[AgentConversation]:
    """`user_id`'s conversations in `room`, most recently active first."""
    return list(
        db.execute(
            select(AgentConversation)
            .where(AgentConversation.user_id == user_id, AgentConversation.room == room)
            .order_by(AgentConversation.last_activity_at.desc())
        ).scalars()
    )


def merged(conversation: AgentConversation, agent_turns: list[Any]) -> list[Turn]:
    """Every question asked, each with the agent's answer where it holds one.

    Answers the agent holds beyond this record came before it (a conversation
    carried over from before the record was kept) and lead. The agent's
    words are its transcript's; the question and its time are this record's,
    since both are known before the agent is.
    """
    held = sum(1 for record in conversation.turns if record.get("answered"))
    lead = max(len(agent_turns) - held, 0)
    turns = [
        Turn(question=t.question, answer=t.answer, at=t.at, citations=list(t.citations), agent_index=index)
        for index, t in enumerate(agent_turns[:lead])
    ]
    index = lead
    for record in conversation.turns:
        at = datetime.datetime.fromisoformat(record["at"])
        if record.get("answered") and index < len(agent_turns):
            answer = agent_turns[index]
            turns.append(
                Turn(
                    record["question"],
                    answer.answer,
                    at,
                    list(answer.citations),
                    index,
                    record.get("kind"),
                    record.get("depth"),
                )
            )
            index += 1
        else:
            turns.append(Turn(record["question"], "", at, kind=record.get("kind"), depth=record.get("depth")))
    return turns


def markdown(title: str, room_title: str, turns: list[Turn], zone: datetime.tzinfo) -> str:
    """The conversation as a reader keeps it: each question, quoted, then its answer."""
    lines = [f"# {title}", "", f"_{room_title}_", ""]
    for turn in turns:
        when = f" · {turn.at.astimezone(zone):%d/%m/%Y %H:%M}" if turn.at else ""
        quoted = "\n".join(f"> {line}" for line in turn.question.splitlines() or [""])
        lines += [f"**Asked**{when}", "", quoted, "", turn.answer or "_No answer._", ""]
    return "\n".join(lines)
