"""The personas this app offers for chat, from `config/chat.yaml` (`app-factory docs/design/agent-console.md` §Chat).

A persona is a directory under `config/personas/<id>/` (CLAUDE.md, settings.json,
.mcp.json); a row of `chat.yaml` offers it for chat, and one `chat-<id>`
entitlement lets a person in. A persona with `collections: true` first
retrieves passages from the library as the person asking, and answers from
them; one without answers from its own files. Which collections a person may
read is the library's answer, never this app's, so the file names none. The
library token, minted afresh for the turn, reaches the persona's own session as `LIBRARY_TOKEN`, with the
library's caller mount as `LIBRARY_URL`, so a persona whose `.mcp.json` names
the library's reader door (`${LIBRARY_URL}/mcp/`, `Bearer ${LIBRARY_TOKEN}`)
searches it again as the same person when its passages fall short.

A persona with `attachments: false` is offered with no attach control, and a
question to it carrying files is refused unread (a persona that may not read
what it is handed, or must not be handed it). The default is true.

A persona's `visuals` lists the fence languages its page draws inside an
answer (`agent_common.visuals`); it is told the format of each, from the
factory's fragment or its own `visuals/<language>.md`.

A persona's `models` maps entitlements to model aliases (`admin: saiyan/sonnet`):
a turn is asked on the first one its caller holds, with no control shown to
them, and on `model` when they hold none. A persona with neither keeps the
`model` of its settings.json. `--model` outranks that file, so the row decides.

The file is committed and released like code and has no admin surface, so a
wrong row is refused at start rather than met by a colleague: `load` raises on
an id that is not a path segment, a row with no name, or no such persona
directory, or a `visuals` entry with no prompt fragment. An app with no file offers no chat. A persona that reads
collections in a deployment with no library configured is not a wrong row:
the app starts, logs which persona waits on which setting, and that persona
answers 503 until it is set.
"""

import asyncio
import builtins
import dataclasses
import datetime
import functools
import hashlib
import json
import logging
import os
import re
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import yaml
from agent_common import persona as agent_persona
from agent_common import visuals
from agent_common.agent import LocalAgent
from agent_common.collections import Collection, Collections, Subject
from starlette.concurrency import run_in_threadpool

from {{ package_name }}.api.agent import persona as persona_module
from {{ package_name }}.config.sections.agent import AgentSettings
from {{ package_name }}.entitlements import CHAT_PREFIX, has_module
from {{ package_name }}.exceptions import NotFoundError, ServiceUnavailableError
from {{ package_name }}.exchange import ASKER_TOKEN, Asking

logger = logging.getLogger(__name__)

#: A persona's id is a path segment and half an entitlement name.
_ID = re.compile(r"\A[a-z0-9][a-z0-9-]{0,62}\Z")
#: The slice's own first path segments, which a persona's routes would sit behind.
_RESERVED = frozenset({"personas", "conversations", "quota"})
#: What a persona that reads collections waits on.
_LIBRARY_URL = "{{ project_name | upper | replace('-', '_') }}_AGENT_LIBRARY_URL"

#: How long a turn waits on the library to list and search before it fails; retrieval is on the answer path.
RETRIEVAL_SECONDS = 15.0

#: How long a person's collection listing is reused. The library cuts every search to what the person may read, so a stale listing cannot widen access; it can only show a change late.
LISTING_SECONDS = 300.0

#: The variables a turn's session reads the library by, as the person asking.
LIBRARY_URL = "LIBRARY_URL"
LIBRARY_TOKEN = "LIBRARY_TOKEN"

#: Under a persona's directory, the brand its documents are rendered in (`agent_common.documents`).
DOCUMENTS = "documents"

#: Under a persona's directory, its own prompt fragments for the fenced visuals it may write (`agent_common.visuals`).
VISUALS = "visuals"


class ChatInvalid(ValueError):
    """`config/chat.yaml` offers a persona this app cannot open."""


@dataclass(frozen=True, slots=True)
class Persona:
    """A persona offered for chat: how the page introduces it, and whether it reads the library's collections."""

    id: str
    name: str
    blurb: str = ""
    examples: tuple[str, ...] = ()
    not_held: str = ""
    collections: bool = False
    visuals: tuple[str, ...] = ()
    #: Whether a question may carry files; false offers no attach control and refuses any.
    attachments: bool = True
    #: The model alias a caller holding none of `models`' entitlements is answered on; empty keeps settings.json's own.
    model: str = ""
    #: Entitlement to model alias, in file order: the first a caller holds answers them (`model_for`).
    models: tuple[tuple[str, str], ...] = ()

    @property
    def entitlement(self) -> str:
        return f"{CHAT_PREFIX}{self.id}"


def model_for(persona: Persona, entitlements: tuple[str, ...]) -> str | None:
    """The model alias to answer a caller holding `entitlements` on: the first of the persona's `models` they hold, else its `model`, else None (settings.json's own)."""
    for entitlement, alias in persona.models:
        if has_module(entitlements, entitlement):
            return alias
    return persona.model or None


def load(settings: AgentSettings) -> dict[str, Persona]:
    """Every persona in `settings.chat_file`, validated; none when there is no file.

    Read once per file version: an edit reaches the next request, as a
    persona's does.

    Raises:
        ChatInvalid: the file offers a persona this app cannot open.
    """
    path = settings.chat_file
    try:
        version = path.stat().st_mtime_ns
    except FileNotFoundError:
        return {}
    return _load(path, version, settings.personas_dir, bool(settings.library_url))


def get(settings: AgentSettings, persona_id: str) -> Persona:
    """The persona `persona_id`.

    Raises:
        NotFoundError: this app offers no such persona for chat.
    """
    persona = load(settings).get(persona_id)
    if persona is None:
        raise NotFoundError(f"No persona named {persona_id!r}")
    return persona


async def agent(
    settings: AgentSettings, persona: Persona, asking: Asking, *, turn: bool = False, model: str | None = None
) -> LocalAgent:
    """The persona's agent for the person `asking` names, at the chat effort, on `model` when given (`model_for`).

    A `turn` asks `app_hooks.agent_turn_settings` for its effort and thinking.
    A `turn` carries a token minted for this app in its environment as
    `ASKER_TOKEN`, which its `.mcp.json` presents to this app's `/mcp`. A
    deployment with no exchange runs its personas without one.

    Raises:
        AuthenticationError: Authentik refused the person.
    """
    run_env = {ASKER_TOKEN: await asking.token()} if turn and asking.exchange.configured else {}
    effort, thinking = settings.chat_effort, settings.thinking
    if turn:
        effort, thinking = await _turn_settings(persona.id, effort, thinking)
    driver = dataclasses.replace(settings.driver(), effort=effort, thinking=thinking)
    guidance = (
        visuals.guidance(persona.visuals, settings.personas_dir / persona.id / VISUALS) if persona.visuals else ""
    )
    return LocalAgent(
        driver, persona_module.load(settings, persona.id), run_env=run_env, guidance=guidance, model=model
    )


async def _turn_settings(persona_id: str, effort: str, thinking: bool) -> tuple[str, bool]:
    """`app_hooks.agent_turn_settings(persona, effort, thinking)`, if this app defines one; the given pair if it raises."""
    from {{ package_name }} import app_hooks

    hook = getattr(app_hooks, "agent_turn_settings", None)
    if hook is None:
        return effort, thinking
    try:
        return await run_in_threadpool(hook, persona_id, effort, thinking)
    except Exception:
        logger.exception("app_hooks.agent_turn_settings failed for persona %s", persona_id)
        return effort, thinking


async def collections(settings: AgentSettings, persona: Persona, asking: Asking) -> Collections:
    """The library's collections, read as the person `asking` names, with a token the exchange mints for them.

    Raises:
        ServiceUnavailableError: this deployment names no library or cannot carry the person to it.
        AuthenticationError: Authentik refused the person.
    """
    return _reader(settings, await _library_token(settings, persona, asking), asking.uid)


async def for_turn(
    settings: AgentSettings, persona: Persona, asking: Asking, *, model: str | None = None
) -> tuple[LocalAgent, Collections | None]:
    """The persona's agent, on `model` when given (`model_for`), and, for one that reads collections, the library as the person: both tokens minted at once.

    The agent's session gets a library token minted now (`LIBRARY_TOKEN`), since
    it presents it for the whole turn; the retrieval reuses a held one.

    Raises:
        ServiceUnavailableError: as `collections`.
        AuthenticationError: as `agent` and `collections`.
    """
    cached = asking.held(settings.library_audience) if persona.collections and settings.library_url else None
    try:
        async with asyncio.TaskGroup() as group:
            asked = group.create_task(agent(settings, persona, asking, turn=True, model=model))
            token = (
                group.create_task(_library_token(settings, persona, asking, fresh=True))
                if persona.collections
                else None
            )
    except ExceptionGroup as failed:
        raise failed.exceptions[0] from None
    if token is None:
        return asked.result(), None
    reading = {**asked.result().run_env, LIBRARY_URL: settings.library_url, LIBRARY_TOKEN: token.result()}
    return dataclasses.replace(asked.result(), run_env=reading), _reader(settings, cached or token.result(), asking.uid)


def documents(settings: AgentSettings, persona: Persona) -> Path:
    """Where the persona's brand for Word and PDF lives: `reference.docx`, `template.typ`, `fonts/`."""
    return settings.personas_dir / persona.id / DOCUMENTS


async def _library_token(settings: AgentSettings, persona: Persona, asking: Asking, *, fresh: bool = False) -> str:
    if not settings.library_url:
        raise ServiceUnavailableError(
            "Collections are not available here yet", context={"persona": persona.id, "unset": _LIBRARY_URL}
        )
    return await (asking.fresh if fresh else asking.token)(settings.library_audience)


def _reader(settings: AgentSettings, token: str, uid: str) -> Collections:
    async def bearer() -> str:
        return token

    return _Listed(settings.library_url, bearer, timeout_seconds=RETRIEVAL_SECONDS, uid=uid)


#: Each person's listing, one file per (library, uid) in the container's tmpfs, so the whole worker pool shares it.
LISTINGS_DIR = Path(tempfile.gettempdir()) / "{{ package_name }}-listings"


def _listing_file(library: str, uid: str) -> Path:
    return LISTINGS_DIR / hashlib.sha256(f"{library}\0{uid}".encode()).hexdigest()


def held_listing(settings: AgentSettings, asking: Asking) -> builtins.list[Collection] | None:
    """The listing some worker fetched for this person within `LISTING_SECONDS`, else None; reading it needs no token."""
    if not (asking.uid and settings.library_url):
        return None
    return _held(_listing_file(settings.library_url, asking.uid))


def _held(path: Path) -> builtins.list[Collection] | None:
    try:
        if time.time() - path.stat().st_mtime >= LISTING_SECONDS:
            return None
        return [_collection(row) for row in json.loads(path.read_text())]
    except FileNotFoundError:
        return None
    except OSError, ValueError, TypeError, KeyError:
        logger.warning("Could not read the held collection listing %s", path.name, exc_info=True)
        return None


def _collection(row: dict[str, Any]) -> Collection:
    when, subject = row["documents_to"], row["subject"]
    return Collection(
        **{
            **row,
            "documents_to": datetime.date.fromisoformat(when) if when else None,
            "subject": Subject(**subject) if subject else None,
        }
    )


def _keep(path: Path, found: builtins.list[Collection]) -> None:
    rows = [{**dataclasses.asdict(c), "documents_to": c.documents_to and c.documents_to.isoformat()} for c in found]
    try:
        LISTINGS_DIR.mkdir(mode=0o700, exist_ok=True)
        now = time.time()
        for other in LISTINGS_DIR.iterdir():
            if now - other.stat().st_mtime >= LISTING_SECONDS:
                other.unlink(missing_ok=True)
        scratch = path.with_suffix(f".{os.getpid()}")
        scratch.write_text(json.dumps(rows))
        os.replace(scratch, path)
    except OSError:
        logger.warning("Could not hold the collection listing", exc_info=True)


@dataclass(frozen=True, slots=True)
class _Listed(Collections):
    """The library as `uid` reads it, with its listing held for `LISTING_SECONDS` across workers, so the page and the ask share one call."""

    uid: str = ""

    async def list(self) -> builtins.list[Collection]:
        if not self.uid:
            return await Collections.list(self)
        path = _listing_file(self.url, self.uid)
        if (held := await run_in_threadpool(_held, path)) is not None:
            return held
        found = await Collections.list(self)
        await run_in_threadpool(_keep, path, found)
        return found


@functools.lru_cache(maxsize=8)
def _load(path: Path, _version: int, personas_dir: Path, library: bool) -> dict[str, Persona]:
    raw = yaml.safe_load(path.read_text()) or {}
    if not isinstance(raw, dict):
        raise ChatInvalid(f"{path}: expected a mapping of persona id to row")
    directories = set(agent_persona.names(personas_dir))
    loaded = {
        str(persona_id): _persona(str(persona_id), body, directories, personas_dir) for persona_id, body in raw.items()
    }
    for persona in loaded.values():
        if persona.collections and not library:
            logger.warning(
                "Persona %r answers 503 until %s is set", persona.id, _LIBRARY_URL, extra={"persona": persona.id}
            )
    return loaded


def _persona(persona_id: str, body: object, directories: set[str], personas_dir: Path) -> Persona:
    def refuse(why: str) -> ChatInvalid:
        return ChatInvalid(f"persona {persona_id!r}: {why}")

    if not _ID.match(persona_id):
        raise refuse("an id is lowercase letters, digits and hyphens")
    if persona_id in _RESERVED:
        raise refuse(f"an id is not one of the chat's own route names ({', '.join(sorted(_RESERVED))})")
    if not isinstance(body, dict) or not str(body.get("name") or "").strip():
        raise refuse("needs a name")
    if persona_id not in directories:
        raise refuse(f"no persona directory {persona_id!r} under config/personas/")
    collections = body.get("collections", False)
    if not isinstance(collections, bool):
        raise refuse("collections is true or false")
    attachments = body.get("attachments", True)
    if not isinstance(attachments, bool):
        raise refuse("attachments is true or false")
    fences = body.get("visuals") or []
    if not isinstance(fences, list) or not all(isinstance(fence, str) for fence in fences):
        raise refuse("visuals is a list of fence languages")
    model = body.get("model") or ""
    if not isinstance(model, str):
        raise refuse("model is a model alias")
    routed = body.get("models") or {}
    if not isinstance(routed, dict) or not all(
        isinstance(k, str) and isinstance(v, str) and v for k, v in routed.items()
    ):
        raise refuse("models maps an entitlement to a model alias")
    for fence in fences:
        try:
            visuals.fragment(fence, personas_dir / persona_id / VISUALS)
        except ValueError:
            raise refuse(f"no prompt fragment for the visual {fence!r}") from None
    return Persona(
        id=persona_id,
        name=str(body["name"]).strip(),
        blurb=str(body.get("blurb") or "").strip(),
        examples=tuple(str(example) for example in body.get("examples") or ()),
        not_held=str(body.get("not_held") or "").strip(),
        collections=collections,
        visuals=tuple(fences),
        attachments=attachments,
        model=model.strip(),
        models=tuple((entitlement, alias.strip()) for entitlement, alias in routed.items()),
    )
