"""Persistence for an app-started persona job: the job row and its event log.

`api/agent/ownership.py`'s ``AgentSession`` is a private CONVERSATION issued
to one asker; a job is different in kind. It is started by the app itself
with no asker (`docs/design/agent-jobs.md`), runs independent of the request
that started it, and any caller entitled to the persona may watch, message or
stop it — so it carries no owning user, and every event Claude Code emits is
kept verbatim so a caller who opens the job after it started sees exactly
what one who watched live would have.

``job_id`` IS Claude Code's own session id: minted here before the CLI ever
runs (``--session-id`` on the first spawn, ``--resume`` on every one after),
so a caller has the id to watch from the moment ``jobs.start()`` returns
rather than waiting on an `init` event to learn it — `ownership.py`'s
claim-on-init dance is needed there because the CLI assigns the id; it is not
needed here because this slice assigns it.
"""

import datetime
from typing import Any

from sqlalchemy import BigInteger, DateTime, ForeignKey, String, Text, func, select
from sqlalchemy.dialects.postgresql import JSONB
from sqlalchemy.orm import Mapped, Session, mapped_column

from {{ package_name }}.db.base import Base, TimestampMixin

#: A job's lifecycle. ``running`` covers a fresh turn and a resumed one alike
#: — nothing here distinguishes them, because a watcher only ever needs to
#: know whether the process behind ``job_id`` is alive right now.
RUNNING, COMPLETED, FAILED, CANCELLED = "running", "completed", "failed", "cancelled"


class AgentJob(Base, TimestampMixin):
    """One app-started persona session: its persona, its status, and its
    structured answer once it has one."""

    __tablename__ = "agent_jobs"

    #: Claude Code's own session id, minted by `jobs.start()` before the CLI
    #: first runs. A str column, not a UUID one, for the same reason
    #: `ownership.AgentSession.session_id` is: the format is the CLI's to
    #: change, and a column that could reject a future one would refuse the
    #: job rather than record it.
    job_id: Mapped[str] = mapped_column(String(128), primary_key=True)
    persona: Mapped[str] = mapped_column(String(255), nullable=False, index=True)
    status: Mapped[str] = mapped_column(String(16), nullable=False, default=RUNNING)
    #: The `--json-schema` this job's turns are held to, replayed on every
    #: resume so a later message (`jobs.send_message`, once the process has
    #: exited) answers under the SAME contract the caller that started the
    #: job asked for — never re-supplied by whoever sends that message, who
    #: may not even know it.
    json_schema: Mapped[dict[str, Any] | None] = mapped_column(JSONB, nullable=True)
    #: `--append-system-prompt`, held for the same reason as `json_schema`.
    append_system_prompt: Mapped[str | None] = mapped_column(Text, nullable=True)
    #: The final turn's structured answer, set once `status` leaves `running`
    #: and only when a `json_schema` was given.
    structured_output: Mapped[dict[str, Any] | None] = mapped_column(JSONB, nullable=True)
    #: What went wrong, when `status == "failed"`.
    error: Mapped[str | None] = mapped_column(Text, nullable=True)


class AgentJobEvent(Base):
    """One Claude Code event, kept verbatim, in the order it landed.

    No `TimestampMixin`: `recorded_at` alone is what a replay needs, and
    `updated_at` would claim an event is ever revised, which it never is.
    """

    __tablename__ = "agent_job_events"

    id: Mapped[int] = mapped_column(BigInteger, primary_key=True, autoincrement=True)
    job_id: Mapped[str] = mapped_column(ForeignKey("agent_jobs.job_id", ondelete="CASCADE"), nullable=False, index=True)
    #: The event exactly as Claude Code printed it — never reshaped, per the
    #: household rule this whole slice is built on: the stream is Claude
    #: Code's own vocabulary, never this app's.
    event: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False)
    recorded_at: Mapped[datetime.datetime] = mapped_column(DateTime(timezone=True), server_default=func.now())


def create_job(
    db: Session,
    *,
    job_id: str,
    persona: str,
    json_schema: dict[str, Any] | None,
    append_system_prompt: str | None,
) -> None:
    """Insert the job row and commit — the caller has the id back before the CLI has even started."""
    db.add(
        AgentJob(
            job_id=job_id,
            persona=persona,
            status=RUNNING,
            json_schema=json_schema,
            append_system_prompt=append_system_prompt,
        )
    )
    db.commit()


def get_job(db: Session, job_id: str) -> AgentJob | None:
    return db.get(AgentJob, job_id)


def record_event(db: Session, job_id: str, event: dict[str, Any]) -> int:
    """Append one event, verbatim, and commit. Returns its `id` — the monotonic
    `seq` `jobs.watch()` uses to tell a replayed event apart from a live one."""
    row = AgentJobEvent(job_id=job_id, event=event)
    db.add(row)
    db.commit()
    db.refresh(row)
    return row.id


def list_events(db: Session, job_id: str) -> list[tuple[int, dict[str, Any]]]:
    """Every event recorded for `job_id` so far, oldest first, each with its `seq`."""
    rows = db.execute(
        select(AgentJobEvent.id, AgentJobEvent.event).where(AgentJobEvent.job_id == job_id).order_by(AgentJobEvent.id)
    )
    return [(row.id, row.event) for row in rows]


def mark_running(db: Session, job_id: str) -> None:
    """Reopen `job_id` for a resumed run (`jobs.send_message`, once the prior process has exited)."""
    job = db.get(AgentJob, job_id)
    if job is None:
        return
    job.status = RUNNING
    db.commit()


def finish_job(
    db: Session,
    job_id: str,
    *,
    status: str,
    structured_output: dict[str, Any] | None = None,
    error: str | None = None,
) -> None:
    """Move `job_id` to a terminal status. A job not found (deleted mid-run) is silently skipped."""
    job = db.get(AgentJob, job_id)
    if job is None:
        return
    job.status = status
    job.structured_output = structured_output
    job.error = error
    db.commit()
