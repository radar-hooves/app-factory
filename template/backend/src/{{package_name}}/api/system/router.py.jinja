"""HTTP routes for the system domain.

Infrastructure plumbing; registered at the top level of the API router.
No auth dependency — a load balancer or monitor calling this has no identity
to present.
"""

from datetime import UTC, datetime
from importlib.metadata import version

from fastapi import APIRouter
from sqlalchemy import text

from {{ package_name }}.api.system.schemas import DatabaseEnvironmentResponse, HealthResponse
from {{ package_name }}.config import get_settings
from {{ package_name }}.db.environment import read_environment
from {{ package_name }}.db.session import get_engine
from {{ package_name }}.deps import SessionDep
from {{ package_name }}.exceptions import ServiceUnavailableError

router = APIRouter()


@router.get("/health", response_model=HealthResponse, operation_id="healthCheck")
def health_check(session: SessionDep) -> HealthResponse:
    """Report liveness and verify the database dependency.

    Pings the database with `SELECT 1`; a 503 is the only outcome that
    should fail a load balancer's health check, so every other dependency
    this app grows should degrade the body, never this status code.

    Raises:
        ServiceUnavailableError: the database is unreachable (503).
    """
    try:
        session.execute(text("SELECT 1"))
    except Exception as exc:
        raise ServiceUnavailableError("Database is unreachable", details={"reason": str(exc)}) from exc

    settings = get_settings()
    return HealthResponse(
        status="healthy",
        version=version("{{ project_name }}"),
        revision=settings.revision,
        environment="development" if settings.debug else "production",
        timestamp=datetime.now(UTC),
    )


@router.get(
    "/database-environment",
    response_model=DatabaseEnvironmentResponse,
    operation_id="databaseEnvironment",
)
def database_environment() -> DatabaseEnvironmentResponse:
    """Report what the database this backend is bound to declares itself to be.

    The one thing a caller talking to this backend over HTTP — rather than
    holding a connection of its own — can ask to find out what it is really
    about to write to. `db/environment.py`'s reasoning applies unchanged:
    unstamped or unreachable reads as production, fail-closed.

    No auth dependency, matching /health: a caller that cannot yet tell which
    database it has reached is in no position to authenticate against it, and
    the answer names an environment, never a host or a credential.
    """
    return DatabaseEnvironmentResponse(environment=read_environment(get_engine()).value)
