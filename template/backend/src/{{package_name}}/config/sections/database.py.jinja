"""Database connection settings."""

from typing import Annotated
from urllib.parse import quote_plus

from pydantic import Field
from pydantic_settings import SettingsConfigDict

from {{ package_name }}.config.vend import Vended, VendedSettings

# The ONE place the SQLAlchemy dialect is named. `database_url` below builds the
# app's URL from it, and `tests/support/explicit_server_guard.py` builds the
# explicit-test-server URL from the same constant, so the two cannot drift.
# +psycopg names psycopg3 explicitly; a bare postgresql:// resolves to psycopg2.
# An app pinning a different driver in pyproject.toml changes THIS line — and
# the guard follows it, rather than being edited to match and going stale.
SQLALCHEMY_SCHEME = "postgresql+psycopg"


class DatabaseSettings(VendedSettings):
    """PostgreSQL connection parameters.

    Standard env var names: POSTGRES_USER, POSTGRES_PASSWORD, etc.
    case_sensitive=False (default) maps them from the environment automatically.

    extra="ignore" because every section reads the same process environment;
    keys it does not own belong to a sibling section, not to nobody.
    """

    model_config = SettingsConfigDict(
        case_sensitive=False,
        extra="ignore",
        populate_by_name=True,
    )

    # The app's own role, not the superuser: a deployed database is created with a
    # role named for its app and usually carries no `postgres` login at all, so a
    # superuser default cannot connect. An app whose role differs changes THIS
    # default — never an env file, which the debugger does not read.
    postgres_user: str = "{{ postgres_user }}"
    # Empty means "read the boot-lane file, else vend it" (see `Vended` in
    # config/vend.py), not "no password". Only a deployment that supplies
    # POSTGRES_PASSWORD itself leaves this set.
    postgres_password: Annotated[
        str,
        Vended("{{ project_name }}-db", "password", file_field="postgres_password_file"),
    ] = ""
    # The answered fleet-host address, NOT localhost: there is no development
    # database, so every consumer of this default — the dev server, the debugger,
    # a script — points at the app's real Postgres. This lived only in `.envrc`
    # until 2026-08-20, which meant a shell had it and the VS Code debugger did
    # not, and `Run > Full Stack` dialled localhost and refused to start.
    postgres_host: str = "{{ postgres_host }}"
    # The app's own Dev-DB band port, not PostgreSQL's own default: the host
    # runs one server per app, and majordomo's `port` tool flags two apps
    # declaring one port. This once hardcoded the default while still
    # asking for the answer, so a stamped app reached whichever database happened
    # to own that port. No literal port number in this comment, deliberately: the
    # parity gate rewrites the app's answered port wherever it appears in the
    # file, so a number here reads as drift on an otherwise identical copy.
    postgres_port: int = {{ postgres_port }}
    postgres_db: str = "{{ project_name | replace('-', '_') }}"
    # The boot-lane credential file: a host-minted, mode-0400, service-owned file
    # (`rules-library/fleet/secrets.md` §Store Scope), for a deployment whose
    # store password must never ride an environment variable or a compose file,
    # or whose app cannot vend it without already having the store running. Unset
    # everywhere else, including development, which vends.
    postgres_password_file: str | None = None
    # The engine's pool, sized by an app that holds several concurrent lanes (a
    # worker) rather than by forking `db/session.py`. The defaults are SQLAlchemy's
    # own, right for a request-only app; a burst of failure handling at 5+10
    # exhausted library's pool, and the write recording the failure starved with it.
    # Set per app as `<APP>_DB_POOL_SIZE` and `<APP>_DB_MAX_OVERFLOW`, in the
    # deployment's committed per-host `.env`, like the app's other settings.
    pool_size: int = Field(default=5, ge=1, validation_alias="{{ project_name | upper | replace('-', '_') }}_DB_POOL_SIZE")
    max_overflow: int = Field(
        default=10, ge=0, validation_alias="{{ project_name | upper | replace('-', '_') }}_DB_MAX_OVERFLOW"
    )

    @property
    def database_url(self) -> str:
        """Sync SQLAlchemy connection URL. A property, never a computed field: a
        computed field rides every `model_dump()`, and this one carries the password.

        User and password are percent-encoded: a generated password containing
        `@`, `:`, `/`, `?` or `#` otherwise splits the URL at the wrong place and
        the app fails to connect with an error that names neither the password
        nor the reason. The failure is invisible until a rotation happens to
        produce one of those characters, which is exactly when nobody is looking
        for a parsing bug.
        """
        user = quote_plus(self.postgres_user)
        password = quote_plus(self.postgres_password)
        return f"{SQLALCHEMY_SCHEME}://{user}:{password}@{self.postgres_host}:{self.postgres_port}/{self.postgres_db}"
