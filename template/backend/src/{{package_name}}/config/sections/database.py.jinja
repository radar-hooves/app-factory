"""Database connection settings."""

from pydantic import computed_field
from pydantic_settings import BaseSettings, SettingsConfigDict

from {{ package_name }}.config.paths import env_file


class DatabaseSettings(BaseSettings):
    """PostgreSQL connection parameters.

    Standard env var names: POSTGRES_USER, POSTGRES_PASSWORD, etc.
    case_sensitive=False (default) maps them from the environment automatically.

    extra="ignore" because this section shares one .env with every other
    section; keys it does not own belong to them, not to nobody.
    """

    model_config = SettingsConfigDict(
        env_file=env_file(),
        case_sensitive=False,
        extra="ignore",
    )

    postgres_user: str = "postgres"
    postgres_password: str = ""  # required — must be overridden in .env or environment
    postgres_host: str = "localhost"
    # The app's registry-allocated port, not PostgreSQL's own default: the host
    # runs one server per app and the registry is what stops two of them
    # colliding (registry-ports.md). This once hardcoded the default while still
    # asking for the answer, so a stamped app reached whichever database happened
    # to own that port. No literal port number in this comment, deliberately: the
    # parity gate rewrites the app's answered port wherever it appears in the
    # file, so a number here reads as drift on an otherwise identical copy.
    postgres_port: int = {{ postgres_port }}
    postgres_db: str = "{{ project_name | replace('-', '_') }}"

    @computed_field  # type: ignore[prop-decorator]
    @property
    def database_url(self) -> str:
        """Sync SQLAlchemy connection URL."""
        return (
            f"postgresql://{self.postgres_user}:{self.postgres_password}"
            f"@{self.postgres_host}:{self.postgres_port}/{self.postgres_db}"
        )
