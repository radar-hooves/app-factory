"""This app's party to the token exchange (`exchange.py`): who it is at Authentik, and where.

One Authentik OAuth2 provider per app, provisioned by app-factory's
`authentik/exchange.py`: `client_id` this app's name, the token-exchange
grant, federating this app's proxy provider (whose tokens are the
`X-authentik-jwt` it trades) and every app that may ask this one for a
person. The issuer is the one setting a deployment names. Empty turns the
exchange off: a fresh stamp, a dev box and CI run without one, `/mcp` admits
no asker, and a persona that reads collections answers 503.

Env vars (all prefixed ``{{ project_name | upper | replace('-', '_') }}_EXCHANGE_``):
    ISSUER         e.g. https://auth.example.org/application/o/{{ project_name }}-exchange/
    CLIENT_ID      this app's name unless the estate named its client otherwise
    CLIENT_SECRET  empty means vend `{{ project_name }}-api-exchange`, only while ISSUER is set
"""

from typing import Annotated, Self

from pydantic import SecretStr, field_validator, model_validator
from pydantic_settings import BaseSettings, SettingsConfigDict

from {{ package_name }}.config.vend import Vended, resolve_vended_fields


class ExchangeSettings(BaseSettings):
    """This app's exchange client and its issuer, off by default."""

    model_config = SettingsConfigDict(
        env_prefix="{{ project_name | upper | replace('-', '_') }}_EXCHANGE_",
        case_sensitive=False,
        extra="ignore",
    )

    # This app's exchange provider's issuer: Authentik's `iss`, which ends in
    # a slash. The token endpoint and the JWKS are read off it.
    issuer: str = ""
    client_id: str = "{{ project_name }}"
    client_secret: Annotated[SecretStr, Vended("{{ project_name }}-api-exchange", "value")] = SecretStr("")

    @field_validator("issuer")
    @classmethod
    def _ends_in_a_slash(cls, value: str) -> str:
        value = value.strip()
        return value if not value or value.endswith("/") else f"{value}/"

    @model_validator(mode="after")
    def _resolve_vended_fields_when_configured(self) -> Self:
        if self.issuer:
            resolve_vended_fields(self)
        return self
