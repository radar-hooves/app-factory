"""Settings for the agent slice: what a persona's session is pointed at.

Everything a PERSONA decides — its identity, its model, its permitted tools —
lives in `config/personas/<name>/` and is read fresh on every spawn
(`agent_common.persona`); nothing here duplicates it. What is left is the
handful of facts every persona on this deployment shares: where the persona
directory lives, the optional gateway, and the CLI's own operating knobs,
which reach the kit's driver as `driver()`.

Lifted from the library's `api/agent/config.py` (radar-hooves/library), which
carries the fuller version this slice split from: a `corpus_root` and a
`permitted_collections` list that scope Milton to a directory of documents.
The factory's own persona has no corpus — it is a chat, not a reading room —
so neither field travels here; an app that needs one is the library's shape,
not this one's.
"""

from pathlib import Path
from typing import Annotated, Self

from agent_common import cli
from pydantic import Field, SecretStr, model_validator
from pydantic_settings import BaseSettings, SettingsConfigDict

from {{ package_name }}.config.paths import config_dir
from {{ package_name }}.config.vend import Vended, resolve_vended_fields


class AgentSettings(BaseSettings):
    """Where this deployment's personas live, and what their sessions inherit."""

    model_config = SettingsConfigDict(env_prefix="{{ project_name | upper | replace('-', '_') }}_AGENT_", extra="ignore")

    # `config/personas/<name>/` holds a persona's CLAUDE.md, settings.json and
    # .mcp.json — app-owned, like config/actors.yaml. Read at every spawn, so
    # an override lets a deployment point at an edited copy with no rebuild
    # and no restart (`agent_common.persona`'s whole reason for reading fresh
    # rather than caching). Under `config_dir()`, found in the container as in
    # a source checkout.
    personas_dir: Path = Field(default_factory=lambda: config_dir() / "personas")

    # The gateway Claude Code is pointed at, and the key it presents. Set,
    # they become ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN on the child
    # process, and every persona session goes through it and nowhere else;
    # empty, the child inherits whatever the process environment already
    # carries — which is the contract this slice is built on:
    # CLAUDE_CODE_OAUTH_TOKEN vended onto the app process authenticates the
    # CLI against Anthropic directly, with no gateway in the path
    # (`docs/design/agent-console.md` §Decision). The gateway pair stays for a
    # genuinely Anthropic-compatible one; unlike the library's own default,
    # this factory names no household gateway, because a stamped app has no
    # standing opinion on one. The URL is deployment configuration; the key
    # is a secret, vended like every other (`config/vend.py`) and only while
    # a URL is set, so an app with no gateway never asks the broker for one.
    gateway_url: str = ""
    gateway_key: Annotated[
        SecretStr,
        Vended("{{ project_name }}-gateway", "value", credential_field="gateway_key_credential"),
    ] = SecretStr("")
    # The broker credential holding the key, when the gateway named it rather
    # than this app (one that mints a key per consumer under its own scheme).
    # Empty means `{{ project_name }}-gateway`.
    gateway_key_credential: str = ""

    # core-memory's MCP endpoint (`api/agent/lessons.py`). Empty opts this
    # deployment out of the learning loop entirely. Deployment configuration,
    # not a secret — the bearer is vended fresh per call under the credential
    # named below.
    core_memory_url: str = ""
    # The broker credential `lessons.py` vends core-memory's bearer from — no
    # default, since no name is derivable the way `{{ project_name }}-gateway`
    # is; a URL set with this still empty is a misconfiguration, alerted
    # rather than retried for 14 days.
    core_memory_credential: str = ""

    # Claude Code runs a small model for background work as well as the one
    # answering. Through a gateway it can only be a model the gateway serves,
    # so it is named rather than left to a default that resolves to nothing.
    haiku_model: str = ""

    # Reasoning effort. Deployment-wide rather than per-persona: the persona
    # contract's settings.json carries `model`, not this — an app that wants
    # two personas at two efforts is a shape nobody has asked for yet.
    effort: str = "high"

    # Extended thinking OFF, via MAX_THINKING_TOKENS=0 on the child (the only
    # mechanism that actually disables it; CLAUDE_CODE_DISABLE_THINKING merely
    # omits the request parameter and an adaptive model goes on thinking).
    thinking: bool = False

    # `claude` resolves off PATH; named here so a deployment can pin it.
    executable: str = "claude"

    # One question's wall clock. The loop is bounded by the model deciding it
    # is finished; this is the backstop for one that does not.
    timeout_seconds: float = 600.0

    # `config/rooms.yaml`: the rooms this app offers (`api/agent/rooms.py`).
    # App-owned like the persona directory, beside it; absent, the app offers none.
    rooms_file: Path = Field(default_factory=lambda: config_dir() / "rooms.yaml")

    # Questions one person may ask a day across every room, admins exempt;
    # 0 turns the allowance off. The day is local to `quota_timezone`.
    daily_questions: int = 40
    quota_timezone: str = "Australia/Brisbane"
    # Where a person whose allowance is spent is pointed; empty shows none.
    support_url: str = ""

    # The library's caller mount (`https://library.example/api/caller`), for
    # a library room. Its bearer is this app's caller credential, vended only
    # while a URL is set, as the gateway key is.
    library_url: str = ""
    library_token: Annotated[
        SecretStr,
        Vended("{{ project_name }}-library", "value", credential_field="library_token_credential"),
    ] = SecretStr("")
    # The broker credential holding it, when the library named it rather than
    # this app. Empty means `{{ project_name }}-library`.
    library_token_credential: str = ""

    def driver(self) -> cli.Settings:
        """These settings as the kit's driver takes them; each session reports as `{{ project_name }}-agent-<persona>`."""
        return cli.Settings(
            service="{{ project_name }}-agent",
            executable=self.executable,
            effort=self.effort,
            thinking=self.thinking,
            timeout_seconds=self.timeout_seconds,
            gateway_url=self.gateway_url,
            gateway_key=self.gateway_key.get_secret_value(),
            haiku_model=self.haiku_model,
        )

    @model_validator(mode="after")
    def _resolve_keys_when_configured(self) -> Self:
        """Vend the gateway key and the library bearer only for a deployment that names their URLs.

        Not `VendedSettings`, which vends unconditionally at construction —
        `config/sections/files.py` gates its own credential on its URL the
        same way, for the same reason.
        """
        named = {"gateway_key": self.gateway_url, "library_token": self.library_url}
        if any(named.values()):
            resolve_vended_fields(self, only=[field for field, url in named.items() if url])
        return self
