"""Settings for the agent slice: what a persona's session is pointed at.

Everything a PERSONA decides — its identity, its model, its permitted tools —
lives in `config/personas/<name>/` and is read fresh on every spawn
(`api/agent/persona.py`); nothing here duplicates it. What is left is the
handful of facts every persona on this deployment shares: where the persona
directory lives, the optional gateway, and the CLI's own operating knobs.

Lifted from the library's `api/agent/config.py` (radar-hooves/library), which
carries the fuller version this slice split from: a `corpus_root` and a
`permitted_collections` list that scope Milton to a directory of documents.
The factory's own persona has no corpus — it is a chat, not a reading room —
so neither field travels here; an app that needs one is the library's shape,
not this one's.
"""

from pathlib import Path

from pydantic_settings import BaseSettings, SettingsConfigDict

from {{ package_name }}.config.paths import project_root


def _default_personas_dir() -> Path:
    """Return the default persona directory (``config/personas`` at the repo root)."""
    return project_root() / "config" / "personas"


class AgentSettings(BaseSettings):
    """Where this deployment's personas live, and what their sessions inherit."""

    model_config = SettingsConfigDict(env_prefix="{{ project_name | upper | replace('-', '_') }}_AGENT_", extra="ignore")

    # `config/personas/<name>/` holds a persona's CLAUDE.md, settings.json and
    # .mcp.json — app-owned, like config/actors.yaml. Read at every spawn, so
    # an override lets a deployment point at an edited copy with no rebuild
    # and no restart (`api/agent/persona.py`'s whole reason for reading fresh
    # rather than caching).
    personas_dir: Path = _default_personas_dir()

    # The gateway Claude Code is pointed at, and the key it presents. Set,
    # they become ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN on the child
    # process; empty, the child inherits whatever the process environment
    # already carries — which is the contract this slice is built on:
    # CLAUDE_CODE_OAUTH_TOKEN vended onto the app process authenticates the
    # CLI against Anthropic directly, with no gateway in the path
    # (`docs/design/agent-console.md` §Decision). The gateway pair stays for a
    # genuinely Anthropic-compatible one; unlike the library's own default,
    # this factory names no household gateway, because a stamped app has no
    # standing opinion on one.
    gateway_url: str = ""
    gateway_key: str = ""

    # Claude Code runs a small model for background work as well as the one
    # answering. Through a gateway it can only be a model the gateway serves,
    # so it is named rather than left to a default that resolves to nothing.
    haiku_model: str = ""

    # Reasoning effort. Deployment-wide rather than per-persona: the persona
    # contract's settings.json carries `model`, not this — an app that wants
    # two personas at two efforts is a shape nobody has asked for yet.
    effort: str = "high"

    # Extended thinking OFF, via MAX_THINKING_TOKENS=0 on the child (the only
    # mechanism that actually disables it; CLAUDE_CODE_DISABLE_THINKING merely
    # omits the request parameter and an adaptive model goes on thinking).
    thinking: bool = False

    # `claude` resolves off PATH; named here so a deployment can pin it.
    executable: str = "claude"

    # One question's wall clock. The loop is bounded by the model deciding it
    # is finished; this is the backstop for one that does not.
    timeout_seconds: float = 600.0
