"""Application configuration.

Settings are composed from domain sections (config/sections/) so each area
of concern owns its own environment variable block. get_settings() is
lru_cache'd: one Settings instance per process.

Usage:
    from {{ package_name }}.config import get_settings
    settings = get_settings()
    print(settings.database.postgres_host)
"""

from functools import lru_cache
from pathlib import Path

from pydantic import Field, ValidationError, computed_field, model_validator
from pydantic_settings import BaseSettings, SettingsConfigDict

from {{ package_name }}.config.sections.database import DatabaseSettings
from {{ package_name }}.config.sections.example import ExampleSettings
from {{ package_name }}.config.sections.identity import IdentitySettings
from {{ package_name }}.config.sections.mcp import MCPSettings
from {{ package_name }}.config.sections.security import SecuritySettings


def _describe_config_error(exc: ValidationError) -> str:
    """Render a config-load failure without echoing field values.

    Pydantic's default ValidationError str() includes ``input_value=...``,
    which for a settings model is the whole env dict -- sibling secrets
    included. One missing required field would otherwise print fragments of
    every other value into logs and tracebacks.
    """
    parts = [
        f"{'.'.join(str(loc) for loc in err['loc'])}: {err['msg']} [{err['type']}]"
        for err in exc.errors(include_url=False, include_input=False)
    ]
    return f"{exc.error_count()} validation error(s) for {exc.title} — " + "; ".join(parts)


def _running_from_checkout() -> bool:
    """True when this package is imported from a source tree, not an installed wheel."""
    return (Path(__file__).resolve().parents[3] / "pyproject.toml").is_file()


class Settings(BaseSettings):
    """Root settings; composes section sub-models."""

    # extra="ignore" is load-bearing, not laxness. Every section reads the same
    # .env, and the root model owns only the unprefixed keys below. Forbidding
    # extras here makes the app refuse to start the moment .env carries a key a
    # SECTION owns (POSTGRES_*, EXAMPLE_*, the MCP auth block) — which is
    # exactly what .env.example ships, so `cp .env.example .env` was fatal.
    model_config = SettingsConfigDict(
        case_sensitive=False,
        env_nested_delimiter="__",
        extra="ignore",
    )

    # A source checkout IS the development environment — there is no env file to
    # say so, and asking the developer to set one is how `Run > Full Stack` ends
    # up refusing to start. The installed package in the production image has no
    # pyproject.toml above it, so a container cannot fall into this branch by
    # forgetting a variable; DEBUG=... still overrides either way.
    debug: bool = Field(default_factory=lambda: _running_from_checkout())
    secret_key: str = "changeme"

    # Comma-separated: CORS needs exact origin strings, not a parsed URL —
    # kept as the raw string field pydantic-settings maps CORS_ORIGINS onto,
    # with cors_origins_list below doing the split.
    cors_origins: str = ""

    # Domain sections. get_settings() constructs each one and passes it as an
    # init argument, which is why these carry only a factory: a section left to
    # the parent's own sources is rebuilt from THEM, and the parent knows only
    # the DATABASE__POSTGRES_HOST spelling. A bare POSTGRES_HOST in the
    # environment then reaches nothing, the section falls back to its own field
    # defaults or to .env, and a container configured entirely by environment
    # silently runs on localhost. Init arguments outrank every source, so the
    # section's own resolution (env, then .env, then default) is what stands.
    database: DatabaseSettings = Field(default_factory=DatabaseSettings)
    example: ExampleSettings = Field(default_factory=ExampleSettings)
    # Names of the forward-auth identity headers. Defaults are Authentik's
    # own spellings, so an app behind the household outpost sets none of them.
    identity: IdentitySettings = Field(default_factory=IdentitySettings)
    # Inbound auth for the embedded MCP surface. Defaults fail CLOSED: with no
    # {{ project_name | upper | replace('-', '_') }}_OIDC_USERINFO_URL set, every /mcp HTTP request 401s.
    mcp: MCPSettings = Field(default_factory=MCPSettings)
    # Trusted-proxy boundary and rate limiting. Defaults are the SAFE ones:
    # no proxy is trusted, so no caller can assert its own address.
    security: SecuritySettings = Field(default_factory=SecuritySettings)

    @computed_field  # type: ignore[prop-decorator]
    @property
    def cors_origins_list(self) -> list[str]:
        """Allowed CORS origins, split from the comma-separated env value."""
        return [origin.strip() for origin in self.cors_origins.split(",") if origin.strip()]

    @model_validator(mode="after")
    def _warn_insecure_defaults(self) -> Settings:
        import logging

        if not self.debug and self.secret_key == "changeme":
            logging.getLogger(__name__).warning(
                "SECRET_KEY is set to the insecure default. Set a real value in production."
            )
        return self


@lru_cache(maxsize=1)
def get_settings() -> Settings:
    """Return the cached Settings instance (one per process)."""
    try:
        return Settings(
            database=DatabaseSettings(),
            example=ExampleSettings(),
            identity=IdentitySettings(),
            mcp=MCPSettings(),
            security=SecuritySettings(),
        )
    except ValidationError as exc:
        # `from None`, deliberately: chaining the original ValidationError
        # would re-print pydantic's input_value echo (the whole env dict,
        # sibling secrets included) in the traceback. The sanitised message
        # already names the field, error type, and message.
        raise RuntimeError(_describe_config_error(exc)) from None
