"""Shared path helpers for locating the app's env file and repo-root config.

Settings sections must find the same `.env` whether the process was started
from `backend/` (the dev path: `.envrc`, and `.vscode/launch.json`'s `cwd`) or
from the repository root. A relative `".env"` resolves against the current
working directory and so finds it in one case and silently not the other, which
is how a section ends up reading defaults nobody chose. These helpers walk up
from this module instead, so the answer does not depend on where you started.

In a production container the package is installed into site-packages and the
walk lands somewhere that does not exist. That is fine and deliberate:
pydantic-settings ignores a missing env file and reads the process environment,
which is how a container supplies configuration anyway. A deployment that keeps
its actor registry elsewhere sets the path explicitly.
"""

import os
from pathlib import Path


def backend_dir() -> Path:
    """Return the `backend/` directory of the source tree."""
    here = Path(__file__).resolve()  # backend/src/{{ package_name }}/config/paths.py
    return here.parents[3]


def project_root() -> Path:
    """Return the repository root (one level above `backend/`)."""
    return backend_dir().parent


def frontend_build_dir() -> Path:
    """Return the built SPA directory, in the source tree or the container.

    `project_root()` above is documented as landing nowhere in a container, which
    is harmless for the settings lookup it was written for and silently fatal here: the image ships the
    built SPA at `/app/frontend/build` and the walk looks for it beside the
    installed package in site-packages, so the mount is skipped and every request
    for the app itself answers 404 while the container reports healthy.

    Resolution order is deployment first, then source tree. The final fallback is
    only reached when neither exists, so the caller's "not built yet" branch still
    fires for a dev checkout that has not run `pnpm build`.
    """
    for candidate in (Path.cwd() / "frontend" / "build", project_root() / "frontend" / "build"):
        if candidate.is_dir():
            return candidate
    return project_root() / "frontend" / "build"


def data_dir() -> Path:
    """Return the app's runtime-state directory, creating it if absent.

    THE one place an app writes state it did not receive from its database: a
    cache it can rebuild, an import staging area, an export, a SQLite file a
    subsystem insists on. One name (`data/`), one override (`DATA_DIR`), in every
    app — because the factory having no opinion here is what produced six
    different answers. Measured 2026-08-19: six apps had each invented their own
    directory name, settings field and environment variable for exactly this, and
    three of them independently reached for SQLite underneath it.

    Resolution mirrors `frontend_build_dir()` — deployment first, then the source
    tree — with one addition that removes the ambiguity rather than resolving it:
    the container sets `DATA_DIR` explicitly (compose mounts `./data` at
    `/app/data`), so the walk below is only ever exercised by a dev checkout.
    Without that, an unmounted volume would fall through to the installed package
    in site-packages and the app would happily write state into its own wheel.

    Subdirectories under here are the app's own domain and the factory has no
    view on them; the ROOT is the shared decision. It is gitignored in every app,
    which means it holds nothing a fresh clone needs — anything a clone DOES need
    belongs in the repo, not here.
    """
    if override := os.environ.get("DATA_DIR", "").strip():
        resolved = Path(override).expanduser()
    else:
        for candidate in (Path.cwd() / "data", project_root() / "data"):
            if candidate.is_dir():
                resolved = candidate
                break
        else:
            resolved = project_root() / "data"
    resolved.mkdir(parents=True, exist_ok=True)
    return resolved
