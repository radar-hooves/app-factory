"""Fetch a secret from the household broker at startup.

Development holds no env file. Every fact a checkout can know is stamped into
this app's own config defaults; what it cannot know — a database password, any
other credential a section owns — is fetched here, keyed by this app's own
software identity: a P-256 key file the host mints at activation and grants in
the broker's declared consumers (never minted or enrolled by this app itself).
A fresh clone needs nothing filled in, and there is no per-consumer copy of the
value to drift.

`Vended` and `VendedSettings` below are the declarative surface every secret
setting uses: a field names its credential and field, `VendedSettings` fills
it in when the environment left it empty, and no settings section hand-writes
its own environment/file/broker resolution order.

A vended value never touches a subprocess, a shell, or stdout: the attest and
the fetch both happen in-process over HTTPS, and the value that comes back is a
plain string handed straight to its caller. Keep it that way: nothing in this
module may log, or interpolate a value into a message, beyond returning it.

A context with no key file -- CI foremost -- has no way to answer any of this,
and adding fields to `Vended` should never mean adding one dummy value per
secret name per workflow. Setting `<APP>_VEND=off` (see `_VEND_SWITCH_ENV`
below) skips the broker for whatever `Vended` field the environment and any
boot-lane file still leave empty, logging once per process and leaving that
field at its empty default rather than raising. Nothing sets it in production:
compose supplies every name there, so the switch is never reached, and a
container that somehow started without a name still fails closed exactly as
before.
"""

import base64
import logging
import os
import time
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from http import HTTPStatus
from pathlib import Path
from typing import Any, Self

import httpx
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import ec
from cryptography.hazmat.primitives.asymmetric.utils import decode_dss_signature
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat, load_pem_private_key
from pydantic import SecretStr, model_validator
from pydantic_settings import BaseSettings

logger = logging.getLogger(__name__)

#: This app's environment prefix (`platform/canonical-app-shape.md` §Named
#: canonical values), so a broker variable can be named for THIS app alone.
_PREFIX = "{{ package_name | upper }}"


def _broker_env(name: str, default: str) -> str:
    """Read this app's own ``<APP>_<name>`` first, then the bare ``<name>``, then ``default``.

    Prefixed FIRST because the bare names are the household's, not this app's: a
    workstation belonging to a different household exports ``PORTCULLIS_URL``
    for its own broker, and an app that read it would attest to the wrong one
    and be refused — or, worse, vend from it. The bare name still answers where
    it is the only one set, which is every host in this household's fleet.
    """
    for candidate in (f"{_PREFIX}_{name}", name):
        value = os.environ.get(candidate, "").strip()
        if value:
            return value
    return default


#: The one machine-local fact that cannot itself be vended — where the broker is.
#: Overridable per host; the default is the household's own broker.
BROKER_URL = _broker_env("PORTCULLIS_URL", "{{ portcullis_url }}")

#: This app's software identity key: a P-256 PKCS8 PEM, mode 0600. The host
#: mints it at activation and grants it in the broker's declared consumers;
#: this app never mints or enrols one itself, and a missing file means this
#: consumer was never activated on this host. One per app per machine.
PORTCULLIS_KEY_FILE = _broker_env(
    "PORTCULLIS_KEY_FILE", os.path.expanduser("~/.config/portcullis/{{ project_name }}.key")
)

_TIMEOUT_SECONDS = 30


#: Set to ``off`` to skip the broker entirely -- the one declared way a context
#: with no key file (CI) constructs settings without vending. Read fresh
#: on every resolution rather than cached at import, so a test can flip it with
#: `monkeypatch.setenv` exactly as it flips any other input to this module.
_VEND_SWITCH_ENV = f"{_PREFIX}_VEND"

_logged_vend_switched_off = False


def _vend_switched_off() -> bool:
    return os.environ.get(_VEND_SWITCH_ENV, "").strip().lower() == "off"


def _log_vend_switched_off_once() -> None:
    """Log once per process, never once per field -- a section carrying a dozen
    ``Vended`` fields must not spam a dozen identical lines.
    """
    global _logged_vend_switched_off
    if _logged_vend_switched_off:
        return
    logger.warning(
        "%s=off: the broker is not asked. Every Vended field the environment and any boot-lane "
        "file still leave empty stays at its empty default. Never set this in production.",
        _VEND_SWITCH_ENV,
    )
    _logged_vend_switched_off = True


class VendError(RuntimeError):
    """A value the app cannot start without could not be vended."""


class BrokerUnavailableError(VendError):
    """The broker will not serve this process right now (locked, unreachable, out of scope)."""


def _key_file_path() -> Path:
    return Path(PORTCULLIS_KEY_FILE).expanduser()


def broker_serves(credential: str, field: str) -> None:
    """Raise BrokerUnavailableError unless the broker serves ``credential`` right now.

    A child process that vends its own secrets at startup (an agent's stdio MCP
    server, a worker subprocess) fails silently into running tool-less when the
    broker will not serve: nothing raises, the child just starts short of what
    it needs. Proving the door is open before spawning it turns that into a
    typed error the caller can park work on, rather than a child missing tools
    nobody notices until its output does. Without a software identity key file
    there is no way to attest, so nothing is proved and nothing is refused (the
    suite, a machine that supplies its values in the environment).
    """
    if not _key_file_path().exists():
        return
    try:
        vend(credential, field)
    except VendError as exc:
        raise BrokerUnavailableError(str(exc)) from exc


def _load_key() -> ec.EllipticCurvePrivateKey:
    """Load this app's P-256 software identity key from ``PORTCULLIS_KEY_FILE``.

    Never minted here: the host mints it at activation and grants it in the
    broker's declared consumers. A missing or malformed file is a clear,
    named-path VendError rather than a fallback to generating one -- an app
    minting its own key would enrol itself, which is the broker's job alone.
    """
    path = _key_file_path()
    if not path.exists():
        raise VendError(
            f"no software identity key at {path}. This app never mints its own key -- the host "
            "mints one at activation and grants it in the broker's declared consumers."
        )
    try:
        key = load_pem_private_key(path.read_bytes(), password=None)
    except Exception as exc:
        raise VendError(f"could not load the software identity key at {path}: {exc}") from exc
    if not isinstance(key, ec.EllipticCurvePrivateKey) or not isinstance(key.curve, ec.SECP256R1):
        raise VendError(f"the key at {path} is not a P-256 (SECP256R1) key")
    return key


def _public_key_der_b64(key: ec.EllipticCurvePrivateKey) -> str:
    """This key's SPKI DER, base64-encoded -- the shape ``/v1/attest/challenge`` wants."""
    der = key.public_key().public_bytes(Encoding.DER, PublicFormat.SubjectPublicKeyInfo)
    return base64.b64encode(der).decode()


def _sign(key: ec.EllipticCurvePrivateKey, message: str) -> str:
    """Sign ``message``; return the base64 IEEE P1363 (raw r||s) signature the broker verifies."""
    signature_der = key.sign(message.encode(), ec.ECDSA(hashes.SHA256()))
    r, s = decode_dss_signature(signature_der)
    p1363 = r.to_bytes(32, "big") + s.to_bytes(32, "big")
    return base64.b64encode(p1363).decode()


def _error_reason(response: httpx.Response) -> str:
    """The one part of a broker error response safe to quote: its own ``code``/``error`` key."""
    try:
        body = response.json()
    except ValueError:
        return "unparseable"
    if isinstance(body, dict):
        return str(body.get("code") or body.get("error") or "unknown")
    return "unknown"


#: The bearer this process last attested, cached in memory only -- never on
#: disk, never logged. One process, one identity, one cache.
_BEARER_CACHE: dict[str, Any] = {}
_BEARER_EXPIRY_MARGIN_SECONDS = 60


def _post_attest(path: str, payload: dict[str, Any]) -> dict[str, Any]:
    response = httpx.post(f"{BROKER_URL.rstrip('/')}{path}", json=payload, timeout=_TIMEOUT_SECONDS)
    if response.status_code != HTTPStatus.OK:
        raise VendError(f"broker refused {path}: HTTP {response.status_code} ({_error_reason(response)})")
    return dict(response.json())


def _attest_bearer() -> str:
    """Return a Portcullis bearer for this app's key file, attesting fresh once the cached one nears expiry.

    Challenge -> sign -> token: the same door every other estate consumer uses
    (mcp-servers' ``mcp-common/mcp_common/portcullis_attest.py`` -- read as the
    reference implementation, never imported; an app does not depend on the MCP
    fleet's library). No renew leg: re-attesting on expiry is fewer lines than
    tracking a renew window, and attest is already infrequent -- roughly once
    per bearer lifetime.
    """
    now = datetime.now(timezone.utc)
    cached = _BEARER_CACHE
    if cached and now < cached["expires_at"] - timedelta(seconds=_BEARER_EXPIRY_MARGIN_SECONDS):
        return str(cached["key"])

    key = _load_key()
    challenge = _post_attest("/v1/attest/challenge", {"public_key_der": _public_key_der_b64(key)})
    signature = _sign(key, f"{challenge['challenge_id']}.{challenge['nonce']}")
    token = _post_attest(
        "/v1/attest/token",
        {
            "challenge_id": challenge["challenge_id"],
            "nonce": challenge["nonce"],
            "signature_b64": signature,
        },
    )
    _BEARER_CACHE["key"] = token["key"]
    _BEARER_CACHE["expires_at"] = datetime.fromisoformat(str(token["expires_at"]).replace("Z", "+00:00"))
    return str(_BEARER_CACHE["key"])


def vend(credential: str, field: str) -> str:
    """Return one field of a broker credential.

    Raises VendError with the broker's own diagnostic rather than falling back to
    an empty value: a blank password fails later, somewhere else, as a connection
    error that names neither the cause nor the fix.
    """
    bearer = _attest_bearer()
    response = httpx.get(
        f"{BROKER_URL.rstrip('/')}/v1/credentials/{credential}",
        headers={"Authorization": f"Bearer {bearer}"},
        timeout=_TIMEOUT_SECONDS,
    )
    if response.status_code != HTTPStatus.OK:
        raise VendError(
            f"could not vend '{credential}.{field}' from {BROKER_URL}: "
            f"HTTP {response.status_code} ({_error_reason(response)})"
        )
    material = dict(response.json()).get("material") or {}
    for entry in material.get("fields", []):
        if entry.get("name") == field and entry.get("value"):
            return str(entry["value"])
    raise VendError(f"credential '{credential}' carries no non-empty field named '{field}'")


_VEND_ATTEMPTS = 3
_VEND_BACKOFF_SECONDS = 2.0


def _vend_with_retry(credential: str, field: str) -> str:
    """`vend`, retried with backoff for a broker that is locked or has not
    finished starting -- the shape of the broker restarting alongside this
    container, not of a genuinely absent credential.

    Bounded: the last attempt's VendError is what escapes, carrying the
    broker's own diagnostic and nothing this app was not already told.
    Uncaught here, it propagates out of settings construction and fails the
    container's own boot -- which is the point: compose restarts it rather
    than serving with a credential it never got.
    """
    last_error: VendError | None = None
    for attempt in range(_VEND_ATTEMPTS):
        try:
            return vend(credential, field)
        except VendError as exc:
            last_error = exc
            if attempt < _VEND_ATTEMPTS - 1:
                time.sleep(_VEND_BACKOFF_SECONDS * (2**attempt))
    assert last_error is not None  # the loop above always sets it before falling through
    raise last_error


@dataclass(frozen=True)
class Vended:
    """Marks a settings field as vended: which broker credential answers it,
    and which field of that credential, when the environment leaves it empty.

    ``file_field`` names a sibling field carrying a boot-lane credential file
    path (`platform/canonical-app-shape.md` §Development launch), consulted
    BEFORE the broker. It is the one escape hatch: a third-party container in
    the stack that cannot vend for itself (postgres), or this app's own
    identity when it IS the broker (portcullis, which cannot vend from
    itself). Every other field leaves it unset and just vends when empty.
    """

    credential: str
    field: str
    file_field: str | None = None


def resolve_vended_fields(settings: BaseSettings) -> None:
    """Fill every ``Vended``-annotated field ``settings`` left empty.

    The whole reason a field declares this instead of a hand-written
    validator: the resolution order -- the environment, then an optional
    boot-lane file, then the broker -- lives here exactly once, for every
    secret setting the app carries. ``VendedSettings`` below is the one line
    each section adds to use it. Nothing here ever logs, returns, or raises a
    resolved value itself, save the one line naming that the broker is being
    skipped under `_VEND_SWITCH_ENV`.
    """
    for name, info in type(settings).model_fields.items():
        spec = next((meta for meta in info.metadata if isinstance(meta, Vended)), None)
        if spec is None:
            continue
        current = getattr(settings, name)
        is_secret = isinstance(current, SecretStr)
        value = current.get_secret_value() if is_secret else current
        if not value and spec.file_field:
            file_path = getattr(settings, spec.file_field, None)
            if file_path:
                try:
                    value = Path(file_path).read_text().strip()
                except OSError as exc:
                    logger.warning(
                        "Could not read the boot-lane credential file (%s): %s",
                        exc.strerror,
                        Path(file_path),
                    )
        if not value:
            if _vend_switched_off():
                _log_vend_switched_off_once()
            else:
                value = _vend_with_retry(spec.credential, spec.field)
        setattr(settings, name, SecretStr(value) if is_secret else value)


class VendedSettings(BaseSettings):
    """Base for a settings section carrying one or more ``Vended`` fields.

    A section declares each field's credential with ``Annotated[str,
    Vended(...)]`` (or ``Annotated[SecretStr, Vended(...)]``) and gets this
    resolution for free -- no per-section ``model_validator`` to hand-write
    or let drift from the next one.
    """

    @model_validator(mode="after")
    def _resolve_vended_fields(self) -> Self:
        resolve_vended_fields(self)
        return self


def vend_envelope(credential: str) -> dict[str, Any]:
    """Return the broker's whole credential envelope for ``credential``.

    ``vend`` covers a static credential, whose value is one field. A SESSION
    credential is not reducible that way: the identity constants a signing
    client needs sit under ``material.connection``, not one flat field. This
    attests through this app's own software key exactly as `vend` does, then
    reads the same door the rest of the estate's consumers use --
    ``GET /v1/credentials/{name}`` -- and returns the parsed JSON.

    The return value CARRIES SECRET MATERIAL. Hand it straight to the client
    that needs it; never log it, never put it in an exception message, and
    never write it anywhere. Nothing in this module renders a response body: a
    failure surfaces the HTTP status and the broker's own error token only.
    """
    response = httpx.get(
        f"{BROKER_URL.rstrip('/')}/v1/credentials/{credential}",
        headers={"Authorization": f"Bearer {_attest_bearer()}"},
        timeout=_TIMEOUT_SECONDS,
    )
    if response.status_code != HTTPStatus.OK:
        raise VendError(f"broker refused '{credential}': HTTP {response.status_code} ({_error_reason(response)})")
    return dict(response.json())
