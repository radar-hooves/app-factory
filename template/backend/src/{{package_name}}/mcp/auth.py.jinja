"""Resolves the calling actor for an MCP tool call (household inbound-auth pattern).

The embedded MCP server is mounted over HTTP (``main.py``), gated by
``http_auth.require_bearer_auth``: every ``/mcp`` HTTP request must carry an
Authentik OAuth2 Bearer token that validates against the userinfo endpoint,
and the gate writes the resolved identity to the ``x-client-id`` header (any
client-supplied value stripped first — see ``http_auth.py``).

:func:`resolve_actor` reads that header and maps it to an :class:`~.actors.Actor`
via the server-side :class:`~.actors.ActorRegistry` (``config/actors.yaml``).
Callers cannot self-declare identity: over HTTP the wire ``_meta.client_id`` is
never trusted (only the header the gate itself wrote), and an identity absent
from the registry is refused, never defaulted to a privileged actor.

A bearer this app's own exchange issued names a person, not a machine: the
gate verifies it and puts the :class:`~{{ package_name }}.exchange.Asker` on the request,
:func:`current_asker` reads it, and :func:`resolve_actor` answers that person
(``actor_type`` ``person``, ``actor_id`` their ``sub``) with no
``config/actors.yaml`` row, since Authentik vouched for them. A person admitted
to chat alone reaches none of its tools, as its HTTP routes refuse
them (``entitlements.admitted``).

A person is held to the entitlements the tool's REST counterpart requires,
declared on the tool as ``meta=requires("<module>", write=...)`` and enforced by
:func:`person_may` under FastMCP's ``AuthMiddleware`` on call and on list. A tool
that declares nothing is refused to a person and hidden from their list. A
machine caller is not held to it: its gate is ``config/actors.yaml``.

Authentik authenticates; this app authorises. Map ``actor_id`` / ``actor_type``
onto your own server-side authorisation (roles, grants, tenancy) as the domain
grows — this module has no domain knowledge of its own.
"""

from __future__ import annotations

import logging
from functools import lru_cache

import mcp.types as mt
from fastmcp.exceptions import AuthorizationError, ToolError
from fastmcp.server.auth import AuthContext
from fastmcp.server.dependencies import get_context, get_http_headers, get_http_request
from fastmcp.server.middleware import CallNext, Middleware, MiddlewareContext
from fastmcp.tools.base import ToolResult

from {{ package_name }}.entitlements import admitted, has_module
from {{ package_name }}.exceptions import AuthenticationError
from {{ package_name }}.exchange import Asker
from {{ package_name }}.mcp.actors import Actor, ActorRegistry

logger = logging.getLogger(__name__)

# ActorRegistry seeds this identity unconditionally, as the trusted in-process
# caller — it is registered even when config/actors.yaml does not mention it.
# That is right for stdio and wrong for HTTP: the bearer gate resolves an
# identity from an Authentik userinfo claim, and Authentik serves ONE
# instance-wide userinfo endpoint, so a token from any application on the
# instance whose claim happened to equal this string would otherwise arrive
# here and resolve to the principal actor. Reserved for stdio below.
_LOCAL_CONSOLE = "local-console"


@lru_cache(maxsize=1)
def _actor_registry() -> ActorRegistry:
    """Build the actor registry once per process from {{ project_name | upper | replace('-', '_') }}_ACTORS_CONFIG_PATH."""
    from {{ package_name }}.config import get_settings

    return ActorRegistry(get_settings().mcp.actors_config_path)


def current_asker() -> Asker | None:
    """The person this call was made for, when its bearer is one this app's exchange issued.

    None for a machine caller and over stdio. Only the bearer gate writes it,
    onto the request it admitted.
    """
    try:
        request = get_http_request()
    except RuntimeError:
        return None
    asker = request.scope.get("asker")
    return asker if isinstance(asker, Asker) else None


def requires(module: str | None = None, *, write: bool = False) -> dict[str, object]:
    """What a person needs to call a tool: pass as ``@mcp.tool(meta=requires("notes", write=True))``.

    Name the module (and grade) the tool's REST counterpart's router or route requires,
    so ``entitlements.has_module`` answers the same on both surfaces. No module: any
    person admitted to the app, for a tool that touches no module (``health_check``).
    """
    return {"requires": {} if module is None else {"module": module, "write": write}}


async def person_may(ctx: AuthContext) -> bool:
    """FastMCP auth check: hold a person to the entitlement the component declares.

    Run by ``AuthMiddleware(auth=person_may)`` on call and on list (a refusal is
    hidden from the list). A machine caller and stdio have no asker and pass.
    Raising names the missing entitlement; an undeclared component fails closed.
    """
    asker = current_asker()
    if asker is None:
        return True
    name = ctx.component.name
    if not admitted(asker.entitlements):
        raise AuthorizationError(f"This person is admitted to this app's chat alone, not its tool {name}")
    meta = ctx.component.meta or {}
    if "requires" not in meta:
        raise AuthorizationError(f"The tool {name} declares no entitlement, so a person may not call it")
    need = meta["requires"]
    if not need or has_module(asker.entitlements, need["module"], write=need["write"]):
        return True
    grade = f"{need['module']}:write" if need["write"] else need["module"]
    raise AuthorizationError(f"You do not have the {grade} entitlement the tool {name} needs")


def resolve_actor() -> Actor:
    """Resolve the calling actor from the registry.

    Fails closed: a missing client identity is a typed refusal, never a silent
    default to a privileged identity. ``local-console`` — the privileged
    identity :class:`~.actors.ActorRegistry` seeds unconditionally for the
    trusted in-process caller — is reserved for stdio and refused over HTTP,
    whether or not ``config/actors.yaml`` lists it.

    The identity SOURCE is chosen by transport, because only one source is
    trustworthy per transport:

    - Over the HTTP transport the ``x-client-id`` header is authoritative and
      the wire ``_meta.client_id`` is IGNORED. The header is written exclusively
      by ``http_auth.require_bearer_auth`` from the validated bearer, with any
      client-supplied value stripped first. ``_meta`` travels inside the
      JSON-RPC request params and is fully caller-controlled, so trusting it
      here would let any holder of a registered bearer self-declare a
      privileged actor by sending ``_meta.client_id="local-console"``.
    - For a genuine in-process / stdio caller (no HTTP request context) the
      trusted ``ctx.client_id`` is used.

    Either way the server-side registry owns the identity -> actor mapping; an
    unregistered identity is refused, so the caller cannot self-declare an
    actor or type.

    A person the gate verified (:func:`current_asker`) resolves to themselves.

    Raises:
        AuthenticationError: no client identity was presented, the presented
            identity is not registered in ``config/actors.yaml``, or a person
            holds no entitlement on this app beyond a chat's.
    """
    asker = current_asker()
    if asker is not None:
        if not admitted(asker.entitlements):
            raise AuthenticationError(
                "This person is admitted to this app's chat alone, not its tools", context={"app": asker.app}
            )
        return Actor(id=asker.sub, type="person", display=asker.username)
    http_headers = get_http_headers()
    try:
        ctx = get_context()
    except RuntimeError:
        ctx = None
    over_http = bool(http_headers) or getattr(ctx, "transport", None) in ("streamable-http", "sse")
    client_id: str | None = http_headers.get("x-client-id") or None if over_http else getattr(ctx, "client_id", None)
    if client_id is None:
        raise AuthenticationError(
            "MCP client identity is absent: the server cannot resolve an actor without a client_id"
        )
    if over_http and client_id == _LOCAL_CONSOLE:
        raise AuthenticationError(
            "MCP client identity is reserved for local in-process callers: "
            "the local-console actor is not reachable over HTTP",
            context={"client_id": client_id},
        )
    try:
        return _actor_registry().resolve(client_id)
    except KeyError:
        raise AuthenticationError(
            "MCP client identity is not registered",
            context={"client_id": client_id, "registered": _actor_registry().registered_ids()},
        ) from None


class ActorGateMiddleware(Middleware):
    """Require every HTTP MCP tool call to resolve to a registered actor.

    Wired unconditionally onto the FastMCP instance, because the gate
    self-exempts by transport: a stdio call carries no HTTP request headers,
    so it is waved through untouched below. Only a call arriving with real
    HTTP headers (i.e. through the bearer-auth-gated /mcp mount) is actually
    resolved and checked.

    This gates ``on_call_tool`` only — connect, initialise and list-tools are
    not gated. Any caller presenting a valid Authentik bearer may reach that
    far; it is refused only on attempting to call a tool while resolving to an
    unregistered identity (authenticate at the transport, authorise at the
    tool call).

    A tool body MAY still call :func:`resolve_actor` to learn WHO is calling —
    it must, to make an authorisation decision of its own. What it no longer
    has to do is remember to call it in order to be gated at all.
    """

    async def on_call_tool(
        self,
        context: MiddlewareContext[mt.CallToolRequestParams],
        call_next: CallNext[mt.CallToolRequestParams, ToolResult],
    ) -> ToolResult:
        """Resolve the caller's actor and refuse an unregistered HTTP caller."""
        if not get_http_headers():
            return await call_next(context)

        try:
            resolve_actor()
        except AuthenticationError as exc:
            logger.warning("MCP HTTP tool call rejected: %s", exc.message)
            raise ToolError(exc.message) from exc

        return await call_next(context)
