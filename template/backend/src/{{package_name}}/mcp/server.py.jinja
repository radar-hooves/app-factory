"""FastMCP server for {{ project_name }}.

Mounted at /mcp by the app factory, wrapped in the Authentik bearer-token gate
(mcp/http_auth.py) — a request that does not carry a valid token never reaches
a tool in this module.

ActorGateMiddleware enforces the registry check on EVERY HTTP tool call, so a
tool cannot be left ungated by forgetting to ask. The gate proves the caller
holds a valid Authentik token; the middleware checks that identity against
config/actors.yaml and refuses one that is not registered. Both steps are
required: Authentik serves one instance-wide userinfo endpoint, so the token
alone proves identity, not which app it was minted for — the allow-list is
what restores the app boundary.

A tool still calls resolve_actor() when it needs to know WHO is calling in
order to authorise off actor.id / actor.type. It no longer has to call it in
order to be gated at all.

Design rules (rules-library/sidekick/sidekick-tooling.md):
  - Target ≤20 tools; above 30 is a design defect.
  - Use action-dispatcher pattern: one tool per noun, action= parameter.
  - Tool docstrings must enumerate every action and its parameters.
"""

import logging

from fastmcp import FastMCP

from {{ package_name }}.mcp.auth import ActorGateMiddleware, resolve_actor
from {{ package_name }}.mcp.dispatchers.alerts import register_alert_tools
from {{ package_name }}.mcp.dispatchers.feedback import register_feedback_tools

logger = logging.getLogger(__name__)


def create_mcp_server() -> FastMCP:
    """Create and configure the FastMCP server instance."""
    mcp: FastMCP = FastMCP(
        name="{{ project_name }}",
        instructions=(
            "Use this server to interact with {{ project_name }}. "
            "Available tools are listed below. "
            "Prefer action-dispatcher tools (action= parameter) over per-operation tools."
        ),
    )

    # Gate every HTTP tool call on a registered actor. Self-exempts stdio, so a
    # genuine in-process caller is untouched. Wire this BEFORE any dispatcher —
    # a tool registered without it is reachable by any valid Authentik bearer.
    mcp.add_middleware(ActorGateMiddleware())

    # The feedback and alerts slices' tools come from the factory, same as their
    # HTTP routers (api/main.py). Register this app's own domain dispatchers
    # beside them as it grows.
    register_feedback_tools(mcp)
    register_alert_tools(mcp)

    @mcp.tool()
    def health_check() -> dict[str, str]:
        """Check that the MCP server is reachable and report the calling actor.

        Returns:
            dict with 'status': 'ok', the app name, and the resolved actor.

        Raises:
            AuthenticationError: the caller's identity is absent or is not
                registered in config/actors.yaml.
        """
        actor = resolve_actor()
        return {
            "status": "ok",
            "app": "{{ project_name }}",
            "actor": actor.id,
            "actor_type": actor.type,
        }

    logger.info("MCP server created: %s", mcp.name)
    return mcp
