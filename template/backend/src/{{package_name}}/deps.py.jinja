"""Reusable FastAPI dependency aliases (Annotated pattern).

Import these instead of writing Depends(...) inline in route signatures.
Add project-specific aliases here as the domain grows.

The three layers a request passes through, each answering exactly ONE question
(`rules-library/platform/tenancy.md`):

  CurrentIdentity   — who is calling            (proxy headers -> local user row)
  require_module    — may they use this module  (entitlement grade; entitlements.py)
  CurrentWorkspace  — whose data is in scope    (membership; BINDS the session)

Conflating any two of them is how an app comes to define "person" as "tenant" and
a second household member signs in to an empty app.

The identity and workspace dependencies are DEFINED in their own slices and
re-exported here, so routes have one import while the dependency graph still
flows one way (slices never import this module).
"""

from typing import Annotated

from fastapi import Depends
from sqlalchemy.orm import Session

from {{ package_name }}.api.users.dependencies import (
    CurrentIdentity,
    CurrentUser,
    Identity,
    get_current_user,
    get_identity,
)
from {{ package_name }}.api.workspaces.dependencies import (
    CurrentWorkspace,
    WorkspaceContext,
    get_current_workspace,
)
from {{ package_name }}.config import Settings, get_settings
from {{ package_name }}.db.session import get_session

SessionDep = Annotated[Session, Depends(get_session)]
SettingsDep = Annotated[Settings, Depends(get_settings)]

__all__ = [
    "CurrentIdentity",
    "CurrentUser",
    "CurrentWorkspace",
    "Identity",
    "SessionDep",
    "SettingsDep",
    "WorkspaceContext",
    "get_current_user",
    "get_current_workspace",
    "get_identity",
]
