"""The app's one rate limiter.

Built on slowapi (the Starlette/FastAPI binding for the `limits` library) so
storage is a deployment choice rather than an architectural one: set a Redis
URL and counters are shared across workers and processes; leave it empty and
they are in-memory. That is `security-standards.md`'s "Redis-backed counters
with in-memory fallback" satisfied by the library, which is why an app without
Redis does not need one and an app with Redis needs no extra code.

Do NOT hand-roll a second limiter beside this one. Four apps in this estate
each wrote their own — one of them 586 lines — and six had none at all
(master-project#277). Per-route limits and a per-app `key_func` are the
supported ways to differ; a parallel implementation is not.

Usage:

    from {{ package_name }}.rate_limit import limiter

    @router.get("/expensive")
    @limiter.limit("5/minute")
    async def expensive(request: Request) -> ...:
        ...

The `request` parameter is required on a decorated route — slowapi reads the
key from it.

The DEFAULT limit (`rate_limit_default`) binds through `enforce_default_rate_limit`,
wired as a dependency on the API router in `main.py` — NOT through slowapi's
`SlowAPIMiddleware`. slowapi's middleware finds the route handler by scanning the
app's top-level routes for one exposing an `.endpoint`; since FastAPI 0.141 an
`include_router()` call is a single opaque `_IncludedRouter` route with no
`.endpoint`, so the scan returns nothing, the middleware treats every included
route as exempt, and the default silently never fires (master-project#286 — it
returned 200 to 140 requests against a 100/minute limit). The dependency runs
AFTER FastAPI has resolved the route, reads the real endpoint from
`request.scope["endpoint"]`, and applies the default unless that endpoint carries
its own `@limiter.limit()` or `@limiter.exempt`. Per-route decorators are
unaffected: they enforce themselves at call time, independently of any middleware.
"""

from __future__ import annotations

import logging
from typing import TYPE_CHECKING

from slowapi import Limiter
from slowapi.errors import RateLimitExceeded
from starlette.requests import Request
from starlette.responses import JSONResponse

from {{ package_name }}.config import get_settings
from {{ package_name }}.proxy_trust import client_ip

if TYPE_CHECKING:
    from starlette.responses import Response

logger = logging.getLogger(__name__)


def rate_limit_key(request: Request) -> str:
    """Key a request by its caller's real address.

    Deliberately NOT slowapi's own ``get_remote_address``: that returns the TCP
    peer, which behind a reverse proxy is the PROXY for every caller — putting
    the whole internet in one bucket and turning the limiter into a self-inflicted
    denial of service. ``client_ip`` resolves the forwarded chain, but only when
    the peer is a configured trusted proxy.

    An app that authenticates its callers should override this with something
    stronger (an API-key id, an account id) so one noisy consumer cannot
    throttle another; pass it as ``key_func`` when building the limiter.
    """
    return client_ip(request, get_settings())


def build_limiter() -> Limiter:
    """Construct the app limiter from settings."""
    settings = get_settings()
    storage_uri = settings.security.rate_limit_storage_uri
    return Limiter(
        key_func=rate_limit_key,
        default_limits=[settings.security.rate_limit_default],
        enabled=settings.security.rate_limit_enabled,
        # slowapi falls back to in-memory when this is None; an unreachable
        # Redis must never silently DISABLE the limit, which is why the fallback
        # is storage-level rather than an `enabled = False` on error.
        #
        # BEFORE YOU SET THIS to a Redis URL, read on. That fallback covers
        # "no URL configured", NOT "URL configured and Redis dies mid-request" —
        # in which case slowapi raises and the request 500s, so the limiter takes
        # the app down with it. No household app sets this today, which is the
        # only reason the gap is unreached. The first app that wants shared
        # counters across workers has to solve degrade-to-in-memory-on-error
        # HERE, in the factory, for every app at once; a per-app fallback flag is
        # exactly the divergence master-project#277 existed to end.
        storage_uri=storage_uri or None,
    )


limiter = build_limiter()


async def enforce_default_rate_limit(request: Request) -> None:
    """Apply the configured default limit to a route that has not opted out.

    Wired as a dependency on the API router (`main.py`) rather than left to
    slowapi's `SlowAPIMiddleware`, which cannot see routes mounted through
    FastAPI's `include_router()` and so applied the default to nothing
    (master-project#286). This runs after FastAPI has resolved the route, so
    the real endpoint is on the scope and the default genuinely binds.

    Defers to any per-route opt-out so the route is limited once, not twice:
    a `@limiter.limit()` decorator (static -> ``_route_limits``, dynamic ->
    ``_dynamic_route_limits``) enforces itself at call time, and `@limiter.exempt`
    (``_exempt_routes``) means the route is deliberately unlimited. Raising
    `RateLimitExceeded` here is caught by the handler registered in the factory.
    """
    if not limiter.enabled:
        return
    endpoint = request.scope.get("endpoint")
    if endpoint is None:
        return
    name = f"{endpoint.__module__}.{endpoint.__name__}"
    if name in limiter._route_limits or name in limiter._dynamic_route_limits or name in limiter._exempt_routes:
        return
    # in_middleware=True is slowapi's "apply the application/default limits"
    # mode; it raises RateLimitExceeded when the caller is over the default.
    limiter._check_request_limit(request, endpoint, True)


def rate_limit_handler(request: Request, exc: Exception) -> Response:
    """Return 429 with Retry-After, and log the hit as a security event.

    `security-standards.md` requires every 429 to be logged and to carry
    Retry-After; slowapi's own handler does neither consistently, so the app
    supplies one. The caller's key is logged (an address or an account id) —
    never a credential, and never the request body.
    """
    retry_after = getattr(exc, "retry_after", None) or 60
    key = rate_limit_key(request)
    logger.warning(
        "Rate limit exceeded",
        extra={
            "event": "rate_limit_exceeded",
            "client_key": key,
            "path": request.url.path,
            "method": request.method,
            "retry_after": retry_after,
        },
    )
    return JSONResponse(
        status_code=429,
        content={"detail": "Rate limit exceeded. Please retry later."},
        headers={"Retry-After": str(retry_after)},
    )


__all__ = [
    "RateLimitExceeded",
    "build_limiter",
    "enforce_default_rate_limit",
    "limiter",
    "rate_limit_handler",
    "rate_limit_key",
]
