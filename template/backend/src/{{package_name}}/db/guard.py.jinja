"""Refuse a write to a production-stamped database from code that is not what production runs.

A seat or a script run from a git checkout can reach the live database (see
``db/environment.py``); product rows written from an unmerged branch are rows the deployed
code cannot read. A database stamped ``production`` therefore takes a write only from a
checkout whose HEAD is the remote's default-branch HEAD and whose ``backend/`` tree is clean.

Passes untouched, because nothing is there to protect or to compare:

- a deployed image (no ``.git`` above the package; migrations run at boot, and refusing on
  missing git state would stop the live app starting);
- a container with no git binary: an app run from source mounts its checkout, so a ``.git`` is
  above the package, but its image carries no git and its deploy unit, not a person, moved the
  checkout. A seat or script on a checkout has git (else it could not have branched) or no
  container, so it is still compared and refused;
- a database not stamped production, one with no marker table (before its first migration a
  failed read would abort the migration's own transaction), and one whose name contains
  ``test`` (the suite's throwaway databases).

A checkout that cannot be compared (remote unreachable, git failing) is refused: the
database is production and the comparison is the point.
"""

from __future__ import annotations

import shutil
import subprocess
from pathlib import Path

from sqlalchemy import text
from sqlalchemy.engine import Connection, Engine

from {{ package_name }}.db.environment import DeploymentEnvironment, stamped_environment


class ProductionWriteForbiddenError(RuntimeError):
    """A checkout that is not the remote's default branch, or is dirty, tried to write to production."""


def _git(root: Path, *args: str) -> str:
    try:
        done = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, timeout=30, check=True)
    except (OSError, subprocess.SubprocessError) as exc:
        raise ProductionWriteForbiddenError(
            f"Cannot verify the checkout against origin (git {args[0]}): {exc}"
        ) from exc
    return done.stdout.strip()


def _in_container() -> bool:
    return Path("/.dockerenv").exists() or Path("/run/.containerenv").exists()


def _is_deployed_container() -> bool:
    """A container without git cannot be a seat's checkout: the deploy unit moved what it runs."""
    return _in_container() and shutil.which("git") is None


def _checkout_root(backend_dir: Path) -> Path | None:
    for candidate in (backend_dir, *backend_dir.parents):
        if (candidate / ".git").exists():
            return candidate
    return None


def _database_name(bind: Engine | Connection) -> str | None:
    return (bind.engine if isinstance(bind, Connection) else bind).url.database


def _has_marker_table(bind: Engine | Connection) -> bool:
    statement = text("SELECT to_regclass('deployment_environment')")
    if isinstance(bind, Connection):
        return bind.execute(statement).scalar() is not None
    with bind.connect() as connection:
        return connection.execute(statement).scalar() is not None


def assert_checkout_on_default_branch(*, backend_dir: Path | None = None) -> None:
    """Raise ``ProductionWriteForbiddenError`` unless this checkout is origin's default branch with a clean ``backend/``.

    The checkout half of the guard, for any live write that is not a database write (a decision
    recorded in core-memory, a call to an estate service). A deployed image (no ``.git``) passes;
    an unreachable origin refuses.
    """
    backend = backend_dir or Path(__file__).resolve().parents[3]
    root = _checkout_root(backend)
    if root is None or _is_deployed_container():
        return

    # The remote's own answer for its default branch, so no fetch and no branch name assumed.
    remote_head = _git(root, "ls-remote", "origin", "HEAD").split()[:1]
    head = _git(root, "rev-parse", "HEAD")
    if not remote_head or head != remote_head[0]:
        raise ProductionWriteForbiddenError(
            "A live write is forbidden from a checkout whose HEAD is not "
            f"origin's default branch (HEAD={head[:8]}, origin={remote_head[0][:8] if remote_head else 'unknown'}). "
            "Merge your code first."
        )
    if _git(root, "status", "--porcelain", "--", str(backend)):
        raise ProductionWriteForbiddenError(
            "A live write is forbidden with uncommitted changes under backend/. Commit and land them first."
        )


def assert_can_write_to_database(
    bind: Engine | Connection, *, backend_dir: Path | None = None, ignore_test_db: bool = False
) -> None:
    """Raise ``ProductionWriteForbiddenError`` unless writing to the connected database is allowed from here."""
    if not ignore_test_db and "test" in (_database_name(bind) or ""):
        return
    if not _has_marker_table(bind):
        return
    if stamped_environment(bind) is not DeploymentEnvironment.PRODUCTION:
        return

    assert_checkout_on_default_branch(backend_dir=backend_dir)
