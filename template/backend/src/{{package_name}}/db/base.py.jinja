"""SQLAlchemy declarative base and shared mixins.

All ORM models inherit from Base (for Alembic autogenerate) and may compose
the mixins for standard columns.
"""

import datetime
import uuid

from sqlalchemy import DateTime, ForeignKey, func
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column


class Base(DeclarativeBase):
    """Shared declarative base for all ORM models in {{ project_name }}.

    Import Base — do NOT import from sqlalchemy directly — so Alembic's
    target_metadata picks up every model registered here.
    """


class TimestampMixin:
    """Adds created_at / updated_at columns to any model.

    created_at is set once on INSERT; updated_at is updated on every UPDATE
    via server_default + onupdate so the DB owns the clock.
    """

    created_at: Mapped[datetime.datetime] = mapped_column(
        DateTime(timezone=True),
        server_default=func.now(),
        nullable=False,
    )
    updated_at: Mapped[datetime.datetime] = mapped_column(
        DateTime(timezone=True),
        server_default=func.now(),
        onupdate=func.now(),
        nullable=False,
    )


class WorkspaceScoped:
    """Marks a model as workspace-scoped: ``workspace_id`` is THE access predicate.

    A model carrying this mixin is filtered automatically on every ORM statement
    and stamped automatically on every insert, by the session hooks in
    ``db/scoping.py``. Services therefore write no scoping filter and take no
    caller-id parameter — there is nothing to forget, which is the difference
    between a mechanism and a discipline (`rules-library/platform/tenancy.md`).

    Take it on CHILD tables too, not only on the aggregate roots. A child row
    reached through its parent's foreign key looks safe because callers happen to
    arrive via a scoped parent, but nothing stops a bare ``select(ChildRow)``, and
    a model without this mixin has no criterion injected into it. Denormalising
    the column down costs an index and buys mechanical coverage.

    Every mapped model must either carry this mixin or be named, with a reason, in
    the exemption list in ``db/registry.py``; the registry test fails on a model
    in neither place.
    """

    # NOT NULL and RESTRICT: deleting a workspace must never cascade a ledger
    # away. A workspace with rows in it cannot be deleted until they are dealt
    # with deliberately, which is the answer a financial app needs.
    workspace_id: Mapped[int] = mapped_column(
        ForeignKey("workspaces.id", ondelete="RESTRICT"),
        nullable=False,
        index=True,
    )

    # Attribution ONLY, never authorisation. No access decision reads this column
    # — the moment one does, the app is back to defining "person" as "tenant".
    # SET NULL so a departed member's rows stay the workspace's rather than
    # cascading away with the account.
    created_by_id: Mapped[uuid.UUID | None] = mapped_column(
        ForeignKey("users.id", ondelete="SET NULL"),
        nullable=True,
    )


class SharedReference:
    """Marks a taxonomy every workspace reads and any workspace may add to.

    A NULL ``workspace_id`` means GLOBAL — visible to every workspace; a non-NULL
    one means that workspace's own addition to the same list. The rule is stated
    HERE, in the model's declaration, rather than implied by whether a column
    happens to be null: a visibility rule nobody declared is the defect this whole
    layer exists to end, and this mixin is what keeps it declared while still
    being injected automatically by the same session hooks.

    Reach for it ONLY for a genuine shared taxonomy that other rows point at with
    a foreign key. The alternative — splitting into a global table and a scoped
    one — was measured against a live app's two instances on 2026-08-20 and costs
    more than it buys: both are foreign-key TARGETS, so a split leaves a
    referencing row unable to name its parent with one foreign key, forcing
    either two nullable columns and a CHECK (doubling the join on every read) or
    a bare integer and a discriminator, which takes referential integrity off a
    financial ledger. One of the two is NOT NULL today, so a split would demote a
    database-enforced invariant to a check constraint.

    A row with a workspace behaves exactly like a WorkspaceScoped one. A GLOBAL
    row is estate-wide reference data: writing one is a deliberate act inside an
    ``unscoped()`` block, which is greppable and baselined, because within a bound
    session the flush hook can only ever stamp a row into the session's own
    workspace.
    """

    workspace_id: Mapped[int | None] = mapped_column(
        ForeignKey("workspaces.id", ondelete="RESTRICT"),
        nullable=True,
        index=True,
    )

    created_by_id: Mapped[uuid.UUID | None] = mapped_column(
        ForeignKey("users.id", ondelete="SET NULL"),
        nullable=True,
    )
