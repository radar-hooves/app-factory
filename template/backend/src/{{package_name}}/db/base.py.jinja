"""SQLAlchemy declarative base and shared mixins.

All ORM models inherit from Base (for Alembic autogenerate) and may compose
the mixins for standard columns.
"""

import datetime

from sqlalchemy import DateTime, func
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column


class Base(DeclarativeBase):
    """Shared declarative base for all ORM models in {{ project_name }}.

    Import Base — do NOT import from sqlalchemy directly — so Alembic's
    target_metadata picks up every model registered here.
    """


class TimestampMixin:
    """Adds created_at / updated_at columns to any model.

    created_at is set once on INSERT; updated_at is updated on every UPDATE
    via server_default + onupdate so the DB owns the clock.
    """

    created_at: Mapped[datetime.datetime] = mapped_column(
        DateTime(timezone=True),
        server_default=func.now(),
        nullable=False,
    )
    updated_at: Mapped[datetime.datetime] = mapped_column(
        DateTime(timezone=True),
        server_default=func.now(),
        onupdate=func.now(),
        nullable=False,
    )
