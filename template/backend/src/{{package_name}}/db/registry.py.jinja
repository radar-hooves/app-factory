"""Model registry — import every ORM model here so Alembic's autogenerate
can discover all tables via Base.metadata.

Add one import per model module as the domain grows:
    from {{ package_name }}.api.example.models import ExampleItem  # noqa: F401

This file also carries WORKSPACE_EXEMPT. Every mapped model falls in exactly one
of three STATED buckets — it takes ``WorkspaceScoped``, or it takes
``SharedReference``, or it is named here with a reason — and
``tests/test_workspace_scoping.py`` fails on a model in none of them. Three
buckets are enforced as mechanically as two; what matters is that each is
DECLARED rather than inferred from whether a column happens to be null, which is
what stops a new table quietly shipping with no access predicate
(`rules-library/platform/tenancy.md`).
"""

from {{ package_name }}.api.example.models import ExampleItem  # noqa: F401
from {{ package_name }}.api.users.models import User
from {{ package_name }}.api.workspaces.models import Workspace, WorkspaceMembership
from {{ package_name }}.db.base import Base
from {{ package_name }}.db.environment import DeploymentEnvironmentMarker

# Models that legitimately carry no workspace column at all, each with the reason
# it does not. Two kinds qualify and no third: the identity tables that workspace
# resolution is performed FROM, and reference data with no per-workspace half.
#
# A CHILD table is NOT a third kind. "Reached only through its scoped parent" is
# a claim about how callers happen to behave, and nothing stops a bare
# select(ChildRow) — so a child row takes WorkspaceScoped too, with workspace_id
# denormalised down. The exemption list is for tables that genuinely have no
# workspace, not for tables whose workspace is inconvenient to reach.
#
# A SHARED TAXONOMY — a global list every workspace reads and any workspace may
# add its own entries to — is not exempt either. It takes the SharedReference
# mixin, which states that rule in the model's own declaration and has the same
# hooks inject the wider predicate. Splitting such a table into a global one and
# a scoped one was measured and rejected on 2026-08-20: a shared taxonomy is
# typically a FOREIGN-KEY TARGET, and a split leaves referencing rows unable to
# name their parent with one foreign key — two nullable columns and a CHECK, or
# a bare integer and a discriminator that takes referential integrity off the
# ledger. Neither is worth a tidier table list.
WORKSPACE_EXEMPT: dict[type, str] = {
    User: "identity — a user exists before any workspace, and membership is resolved from this table",
    Workspace: "the workspace itself — rows are scoped TO it",
    WorkspaceMembership: "the grant that resolution reads; scoping it by workspace would be circular",
    DeploymentEnvironmentMarker: "app-level singleton recording which deployment this database belongs to",
}

__all__ = ["WORKSPACE_EXEMPT", "Base"]
