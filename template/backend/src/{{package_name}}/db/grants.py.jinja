"""Least-privilege grants for the role the running app connects as.

`alembic/env.py` calls `grant_runtime_role` on the owner's connection after the
last migration whenever `DatabaseSettings.postgres_runtime_user` is set, so the
app runs with data access to its own tables and no DDL. The role is provisioned
on the database host (it needs a credential this repo never holds); this module
only grants, idempotently, and never creates it.
"""

from sqlalchemy import text
from sqlalchemy.engine import Connection

_SCHEMA = "public"
_VERSION_TABLE = "alembic_version"


def grant_runtime_role(connection: Connection, role: str, owner: str) -> None:
    """Give `role` DML on every table and sequence in `public`, and no DDL.

    Runs on the owner's connection. Safe to repeat: grants and revokes are
    idempotent. `owner`'s default privileges cover tables a later migration
    creates, so a release adding a table needs nothing else.
    """
    exists = connection.execute(text("SELECT 1 FROM pg_roles WHERE rolname = :role"), {"role": role}).scalar()
    if not exists:
        raise RuntimeError(
            f"Database role {role!r} (POSTGRES_RUNTIME_USER) does not exist. "
            "It is provisioned on the database host, not by this app: create it there with LOGIN and no other attributes."
        )
    quote = connection.dialect.identifier_preparer.quote
    runtime, owner_role, schema, version = quote(role), quote(owner), quote(_SCHEMA), quote(_VERSION_TABLE)
    statements = [
        f"GRANT USAGE ON SCHEMA {schema} TO {runtime}",
        f"REVOKE CREATE ON SCHEMA {schema} FROM {runtime}",
        f"GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA {schema} TO {runtime}",
        f"GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA {schema} TO {runtime}",
        f"ALTER DEFAULT PRIVILEGES FOR ROLE {owner_role} IN SCHEMA {schema} "
        f"GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO {runtime}",
        f"ALTER DEFAULT PRIVILEGES FOR ROLE {owner_role} IN SCHEMA {schema} GRANT USAGE, SELECT ON SEQUENCES TO {runtime}",
        f"REVOKE ALL ON {schema}.{version} FROM {runtime}",
    ]
    for statement in statements:
        connection.execute(text(statement))
