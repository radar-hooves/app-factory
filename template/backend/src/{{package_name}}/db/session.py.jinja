"""Database engine and session factory.

Sync SQLAlchemy is the household way (`rules-library/platform/canonical-app-shape.md`);
there is no per-app sync/async choice. An endpoint that genuinely fans out I/O
uses the bounded thread-pool helper in `services/fanout.py` instead of an
app-wide async flip.
"""

from collections.abc import Generator

from sqlalchemy import Engine, create_engine, event
from sqlalchemy.orm import Session, sessionmaker

from {{ package_name }}.config import get_settings

# Imported for its side effect: db/scoping.py registers the workspace hooks on
# the Session CLASS, so they apply to every session in the process including the
# test suite's own factory. Importing it HERE means any code path that can make
# a session has already armed them — there is no window in which a session
# exists unguarded.
from {{ package_name }}.db import scoping  # noqa: F401

_engine: Engine | None = None
_session_factory: sessionmaker[Session] | None = None


def get_engine() -> Engine:
    """Return the shared sync engine (created once per process)."""
    global _engine
    if _engine is None:
        settings = get_settings()
        _engine = create_engine(
            settings.database.database_url,
            echo=settings.debug,
            pool_pre_ping=True,
        )

        @event.listens_for(_engine, "connect")
        def _set_timezone_utc(dbapi_connection: object, connection_record: object) -> None:
            """Force UTC on every new DBAPI connection.

            PostgreSQL sessions otherwise inherit the server's configured
            timezone, which can silently disagree with TimestampMixin's
            server-side NOW() defaults.
            """
            cursor = dbapi_connection.cursor()  # type: ignore[attr-defined]
            try:
                cursor.execute("SET timezone = 'UTC'")
            finally:
                cursor.close()

    return _engine


def get_session_factory() -> sessionmaker[Session]:
    global _session_factory
    if _session_factory is None:
        _session_factory = sessionmaker(
            bind=get_engine(),
            autoflush=False,
            expire_on_commit=False,
        )
    return _session_factory


def get_session() -> Generator[Session]:
    """FastAPI dependency: yields a sync database session per request.

    Every `Depends(get_session)` call site must pass `scope="function"`
    (`deps.py`, `api/users/dependencies.py`, `api/workspaces/dependencies.py`):
    FastAPI's default "request" scope runs the commit below AFTER the response
    has already been sent, so a client's next request can miss a row its own
    previous response just returned, and a failed commit has nobody left to
    hand the error to (master-project#233).
    """
    factory = get_session_factory()
    with factory() as session:
        try:
            yield session
            session.commit()
        except Exception:
            session.rollback()
            raise
