"""Gunicorn configuration for production deployment.

TLS/HSTS is normally terminated by the reverse proxy; the app also sets HSTS
itself (middleware.py) so it is safe standalone.
"""

import ipaddress
import logging
import os
import socket
import struct
import sys
import time
from collections.abc import Callable
from urllib.parse import urlsplit

PORT = {{ backend_port }}


def _ipv4_interfaces() -> list[ipaddress.IPv4Interface]:
    """Every IPv4 address this container holds, with its subnet (Linux SIOCGIFADDR/SIOCGIFNETMASK)."""
    import fcntl

    found = []
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        for _, name in socket.if_nameindex():
            request = struct.pack("256s", name.encode()[:15])
            try:
                address = socket.inet_ntoa(fcntl.ioctl(probe.fileno(), 0x8915, request)[20:24])
                netmask = socket.inet_ntoa(fcntl.ioctl(probe.fileno(), 0x891B, request)[20:24])
            except OSError:  # an interface with no IPv4 address
                continue
            found.append(ipaddress.IPv4Interface(f"{address}/{netmask}"))
    return found


def _resolve_ipv4(host: str) -> list[ipaddress.IPv4Address]:
    return sorted({ipaddress.IPv4Address(info[4][0]) for info in socket.getaddrinfo(host, None, socket.AF_INET)})


def listen_addresses(
    environ: dict[str, str],
    interfaces: Callable[[], list[ipaddress.IPv4Interface]] = _ipv4_interfaces,
    resolve: Callable[[str], list[ipaddress.IPv4Address]] = _resolve_ipv4,
    wait: float = 30.0,
) -> list[str]:
    """The addresses to listen on: every one this container holds except the telemetry network's.

    An app joins the shared telemetry network only to dial the OTLP collector
    (OTEL_EXPORTER_OTLP_ENDPOINT), yet a listener on 0.0.0.0 answers every other
    member of that network, past the front door, and the app trusts the identity
    headers the front door sets. Docker's resolver answers the collector's name
    only from a network the two share, so the collector's address names the
    interface to leave unbound; a connection the app opens to the collector
    needs no listener there, so traces are untouched. No address is pinned and
    no network is named: the deployment already sets the endpoint.

    Without the endpoint (development, a bare host), or with a collector reached
    through a route rather than a shared subnet, nothing is excluded and the
    listener stays on 0.0.0.0. A collector name that does not resolve within
    `wait` seconds stops the start rather than opening every interface: the
    restart policy brings the app up once the collector does.
    """
    endpoint = environ.get("OTEL_EXPORTER_OTLP_ENDPOINT", "").strip()
    host = urlsplit(endpoint if "//" in endpoint else f"//{endpoint}").hostname if endpoint else None
    if not host or sys.platform != "linux":
        return [f"0.0.0.0:{PORT}"]
    deadline = time.monotonic() + wait
    while True:
        try:
            collectors = resolve(host)
            break
        except OSError as error:
            if time.monotonic() >= deadline:
                raise RuntimeError(
                    f"OTEL_EXPORTER_OTLP_ENDPOINT host {host!r} does not resolve ({error}); refusing to listen on "
                    "every network. Start the collector, or unset the endpoint."
                ) from error
            time.sleep(1)
    held = interfaces()
    closed = [i for i in held if not i.ip.is_loopback and any(c in i.network for c in collectors)]
    if not closed:
        return [f"0.0.0.0:{PORT}"]
    kept = [i for i in held if i not in closed]
    if not any(not i.ip.is_loopback for i in kept):
        raise RuntimeError(
            f"the collector {host!r} shares the app's only network ({closed[0].network}); closing it would "
            "leave the app unreachable. Give the app a network of its own for the front door."
        )
    return [f"{i.ip}:{PORT}" for i in kept]


bind = listen_addresses(dict(os.environ))
backlog = 2048

# Worker count is container-aware. DEBUG runs a single worker. Production
# reads WEB_CONCURRENCY (the 12-factor standard), which the deployment sets
# to match the container's actual CPU allocation. The default of 5 sizes a
# 2-CPU container by gunicorn's (2 * cores) + 1 rule. This deliberately does
# NOT call multiprocessing.cpu_count(): inside a container that reports the
# HOST's logical CPUs (ignoring the cgroup limit), so a host-derived count
# over-provisions the worker pool badly enough to trip the OOM-killer on a
# cold-start fork storm.
workers = 1 if os.getenv("DEBUG", "false").lower() == "true" else int(os.getenv("WEB_CONCURRENCY", "5"))
worker_class = "uvicorn.workers.UvicornWorker"
worker_connections = 1000

# Uvicorn rewrites request.client from X-Forwarded-For for peers in this list.
# proxy_trust.py resolves the chain itself against the trusted-proxy list and
# needs the real TCP peer, which the rewrite destroys, so nothing is trusted here
# and FORWARDED_ALLOW_IPS is not consulted. Naming the proxy or an RFC1918 range
# hands a caller any address it asserts. Gunicorn takes the empty string for [].
forwarded_allow_ips = ""
# Recycling a worker is a hygiene default, not a universal one. A service whose
# worker holds process-local state a restart cannot rebuild — an unlocked vault
# session, a supervised child process — comes back from a recycle unable to serve,
# and it is the recycle rather than the load that breaks it. Setting both to 0
# disables recycling; every other app leaves the default and never thinks about it.
max_requests = int(os.getenv("GUNICORN_MAX_REQUESTS", "1000"))
max_requests_jitter = int(os.getenv("GUNICORN_MAX_REQUESTS_JITTER", "100"))

timeout = 60
graceful_timeout = 30
keepalive = 2

preload_app = True
# reuse_port stays off. On, every worker gets its own SO_REUSEPORT listener and
# the kernel resets whatever is queued on it when that worker exits, so each
# max_requests recycle 502s the connections a cold SPA load has just opened,
# which SvelteKit renders as its 500 page. Measured 06/09/2026: two route chunks
# reset within 3 ms of a worker closing its socket. Off, the master's one shared
# socket is drained by the surviving workers.

loglevel = "debug" if os.getenv("DEBUG", "false").lower() == "true" else "warning"
accesslog = None  # disabled; access logs flow through uvicorn.access -> the app's own root handler
errorlog = "-"  # stderr for Gunicorn's own master-process messages only
logconfig_dict = {
    "version": 1,
    "disable_existing_loggers": False,
    "root": {"level": "INFO", "handlers": []},
    "loggers": {
        "gunicorn.error": {"level": "INFO", "handlers": [], "propagate": True},
        "gunicorn.access": {"level": "INFO", "handlers": [], "propagate": True},
    },
}

proc_name = "{{ package_name }}"

# Gunicorn defaults its control socket under $HOME, which a read-only root cannot
# create; the tmpfs holds it.
control_socket = "/tmp/gunicorn/gunicorn.ctl"

# Security limits
limit_request_line = 4094
limit_request_fields = 100
limit_request_field_size = 8190


def when_ready(server) -> None:
    """Announce readiness once the server can accept connections."""
    server.log.info("{{ project_name }} is ready to accept connections (%d worker(s))", workers)


def worker_int(worker) -> None:
    """Log a worker's graceful-shutdown signal."""
    worker.log.info("Worker %s received shutdown signal", worker.pid)


def on_exit(server) -> None:
    """Log final shutdown, then run app_hooks.on_exit if the app defines one.

    Only the arbiter knows the application has ended (a worker cannot tell a
    recycle from a shutdown), so an app supervising a child process ends it here.
    Guarded: a shutdown hook must never raise.
    """
    server.log.info("{{ project_name }} shutdown complete")
    try:
        from {{ package_name }} import app_hooks

        hook = getattr(app_hooks, "on_exit", None)
        if hook is not None:
            hook(server)
    except Exception as exc:  # a shutdown hook must never raise
        server.log.warning("app_hooks.on_exit failed during shutdown: %r", exc)


def post_fork(server, worker) -> None:
    """Mute uvicorn's own startup noise; the app owns stdout via configure_logging()."""
    if os.getenv("DEBUG", "false").lower() != "true":
        for name in ("uvicorn", "uvicorn.access", "uvicorn.error"):
            logging.getLogger(name).setLevel(logging.WARNING)
