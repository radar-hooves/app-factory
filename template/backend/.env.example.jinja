# Machine-local settings for {{ project_name }}. Copy to `backend/.env`, fill in
# the value below, then `direnv allow`.
#
#   cp backend/.env.example backend/.env
#
# This is the ONE place a machine-specific value belongs. Three consumers read
# this same file: direnv (.envrc) exports it into the shell, the .vscode launch
# configurations name it as their `envFile`, and compose.yaml mounts it as
# `env_file`. Gitignored.
#
# Two conventions, both load-bearing:
#
#   UNCOMMENTED = you must supply it. A blank one is what stops the app, by
#   design: the dev server talks to the REAL database, so a defaulted identity
#   writes real rows under a user nobody chose.
#
#   COMMENTED OUT = optional; the code already has the right default. Leave it
#   commented unless you are deliberately overriding. A key present with a blank
#   value is NOT the same as an absent one — it exports an empty string that
#   beats the code default, and a consumer reading os.environ[KEY] directly
#   crashes on it rather than falling back (uvicorn does exactly this with
#   WEB_CONCURRENCY, and int("") is not a number).
#
# POSTGRES_HOST and POSTGRES_PORT appear nowhere here: they are committed in
# .envrc, where a fresh clone gets them for free.
#
# The must-fill value below can also be supplied ONCE for the whole estate, in
# the umbrella's own gitignored .envrc.local, as a single DEV_UID. This file
# still wins where it sets one; the estate file is what stops a fresh clone of
# any app being dead until someone remembers to paste the same identity again.
#
# POSTGRES_PASSWORD appears nowhere here, uncommented or otherwise: this app
# vends it from the household broker under its own software identity key
# (config/vend.py) every time it starts. A fresh clone needs that key minted
# at activation, not a value pasted here -- see the Optional overrides section
# below to override the vend instead.

# Your own Authentik uid — the stable 64-character hashed id, not a username.
# The backend upserts a user by this key on every request against the REAL
# database, so it must be YOU, not a made-up value, or you are developing
# against someone who does not exist. The E2E suite overrides it with an
# identity of its own; nothing else should.
{{ project_name | upper | replace('-', '_') }}_DEV_UID=

# Instead of the uid above: run behind the Authentik forward-auth proxy (a
# `{{ project_name }}-dev` host), where nginx authenticates you and injects your real
# identity per request — the same division of labour as production, so there is
# nothing to look up and nothing to keep in step. Uncomment BOTH, and leave the
# uid above blank.
#{{ project_name | upper | replace('-', '_') }}_DEV_BEHIND_PROXY=true
#{{ project_name | upper | replace('-', '_') }}_DEV_PUBLIC_HOST=

# Development mode. This file is the DEV env file in both the places that read
# it — the launch configurations and compose.yaml's local image-build smoke —
# and a deployment supplies its own, so the dev value belongs here rather than
# the production one. Left unset, the image the smoke builds runs as production:
# only a source checkout defaults to development.
DEBUG=true

# ── Optional overrides ───────────────────────────────────────────────────────
# Everything below has a working default in code. Uncomment only to change one.

# Overrides the vend above. Every other consumer -- the dev server, the
# debugger, the test suite's own throwaway container -- leaves this unset.
#POSTGRES_PASSWORD=

# Embedded MCP surface (/mcp) — inbound auth.
#
# The /mcp mount serves MACHINE callers and validates a live Authentik OIDC
# Bearer token app-side. It does NOT trust the X-authentik-* proxy headers the
# human surface uses; a machine caller does not traverse the human proxy, so
# header trust there would be a bypass.
#
# The shipped default fails CLOSED: with no userinfo URL, every /mcp HTTP
# request 401s, so this app is never open by accident and runs locally with no
# identity provider. Set the URL to open the surface — no rebuild needed.
#{{ project_name | upper | replace('-', '_') }}_OIDC_USERINFO_URL=
# The userinfo claim read as the caller's identity (falls back to `sub`).
# Deployments behind the household's shared mcp-gateway client set mcp_actor.
#{{ project_name | upper | replace('-', '_') }}_OIDC_IDENTITY_CLAIM=preferred_username
# Protected-resource metadata URL advertised in the 401 WWW-Authenticate header
# (RFC 9728). Unset omits the parameter.
#{{ project_name | upper | replace('-', '_') }}_OIDC_RESOURCE_METADATA_URL=
# Actor allow-list. An identity the gate resolves but that is absent from that
# file is refused. Defaults to config/actors.yaml at the repo root.
#{{ project_name | upper | replace('-', '_') }}_ACTORS_CONFIG_PATH=

# Comma-separated browser origins allowed to call the API. Unset in dev, where
# the Vite proxy makes the frontend same-origin.
#CORS_ORIGINS=

# Gunicorn worker count (backend/gunicorn.conf.py). Set it per deployment from
# the container's own CPU limit: the process cannot read a cgroup quota, so an
# unset value falls back to a conservative default rather than the host's cores.
#WEB_CONCURRENCY=
