# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB={{ project_name | replace('-', '_') }}

# Application
DEBUG=false
SECRET_KEY=changeme-replace-in-production

# Embedded MCP surface (/mcp) — inbound auth
#
# The /mcp mount serves MACHINE callers and validates a live Authentik OIDC
# Bearer token app-side. It does NOT trust the X-authentik-* proxy headers the
# human surface uses; a machine caller does not traverse the human proxy, so
# header trust there would be a bypass.
#
# Leaving the userinfo URL EMPTY fails closed: every /mcp HTTP request 401s.
# That is the shipped default, so this app is never open by accident and runs
# locally with no identity provider. Set it to open the surface — no rebuild
# needed to point at a different provider.
{{ project_name | upper | replace('-', '_') }}_OIDC_USERINFO_URL=
# The userinfo claim read as the caller's identity (falls back to `sub`).
# Deployments behind the household's shared mcp-gateway client set this to mcp_actor.
{{ project_name | upper | replace('-', '_') }}_OIDC_IDENTITY_CLAIM=preferred_username
# Protected-resource metadata URL advertised in the 401 WWW-Authenticate header
# (RFC 9728). Empty omits the parameter.
{{ project_name | upper | replace('-', '_') }}_OIDC_RESOURCE_METADATA_URL=
# Actor allow-list. An identity the gate resolves but that is absent from this
# file is refused. Defaults to config/actors.yaml at the repo root.
{{ project_name | upper | replace('-', '_') }}_ACTORS_CONFIG_PATH=
