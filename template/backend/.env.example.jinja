# Machine-local settings for {{ project_name }}. Copy to `backend/.env`, fill in
# the two values below, then `direnv allow`.
#
#   cp backend/.env.example backend/.env
#
# This is the ONE place a machine-specific value belongs. Three consumers read
# this same file: direnv (.envrc) exports it into the shell, the .vscode launch
# configurations name it as their `envFile`, and compose.yaml mounts it as
# `env_file`. Gitignored.
#
# Without it the app stops at the first missing value rather than inventing one.
# That is deliberate: the dev server talks to the REAL database, so a defaulted
# identity writes real rows under a user nobody chose.
#
# POSTGRES_HOST and POSTGRES_PORT are deliberately absent — they are committed
# in .envrc, where a fresh clone gets them for free. Setting them here would
# override that and silently point the app at a different real database.

# The database password. Each app has its own Postgres instance on its own port,
# so this is per-app, not shared. It lives in the household vault; vend it rather
# than copying it around by hand.
POSTGRES_PASSWORD=

# Your own Authentik uid — the stable 64-character hashed id, not a username.
# The backend upserts a user by this key on every request against the REAL
# database, so it must be YOU, not a made-up value, or you are developing
# against someone who does not exist. The E2E suite overrides it with an
# identity of its own; nothing else should.
{{ project_name | upper | replace('-', '_') }}_DEV_UID=

# Optional, and mutually exclusive with the uid above: run behind the Authentik
# forward-auth proxy (a `{{ project_name }}-dev` host) instead, where nginx
# authenticates you and injects your real identity per request — the same
# division of labour as production, so there is nothing to look up and nothing
# to keep in step.
{{ project_name | upper | replace('-', '_') }}_DEV_BEHIND_PROXY=
# The public hostname that proxy serves, so Vite accepts the Host header and HMR
# dials the public origin rather than localhost.
{{ project_name | upper | replace('-', '_') }}_DEV_PUBLIC_HOST=

# Application
DEBUG=false
SECRET_KEY=changeme-replace-in-production

# Embedded MCP surface (/mcp) — inbound auth
#
# The /mcp mount serves MACHINE callers and validates a live Authentik OIDC
# Bearer token app-side. It does NOT trust the X-authentik-* proxy headers the
# human surface uses; a machine caller does not traverse the human proxy, so
# header trust there would be a bypass.
#
# Leaving the userinfo URL EMPTY fails closed: every /mcp HTTP request 401s.
# That is the shipped default, so this app is never open by accident and runs
# locally with no identity provider. Set it to open the surface — no rebuild
# needed to point at a different provider.
{{ project_name | upper | replace('-', '_') }}_OIDC_USERINFO_URL=
# The userinfo claim read as the caller's identity (falls back to `sub`).
# Deployments behind the household's shared mcp-gateway client set this to mcp_actor.
{{ project_name | upper | replace('-', '_') }}_OIDC_IDENTITY_CLAIM=preferred_username
# Protected-resource metadata URL advertised in the 401 WWW-Authenticate header
# (RFC 9728). Empty omits the parameter.
{{ project_name | upper | replace('-', '_') }}_OIDC_RESOURCE_METADATA_URL=
# Actor allow-list. An identity the gate resolves but that is absent from this
# file is refused. Defaults to config/actors.yaml at the repo root.
{{ project_name | upper | replace('-', '_') }}_ACTORS_CONFIG_PATH=

# Comma-separated browser origins allowed to call the API. Empty in dev, where
# the Vite proxy makes the frontend same-origin.
CORS_ORIGINS=

# Gunicorn worker count (backend/gunicorn.conf.py). Set it per deployment from
# the container's own CPU limit: the process cannot read a cgroup quota, so an
# unset value falls back to a conservative default rather than the host's cores.
WEB_CONCURRENCY=
