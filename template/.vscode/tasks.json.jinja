{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kill Port {{ backend_port }}",
      "type": "shell",
      "command": "lsof -ti :{{ backend_port }} | xargs kill 2>/dev/null; echo 'Port {{ backend_port }} cleared'",
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    },
    {
      "label": "Kill Port {{ frontend_port }}",
      "type": "shell",
      "command": "lsof -ti :{{ frontend_port }} | xargs kill 2>/dev/null; echo 'Port {{ frontend_port }} cleared'",
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    }
  ]
}
