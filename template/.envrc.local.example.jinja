# Machine-local settings for {{ project_name }}. Copy to `.envrc.local`, fill in,
# then `direnv allow`. Gitignored — it is the ONE place a machine-specific value
# belongs, and direnv exports it, so the backend and the Vite dev server both see it.
#
#   cp .envrc.local.example .envrc.local
#
# Without it the app stops at the first missing value rather than inventing one.
# That is deliberate: the dev server talks to the REAL database, so a defaulted
# identity writes real rows under a user nobody chose.

# The database password. Each app has its own Postgres instance on its own port,
# so this is per-app, not shared. It lives in the household vault; vend it rather
# than copying it around by hand.
export POSTGRES_PASSWORD=

# Pick ONE of the two lines below; the dev server refuses to start with neither.
#
# Behind the Authentik forward-auth proxy (a `{{ project_name }}-dev` host), nginx
# authenticates you and injects your real identity per request — the same division
# of labour as production, so there is nothing to look up and nothing to keep in
# step. Prefer this.
export {{ project_name | upper | replace('-', '_') }}_DEV_BEHIND_PROXY=
# The public hostname that proxy serves, so Vite accepts the Host header and HMR
# dials the public origin rather than localhost.
export {{ project_name | upper | replace('-', '_') }}_DEV_PUBLIC_HOST=

# Otherwise, for laptop dev with nothing in front, your own Authentik uid — the
# stable 64-character hashed id, not a username. The backend upserts a user by
# this key on every request against the REAL database, so it must be YOU, not a
# made-up value, or you are developing against someone who does not exist. The
# E2E suite overrides it with an identity of its own; nothing else should.
export {{ project_name | upper | replace('-', '_') }}_DEV_UID=
