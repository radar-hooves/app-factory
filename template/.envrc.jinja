# uv-managed dev environment.
#
# Machine-local values live in ONE file, backend/.env (copy backend/.env.example).
# Three consumers read that same file and no other: direnv exports it into the
# shell here, the .vscode launch configurations name it as their `envFile`, and
# compose.yaml mounts it as `env_file`. A debugger cannot see a direnv
# environment, which is why a shell-only home for these values leaves every
# launch configuration starting with no database password at all.
source_up
{% if postgres_host %}
export POSTGRES_HOST="${POSTGRES_HOST:-{{ postgres_host }}}"
export POSTGRES_PORT="${POSTGRES_PORT:-{{ postgres_port }}}"
{% endif %}
# Present, always: compose declares backend/.env as a required env_file, so a
# fresh clone that has not been filled in yet must still have the file rather
# than fail before it can report what is missing.
[[ -f backend/.env ]] || cp backend/.env.example backend/.env

# Carry across any key the example has grown since this env file was written.
# Without it a new setting is silently absent from every existing checkout, and
# a REQUIRED one surfaces as a process that will not start — the same class of
# failure as the missing file itself, one release later. Key names only ever
# leave this pipeline; values are appended by `grep -f`, never printed.
_new_keys=$(comm -23 \
  <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' backend/.env.example | sort -u) \
  <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' backend/.env | sort -u))
if [[ -n "$_new_keys" ]]; then
  { echo; echo "# Added from backend/.env.example on $(date +%F)."; } >> backend/.env
  grep -E -f <(echo "$_new_keys" | sed 's/^/^/') backend/.env.example >> backend/.env
  echo "direnv: backend/.env gained $(echo "$_new_keys" | wc -l | tr -d ' ') key(s) the example documents" >&2
fi
unset _new_keys

watch_file backend/.env
dotenv_if_exists backend/.env

# shellcheck disable=SC2034  # read by direnv's stdlib as a shell variable, not exported
direnv_layout_dir="${XDG_CACHE_HOME:-$HOME/.cache}/direnv/layouts/$(echo -n "$PWD" | shasum | cut -d' ' -f1)"

if ! has uv; then
  echo "direnv: 'uv' not found on PATH; install it before working here" >&2
  return 0
fi

watch_file backend/pyproject.toml backend/uv.lock
uv sync --project backend --quiet

export VIRTUAL_ENV="$PWD/backend/.venv"
PATH_add "$PWD/backend/.venv/bin"

# Report a missing value HERE, where the fix is, rather than letting it surface
# as a pydantic validation error at the first request or as a debugger that
# exits before printing anything useful.
for _required in POSTGRES_PASSWORD {{ project_name | upper | replace('-', '_') }}_DEV_UID; do
  if [[ -z "${!_required:-}" ]]; then
    echo "direnv: $_required is not set — fill it in at backend/.env (see backend/.env.example)" >&2
  fi
done
unset _required
