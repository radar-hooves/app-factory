# .envrc - uv-managed Python project (backend/ layout)

# Cascade shared config/secrets from the master project's .envrc.local.
source_up
{% if postgres_host %}
# The database. Committed on purpose: the fleet host publishes {{ project_name }}'s
# Postgres on its TAILNET address, which is the same from the LAN, from a cafe, from
# anywhere an enrolled node sits — so there is nothing machine-specific left to
# configure and nothing to start. A fresh clone works as-is.
#
# This is production's database; there is no dev one (stacks/dev-environment.md).
# Set POSTGRES_HOST in .envrc.local only to point somewhere else deliberately (it is
# sourced after this, so it still wins). Extra service URLs an app needs in dev
# (Redis, Qdrant, an embedding endpoint) belong beside these two — the app's own
# remainder, not the template's concern.
export POSTGRES_HOST="${POSTGRES_HOST:-{{ postgres_host }}}"
export POSTGRES_PORT="${POSTGRES_PORT:-{{ postgres_port }}}"
{% endif %}
[[ -f .envrc.local ]] && source .envrc.local

# Keep direnv's cache out of the tree (core/direnv.md): an in-tree .direnv/
# pollutes the repo and churns watched-file mtimes when the checkout sits in a
# sync folder.
# shellcheck disable=SC2034  # read by direnv's stdlib as a shell variable, not exported
direnv_layout_dir="${XDG_CACHE_HOME:-$HOME/.cache}/direnv/layouts/$(echo -n "$PWD" | shasum | cut -d' ' -f1)"

# Prefer Nix when a flake is present (core/direnv.md). Falls through silently
# off-Nix so the uv path below still works.
if has nix && [[ -f flake.nix ]]; then
  use flake
fi

if ! has uv; then
  echo "direnv: 'uv' not found on PATH; install it (nix-darwin) before working here" >&2
  return 0
fi

watch_file backend/pyproject.toml backend/uv.lock
uv sync --project backend --quiet

export VIRTUAL_ENV="$PWD/backend/.venv"
PATH_add "$PWD/backend/.venv/bin"
