# uv-managed dev environment.
#
# There is deliberately no env file here and nothing to fill in. Every fact this
# app needs is stamped into its own config defaults (database host, port, user,
# ports); the two values a checkout cannot know — the database password and the
# operator's Authentik uid — are vended from the household broker at startup,
# by the backend's config/vend.py and the frontend's dev-identity.ts.
#
# That is what makes the debugger work. Values that live only in a shell reach a
# terminal and nothing else: `Run > Full Stack` starts VS Code's own processes,
# which never see a direnv environment, and an env file named as the launch
# configuration's `envFile` still has to be filled in by hand on every clone.
source_up

# shellcheck disable=SC2034  # read by direnv's stdlib as a shell variable, not exported
direnv_layout_dir="${XDG_CACHE_HOME:-$HOME/.cache}/direnv/layouts/$(echo -n "$PWD" | shasum | cut -d' ' -f1)"

if ! has uv; then
  echo "direnv: 'uv' not found on PATH; install it before working here" >&2
  return 0
fi

watch_file backend/pyproject.toml backend/uv.lock
uv sync --project backend --quiet

export VIRTUAL_ENV="$PWD/backend/.venv"
PATH_add "$PWD/backend/.venv/bin"

# This checkout's own machine-local additions, if it has any. Untracked and
# gitignored, and NOT a way back to an env file: a credential still belongs in
# the broker, and everything a checkout can know is stamped into config already.
source_env_if_exists .envrc.local

# Last, so nothing above can put one back. An Anthropic API credential in the
# environment sends an agent session to the metered API instead of the Max
# login it is entitled to, and foreman refuses to dispatch at all while either
# is set — so a checkout that inherits one from a shell profile silently either
# bills or blocks.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
