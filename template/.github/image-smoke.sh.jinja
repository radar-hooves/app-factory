#!/usr/bin/env bash
# THE extension point for docker-image.yaml's smoke gate (canonical-app-shape.md
# §Extension points): proves THIS app's image boots and serves. App-owned after the
# stamp. `$IMAGE` is the image just built; a non-zero exit stops the publish.
# DB-free: create_app() defers database access to the lifespan, so the server is
# booted directly, bypassing entrypoint.sh, and must serve /openapi.json 200.
set -eu

name="smoke-{{ project_name }}-$$"
# POSTGRES_PASSWORD is never used; eager settings validation needs a value to construct.
docker run -d --name "$name" -e POSTGRES_PASSWORD=smoke "$IMAGE" \
  gunicorn {{ package_name }}.server:app --config backend/gunicorn.conf.py
trap 'docker logs "$name" 2>&1 | tail -n 50 || true; docker rm -f "$name" >/dev/null 2>&1 || true' EXIT

for _ in $(seq 1 30); do
  if [ -z "$(docker ps -q -f name="^${name}$" -f status=running)" ]; then
    echo "smoke: container exited before serving — the server failed to boot"
    exit 1
  fi
  # stderr silenced: an early poll raises a benign ConnectionRefused; the container log is the diagnosis.
  if docker exec "$name" python3 -c 'import urllib.request, sys; sys.exit(0 if urllib.request.urlopen("http://localhost:{{ backend_port }}/openapi.json", timeout=5).getcode() == 200 else 1)' 2>/dev/null; then
    echo "smoke: {{ project_name }} booted and served /openapi.json 200"
    exit 0
  fi
  sleep 2
done
echo "smoke: {{ project_name }} never served /openapi.json 200 within the timeout — image will NOT be published"
exit 1
