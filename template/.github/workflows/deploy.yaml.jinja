name: Deploy

# A merge to main is the go-live: CI builds the image, Trivy-scans and
# smoke-tests it, pushes `<commit sha>` and `:latest`, and asks Watchtower to
# pull it. A rollback is a revert merged to main.
#
#   inputs  `.github/image-inputs.sh` asks BuildKit whether anything this push
#           changed is in the image's build context; a push that changes
#           nothing the image is built from skips everything below, and the
#           run reads green with its jobs skipped. A dispatch always ships.
#   checks  python-ci and frontend-ci, every deploy: neither runs on a push or
#           a PR, so a branch is untested unless someone dispatched it by hand.
#   build   image-verify builds, scans and smoke-probes beside the checks;
#           deploy rebuilds from the runner's warm Buildx layer cache and
#           pushes (radar-hooves/master-project docker-image-simple.yaml,
#           mode verify then push).
#   smoke   `.github/image-smoke.sh`, the app-owned probe.
#   deploy  Watchtower pulls `:latest`; the image migrates its database as it
#           starts. /api/system/health's `revision` is the last commit that
#           changed the image, not necessarily main's head.
#
# security.yaml runs the security battery weekly and on a dependency PR, not
# here.
on:
  push:
    branches: [main]
    # No path filter: an app's Dockerfile tail copies in paths the factory
    # cannot enumerate, so any list here silently misses one (app-factory#16).
    # The image-inputs job decides from the build context instead.
  workflow_dispatch:

# A deploy is never cancelled mid-push; a newer merge queues behind it.
{% raw %}concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false{% endraw %}

permissions:
  contents: read

jobs:
  image-inputs:
    runs-on: {{ runner_labels }}
    # actions: read to find the last successful run of this workflow.
    permissions:
      actions: read
      contents: read
    outputs:
      changed: {% raw %}${{ steps.decide.outputs.changed }}{% endraw %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # Every commit and tree, no blobs: the diff against the last live
          # commit reads trees alone.
          fetch-depth: 0
          filter: blob:none
          persist-credentials: false
      - id: decide
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: bash .github/image-inputs.sh

  python-ci:
    needs: image-inputs
    if: {% raw %}${{ needs.image-inputs.outputs.changed == 'true' }}{% endraw %}
    uses: ./.github/workflows/python-ci.yaml
    permissions:
      contents: read

  frontend-ci:
    needs: image-inputs
    if: {% raw %}${{ needs.image-inputs.outputs.changed == 'true' }}{% endraw %}
    uses: ./.github/workflows/frontend-ci.yaml
    permissions:
      contents: read

  # Build, scan and smoke-probe beside the checks, pushing nothing; `deploy`
  # then rebuilds from the runner's warm layer cache and pushes. Runs on any
  # ref, so a workflow_dispatch from a branch proves the image before a merge.
  image-verify:
    needs: image-inputs
    if: {% raw %}${{ needs.image-inputs.outputs.changed == 'true' }}{% endraw %}
    uses: radar-hooves/master-project/.github/workflows/docker-image-simple.yaml@main
    # packages: write because the golden workflow asks for it (its default
    # registry is ghcr.io); a caller granting less fails to start.
    permissions:
      contents: read
      packages: write
    with:
      image-name: {{ project_name }}
      # JSON array of labels, as the reusable's own `runner` input takes it.
      runner: '{{ runner_labels }}'
      # The household registry, not the reusable's ghcr.io default; the push
      # credential stays on the runner host.
      registry: {{ registry_host }}
      registry-credential-file: {{ registry_credential_file }}
      # The commit is the version: no git tag, no pyproject version.
      tag: {% raw %}${{ github.sha }}{% endraw %}
      # The household private-index read credential, mounted into the build as a
      # BuildKit secret (never a build arg) so it stays out of image history.
      # Passed by every app: the Dockerfile's mount is optional, so an app with
      # only public dependencies mounts a file `uv` never reads.
      build-secret-files: |
        netrc=/run/github-runner/devpi-read.netrc
      # The app-owned probe (canonical-app-shape.md §Sanctioned per-app files);
      # $IMAGE is the local tag of the image just built.
      smoke-command: bash .github/image-smoke.sh
      mode: verify

  deploy:
    needs: [image-inputs, python-ci, frontend-ci, image-verify]
    if: {% raw %}${{ success() && needs.image-inputs.outputs.changed == 'true' && github.ref == 'refs/heads/main' }}{% endraw %}
    uses: radar-hooves/master-project/.github/workflows/docker-image-simple.yaml@main
    # packages: write because the golden workflow asks for it (its default
    # registry is ghcr.io); a caller granting less fails to start.
    permissions:
      contents: read
      packages: write
    with:
      image-name: {{ project_name }}
      # JSON array of labels, as the reusable's own `runner` input takes it.
      runner: '{{ runner_labels }}'
      # The household registry, not the reusable's ghcr.io default; the push
      # credential stays on the runner host.
      registry: {{ registry_host }}
      registry-credential-file: {{ registry_credential_file }}
      # The commit is the version: no git tag, no pyproject version.
      tag: {% raw %}${{ github.sha }}{% endraw %}
      # The household private-index read credential, mounted into the build as a
      # BuildKit secret (never a build arg) so it stays out of image history.
      # Passed by every app: the Dockerfile's mount is optional, so an app with
      # only public dependencies mounts a file `uv` never reads.
      build-secret-files: |
        netrc=/run/github-runner/devpi-read.netrc
      # The app-owned probe (canonical-app-shape.md §Sanctioned per-app files);
      # $IMAGE is the local tag of the image just built.
      smoke-command: bash .github/image-smoke.sh
      # The go-live: Watchtower pulls the :latest just pushed now, not at its
      # scheduled poll; the token stays on the runner host.
      watchtower-url: {{ watchtower_url }}
      mode: push
