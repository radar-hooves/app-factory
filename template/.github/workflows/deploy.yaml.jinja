name: Deploy

# A merge to main is the go-live: CI builds the image, Trivy-scans and
# smoke-tests it, pushes `<commit sha>` and `:latest`, and asks Watchtower to
# pull it. A rollback is a revert merged to main.
#
#   checks  python-ci and frontend-ci, every deploy: neither runs on a push or
#           a PR, so a branch is untested unless someone dispatched it by hand.
#   build   Buildx on the runner's persistent builder cache
#           (radar-hooves/master-project docker-image-simple.yaml).
#   smoke   `.github/image-smoke.sh`, the app-owned probe.
#   deploy  Watchtower pulls `:latest`; the image migrates its database as it
#           starts.
#
# security.yaml runs the security battery weekly and on a dependency PR, not
# here.
on:
  push:
    branches: [main]
    # What the Dockerfile copies in; a commit touching nothing else does not
    # go live again.
    paths:
      - 'backend/**'
      - 'frontend/**'
      - 'config/**'
      - 'Dockerfile'
      - '.dockerignore'
  workflow_dispatch:

# A deploy is never cancelled mid-push; a newer merge queues behind it.
{% raw %}concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false{% endraw %}

permissions:
  contents: read

jobs:
  python-ci:
    uses: ./.github/workflows/python-ci.yaml
    permissions:
      contents: read

  frontend-ci:
    uses: ./.github/workflows/frontend-ci.yaml
    permissions:
      contents: read

  deploy:
    needs: [python-ci, frontend-ci]
    if: {% raw %}${{ success() && github.ref == 'refs/heads/main' }}{% endraw %}
    uses: radar-hooves/master-project/.github/workflows/docker-image-simple.yaml@main
    # packages: write because the golden workflow asks for it (its default
    # registry is ghcr.io); a caller granting less fails to start.
    permissions:
      contents: read
      packages: write
    with:
      image-name: {{ project_name }}
      # JSON array of labels, as the reusable's own `runner` input takes it.
      runner: '{{ runner_labels }}'
      # The household registry, not the reusable's ghcr.io default; the push
      # credential stays on the runner host.
      registry: {{ registry_host }}
      registry-credential-file: {{ registry_credential_file }}
      # The commit is the version: no git tag, no pyproject version.
      tag: {% raw %}${{ github.sha }}{% endraw %}
      # The household private-index read credential, mounted into the build as a
      # BuildKit secret (never a build arg) so it stays out of image history.
      # Passed by every app: the Dockerfile's mount is optional, so an app with
      # only public dependencies mounts a file `uv` never reads.
      build-secret-files: |
        netrc=/run/github-runner/devpi-read.netrc
      # The app-owned probe (canonical-app-shape.md §Sanctioned per-app files);
      # $IMAGE is the local tag of the image just built.
      smoke-command: bash .github/image-smoke.sh
      # The go-live: Watchtower pulls the :latest just pushed now, not at its
      # scheduled poll; the token stays on the runner host.
      watchtower-url: {{ watchtower_url }}
