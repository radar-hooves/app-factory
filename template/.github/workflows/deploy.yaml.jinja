name: Deploy

# A merge to main IS the go-live (the operator's ruling, 29/09/2026: every app
# deploys the one ordinary way, master-project#233): CI builds the image,
# Trivy-scans and smoke-tests it, pushes `<commit sha>` and `:latest` to the
# registry, and asks Watchtower to pull it.
#
#   checks  python-ci and frontend-ci run here, once per go-live, unless a run
#           by hand already passed for this commit. No branch push runs them.
#   build   Buildx on the runner's own persistent builder cache
#           (radar-hooves/master-project docker-image-simple.yaml).
#   smoke   `.github/image-smoke.sh`, the app-owned probe: the image must serve
#           before it is pushed (full-stack-app-template#4).
#   deploy  Watchtower pulls the `:latest` just pushed, now rather than at its
#           scheduled poll; the image migrates its database as it starts.
#
# A rollback is a revert merged to main.
#
# The security battery is not on this path; security.yaml runs it weekly and on
# a dependency pull request.
on:
  push:
    branches: [main]
    # What the Dockerfile copies in; a commit touching nothing else does not
    # go live again.
    paths:
      - 'backend/**'
      - 'frontend/**'
      - 'config/**'
      - 'Dockerfile'
      - '.dockerignore'
  workflow_dispatch:

# A deploy is never cancelled mid-push; a newer merge queues behind it.
{% raw %}concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false{% endraw %}

permissions:
  contents: read
  actions: read

jobs:
  checked:
    runs-on: [self-hosted, atlas]
    outputs:
      python: {% raw %}${{ steps.python.outputs.passed }}{% endraw %}
      frontend: {% raw %}${{ steps.frontend.outputs.passed }}{% endraw %}
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - id: python
        uses: radar-hooves/master-project/.github/actions/workflow-passed@main
        with:
          workflow: python-ci.yaml
      - id: frontend
        uses: radar-hooves/master-project/.github/actions/workflow-passed@main
        with:
          workflow: frontend-ci.yaml

  python-ci:
    needs: checked
    if: needs.checked.outputs.python != 'true'
    uses: ./.github/workflows/python-ci.yaml
    permissions:
      contents: read

  frontend-ci:
    needs: checked
    if: needs.checked.outputs.frontend != 'true'
    uses: ./.github/workflows/frontend-ci.yaml
    permissions:
      contents: read

  deploy:
    needs: [python-ci, frontend-ci]
    # Skipped checks are passed checks; a failed or cancelled one stops here.
    if: {% raw %}${{ !failure() && !cancelled() && github.ref == 'refs/heads/main' }}{% endraw %}
    uses: radar-hooves/master-project/.github/workflows/docker-image-simple.yaml@main
    # packages: write because the golden workflow asks for it (its default
    # registry is ghcr.io); a caller granting less fails to start.
    permissions:
      contents: read
      packages: write
    with:
      image-name: {{ project_name }}
      # The household registry, not the reusable's ghcr.io default; the push
      # credential stays on the runner host.
      registry: {{ registry_host }}
      registry-credential-file: {{ registry_credential_file }}
      # The commit is the version: no git tag, no pyproject version.
      tag: {% raw %}${{ github.sha }}{% endraw %}
      # The household private-index read credential, mounted into the build as a
      # BuildKit secret (never a build arg) so it stays out of image history.
      # Passed by every app: the Dockerfile's mount is optional, so an app with
      # only public dependencies mounts a file `uv` never reads.
      build-secret-files: |
        netrc=/run/github-runner/devpi-read.netrc
      # The app-owned probe (canonical-app-shape.md §Sanctioned per-app files);
      # $IMAGE is the local tag of the image just built.
      smoke-command: bash .github/image-smoke.sh
      # The go-live: Watchtower pulls the :latest just pushed now, not at its
      # scheduled poll; the token stays on the runner host.
      watchtower-url: {{ watchtower_url }}
