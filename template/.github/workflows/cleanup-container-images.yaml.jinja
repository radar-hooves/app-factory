name: Cleanup Old Container Images

on:
  workflow_dispatch:
  schedule:
    - cron: '0 0 * * 0'

# cancel-in-progress stays FALSE: the job deletes registry versions, so two
# runs racing (or one killed part-way) is worse than queueing.
{% raw %}concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false{% endraw %}

permissions:
  packages: write
  contents: read

jobs:
  cleanup:
    uses: poodle64/master-project/.github/workflows/cleanup-container-images.yaml@main
    with:
      package-name: {{ project_name }}
      keep-versions: '10'
