name: Frontend CI

# Thin caller of the golden reusable (rules-library/core/ci-workflow-standard.md).
# Called by deploy.yaml when a push to main changes an image input, or run by
# hand; never per push.
on:
  workflow_dispatch:
  workflow_call:

# Prefixed with this workflow's own name: called from deploy.yaml,
# `github.workflow` is the caller's.
concurrency:
  group: frontend-ci-{% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  frontend-ci:
    uses: radar-hooves/master-project/.github/workflows/frontend-ci.yaml@main
    with:
      working-directory: frontend
      runner: '{{ runner_labels }}'
      run-tests: true
