name: Security

# Thin caller of the golden reusable (rules-library/core/10-ci-workflow-standard.md):
# secret scan (gitleaks), Python dependency audit (pip-audit over the hashed
# lockfile), Trivy filesystem scan, and a CycloneDX SBOM artefact{% if has_frontend %} —
# plus a Node/pnpm audit over frontend/{% endif %}.
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  security:
    uses: poodle64/master-project/.github/workflows/security-checks.yaml@main
    with:
      working-directory: backend
{%- if has_frontend %}
      node-dir: frontend
{%- endif %}
