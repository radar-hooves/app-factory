name: Security

# Thin caller of the golden reusable (rules-library/core/ci-workflow-standard.md):
# secret scan (gitleaks), Python dependency audit (pip-audit over the hashed
# lockfile), Trivy filesystem scan, and a CycloneDX SBOM artefact —
# plus a Node/pnpm audit over frontend/.
# Weekly, and on a dependency change: CVEs arrive with time, not with commits,
# and pre-commit already runs gitleaks on every commit. Measured 06/09/2026:
# on every push this was 3-5 runner jobs per commit across 22 repos, a third
# of the fleet's runs.
on:
  schedule:
    - cron: '0 18 * * 0' # Monday 04:00 AEST
  push:
    branches: [main]
    paths:
      - '**/pyproject.toml'
      - '**/uv.lock'
      - '**/package.json'
      - '**/pnpm-lock.yaml'
      - '**/Cargo.lock'
      - '**/go.sum'
      - '**/Dockerfile*'
      - '.github/workflows/security.yaml'
  pull_request:
    paths:
      - '**/pyproject.toml'
      - '**/uv.lock'
      - '**/package.json'
      - '**/pnpm-lock.yaml'
      - '**/Cargo.lock'
      - '**/go.sum'
      - '**/Dockerfile*'
      - '.github/workflows/security.yaml'
  workflow_dispatch:
  # Called by the image build, which must not publish an image carrying a known
  # CRITICAL or HIGH in its dependency tree.
  workflow_call:

# Prefixed with this workflow's own name, not `github.workflow` alone: in a
# called workflow that expression is the CALLER's name, so two workflows called
# from one caller would share a group and cancel each other.
{% raw %}concurrency:
  group: security-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true{% endraw %}

permissions:
  contents: read

jobs:
  security:
    uses: poodle64/master-project/.github/workflows/security-checks.yaml@main
    with:
      working-directory: backend
      node-dir: frontend
