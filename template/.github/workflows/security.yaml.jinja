name: Security

# Thin caller of the golden reusable (rules-library/core/ci-workflow-standard.md):
# secret scan (gitleaks), Python dependency audit (pip-audit over the hashed
# lockfile), Trivy filesystem scan, and a CycloneDX SBOM artefact —
# plus a Node/pnpm audit over frontend/.
# Weekly, and on a dependency change: CVEs arrive with time, not with commits,
# and pre-commit already runs gitleaks on every commit. Measured 06/09/2026:
# on every push this was 3-5 runner jobs per commit across 22 repos, a third
# of the fleet's runs. The dependency change is scanned on its feature branch,
# never again on main: a merge is the go-live and never waits on this.
# docker-image-simple.yaml's own Trivy step already gates every image at push
# time, so this battery carries no image scan of its own.
on:
  schedule:
    - cron: '0 18 * * 0' # Monday 04:00 AEST
  pull_request:
    paths:
      - '**/pyproject.toml'
      - '**/uv.lock'
      - '**/package.json'
      - '**/pnpm-lock.yaml'
      - '**/Cargo.lock'
      - '**/go.sum'
      - '**/Dockerfile*'
      - '**/.trivyignore*'
      - '.github/workflows/security.yaml'
  workflow_dispatch:

{% raw %}concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true{% endraw %}

permissions:
  contents: read

jobs:
  security:
    uses: radar-hooves/master-project/.github/workflows/security-checks.yaml@main
    with:
      working-directory: backend
      node-dir: frontend
      runner: '{{ runner_labels }}'
