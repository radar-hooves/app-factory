name: Python CI

# Thin caller of the golden reusable (rules-library/core/ci-workflow-standard.md).
# Called by deploy.yaml when a push to main changes an image input, or run by
# hand; never per push.
on:
  workflow_dispatch:
  workflow_call:

# Prefixed with this workflow's own name, not `github.workflow` alone: in a
# called workflow that expression is the CALLER's name, so two workflows called
# from one caller would share a group and cancel each other.
concurrency:
  group: python-ci-{% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  python-ci:
    uses: radar-hooves/master-project/.github/workflows/python-ci.yaml@main
    with:
      working-directory: backend
      runner: '{{ runner_labels }}'
      lint-paths: 'src tests'
      mypy-paths: 'src'
      # A fixed worker count, never `-n auto`: auto reads the core count of a
      # host eight runners share, so one run would ask for twenty of everything.
      # The suite's Postgres is shared across workers (backend/tests/conftest.py),
      # so a worker costs CPU and memory, not a database container. Whole files
      # per worker: tests/test_agent_api.py fails when its tests are split.
      pytest-args: '-q -n 8 --dist loadfile'
      # Base + dev, and nothing else. A repo's non-dev groups carry editable
      # overrides onto sibling checkouts that exist only beside a developer's
      # clone; taking the defaults in CI resolves those to paths that are not
      # there. Dropping them resolves the same packages from the household index
      # instead, which is the one sanctioned mechanism.
      # `dev` is then asked for by name, or there is no pytest to run.
      sync-args: '--no-default-groups --group dev'
