name: Build and Push Docker Image

# Golden docker-image build/publish caller (rules-library/core/ci-workflow-standard.md).
# Thin caller of the shared reusable: build the production image with Buildx,
# Trivy-scan it, BOOT THE SERVER and poll /openapi.json for 200, then publish it
# to gwcr.example.com with the CalVer tag AND :latest (Watchtower auto-deploys :latest).
#
# The smoke probe is the gate this workflow exists for (full-stack-app-template#4).
# A green `docker build`, a clean Trivy scan and a caller-supplied import-only
# smoke check all passed an image whose gunicorn died on startup because
# backend/gunicorn.conf.py was never COPYd into the runtime stage — it reached
# production and took a live service down on its first deploy. None of those
# gates can see "does the image actually boot and serve"; this one can, and it
# is the SAME probe every app gets, not a per-app hand-roll (which the umbrella
# rule forbids and which is exactly what shipped the broken image).
#
# The probe is DB-free by construction: create_app() defers all DB access to a
# lazy lifespan (get_engine only calls create_engine, which never connects), so
# booting `{{ package_name }}.server:app --config backend/gunicorn.conf.py`
# (bypassing the entrypoint's DB-dependent migrate/stamp) serves /openapi.json
# with 200 on an image with no database in reach — the same /openapi.json probe
# compose.yaml's healthcheck uses. One probe catches a missing runtime file, an
# import error and a worker-boot failure alike.
on:
  push:
    tags: ['v*']
  workflow_dispatch:

# cancel-in-progress stays FALSE: this builds and pushes a release image, and
# killing it mid-push leaves a partial artefact -- worse than queueing behind it.
{% raw %}concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false{% endraw %}

permissions:
  contents: read
  packages: write

jobs:
  docker:
    uses: poodle64/master-project/.github/workflows/docker-image-simple.yaml@main
    with:
      image-name: {{ project_name }}
      # Publish to the household registry, not the reusable's ghcr.io default; every
      # deployed app pulls gwcr.example.com and the credential lives on the runner host.
      registry: gwcr.example.com
      registry-credential-file: /var/lib/gwcr/ci_push
      # On a v* tag the version is the tag; a manual run falls back to this file
      # (the app's pyproject lives under backend/, not the repo root default).
      version-file: backend/pyproject.toml
      # The household private-index read credential, mounted into the build as a
      # BuildKit secret (never a build arg) so it stays out of image history. The
      # Dockerfile's `uv sync` reads it at /root/.netrc to fetch a sibling
      # published to the private index. Passed by EVERY app, not only the ones
      # that need it: the secret mount is optional on the Dockerfile side, so an
      # app with only public dependencies mounts a file `uv` never consults, and
      # the alternative — a per-app knob — is a divergence three apps had to
      # record separately for one credential the shared runner always has.
      build-secret-files: |
        netrc=/run/github-runner/devpi-read.netrc
      # No GHA cache export. Every app builds on the household's own persistent
      # self-hosted runner, whose Docker daemon already keeps the layer cache
      # between runs, so the export is a SECOND cache path that buys nothing here
      # and has cost real builds: one spent 61 minutes exporting after the layers
      # were done, then died on a 403 when its one-hour cache token expired.
      cache-to: ''
      smoke-command: |
        set -eu
        # Boot the production server the way the runtime image will, but bypass
        # entrypoint.sh's DB-dependent migrate/stamp — the app boots and serves
        # /openapi.json with no database in reach (see this workflow's header).
        name="smoke-{{ project_name }}-$$"
        # POSTGRES_PASSWORD: the probe reaches no database and never uses this
        # value, but an app whose settings validate eagerly cannot be CONSTRUCTED
        # without one — it fails as a boot failure and proves nothing. One token
        # here costs nothing and covers every app that tightens that validation.
        docker run -d --name "$name" -e POSTGRES_PASSWORD=smoke "$IMAGE" \
          gunicorn {{ package_name }}.server:app --config backend/gunicorn.conf.py
        trap 'docker logs "$name" 2>&1 | tail -n 50 || true; docker rm -f "$name" >/dev/null 2>&1 || true' EXIT
        for _ in $(seq 1 30); do
          if [ -z "$(docker ps -q -f name="^${name}$" -f status=running)" ]; then
            echo "smoke: container exited before serving — the server failed to boot"
            exit 1
          fi
          # stderr silenced: an early poll before the workers bind raises a
          # benign ConnectionRefused; the real diagnosis on failure is the
          # container's own log, dumped by the trap above.
          if docker exec "$name" python3 -c 'import urllib.request, sys; sys.exit(0 if urllib.request.urlopen("http://localhost:{{ backend_port }}/openapi.json", timeout=5).getcode() == 200 else 1)' 2>/dev/null; then
            echo "smoke: {{ project_name }} booted and served /openapi.json 200"
            exit 0
          fi
          sleep 2
        done
        echo "smoke: {{ project_name }} never served /openapi.json 200 within the timeout — image will NOT be published"
        exit 1
