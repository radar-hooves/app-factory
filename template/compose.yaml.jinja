# {{ project_name }} — local image build + smoke test.
#
# This builds the production image from source and runs it against the same
# database the dev server uses — there is no separate development database
# (rules-library/stacks/dev-environment.md). It is NOT the
# production deployment — that lives as its own stack under the operator's
# fleet repo, using the published image. Stop any local dev server on
# {{ backend_port }} before bringing this up; both bind the same host port.

include:
  # THE extension point for this file. compose.yaml is the factory's and is owed
  # byte-identical in every app, so an app's own services — a worker, a queue, a
  # sidecar — arrive through a fragment it owns rather than by editing this file
  # (canonical-app-shape.md §Extension points). Stamped empty and on copier's
  # `_skip_if_exists`, so it exists for `include` to find and an update never
  # overwrites it.
  - compose.app.yaml

services:
  # The service and its container_name are ONE string, hyphenated
  # (canonical-app-shape.md §Service and container naming). This rendered from
  # `package_name` until 03/09/2026, so a hyphenated app shipped an underscored
  # service beside a hyphenated container — invisible in the one-word apps,
  # which were eight of the nine, and unfixable per app because the file is
  # owed byte-identical.
  {{ project_name }}:
    build:
      context: .
      dockerfile: Dockerfile
      # The private-index read credential, as the same optional `netrc` BuildKit
      # secret the Dockerfile mounts and the docker-image caller passes in CI —
      # one mechanism, declared by every app whether or not it has a private
      # dependency, because a per-app knob is the divergence three apps recorded
      # separately for one credential.
      secrets:
        - netrc
    container_name: {{ project_name }}
    restart: always
    # Container hardening. The app writes nothing to its own filesystem: its
    # state is the database and `data/`, which is mounted below and stays
    # writable. A read-only root therefore costs nothing and makes "the image is
    # what it says it is" something the runtime enforces rather than something
    # the Dockerfile asserts. /tmp is the one exception the app genuinely needs
    # — Python's tempfile is on the vend path — and it is a tmpfs, so nothing
    # written there outlives the container. cap_drop ALL because the process
    # binds a port above 1024 as uid 1000 and needs no capability whatsoever.
    read_only: true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    ports:
      - '{{ backend_port }}:{{ backend_port }}'
    environment:
      # There is no development database (stacks/dev-environment.md): the
      # workstation runs no backing services, so this points at the app's REAL
      # Postgres on the fleet host, at that host's tailnet address — one address
      # that stays correct on any network. `host.docker.internal` was wrong here
      # and reached a workstation Postgres that does not exist. The `:-` defaults
      # keep a fresh clone working unconfigured while leaving an override open.
      POSTGRES_HOST: ${POSTGRES_HOST:-{{ postgres_host }}}
      POSTGRES_PORT: ${POSTGRES_PORT:-{{ postgres_port }}}
      # Named explicitly rather than left to the resolver's walk: the installed
      # package lives in site-packages here, so an unmounted volume would fall
      # through to it and the app would write its state inside its own wheel.
      DATA_DIR: /app/data
    env_file:
      # Deployment's own values (POSTGRES_PASSWORD and anything host-specific).
      # Optional on purpose: development holds no env file — it vends instead —
      # so a required one would stop `docker compose` in a working checkout.
      - path: ./backend/.env
        required: false
    volumes:
      # The app's runtime state, on the host so a container rebuild does not take
      # it with it. Same directory the dev server uses (config/paths.py).
      - ./data:/app/data
    stop_grace_period: 30s
    healthcheck:
      test:
        - CMD
        - python3
        - -c
        - |
          import socket, urllib.request
          socket.setdefaulttimeout(5)
          response = urllib.request.urlopen("http://localhost:{{ backend_port }}/openapi.json")
          exit(0 if response.getcode() == 200 else 1)
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: 'json-file'
      options:
        max-size: '10m'
        max-file: '3'
        tag: '{{ '{{' }}.Name{{ '}}' }}'

secrets:
  # Sourced from NETRC, which is a PATH the workstation already exports at a
  # boot-lifetime file (yggdrasil `devpi-netrc.nix`) — so the credential never
  # becomes a shell VALUE here. `/dev/null` is the fallback rather than a home
  # path because a MISSING file hard-fails the build outright, verified
  # 2026-08-20, while an empty one leaves /root/.netrc empty and `uv` treats it
  # as no credential — which is the property the Dockerfile is written around.
  netrc:
    file: ${NETRC:-/dev/null}
