import { sveltekit } from '@sveltejs/kit/vite';
import tailwindcss from '@tailwindcss/vite';
import { defineConfig } from 'vite';

import { resolveDevIdentity, vendDevUid } from './dev-identity';

export default defineConfig(({ command, isPreview }) => {
	const plugins = [tailwindcss(), sveltekit()];

	// The dev proxy and the identity it injects exist ONLY to serve `vite dev`.
	// `vite build`, `vite preview` and `svelte-check` also load this config but
	// never run that proxy, so they must not require a dev identity the built SPA
	// never carries — reading or throwing for it there would abort the production
	// image build (`pnpm run build`) and the CI type-check (`pnpm check`) for a
	// value they never use.
	if (command !== 'serve' || isPreview) {
		return { plugins };
	}

	// Who dev says you are, and whether it may start at all. The reasoning — and
	// why injecting behind the proxy would overwrite the real identity — lives in
	// dev-identity.ts, which is unit-tested directly.
	const identity = resolveDevIdentity({
		behindProxy: process.env.{{ project_name | upper | replace('-', '_') }}_DEV_BEHIND_PROXY,
		// The broker is the source; the env var is an override for a machine
		// without signet (CI, a container-only E2E run).
		devUid: process.env.{{ project_name | upper | replace('-', '_') }}_DEV_UID ?? vendDevUid(),
		// Optional, and absent in most apps. Production's forward-auth proxy forwards
		// whatever entitlements Authentik holds for the user; an app that gates modules
		// on them needs the same header in dev or every gated module vanishes.
		devEntitlements: process.env.{{ project_name | upper | replace('-', '_') }}_DEV_ENTITLEMENTS,
		publicHost: process.env.{{ project_name | upper | replace('-', '_') }}_DEV_PUBLIC_HOST
	});

	// Asserted in configureServer, NOT in the config body. The `command`
	// discriminator above is not sufficient on its own: svelte-check loads this
	// config with command === 'serve' to resolve the Tailwind plugin for
	// preprocessing, so throwing in the body fails `pnpm check` on every app with
	// a <style> block, for a value the type-check never uses. configureServer is
	// the one hook that runs only when a real `vite dev` server is created.
	const requireDevIdentity = {
		name: 'require-dev-identity',
		configureServer() {
			if (identity.refusal) {
				throw new Error(identity.refusal);
			}
		}
	};

	// Defaults to the app's registered backend port. Overridable so an isolated
	// E2E harness can point this proxy at its own ephemeral backend, rather than
	// the dev backend — which is the one talking to the real database.
	const backendPort = process.env.{{ project_name | upper | replace('-', '_') }}_BACKEND_PORT ?? '{{ backend_port }}';
	const backendTarget = `http://localhost:${backendPort}`;

	return {
		plugins: [...plugins, requireDevIdentity],
		server: {
			port: {{ frontend_port }},
			...identity.serverOptions,
			// This is the frontend port, allocated in the household registry; failing
			// beats silently moving off it onto one another app owns.
			strictPort: true,
			proxy: {
				'/api': {
					target: backendTarget,
					// Inject Authentik identity headers for the HUMAN surface, so dev runs
					// the same backend code path production does. They belong on the PROXY,
					// not on `server.headers`: that sets headers on Vite's response to the
					// browser, which the backend never sees, and every /api call 401s.
					// The stable uid ONLY. Display fields are deliberately not injected:
					// the backend updates mutable fields on every upsert
					// (platform/proxy-delegated-auth.md), so sending a placeholder
					// username overwrites the real profile in the real database.
					// Undefined behind the proxy, where the real headers are already on
					// the request and this object would overwrite them — Vite merges it last.
					headers: identity.proxyHeaders
				},
				// /mcp is proxied so an MCP client can reach the dev backend through this
				// origin. It gets no identity headers: /mcp validates an Authentik Bearer
				// token app-side and is closed until
				// {{ project_name | upper | replace('-', '_') }}_OIDC_USERINFO_URL is set. See backend mcp/http_auth.py.
				'/mcp': backendTarget
			}
		}
	};
});
