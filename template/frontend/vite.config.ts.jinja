import { realpathSync } from 'node:fs';
import { join } from 'node:path';
import { sveltekit } from '@sveltejs/kit/vite';
import tailwindcss from '@tailwindcss/vite';
import { defineConfig } from 'vite';

import { appProxy } from './app-proxy';
import { resolveDevIdentity, vendDevUid } from './dev-identity';

// The REAL path of node_modules, for Vite's serve allow-list.
//
// pnpm links every dependency out of a content-addressed store, and a git
// worktree's node_modules is routinely a symlink into another checkout's store.
// Vite resolves an import through the symlink to its real location, then checks
// that location against `server.fs.allow` — which holds the worktree root, a
// path the real one is not under — so `vite dev` answers 403 for the module it
// just resolved, while build, check and Vitest (none of which serve over HTTP)
// stay green. Adding the resolved path removes the class; falling back to the
// unresolved one keeps the ordinary non-symlinked checkout exactly as it was.
const configDir = new URL('.', import.meta.url).pathname.replace(/\/$/, '');
const realNodeModules = (() => {
	const nodeModules = join(configDir, 'node_modules');
	try {
		return realpathSync(nodeModules);
	} catch {
		return nodeModules;
	}
})();

export default defineConfig(({ command, isPreview }) => {
	const plugins = [tailwindcss(), sveltekit()];

	// The dev proxy and the identity it injects exist ONLY to serve `vite dev`.
	// `vite build`, `vite preview` and `svelte-check` also load this config but
	// never run that proxy, so they must not require a dev identity the built SPA
	// never carries — reading or throwing for it there would abort the production
	// image build (`pnpm run build`) and the CI type-check (`pnpm check`) for a
	// value they never use.
	if (command !== 'serve' || isPreview) {
		return { plugins };
	}

	// Who dev says you are, and whether it may start at all. The reasoning — and
	// why injecting behind the proxy would overwrite the real identity — lives in
	// dev-identity.ts, which is unit-tested directly.
	const identity = resolveDevIdentity({
		behindProxy: process.env.{{ project_name | upper | replace('-', '_') }}_DEV_BEHIND_PROXY,
		// The broker is the source; the env var is an override for a machine
		// without portcullis (CI, a container-only E2E run).
		devUid: process.env.{{ project_name | upper | replace('-', '_') }}_DEV_UID ?? vendDevUid(),
		// Optional, and absent in most apps. Production's forward-auth proxy forwards
		// whatever entitlements Authentik holds for the user; an app that gates modules
		// on them needs the same header in dev or every gated module vanishes.
		devEntitlements: process.env.{{ project_name | upper | replace('-', '_') }}_DEV_ENTITLEMENTS,
		publicHost: process.env.{{ project_name | upper | replace('-', '_') }}_DEV_PUBLIC_HOST
	});

	// Asserted in configureServer, NOT in the config body. The `command`
	// discriminator above is not sufficient on its own: svelte-check loads this
	// config with command === 'serve' to resolve the Tailwind plugin for
	// preprocessing, so throwing in the body fails `pnpm check` on every app with
	// a <style> block, for a value the type-check never uses. configureServer is
	// the one hook that runs only when a real `vite dev` server is created.
	const requireDevIdentity = {
		name: 'require-dev-identity',
		configureServer() {
			if (identity.refusal) {
				throw new Error(identity.refusal);
			}
		}
	};

	// The app's registered backend port, as the literal IPv4 loopback rather than
	// the hostname. The dev backend binds `0.0.0.0` (gunicorn.conf.py, and the
	// launch configurations), which is IPv4-only — while on a Linux container
	// `localhost` resolves to `::1` first, and a Node dial to a bare hostname is
	// not guaranteed to fall through to the other family. The literal address
	// removes the resolution from the path rather than depending on its order.
	// This is a construction argument, not a benchmark: `127.0.0.1` cannot be
	// worse than `localhost` against a socket bound to `0.0.0.0`, on any machine.
	//
	// The override exists for one measured use (a fleet app's own #772): an E2E suite whose
	// backend runs on its own port so it can never adopt the interactive one.
	const backendTarget = process.env.{{ project_name | upper | replace('-', '_') }}_DEV_BACKEND_TARGET ?? `http://127.0.0.1:{{ backend_port }}`;

	return {
		plugins: [...plugins, requireDevIdentity],
		server: {
			port: {{ frontend_port }},
			...identity.serverOptions,
			// Vite's default allow-list is the workspace root; this adds the store
			// node_modules actually resolves to (see realNodeModules above).
			fs: { allow: [realNodeModules] },
			// This is the frontend port, allocated in the household registry; failing
			// beats silently moving off it onto one another app owns.
			strictPort: true,
			proxy: {
				// Anchored and trailing-slashed: a Vite proxy key is a PREFIX match, so
				// the bare '/api' also swallows a top-level SPA route whose name merely
				// starts with it. Measured 2026-08-25 in a stamped app: its own `/api-docs`
				// page was proxied to the backend, which answered with the built SPA
				// shell, and the route died on chunks the dev server cannot serve. A
				// leading '^' makes Vite read the key as a RegExp; every real call is
				// '/api/…', so nothing else changes.
				'^/api/': {
					target: backendTarget,
					// Inject Authentik identity headers for the HUMAN surface, so dev runs
					// the same backend code path production does. They belong on the PROXY,
					// not on `server.headers`: that sets headers on Vite's response to the
					// browser, which the backend never sees, and every /api call 401s.
					// The stable uid ONLY. Display fields are deliberately not injected:
					// the backend updates mutable fields on every upsert
					// (platform/proxy-delegated-auth.md), so sending a placeholder
					// username overwrites the real profile in the real database.
					// Undefined behind the proxy, where the real headers are already on
					// the request and this object would overwrite them — Vite merges it last.
					headers: identity.proxyHeaders
				},
				// This app's own prefixes, from frontend/app-proxy.ts — the one seam
				// on this file, and the reason the file itself stays byte-identical.
				// Declared AFTER `^/api/` so the factory's entry keeps routing
				// precedence; the seam adds prefixes, it does not replace ours.
				//
				// No /mcp proxy in the factory: an MCP client names a full URL, not a
				// same-origin path the way the SPA's own fetch calls do (that is what
				// /api above is for), so it reaches the backend on {{ backend_port }}
				// directly. Four apps carry one anyway, which is a question for the
				// factory rather than a default to reinstate untested — until it is
				// answered, `/mcp` is one line in app-proxy.ts.
				...appProxy(backendTarget)
			}
		}
	};
});
