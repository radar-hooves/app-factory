import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';

import { chromium, defineConfig, devices } from '@playwright/test';

import { appWebServer } from './tests/e2e/app-web-server';

const CI = !!process.env.CI;

// NixOS runs no downloaded browser. atlas exports nixpkgs' patched build as
// PLAYWRIGHT_BROWSERS_PATH, at nixpkgs' Playwright revision rather than this
// app's, so the browser this @playwright/test expects is absent there and the
// headless shell that is present runs the suite instead. A pixel baseline is
// still CI's own (playwright-container.yaml): this is a different Chromium.
function hostHeadlessShell(): string | undefined {
	const dir = process.env.PLAYWRIGHT_BROWSERS_PATH;
	if (!dir || !existsSync(dir) || existsSync(chromium.executablePath())) return undefined;
	const build = readdirSync(dir).find((name) => name.startsWith('chromium_headless_shell-'));
	if (!build) return undefined;
	return ['chrome-headless-shell-linux64/chrome-headless-shell', 'chrome-linux/headless_shell']
		.map((binary) => join(dir, build, binary))
		.find((path) => existsSync(path));
}
const HOST_HEADLESS_SHELL = hostHeadlessShell();

// There is one database and no staging environment (dev-environment.md
// "There Is No Development Database"), so this suite gets its own port and
// its own identity — the two things that stop it colliding with a `pnpm dev`
// session already running, or writing under the identity that session uses.
const E2E_PORT = {{ frontend_e2e_port }}; // not {{ frontend_port }}: this app's own row in the registry's Frontend E2E band, so it collides with no interactive dev server and nothing else can be allocated over it. Derived offsets landed outside every band.
const E2E_UID = 'e2e-uid';
const APP_WEB_SERVER = appWebServer(E2E_PORT);

export default defineConfig({
	testDir: 'tests/e2e',
	// The webServer below boots the FRONTEND only; the backend and its backing
	// services are booted separately. global-setup.ts fails fast with a clear
	// message when they are not, rather than letting every spec fail on its own
	// connection-refused. App-specific preconditions — seeding, a route pre-warm,
	// an asset build — go in `appPreconditions` in tests/e2e/app-web-server.ts,
	// which global-setup calls once its guard passes; that file is the seam for
	// BOTH this stanza and that one, and neither of them is edited per app.
	globalSetup: './tests/e2e/global-setup.ts',
	// No factory default: nothing the factory's own setup starts outlives the
	// run. An app that starts something that does — a broker holding an unlocked
	// vault, a container, a temp data root — names its teardown module in
	// tests/e2e/app-web-server.ts, and `undefined` here is Playwright's "none".
	globalTeardown: APP_WEB_SERVER.globalTeardown,
	timeout: CI ? 90_000 : 30_000,
	expect: { timeout: CI ? 20_000 : 5_000 },
	// Deliberately no CI retry: a retry turns a real intermittent failure into a green build.
	retries: 0,
	// One worker. The suite has one database and ONE identity (E2E_UID below),
	// and the tenancy specs change what that identity belongs to — a grant made
	// in one file is a second membership seen by another running beside it,
	// which turns "the menu offers no switch" into a coin toss. Serial is the
	// only honest answer while the identity is singular. An app that has made its
	// suite genuinely independent — or that is serial for a reason of its own —
	// says so in tests/e2e/app-web-server.ts rather than forking this file.
	workers: APP_WEB_SERVER.workers ?? 1,
	reporter: CI
		? [
				['list'],
				['html', { open: 'never' }],
				['junit', { outputFile: 'test-results/junit.xml' }],
				['github']
			]
		: [['list']],
	use: {
		baseURL: `http://localhost:${E2E_PORT}`,
		trace: CI ? 'retain-on-failure' : 'off'
	},
	projects: [
		// Chromium only. Add firefox/webkit `devices` entries here if
		// cross-browser coverage becomes worth the run-time cost.
		{
			name: 'chromium',
			use: {
				...devices['Desktop Chrome'],
				...(HOST_HEADLESS_SHELL && { launchOptions: { executablePath: HOST_HEADLESS_SHELL } })
			}
		}
	],
	webServer: {
		// The three seams an app may take are its own file's, so this stanza
		// stays byte-identical everywhere: `command` and `timeout` replace,
		// `env` merges over the identity variable below (tests/e2e/app-web-server.ts).
		command: APP_WEB_SERVER.command ?? `vite dev --port ${E2E_PORT}`,
		// Read by vite.config.ts's dev-identity header; keeps this suite's
		// writes off whatever the interactive `dev-uid` identity owns.
		env: { {{ project_name | upper | replace('-', '_') }}_DEV_UID: E2E_UID, ...APP_WEB_SERVER.env },
		port: E2E_PORT,
		// Never reuse — the whole point of the separate port and identity is
		// that this suite controls the server it runs against.
		reuseExistingServer: false,
		// Playwright's own default, stated rather than inherited so an app that
		// needs longer has somewhere to say so.
		timeout: APP_WEB_SERVER.timeout ?? 60_000,
		stdout: 'pipe',
		stderr: 'pipe'
	}
});
