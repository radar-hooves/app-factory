/**
 * The `auth` singleton — who is signed in, and which workspace they are acting in.
 *
 * Contract and shape are the household's, not this app's
 * (`rules-library/platform/authentication.md` §Frontend Auth Store Contract):
 * module-level `$state` with getter exports, no credential on the store, and no
 * `login()` — Tier 1a is proxy-delegated, so signing in is a redirect to the
 * identity provider and there is nothing here to hold.
 *
 * The workspace members are the tenancy layer
 * (`rules-library/platform/tenancy.md`). A caller belonging to one workspace
 * never sees a switcher and never sends a header; the backend resolves their
 * sole membership. A caller belonging to two must choose, and until they have,
 * every request is answered 409 with the choices — deliberately, because a
 * silent default is how one workspace's data lands in another.
 */
import { api, setActiveWorkspaceId } from './api/client';

export const ACTIVE_WORKSPACE_STORAGE_KEY = '{{ project_name }}.activeWorkspaceId';

export interface User {
	id: string;
	username: string;
	email: string | null;
	is_admin: boolean;
	last_seen_at: string | null;
}

export interface Workspace {
	id: number;
	slug: string;
	name: string;
}

export interface Membership {
	workspace: Workspace;
	role: 'owner' | 'member';
}

let user = $state<User | null>(null);
let entitlements = $state<string[]>([]);
let memberships = $state<Membership[]>([]);
let activeWorkspace = $state<Workspace | null>(null);
let isLoading = $state(true);

function restoreStoredWorkspaceId(): number | null {
	// localStorage is unavailable during SSR and in a locked-down browser; a
	// missing preference is not an error, it just means "resolve from the sole
	// membership or ask".
	try {
		const raw = localStorage.getItem(ACTIVE_WORKSPACE_STORAGE_KEY);
		return raw === null ? null : Number(raw);
	} catch {
		return null;
	}
}

function rememberWorkspaceId(id: number | null) {
	try {
		if (id === null) localStorage.removeItem(ACTIVE_WORKSPACE_STORAGE_KEY);
		else localStorage.setItem(ACTIVE_WORKSPACE_STORAGE_KEY, String(id));
	} catch {
		// A browser refusing storage costs the preference, never the session.
	}
}

function selectWorkspace(next: Workspace | null) {
	activeWorkspace = next;
	setActiveWorkspaceId(next?.id ?? null);
	rememberWorkspaceId(next?.id ?? null);
}

export const auth = {
	get user() {
		return user;
	},
	get isLoading() {
		return isLoading;
	},
	get isAuthenticated() {
		return !!user;
	},
	get entitlements() {
		return entitlements;
	},
	get workspaces() {
		return memberships;
	},
	get activeWorkspace() {
		return activeWorkspace;
	},
	/** True when more than one workspace is reachable — what a switcher renders on. */
	get canSwitchWorkspace() {
		return memberships.length > 1;
	},

	/**
	 * Load the caller and their memberships. Call once at app startup.
	 *
	 * The stored preference is honoured only if it is still a membership: a
	 * workspace someone was removed from must not keep being sent, or every
	 * request 403s with no way for the user to see why.
	 */
	async init() {
		isLoading = true;
		try {
			const [me, mine] = await Promise.all([
				api.GET('/api/users/me'),
				api.GET('/api/workspaces/me')
			]);

			if (me.error || !me.data) {
				user = null;
				return;
			}
			user = me.data as User;
			entitlements = (me.data as { entitlements?: string[] }).entitlements ?? [];
			memberships = (mine.data as Membership[]) ?? [];

			const stored = restoreStoredWorkspaceId();
			const remembered = memberships.find((m) => m.workspace.id === stored);
			// One membership needs no choice; several with nothing remembered is a
			// choice only the person can make, so nothing is selected and the
			// backend's 409 is what prompts them.
			const sole = memberships.length === 1 ? memberships.at(0) : undefined;
			selectWorkspace(remembered?.workspace ?? sole?.workspace ?? null);
		} finally {
			isLoading = false;
		}
	},

	/** Switch the workspace every subsequent request acts in. */
	setActiveWorkspace(workspaceId: number) {
		const membership = memberships.find((m) => m.workspace.id === workspaceId);
		if (!membership) return;
		selectWorkspace(membership.workspace);
	},

	/**
	 * Whether the caller holds a module entitlement, at the grade asked for.
	 *
	 * A CONVENIENCE for hiding what someone cannot use — never the gate. The gate
	 * is `require_module()` on the server, and this store is browser state anyone
	 * can edit.
	 */
	can(module: string, write = false) {
		return write
			? entitlements.includes(`${module}:write`)
			: entitlements.includes(module) || entitlements.includes(`${module}:write`);
	},

	/** Sign out at the identity provider; the app holds no session to clear. */
	async logout() {
		user = null;
		entitlements = [];
		memberships = [];
		selectWorkspace(null);
		window.location.href = '/outpost.goauthentik.io/sign_out';
	}
};
