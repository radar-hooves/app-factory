/**
 * The `auth` singleton — who is signed in, and which workspace they are acting in.
 *
 * Contract and shape are the household's, not this app's
 * (`rules-library/platform/authentication.md` §Frontend Auth Store Contract):
 * module-level `$state` with getter exports, no credential on the store, and no
 * `login()` — Tier 1a is proxy-delegated, so signing in is a redirect to the
 * identity provider and there is nothing here to hold.
 *
 * The workspace members are the tenancy layer
 * (`rules-library/platform/tenancy.md`). A caller belonging to one workspace
 * never sees a switcher and never sends a header; the backend resolves their
 * sole membership. A caller belonging to two must choose, and until they have,
 * every request is answered 409 with the choices — deliberately, because a
 * silent default is how one workspace's data lands in another.
 */
import { api, setActiveWorkspaceId } from './api/client';
import type { components } from './api/schema';

export const ACTIVE_WORKSPACE_STORAGE_KEY = '{{ project_name }}.activeWorkspaceId';

/**
 * Whoever `/api/users/me` says you are — the backend's own schema, not a second
 * hand-written copy of it.
 *
 * Derived from the generated schema so a field added, renamed or made nullable
 * on the backend is a type error here at the next `pnpm generate:api`, rather
 * than a hand-maintained interface that silently drifts. Workspace and
 * membership shapes below stay declared: they are the tenancy contract the
 * household fixes (`platform/tenancy.md`), not this app's API surface.
 */
export type User = components['schemas']['CurrentUserRead'];

export interface Workspace {
	id: number;
	slug: string;
	name: string;
}

export interface Membership {
	workspace: Workspace;
	role: 'owner' | 'member';
}

let user = $state<User | null>(null);
let entitlements = $state<string[]>([]);
let memberships = $state<Membership[]>([]);
let activeWorkspace = $state<Workspace | null>(null);
let isLoading = $state(true);

/**
 * Why the last init() found nobody.
 *
 * - 'lapsed': a session only the identity provider can renew. A 401, or the
 *   forward-auth proxy's redirect to the provider, which init() asks the
 *   browser not to follow so it arrives as an `opaqueredirect`.
 * - 'refused': the app knows who this is and will not let them in (a 403: the
 *   account is not active). Signing in again would change nothing.
 * - 'failed': anything else a sign-in would not fix: the backend down or
 *   unreachable, a reset connection, a timeout. Sending the browser to sign in
 *   there would bring it straight back to the same failure, as fast as the
 *   round trip allows.
 */
export type SignInFailure = 'lapsed' | 'refused' | 'failed';
let failure = $state<SignInFailure | null>(null);

function signInFailure(result: { response: Response }): SignInFailure {
	const { status, type } = result.response;
	if (status === 401 || type === 'opaqueredirect') return 'lapsed';
	return status === 403 ? 'refused' : 'failed';
}

function restoreStoredWorkspaceId(): number | null {
	// localStorage is unavailable during SSR and in a locked-down browser; a
	// missing preference is not an error, it just means "resolve from the sole
	// membership or ask".
	try {
		const raw = localStorage.getItem(ACTIVE_WORKSPACE_STORAGE_KEY);
		return raw === null ? null : Number(raw);
	} catch {
		return null;
	}
}

function rememberWorkspaceId(id: number | null) {
	try {
		if (id === null) localStorage.removeItem(ACTIVE_WORKSPACE_STORAGE_KEY);
		else localStorage.setItem(ACTIVE_WORKSPACE_STORAGE_KEY, String(id));
	} catch {
		// A browser refusing storage costs the preference, never the session.
	}
}

/** Make a workspace the one every request acts in. In-memory only; see below. */
function selectWorkspace(next: Workspace | null) {
	activeWorkspace = next;
	setActiveWorkspaceId(next?.id ?? null);
}

/**
 * Pick the workspace every request should act in, from what is preferred and
 * what is actually held. Shared by init() and refreshWorkspaces() so a rename,
 * a grant or a retraction reconciles exactly the way a fresh load does.
 *
 * A preference is honoured only if it is still a membership: a workspace
 * someone was removed from must not keep being sent, or every request 403s
 * with no way for the user to see why. Such a preference is forgotten here.
 *
 * A sole membership is selected but NOT remembered, because selecting the only
 * option is not a choice. Measured 03/09/2026 driving the grant end to end:
 * remembering it meant a person who signed in before being granted a seat
 * reloaded into their old, empty workspace with the new one tucked behind a
 * menu — the very symptom this layer exists to end, one grant later. Left
 * unremembered, the next load finds two memberships and nothing preferred, and
 * the layout asks. Only setActiveWorkspace() — a person choosing — remembers.
 */
function reconcileActiveWorkspace(preferred: number | null) {
	const remembered = memberships.find((m) => m.workspace.id === preferred);
	if (remembered) {
		selectWorkspace(remembered.workspace);
		return;
	}
	rememberWorkspaceId(null);
	const sole = memberships.length === 1 ? memberships.at(0) : undefined;
	selectWorkspace(sole?.workspace ?? null);
}

export const auth = {
	get user() {
		return user;
	},
	get isLoading() {
		return isLoading;
	},
	get isAuthenticated() {
		return !!user;
	},
	/** Why nobody is signed in after init(), or null (see `SignInFailure`). */
	get failure() {
		return failure;
	},
	get entitlements() {
		return entitlements;
	},
	get workspaces() {
		return memberships;
	},
	get activeWorkspace() {
		return activeWorkspace;
	},
	/** True when more than one workspace is reachable — what a switcher renders on. */
	get canSwitchWorkspace() {
		return memberships.length > 1;
	},
	/**
	 * True while several workspaces are held and none is chosen. The layout
	 * renders the chooser instead of a page, because a page fetched in that
	 * state is answered 409 — deliberately (see the module comment).
	 */
	get needsWorkspaceChoice() {
		return memberships.length > 1 && activeWorkspace === null;
	},
	/** The caller's standing in the active workspace, or null before one is chosen. */
	get activeRole() {
		return memberships.find((m) => m.workspace.id === activeWorkspace?.id)?.role ?? null;
	},

	/**
	 * Load the caller and their memberships. Call once at app startup.
	 *
	 * The stored preference is honoured only if it is still a membership: a
	 * workspace someone was removed from must not keep being sent, or every
	 * request 403s with no way for the user to see why.
	 */
	async init() {
		isLoading = true;
		failure = null;
		try {
			const [me, mine] = await Promise.all([
				// Not followed: a redirect here is the proxy sending a lapsed
				// session to sign in, and followed it would fail as a network
				// error, indistinguishable from an unreachable backend.
				api.GET('/api/users/me', { redirect: 'manual' }),
				api.GET('/api/workspaces/me')
			]);

			if (me.error || !me.data) {
				user = null;
				failure = signInFailure(me);
				return;
			}
			user = me.data;
			entitlements = (me.data as { entitlements?: string[] }).entitlements ?? [];
			memberships = (mine.data as Membership[]) ?? [];

			reconcileActiveWorkspace(restoreStoredWorkspaceId());
		} finally {
			isLoading = false;
		}
	},

	/**
	 * Re-read the caller's memberships after something changed them — a
	 * workspace created or renamed, a membership granted or retracted. The
	 * active workspace is kept while it is still held (its name may have
	 * changed), dropped when it is gone, and chosen for them when only one
	 * remains. Cheaper than init(): the user record has not changed and the
	 * page must not flicker through the loading state.
	 */
	async refreshWorkspaces() {
		const mine = await api.GET('/api/workspaces/me');
		if (mine.error || !mine.data) return;
		memberships = mine.data as Membership[];
		reconcileActiveWorkspace(activeWorkspace?.id ?? restoreStoredWorkspaceId());
	},

	/**
	 * Switch the workspace every subsequent request acts in.
	 *
	 * Only the store changes here. The layout keys the page on the active
	 * workspace, so the page remounts and fetches again; no page has to know a
	 * switch happened, and none can show the previous workspace's rows.
	 */
	setActiveWorkspace(workspaceId: number) {
		const membership = memberships.find((m) => m.workspace.id === workspaceId);
		if (!membership) return;
		selectWorkspace(membership.workspace);
		rememberWorkspaceId(membership.workspace.id);
	},

	/**
	 * Whether the caller holds a module entitlement, at the grade asked for.
	 *
	 * A CONVENIENCE for hiding what someone cannot use — never the gate. The gate
	 * is `require_module()` on the server, and this store is browser state anyone
	 * can edit.
	 */
	can(module: string, write = false) {
		return write
			? entitlements.includes(`${module}:write`)
			: entitlements.includes(module) || entitlements.includes(`${module}:write`);
	},

	/** Sign out at the identity provider; the app holds no session to clear. */
	async logout() {
		user = null;
		entitlements = [];
		memberships = [];
		selectWorkspace(null);
		rememberWorkspaceId(null);
		window.location.href = '/outpost.goauthentik.io/sign_out';
	}
};
