{% raw %}<!--
	This app's frame: the shared shell composed with this app's own nav, brand
	and top bar.

	THE extension point for routes/(protected)/+layout.svelte, which is owed
	byte-identical and renders this around every signed-in route: the factory's
	layout owns the session, the workspace and the guard, and this file owns what
	the app looks like around them. Stamped once and never overwritten, so this
	is where the app declares its nav, points the brand at its real landing page
	(`homeHref`), and adds its own top-bar actions and palette groups — never by
	editing the factory's layout. It sets no width: a route says what it is.

	`children` is the factory's guarded page: render it inside the shell, once.
	The frame renders from the first paint, before the session is confirmed:
	around the loading state, the workspace chooser and the retry as well as
	the page. So nothing here may assume `auth.user`, and what needs a
	signed-in caller waits for it, as `identity` below does.
-->
<script module lang="ts">
	/**
	 * What THIS app calls a workspace ("Household"), declared once and read by
	 * the menu below, the factory's members page and its workspace chooser
	 * (rules-library/platform/tenancy.md).
	 */
	export const workspaceLabel = 'Workspace';
</script>

<script lang="ts">
	import type { Snippet } from 'svelte';
	import { AppIdentity } from '@poodle64/ui/app-identity';
	import { AppShell, type NavGroup } from '@poodle64/ui/app-shell';
	import { CommandPalette } from '@poodle64/ui/command-palette';
	import { page } from '$app/state';
	import { goto } from '$app/navigation';
	import Eye from '@lucide/svelte/icons/eye';
	import House from '@lucide/svelte/icons/house';
	import { auth } from '$lib/auth.svelte';
	import AdminAlertBell from '$lib/alerts/admin-alert-bell.svelte';
	import ViewAsBanner from '$lib/view-as/view-as-banner.svelte';
	import ViewAsDialog from '$lib/view-as/view-as-dialog.svelte';
	import WorkspaceMenu from '$lib/workspaces/workspace-menu.svelte';

	let { children }: { children: Snippet } = $props();

	/**
	 * This app's navigation: the rail, the phone's drawer and the palette's
	 * results, from one value. How to grow it:
	 *
	 * - Groups, in the order a reader reaches for them. The first group has no
	 *   heading and holds the ways in; a later group takes a `heading` only when
	 *   its rows share a subject the reader would name.
	 * - `children` for a section whose own pages are destinations, one level
	 *   deep (the type refuses two). A table of contents, a document tree or a
	 *   filter is not navigation: it goes in the page beside what it serves.
	 * - No Settings row: Settings is the account menu's one item, wired below.
	 * - Who may see a row is decided before it gets here (`$derived` over
	 *   `auth.entitlements`); the shell knows nothing of permissions.
	 * - Name rows in the reader's words, never the library's architecture
	 *   (canonical-app-shape.md §Milton is a person, not a place).
	 *
	 * A nav long enough to want its own file moves to `$lib/config/navigation.ts`
	 * and is imported here.
	 */
	const nav: NavGroup[] = [{ items: [{ label: 'Home', href: '/', icon: House }] }];

	// The global search affordance canonical-app-shape.md requires in the top bar,
	// and the palette it opens. @poodle64/ui ships both halves; composing them is
	// what the factory had never done, so four apps wrote these same three lines
	// four times and three shipped no top-bar search at all
	// (full-stack-app-template#23). ⌘K is bound by CommandPalette itself — do not
	// add a keydown handler here.
	let paletteOpen = $state(false);

	// One route, read by both WorkspaceMenu (its own "Members" item, for
	// several memberships) and AppIdentity below (onManageMembers, for
	// exactly one) — so renaming the members route stays a one-line change
	// rather than two call sites drifting apart.
	const membersHref = '/settings/members';

	// "View as colleague": an admin previews the app with fewer entitlements
	// (docs/design/exchange.md §View as colleague). Offered to whoever really
	// holds `admin` (`auth.canViewAs`, not `auth.can`, which reads the narrowed
	// set), and the banner below is the way back once admin itself is narrowed away.
	let viewAsOpen = $state(false);
</script>

<!-- One `nav` feeds BOTH the shell and the palette below: a palette handed none
     finds nothing while looking like it works. -->
<!-- The house floor and the rail's collapse control arrive by default from
     @poodle64/ui — do not pass `texture` or `collapsible` to ask for them, and
     do not hand-roll a dot-grid class in app.css. -->
<!-- What a page is, `pageType`, is the route's to say in its load data
     (app.d.ts types it): `reading` by default, `panel` or `tool` from a route
     group's +layout.ts or one route's +page.ts. The shell does the rest. Keep
     both page lines if you compose the shell differently, or the routes lose
     what they asked for; `title` names a page the rail has no row for. -->

<AppShell
	{nav}
	brandTitle="{% endraw %}{{ project_title }}{% raw %}"
	currentPath={page.url.pathname}
	pageType={page.data.pageType}
	title={page.data.title}
	onSearch={() => (paletteOpen = true)}
>
	<!-- The workspace switch, for whoever has more than one to switch between —
	     renders nothing for an org-of-one (see workspace-menu.svelte). The
	     factory owns the component; this is where the app mounts it, named by
	     `workspaceLabel` above. -->
	{#snippet context()}
		<WorkspaceMenu {membersHref} label={workspaceLabel} />
	{/snippet}

	<!-- The bell (app-factory docs/design/alerts.md), admin-gated by the component itself. -->
	{#snippet actions()}
		<AdminAlertBell />
	{/snippet}

	<!-- Who is signed in, and the way out — rendered once, at the end of the
	     top bar (rules-library/platform/authentication.md §Frontend Auth Store
	     Contract). Waits for auth.user rather than passing it a null one; the
	     loading and workspace-choice states still get full shell chrome, just
	     not yet an avatar. onAccountSettings is the Settings item, the one door
	     to /settings: the rail has no row for it, and sign out lives here only.

	     onManageMembers is wired ONLY while WorkspaceMenu renders nothing for
	     this caller (one membership, `!auth.canSwitchWorkspace`): that menu
	     carries its own Members entry once there is a switch to go with it,
	     and giving both surfaces the same item at once is the same act listed
	     twice, not a second door (see workspace-menu.svelte). -->
	{#snippet identity()}
		{#if auth.user}
			<AppIdentity
				user={auth.user}
				workspace={auth.activeWorkspace?.name}
				role={auth.activeRole}
				entitlements={auth.entitlements}
				links={auth.canViewAs
					? [{ label: 'View as colleague', icon: Eye, onSelect: () => (viewAsOpen = true) }]
					: []}
				onManageMembers={auth.canSwitchWorkspace ? undefined : () => goto(membersHref)}
				onAccountSettings={() => goto('/settings')}
				onSignOut={() => void auth.logout()}
			/>
		{/if}
	{/snippet}

	<ViewAsBanner />
	{@render children()}
</AppShell>

<ViewAsDialog bind:open={viewAsOpen} />

<!-- An app with palette ACTIONS as well as pages adds them as a child command
     group right here. -->
<CommandPalette bind:open={paletteOpen} {nav} onNavigate={goto} />
{% endraw -%}
