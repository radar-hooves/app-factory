/**
 * openapi-fetch client for {{ project_name }}.
 *
 * Run `pnpm generate:api` after changing the backend to regenerate schema.d.ts.
 * The client is type-safe: paths come from the generated schema, not strings.
 *
 * credentials: 'include' sends the Authentik session cookie so the proxy
 * can validate the request.
 */
import createClient from 'openapi-fetch';
import type { Middleware } from 'openapi-fetch';

import type { paths } from './schema';

export const api = createClient<paths>({
	baseUrl: import.meta.env.VITE_API_URL ?? '',
	credentials: 'include'
});

// The workspace this browser is acting in, held HERE rather than in the auth
// store so the store can import the client without a cycle. A value of null
// sends no header, which is correct for a caller holding exactly one membership:
// the backend resolves it without being told. It is only once someone belongs to
// two workspaces that the header becomes load-bearing, and until it is set the
// backend answers 409 with the choices rather than guessing.
let activeWorkspaceId: number | null = null;

export function setActiveWorkspaceId(id: number | null) {
	activeWorkspaceId = id;
}

export function getActiveWorkspaceId(): number | null {
	return activeWorkspaceId;
}

// Sent on every request rather than threaded through call sites: scoping is not
// a parameter any one caller should be able to forget or fake.
const workspaceMiddleware: Middleware = {
	async onRequest({ request }) {
		if (activeWorkspaceId !== null) {
			request.headers.set('X-Workspace-Id', String(activeWorkspaceId));
		}
		return request;
	}
};

// Track timeout IDs by request identity (survives request.clone()).
const timeoutIds = new WeakMap<Request, ReturnType<typeof setTimeout>>();

// Abort requests exceeding 30 seconds.
const timeoutMiddleware: Middleware = {
	async onRequest({ request }) {
		const controller = new AbortController();
		const timeoutId = setTimeout(() => controller.abort(), 30_000);
		const newRequest = new Request(request, { signal: controller.signal });
		timeoutIds.set(newRequest, timeoutId);
		return newRequest;
	},
	async onResponse({ request, response }) {
		clearRequestTimeout(request);
		return response;
	},
	// onResponse never runs when fetch rejects, so the timer is cleared here too
	// or it leaks on every network failure.
	async onError({ request }) {
		clearRequestTimeout(request);
	}
};

function clearRequestTimeout(request: Request) {
	const timeoutId = timeoutIds.get(request);
	if (timeoutId) {
		clearTimeout(timeoutId);
		timeoutIds.delete(request);
	}
}

// fetch() REJECTS on a network/CORS failure (TypeError) or a timeout abort
// (DOMException), unlike an HTTP error which comes back as { error }. Normalise
// that throwing path here, once, so every call site stays on the same
// try/catch-free `if (error)` contract (sveltekit-api-client.md §Error Handling).
const errorNormaliserMiddleware: Middleware = {
	async onError({ error }) {
		if (error instanceof DOMException && error.name === 'AbortError') {
			return new Response(JSON.stringify({ error: 'timeout', message: 'The request timed out.' }), {
				status: 408,
				headers: { 'Content-Type': 'application/json' }
			});
		}
		// 503, not 0: the Response constructor rejects a status outside 200-599.
		return new Response(
			JSON.stringify({ error: 'network_error', message: 'Could not reach the API.' }),
			{
				status: 503,
				headers: { 'Content-Type': 'application/json' }
			}
		);
	}
};

// Tier 1a is proxy-delegated: there is no app-level login page. An unauthenticated
// or 401 state means the Authentik session is absent or expired, so bounce the
// browser to the outpost start URL. The forward-auth proxy intercepts it in prod and
// round-trips back to `rd`; in dev the proxy is absent (Vite injects identity headers)
// so this path is not exercised. There is no refresh endpoint.
export function redirectToAuthentik(returnPath: string = '/') {
	window.location.href = `/outpost.goauthentik.io/start?rd=${encodeURIComponent(returnPath)}`;
}

// 401 middleware: an expired or absent session sends the browser to re-authenticate.
const authMiddleware: Middleware = {
	async onResponse({ response }) {
		if (response.status !== 401) return response;
		redirectToAuthentik(window.location.pathname + window.location.search);
		return response;
	}
};

api.use(workspaceMiddleware);
api.use(timeoutMiddleware);
api.use(authMiddleware);
// Last: it turns a throw into a Response, so every middleware above sees a
// uniform result whichever way the request failed.
api.use(errorNormaliserMiddleware);
