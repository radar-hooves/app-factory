{% raw %}<script lang="ts">
	import { onMount } from 'svelte';
	import PageHeader from '@poodle64/ui/page-header';
	import { ShellControls } from '@poodle64/ui/app-shell';
	import { Segmented, type SegmentedOption } from '@poodle64/ui/segmented';
	import { api, describeApiError } from '$lib/api';
	import { auth } from '$lib/auth.svelte';

	let status = $state<string | null>(null);

	// Through the api client, never a bare fetch(): the client is what stamps
	// every call with the workspace the caller chose. A bare fetch carries no
	// such header, so it is answered 409 the moment the caller belongs to two —
	// which is the first thing that happens once someone shares with them.
	onMount(async () => {
		const { data, error } = await api.GET('/api/example/');
		status = error
			? describeApiError(error, 'Could not reach the API')
			: `Connected — ${data.length} example items in ${auth.activeWorkspace?.name ?? 'this workspace'}.`;
	});

	// The pattern a real domain route follows for its own scope (an entity, a
	// financial year, a chart/table toggle): render it inside `ShellControls`
	// and it appears in the top bar, never a row above the body
	// (`sveltekit-frontend.md` §Component library). This page's own choice —
	// how much of the connection status to show — is a placeholder for that;
	// the wiring is the point.
	let view = $state<'summary' | 'detail'>('summary');
	const VIEW_OPTIONS: SegmentedOption<'summary' | 'detail'>[] = [
		{ value: 'summary', label: 'Summary' },
		{ value: 'detail', label: 'Detail' }
	];
</script>

<!-- Compose the shared page-title treatment rather than a hand-rolled heading —
     every route shares one header (canonical-app-shape.md, check-ui-drift.mjs).

     prettier-ignore, because this tag's WIDTH is an answer, not a style: both
     values are rendered from copier answers, so it is this app's name plus its
     one-line description. An app whose sentence runs long is past prettier's
     print width on one line, and a terser app has the pre-wrapped form collapsed
     back onto one — so `pnpm lint` failed on a freshly stamped app that nobody
     had touched yet, at whichever length the file was not tuned for. Ignoring
     the tag is the only form stable at every length. -->
<!-- prettier-ignore -->
<PageHeader title="{% endraw %}{{ project_name }}{% raw %}" subtitle="{% endraw %}{{ description }}{% raw %}" />

<ShellControls>
	<Segmented bind:value={view} options={VIEW_OPTIONS} label="View" size="sm" />
</ShellControls>

{#if status}
	<p class="bg-card text-card-foreground mt-6 rounded-md border px-4 py-3 text-sm">
		{view === 'detail' ? status : status.split(' — ')[0]}
	</p>
{:else}
	<p class="text-muted-foreground mt-6 text-sm">Checking API…</p>
{/if}
{% endraw -%}
