test('a question handed over in navigation state is asked, stays on screen and is never re-sent', async ({
	page
}) => {
	const question = "What about carer's leave?";
	let asks = 0;
	page.on('request', (request) => {
		if (request.method() === 'POST' && request.url().endsWith('/api/agent/helper/ask')) asks += 1;
	});
	await page.goto('/chat');
	await expect(page.getByRole('link', { name: /^Ask The Helper/ })).toBeVisible();
	// Another page's `goto('/chat/helper', { state: { ask } })`, through the app's own router.
	await page.evaluate(async (ask) => {
		const loaded = performance
			.getEntriesByType('resource')
			.map((entry) => entry.name)
			.find((name) => /\/app\/navigation\.js/.test(name));
		const { goto } = await import(/* @vite-ignore */ loaded as string);
		await goto('/chat/helper', { state: { ask } });
	}, question);

	// The turn survives the entry being cleared: it is on screen, streams, and the
	// address gains the conversation as for any asked question.
	await expect(page.getByText(`You asked: ${question}`)).toBeVisible();
	await expect(page).toHaveURL(/\/chat\/helper\?c=/);
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	await expect(page.getByText(`You asked: ${question}`)).toBeVisible();
	const id = conversationId(page);
	expect((await read(page, id)).turns).toHaveLength(1);

	await page.reload();
	await expect(page.getByText(`You asked: ${question}`)).toBeVisible();
	await page.goBack();
	await page.goForward();
	await expect(page.getByText(`You asked: ${question}`)).toBeVisible();
	await page.waitForTimeout(500);
	expect(asks, 'reload, Back and Forward never re-send').toBe(1);
});

test('a link can wait a question in the box but never make the chat ask it', async ({ page }) => {
	let asks = 0;
	page.on('request', (request) => {
		if (request.method() === 'POST' && request.url().endsWith('/api/agent/helper/ask')) asks += 1;
	});
	// Asking on arrival is navigation state (`goto(href, { state: { ask } })`),
	// which an address cannot carry: `?ask=` is just another parameter.
	await page.goto('/chat/helper?ask=What%20about%20long%20service%20leave%3F');
	await expect(composer(page)).toHaveValue('');
	await page.waitForTimeout(500);
	expect(asks).toBe(0);
});

/** The reading column a written document opens in, named for the version it shows. */
function pane(page: Page) {
	return page.getByRole('complementary', { name: /^Leave brief/ });
}

/** The card for one version of a written document: the innermost block holding its version and its Open. */
function card(page: Page, version: number) {
	return page
		.locator('div')
		.filter({ has: page.getByText(new RegExp(` · v${version}$`)) })
		.filter({ has: page.getByRole('button', { name: /^(Open|Showing)/ }) })
		.last();
}

test('a document the persona writes shows as a card, opens beside the chat and downloads as written', async ({
	page
}) => {
	test.setTimeout(60_000);
	await page.goto('/chat/helper');
	await ask(page, '__write__:brief.md:# Leave brief');
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	const id = conversationId(page);

	// The card names the document by its title; its chip downloads the file it is.
	const first = card(page, 1);
	await expect(first.getByText('Leave brief', { exact: true })).toBeVisible();
	await expect(page.getByRole('link', { name: /brief\.md.*v1.*Download/ })).toBeVisible();
	await first.getByRole('button', { name: 'Open' }).click();
	await expect(pane(page).getByRole('heading', { name: 'Leave brief' })).toBeVisible();

	// Its download is the bytes the persona wrote, not a rendering of them.
	await pane(page).getByRole('button', { name: 'Download' }).click();
	const href = await pane(page).getByRole('menuitem', { name: 'Markdown' }).getAttribute('href');
	expect(href).toBeTruthy();
	const bytes = await ok(page.request.get(href as string));
	expect(await bytes.text()).toBe('# Leave brief');

	// The same name written again is v2, and the column can read either.
	await pane(page).getByRole('button', { name: 'Close source' }).click();
	await ask(page, '__write__:brief.md:# Leave brief, revised');
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	const second = card(page, 2);
	await expect(second.getByText('Leave brief, revised', { exact: true })).toBeVisible();
	await second.getByRole('button', { name: 'Open' }).click();
	const column = pane(page);
	await expect(column.getByRole('heading', { name: 'Leave brief, revised' })).toBeVisible();
	await column.getByRole('combobox', { name: 'Version' }).selectOption('1');
	await expect(column.getByRole('heading', { name: 'Leave brief', exact: true })).toBeVisible();
	await expect(column.getByRole('heading', { name: 'Leave brief, revised' })).toHaveCount(0);

	const stored = await readJson<{ turns: { artefacts: { name: string; version: number }[] }[] }>(
		page.request.get(`/api/agent/conversations/${id}`)
	);
	expect(stored.turns.flatMap((t) => t.artefacts.map((a) => [a.name, a.version]))).toEqual([
		['brief.md', 1],
		['brief.md', 2]
	]);
});

test('the Write step is its own collapsed row, and opens on its input and its result', async ({
	page
}) => {
	await page.goto('/chat/helper');
	await ask(page, '__write__:notes.md:# Notes');
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });

	// The turn's steps are folded behind one line, which opens on the rows.
	await page.getByRole('button', { name: /^Wrote a .*1 step/ }).click();
	const step = page.getByRole('button', { name: /Wrote\s*notes\.md/ });
	await expect(step).toHaveAttribute('aria-expanded', 'false');
	await expect(page.getByText('File created')).toHaveCount(0);

	await step.click();
	await expect(step).toHaveAttribute('aria-expanded', 'true');
	await expect(page.getByText('Input', { exact: true })).toBeVisible();
	await expect(page.getByText('"content": "# Notes"')).toBeVisible();
	await expect(page.getByText('Result', { exact: true })).toBeVisible();
	await expect(page.getByText('File created')).toBeVisible();

	await step.click();
	await expect(step).toHaveAttribute('aria-expanded', 'false');
});

test('an edited question is sent again, replacing the old answer and everything after it', async ({
	page
}) => {
	// Three paced answers, one of them after an edit.
	test.setTimeout(90_000);
	await page.goto('/chat/helper');
	await ask(page, 'one');
	await expect(page.getByText('You asked: one', { exact: true })).toBeVisible();
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	await ask(page, 'two');
	await expect(page.getByText('You asked: two', { exact: true })).toBeVisible();
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	const id = conversationId(page);

	await page.getByRole('button', { name: 'Edit' }).last().click();
	const box = page.getByRole('textbox', { name: 'Edit' });
	await box.fill('two, edited');
	await box.locator('xpath=ancestor::form').getByRole('button', { name: 'Send' }).click();

	await expect(page.getByText('You asked: two, edited', { exact: true })).toBeVisible();
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	await expect(page.getByText('You asked: two', { exact: true })).toHaveCount(0);
	await expect(page.getByText('You asked: one', { exact: true })).toBeVisible();

	const asked = async () => (await read(page, id)).turns.map((t) => t.question);
	await expect.poll(asked, { timeout: 10_000 }).toEqual(['one', 'two, edited']);

	await page.reload();
	await expect(page).toHaveURL(new RegExp(`[?&]c=${id}`));
	await expect(page.getByText('You asked: two, edited', { exact: true })).toBeVisible();
	await expect(page.getByText('You asked: one', { exact: true })).toBeVisible();
	await expect(page.getByText('You asked: two', { exact: true })).toHaveCount(0);
});

test('a file attached to a question shows as a chip on it, and still does after a reload', async ({
	page
}) => {
	await page.goto('/chat/helper');
	await page.locator('input[type=file]').setInputFiles({
		name: 'roster.txt',
		mimeType: 'text/plain',
		buffer: Buffer.from('Monday: early\nTuesday: late\n')
	});
	await expect(page.getByText('roster.txt')).toBeVisible();
	await ask(page, 'What does the attached roster say?');
	await expect(page.getByText('You asked: What does the attached roster say?')).toBeVisible();
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	const id = conversationId(page);

	// The chip rides the sent question, and the composer's own is spent.
	// (The persona's echo lists the file's path too, so match the name alone.)
	// Named, with its type beside it, as drawn above the question.
	const chip = () =>
		page.getByRole('listitem').filter({ has: page.getByText('roster.txt', { exact: true }) });
	await expect(chip()).toHaveCount(1);
	await expect(page.getByRole('button', { name: 'Remove roster.txt' })).toHaveCount(0);

	await page.reload();
	await expect(page.getByText('You asked: What does the attached roster say?')).toBeVisible();
	await expect(chip()).toHaveCount(1);

	const stored = await readJson<{ turns: { files: string[] }[] }>(
		page.request.get(`/api/agent/conversations/${id}`)
	);
	expect(stored.turns[0]?.files).toEqual(['roster.txt']);
});

test('a spent allowance is shown, and the next question is refused', async ({ page }) => {
	for (let asked = 0; asked < 40; asked += 1) {
		const response = await page.request.post('/api/agent/outrider/ask', {
			data: { question: 'One more?', resume: outriderConversation }
		});
		if (response.status() === 429) break;
		expect(response.status()).toBe(200);
	}
	const quota = await readJson<{ reached: boolean; limit: number }>(
		page.request.get('/api/agent/quota')
	);
	expect(quota.reached).toBe(true);

	await page.goto('/chat/helper');
	await expect(page.getByText(/reached today's fair-use limit/)).toBeVisible();
	await composer(page).fill('Just one more?');
	await page.getByRole('button', { name: 'Send' }).click();
	await expect(page.getByText('You asked: Just one more?')).toBeHidden();
	const refused = await page.request.post('/api/agent/helper/ask', {
		data: { question: 'x' }
	});
	expect(refused.status()).toBe(429);
	expect(Number(refused.headers()['retry-after'])).toBeGreaterThan(0);
});

test('a person invited to chat with one persona is refused everything else', async () => {
	const person = await request.newContext({
		baseURL: BACKEND,
		extraHTTPHeaders: {
			'x-authentik-uid': 'e2e-chat-only',
			'x-authentik-username': 'e2e-chat-only',
			'x-authentik-entitlements': 'chat-helper'
		}
	});
	try {
		const personas = await readJson<{ id: string }[]>(person.get('/api/agent/personas'));
		expect(personas.map((p) => p.id)).toEqual(['helper']);
		await ok(person.get('/api/agent/helper/conversations'));
		for (const path of [
			'/api/agent/outrider/conversations',
			'/api/agent/outrider/collections',
			'/api/agent/outrider/documents/1042'
		]) {
			expect((await person.get(path)).status(), path).toBe(403);
		}
		expect(
			(await person.post('/api/agent/outrider/ask', { data: { question: 'x' } })).status()
		).toBe(403);

		const document = await readJson<{ paths: Record<string, Record<string, unknown>> }>(
			person.get('/openapi.json')
		);
		const walked: string[] = [];
		for (const [path, operations] of Object.entries(document.paths)) {
			if (PERSON_FACING.some((prefix) => path.startsWith(prefix))) continue;
			for (const method of Object.keys(operations)) {
				const url = path.replace(/\{[^}]+\}/g, '1');
				const response = await person.fetch(url, {
					method,
					data: method === 'get' ? undefined : {}
				});
				walked.push(`${method.toUpperCase()} ${path} ${response.status()}`);
			}
		}
		expect(walked.length).toBeGreaterThan(10);
		expect(walked.filter((line) => !line.endsWith(' 403'))).toEqual([]);
	} finally {
		await person.dispose();
	}
});

test('the pages, photographed', async ({ browser }) => {
	test.skip(!SHOTS, 'set CHAT_SCREENSHOTS to a directory to photograph the pages');
	test.setTimeout(120_000);
	const views: [string, string][] = [
		['index', '/chat'],
		['new', '/chat/outrider'],
		['collections', `/chat/outrider?c=${outriderConversation}`],
		['shared', `/chat/outrider/answers/${outriderConversation}/0`],
		['allowance', '/chat/helper']
	];
	const sizes: [number, number][] = [
		[1440, 900],
		[390, 844]
	];
	for (const [width, height] of sizes) {
		for (const theme of ['light', 'dark'] as const) {
			const context = await browser.newContext({ viewport: { width, height }, colorScheme: theme });
			const page = await context.newPage();
			for (const [name, path] of views) {
				await page.goto(path);
				await page.waitForLoadState('networkidle');
				await page.screenshot({ path: `${SHOTS}/${name}-${width}-${theme}.png` });
			}
			await context.close();
		}
	}
});
