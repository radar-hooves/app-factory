		const top = await page.evaluate(
			({ x, y }) => document.elementFromPoint(x, y)?.closest('button')?.textContent?.trim(),
			{ x: box.x + box.width / 2, y: box.y + box.height / 2 }
		);
		expect(top).toBe('Send');
		await page.getByTestId('ds-shell-menu').click();
		await expect(page.getByTestId('ds-shell-drawer-report')).toBeVisible();
		await page.getByTestId('ds-shell-menu').click();

		// Past questions are the bar's action here, and open over the page.
		await expect(page.getByRole('region', { name: 'Past questions' })).toHaveCount(0);
		await page.getByTestId('chat-past-questions').click();
		await expect(page.getByRole('region', { name: 'Past questions' })).toBeVisible();
		await page.keyboard.press('Escape');

		await ask(page, 'And on a phone?');
		await expect(page.getByText(/on 'And on a phone\?': a member accrues/).first()).toBeVisible();
	} finally {
		await phone.close();
	}
});

