import { expect, request, test, type Page } from '@playwright/test';
import { ok, readJson } from './api';

// Rooms, driven as a person drives them (docs/design/agent-console.md, step 4's
// proof): a persona room answered by the suites' fake CLI and a library room
// answered by the fake library, over the backend `tests/e2e/rooms/serve.sh`
// starts. The browser's person holds both rooms:
//
//   {{ project_name | upper | replace('-', '_') }}_DEV_ENTITLEMENTS='example|room-helper|room-manual' pnpm exec playwright test rooms
//
// The tests run in order and share one person's conversations and allowance.
// With ROOMS_SCREENSHOTS set to a directory, the last one photographs the pages
// at 1440 and 390 wide in both themes.

const BACKEND = process.env.{{ project_name | upper | replace('-', '_') }}_DEV_BACKEND_TARGET ?? 'http://127.0.0.1:{{ backend_port }}';
const SHOTS = process.env.ROOMS_SCREENSHOTS;
/** What any signed-in person may reach; everything else, the people list included, needs a module
 *  (tests/test_route_walk.py). */
const PERSON_FACING = [
	'/api/users/me',
	'/api/workspaces',
	'/api/feedback',
	'/api/system',
	'/api/agent/rooms',
	'/api/agent/conversations',
	'/api/agent/quota'
];

type Conversation = {
	id: string;
	answering_since: string | null;
	turns: {
		question: string;
		answer: string;
		at: string | null;
		depth?: string | null;
		shared?: string | null;
	}[];
};

test.describe.configure({ mode: 'serial' });

function composer(page: Page) {
	return page.getByPlaceholder(/^Ask /);
}

async function ask(page: Page, question: string) {
	await composer(page).fill(question);
	await page.getByRole('button', { name: 'Send' }).click();
}

function conversationId(page: Page): string {
	const id = new URL(page.url()).searchParams.get('c');
	expect(id, 'the address names the conversation').toBeTruthy();
	return id as string;
}

async function read(page: Page, id: string): Promise<Conversation> {
	return readJson<Conversation>(page.request.get(`/api/agent/conversations/${id}`));
}

let helperConversation = '';
let manualConversation = '';

test('the rooms a person holds are the ones they can ask', async ({ page }) => {
	// The first page a fresh dev server serves waits on its dependency optimisation.
	test.setTimeout(120_000);
	await page.goto('/rooms');
	await expect(page.getByRole('link', { name: /^Ask The Helper/ })).toBeVisible({
		timeout: 60_000
	});
	await expect(page.getByRole('link', { name: /^Ask Milton about The Manual/ })).toBeVisible();
});

test('an ask streams its answer and names the conversation in the address and the list', async ({
	page
}) => {
	await page.goto('/rooms');
	await page.getByRole('link', { name: /^Ask The Helper/ }).click();
	await ask(page, 'How is recreation leave accrued?');

	await expect(page.getByText('You asked: How is recreation leave accrued?')).toBeVisible();
	await expect(page).toHaveURL(/\?c=/);
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	const past = page.getByRole('region', { name: 'Past questions' });
	await expect(past.getByText('How is recreation leave accrued?')).toBeVisible();
	helperConversation = conversationId(page);
});

test('a refresh mid-answer shows it still being answered, then the answer', async ({ page }) => {
	await page.goto('/rooms/helper');
	await ask(page, 'And long service leave?');
	await expect(page.getByText('You asked: And long service leave?')).toBeVisible();
	await expect(page).toHaveURL(/\?c=/);
	const id = conversationId(page);

	await page.reload();
	await expect(page.getByText(/still answering/).first()).toBeVisible();
	expect((await read(page, id)).answering_since).not.toBeNull();

	await expect(page.getByText(/written slowly enough to be refreshed/)).toBeVisible({
		timeout: 20_000
	});
	expect((await read(page, id)).answering_since).toBeNull();
});

test('a link reopens a conversation on another device', async ({ browser }) => {
	const device = await browser.newContext();
	const page = await device.newPage();
	await page.goto(`/rooms/helper?c=${helperConversation}`);
	await expect(page.getByText('How is recreation leave accrued?').first()).toBeVisible();
	await expect(page.getByText('You asked: How is recreation leave accrued?')).toBeVisible();
	await device.close();
});

test('rename, download and delete a conversation', async ({ page }) => {
	await page.goto(`/rooms/helper?c=${helperConversation}`);
	const past = page.getByRole('region', { name: 'Past questions' });

	await past.getByRole('button', { name: 'More: How is recreation leave accrued?' }).click();
	await past.getByRole('button', { name: 'Rename' }).click();
	await past.getByRole('textbox', { name: 'Rename' }).fill('Recreation leave');
	await past.getByRole('button', { name: 'Save' }).click();
	await expect(past.getByText('Recreation leave', { exact: true })).toBeVisible();

	await past.getByRole('button', { name: 'More: Recreation leave' }).click();
	const [download] = await Promise.all([
		page.waitForEvent('download'),
		past.getByRole('button', { name: 'Download' }).click()
	]);
	expect(download.suggestedFilename()).toBe('Recreation leave.md');
	const saved = await download.path();
	const { readFile } = await import('node:fs/promises');
	const text = await readFile(saved, 'utf8');
	expect(text).toContain('# Recreation leave');
	expect(text).toContain('> How is recreation leave accrued?');

	await past.getByRole('button', { name: 'More: Recreation leave' }).click();
	await past.getByRole('button', { name: 'Delete' }).click();
	await past.getByRole('group', { name: 'Delete' }).getByRole('button', { name: 'Delete' }).click();
	await expect(past.getByText('Recreation leave', { exact: true })).toBeHidden();
	await expect(page).not.toHaveURL(/\?c=/);
	expect((await page.request.get(`/api/agent/conversations/${helperConversation}`)).status()).toBe(
		404
	);

	// A link to it now says so, and leaves the address.
	await page.goto(`/rooms/helper?c=${helperConversation}`);
	await expect(page.getByText(/That conversation can't be opened/)).toBeVisible();
	await expect(page).not.toHaveURL(/\?c=/);
});

test('stop ends an answer being written, and the question stays', async ({ page }) => {
	await page.goto('/rooms/helper');
	await ask(page, 'What about leave without pay?');
	await expect(page.getByText('You asked: What about leave without pay?')).toBeVisible();
	const id = conversationId(page);

	await page.getByRole('button', { name: 'Stop' }).click();
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible();
	await expect
		.poll(async () => (await read(page, id)).answering_since, { timeout: 10_000 })
		.toBeNull();
	const stopped = await read(page, id);
	expect(stopped.turns.map((t) => [t.question, t.answer])).toEqual([
		['What about leave without pay?', '']
	]);
});

test('a library room cites, opens the cited document and takes a mark', async ({ page }) => {
	await page.goto('/rooms/manual');
	await expect(page.getByText('Ask Milton about The Manual')).toBeVisible();
	await expect(page.getByText(/Checked against the open record on .*2026\./)).toBeVisible();
	await ask(page, 'How much recreation leave does a member accrue?');

	await expect(page.getByText(/four weeks of recreation leave/)).toBeVisible();
	await expect(page.getByRole('button', { name: 'Send' })).toBeVisible({ timeout: 15_000 });
	manualConversation = conversationId(page);

	await page
		.getByRole('button', { name: /The Manual, Part 5: Leave/ })
		.first()
		.click();
	await expect(page.getByText('A member accrues four weeks a year.')).toBeVisible();

	// A verdict recorded opens its note; a note recorded is thanked.
	const helpful = page.getByRole('button', { name: 'Helpful', exact: true });
	await helpful.click();
	await expect(helpful).toHaveAttribute('aria-pressed', 'true');
	const note = page.getByRole('textbox', { name: 'Anything to add? (optional)' });
	await note.fill('Clear and quick.');
	await note.locator('xpath=ancestor::form').getByRole('button', { name: 'Send' }).click();
	await expect(page.getByText('Thanks, noted.')).toBeVisible();
});

test('a shared answer opens read-only in the room it was asked in, until it is withdrawn', async ({
	page
}) => {
	const person = (entitlements: string) =>
		request.newContext({
			baseURL: BACKEND,
			extraHTTPHeaders: {
				'x-authentik-uid': `e2e-${entitlements}`,
				'x-authentik-username': `e2e-${entitlements}`,
				'x-authentik-entitlements': entitlements
			}
		});
	const colleague = await person('room-manual');
	const outsider = await person('room-helper');
	const api = `/api/agent/rooms/manual/answers/${manualConversation}/0`;
	try {
		expect((await colleague.get(api)).status(), 'nothing is shared by default').toBe(404);

		await page.goto(`/rooms/manual?c=${manualConversation}`);
		await page.getByRole('button', { name: 'Share' }).first().click();
		await expect(page.getByText(/anyone who can ask Milton here can open the link/)).toBeVisible();
		const link = (await read(page, manualConversation)).turns[0]?.shared;
		expect(link).toBe(`/rooms/manual/answers/${manualConversation}/0`);

		expect((await readJson<{ question: string }>(colleague.get(api))).question).toBe(
			'How much recreation leave does a member accrue?'
		);
		expect((await outsider.get(api)).status(), 'as the room itself refuses them').toBe(403);

		await page.goto(link as string);
		await expect(page.getByText(/four weeks of recreation leave/)).toBeVisible();
		await expect(page.getByRole('button', { name: /The Manual, Part 5: Leave/ })).toBeVisible();
		await expect(page.getByRole('link', { name: 'Ask Milton about The Manual' })).toBeVisible();
		await expect(composer(page)).toHaveCount(0);

		await page.goto(`/rooms/manual?c=${manualConversation}`);
		await page.getByRole('button', { name: 'Stop sharing' }).first().click();
		await expect(page.getByRole('button', { name: 'Share' }).first()).toBeVisible();
		expect((await colleague.get(api)).status()).toBe(404);
		await page.goto(link as string);
		await expect(page.getByText('This answer is not shared')).toBeVisible();

		// Shared again, for the photographs.
		await ok(page.request.put(`/api/agent/conversations/${manualConversation}/turns/0/share`));
	} finally {
		await colleague.dispose();
		await outsider.dispose();
	}
});

test('a library room offers Quick or Thorough; a persona room offers neither', async ({ page }) => {
	await page.goto('/rooms/manual');
	const group = page.getByRole('group', { name: /How hard Milton works/ });
	await expect(group).toBeVisible();
	await expect(page.getByRole('button', { name: 'Quick' })).toHaveAttribute('aria-pressed', 'true');

	await page.getByRole('button', { name: 'Thorough' }).click();
	await ask(page, 'What about long service leave, in detail?');
	await expect(page.getByText(/long service leave after ten years/)).toBeVisible();
	// Priced in US dollars, since the factory's app.ts declares no currency of its own.
	await expect(page.getByText(/^Thorough · .* · about US\$0\.03$/)).toBeVisible();
	expect((await read(page, conversationId(page))).turns.at(-1)?.depth).toBe('thorough');

	await page.goto('/rooms/helper');
	await expect(page.getByRole('group', { name: /How hard/ })).toHaveCount(0);
	await expect(page.getByText('Quick', { exact: true })).toHaveCount(0);
});

// The library room's composer is the tallest, with its Quick or Thorough row.
// On a phone the report button shares its corner with Send (app-factory#29).
test('on a phone, Send is clear of the report button', async ({ browser }) => {
	const phone = await browser.newContext({ viewport: { width: 390, height: 844 } });
	const page = await phone.newPage();
	try {
		await page.goto('/rooms/manual');
		const send = page.getByRole('button', { name: 'Send' });
		const report = page.getByRole('button', { name: 'Report a problem' });
		await expect(send).toBeVisible();
		await expect(report).toBeVisible();
		const s = await send.boundingBox();
		const r = await report.boundingBox();
		if (!s || !r) throw new Error('Send or the report button has no box');
		const apart =
			s.y + s.height <= r.y ||
			r.y + r.height <= s.y ||
			s.x + s.width <= r.x ||
			r.x + r.width <= s.x;
		expect(apart, `Send ${JSON.stringify(s)}, the report button ${JSON.stringify(r)}`).toBe(true);

		await ask(page, 'And on a phone?');
		await expect(page.getByText(/On and on a phone: a member accrues/)).toBeVisible();
	} finally {
		await phone.close();
	}
});

test('a link to another room shows that room, not the last one', async ({ page }) => {
	await page.goto(`/rooms/manual?c=${manualConversation}`);
	await expect(page.getByText(/four weeks of recreation leave/).first()).toBeVisible();
	// A link inside the app, as its own navigation offers one: the router keeps
	// the page and changes the room under it.
	await page.evaluate(() => {
		const link = document.createElement('a');
		link.href = '/rooms/helper';
		link.textContent = 'To the helper';
		document.body.append(link);
	});
	await page.getByRole('link', { name: 'To the helper' }).click();
	await expect(page).toHaveURL(/\/rooms\/helper$/);
	await expect(page.getByText('Ask the helper about leave, slowly enough')).toBeVisible();
	await expect(page.getByText(/four weeks of recreation leave/)).toHaveCount(0);
	await expect(page.getByText('Ask Milton about The Manual')).toHaveCount(0);
});

test('a question handed over by a link waits in the box, unsent', async ({ page }) => {
	await page.goto('/rooms/helper?q=What%20about%20long%20service%20leave%3F');
	await expect(composer(page)).toHaveValue('What about long service leave?');
	await expect(page).toHaveURL(/\/rooms\/helper$/);
});

test('a spent allowance is shown, and the next question is refused', async ({ page }) => {
	for (let asked = 0; asked < 12; asked += 1) {
		const response = await page.request.post('/api/agent/rooms/manual/ask', {
			data: { question: 'One more?', resume: manualConversation }
		});
		if (response.status() === 429) break;
		expect(response.status()).toBe(200);
	}
	const quota = await readJson<{ reached: boolean; limit: number }>(
		page.request.get('/api/agent/quota')
	);
	expect(quota.reached).toBe(true);

	await page.goto('/rooms/helper');
	await expect(page.getByText(/reached today's fair-use limit/)).toBeVisible();
	await composer(page).fill('Just one more?');
	await page.getByRole('button', { name: 'Send' }).click();
	await expect(page.getByText('You asked: Just one more?')).toBeHidden();
	const refused = await page.request.post('/api/agent/rooms/helper/ask', {
		data: { question: 'x' }
	});
	expect(refused.status()).toBe(429);
	expect(Number(refused.headers()['retry-after'])).toBeGreaterThan(0);
});

test('a person granted one room is refused everything else', async () => {
	const person = await request.newContext({
		baseURL: BACKEND,
		extraHTTPHeaders: {
			'x-authentik-uid': 'e2e-rooms-only',
			'x-authentik-username': 'e2e-rooms-only',
			'x-authentik-entitlements': 'room-helper'
		}
	});
	try {
		const rooms = await readJson<{ id: string }[]>(person.get('/api/agent/rooms'));
		expect(rooms.map((r) => r.id)).toEqual(['helper']);
		await ok(person.get('/api/agent/rooms/helper/conversations'));
		for (const path of [
			'/api/agent/rooms/manual/conversations',
			'/api/agent/rooms/manual/documents/1042'
		]) {
			expect((await person.get(path)).status(), path).toBe(403);
		}
		expect(
			(await person.post('/api/agent/rooms/manual/ask', { data: { question: 'x' } })).status()
		).toBe(403);

		const document = await readJson<{ paths: Record<string, Record<string, unknown>> }>(
			person.get('/openapi.json')
		);
		const walked: string[] = [];
		for (const [path, operations] of Object.entries(document.paths)) {
			if (PERSON_FACING.some((prefix) => path.startsWith(prefix))) continue;
			for (const method of Object.keys(operations)) {
				const url = path.replace(/\{[^}]+\}/g, '1');
				const response = await person.fetch(url, {
					method,
					data: method === 'get' ? undefined : {}
				});
				walked.push(`${method.toUpperCase()} ${path} ${response.status()}`);
			}
		}
		expect(walked.length).toBeGreaterThan(10);
		expect(walked.filter((line) => !line.endsWith(' 403'))).toEqual([]);
	} finally {
		await person.dispose();
	}
});

test('the pages, photographed', async ({ browser }) => {
	test.skip(!SHOTS, 'set ROOMS_SCREENSHOTS to a directory to photograph the pages');
	test.setTimeout(120_000);
	const views: [string, string][] = [
		['index', '/rooms'],
		['library', `/rooms/manual?c=${manualConversation}`],
		['shared', `/rooms/manual/answers/${manualConversation}/0`],
		['allowance', '/rooms/helper']
	];
	const sizes: [number, number][] = [
		[1440, 900],
		[390, 844]
	];
	for (const [width, height] of sizes) {
		for (const theme of ['light', 'dark'] as const) {
			const context = await browser.newContext({ viewport: { width, height }, colorScheme: theme });
			const page = await context.newPage();
			for (const [name, path] of views) {
				await page.goto(path);
				await page.waitForLoadState('networkidle');
				await page.screenshot({ path: `${SHOTS}/${name}-${width}-${theme}.png` });
			}
			await context.close();
		}
	}
});
