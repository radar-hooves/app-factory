# ============================================================================
# Operating System
# ============================================================================
.DS_Store
._.DS_Store
Thumbs.db
desktop.ini

# ============================================================================
# Editor / IDE
# ============================================================================
.idea/
# Share the four VS Code config files; !.vscode/ re-includes the directory under a
# global ignore. The *.jinja line earns its place in the template repo, where this
# same file governs the unstamped sources — drop it and copier stamps apps with no
# launch configuration at all. Inert once stamped; kept so both copies are one file.
!.vscode/
.vscode/*
!.vscode/*.jinja
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.swp
*.swo
*~

# ============================================================================
# Claude Code
# ============================================================================
.claude/settings.local.json
.claude/CLAUDE.local.md
# .local convention — scratch notes, never a committed artefact.
*.local.md
.claude/.sessions/
.claude/worktrees/
.worktrees/
# Worktree governance-resolution shims: deliberately UNTRACKED. A tracked shim
# would place .claude/.claude/skills inside the scanned tree and register the
# whole master skills pool a second time in every session.
.claude/.claude
.claude/docs
.claude/rules-library

