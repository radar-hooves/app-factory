# ============================================================================
# Operating System
# ============================================================================
.DS_Store
._.DS_Store
Thumbs.db
desktop.ini

# ============================================================================
# Editor / IDE
# ============================================================================
.idea/
# Share the four VS Code config files; !.vscode/ re-includes the directory under a
# global ignore. *.jinja is for THIS repo: without it copier stamps apps debug-less.
!.vscode/
.vscode/*
!.vscode/*.jinja
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.swp
*.swo
*~

# ============================================================================
# Claude Code
# ============================================================================
.claude/settings.local.json
.claude/CLAUDE.local.md
# .local convention — scratch notes, never a committed artefact.
*.local.md
.claude/.sessions/
.claude/worktrees/
.worktrees/
# Worktree governance-resolution shims: deliberately UNTRACKED. A tracked shim
# would place .claude/.claude/skills inside the scanned tree and register the
# whole master skills pool a second time in every session.
.claude/.claude
.claude/docs
.claude/rules-library

# ============================================================================
# Environment & Secrets
# ============================================================================
.env
.env.*
!.env.example
.direnv/

