{
  "name": "{{ project_name }}-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "pnpm run lint:js",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\"",
    "generate:api": "openapi-typescript http://localhost:{{ backend_port }}/openapi.json -o src/lib/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/hanken-grotesk": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@lucide/svelte": "^1.7.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.2.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript-eslint": "^8.0.0",
    "postcss-html": "^1.7.0",
    "stylelint": "^16.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^37.0.0",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@poodle64/design-tokens": "^2026.7.0",
    "@poodle64/ui": "^2026.7.0",
    "mode-watcher": "^1.1.0",
    "openapi-fetch": "^0.17.0"
  }
}
