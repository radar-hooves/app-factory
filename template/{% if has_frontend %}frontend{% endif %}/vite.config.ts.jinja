import { sveltekit } from '@sveltejs/kit/vite';
import tailwindcss from '@tailwindcss/vite';
import { defineConfig } from 'vite';

// Overridable so playwright.config.ts.jinja's E2E suite authenticates as its
// own identity rather than this default interactive one — see its comment.
const devUid = process.env.{{ project_name | upper | replace('-', '_') }}_DEV_UID ?? 'dev-uid';

export default defineConfig({
  plugins: [tailwindcss(), sveltekit()],
  server: {
    port: {{ frontend_port }},
    proxy: {
      '/api': 'http://localhost:{{ backend_port }}',
      // /mcp is proxied so an MCP client can reach the dev backend through this
      // origin. The headers below do NOT authenticate it: /mcp validates an
      // Authentik Bearer token app-side and is closed until
      // {{ project_name | upper | replace('-', '_') }}_OIDC_USERINFO_URL is set. See backend mcp/http_auth.py.
      '/mcp': 'http://localhost:{{ backend_port }}',
    },
    // Inject Authentik dev-bypass headers for the HUMAN surface (/api, the SPA)
    // — same code path as production. These headers carry no weight on /mcp.
    headers: {
      'x-authentik-uid': devUid,
      'x-authentik-username': 'devuser',
    },
  },
});
