# Don't run an implicit `pnpm install` before scripts. pnpm's pre-run dependency
# check tries to purge node_modules when it thinks they're stale, which aborts
# without a TTY (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY) and breaks
# `pnpm run build` in non-interactive shells (e.g. the Docker build). Run
# `pnpm install` explicitly when needed.
verify-deps-before-run=false

# No @poodle64:registry line, deliberately. The scope is published to public npm
# (registry.npmjs.org), which the default registry already resolves with no
# credential. Pointing the scope at GitHub Packages is what made every install
# require a token and 404 without one.
