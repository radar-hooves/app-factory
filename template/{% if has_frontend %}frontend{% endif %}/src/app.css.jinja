@import 'tailwindcss';
@import 'tw-animate-css';

@custom-variant dark (&:is(.dark *));

/*
  Design tokens for {{ project_name }}.

  These are project-specific overrides of the shared household design language
  (docs/master/design/shared-design-language.md — Eucalyptus palette, OKLCH).
  Colours must be defined here; raw oklch() values in component files are a lint
  violation. Update the master design tokens first, then adopt here.
*/
:root {
  --base-font-size: 14px;
  --radius: 0.625rem;

  --background: oklch(1 0 0);
  --foreground: oklch(0.15 0.01 145);

  --card: oklch(0.98 0.005 145);
  --card-foreground: oklch(0.15 0.01 145);

  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.15 0.01 145);

  --primary: oklch(0.55 0.12 145);
  --primary-foreground: oklch(1 0 0);

  --secondary: oklch(0.92 0.02 145);
  --secondary-foreground: oklch(0.25 0.04 145);

  --muted: oklch(0.94 0.01 145);
  --muted-foreground: oklch(0.5 0.04 145);

  --accent: oklch(0.9 0.03 145);
  --accent-foreground: oklch(0.15 0.01 145);

  --destructive: oklch(0.6 0.2 25);
  --destructive-foreground: oklch(1 0 0);

  --border: oklch(0.88 0.02 145);
  --input: oklch(0.88 0.02 145);
  --ring: oklch(0.55 0.12 145);

  --chart-1: oklch(0.55 0.12 145);
  --chart-2: oklch(0.6 0.1 200);
  --chart-3: oklch(0.65 0.1 260);
  --chart-4: oklch(0.7 0.1 60);
  --chart-5: oklch(0.6 0.15 330);

  --sidebar: oklch(0.15 0.01 145);
  --sidebar-foreground: oklch(0.9 0.02 145);
  --sidebar-primary: oklch(0.55 0.12 145);
  --sidebar-primary-foreground: oklch(1 0 0);
  --sidebar-accent: oklch(0.25 0.04 145);
  --sidebar-accent-foreground: oklch(0.9 0.02 145);
  --sidebar-border: oklch(0.3 0.04 145);
  --sidebar-ring: oklch(0.55 0.12 145);
}

.dark {
  --background: oklch(0.12 0.01 145);
  --foreground: oklch(0.92 0.02 145);

  --card: oklch(0.17 0.01 145);
  --card-foreground: oklch(0.92 0.02 145);

  --popover: oklch(0.17 0.01 145);
  --popover-foreground: oklch(0.92 0.02 145);

  --primary: oklch(0.65 0.12 145);
  --primary-foreground: oklch(0.1 0.01 145);

  --secondary: oklch(0.25 0.04 145);
  --secondary-foreground: oklch(0.85 0.03 145);

  --muted: oklch(0.22 0.02 145);
  --muted-foreground: oklch(0.65 0.04 145);

  --accent: oklch(0.28 0.04 145);
  --accent-foreground: oklch(0.92 0.02 145);

  --destructive: oklch(0.65 0.2 25);
  --destructive-foreground: oklch(1 0 0);

  --border: oklch(0.28 0.03 145);
  --input: oklch(0.28 0.03 145);
  --ring: oklch(0.65 0.12 145);

  --chart-1: oklch(0.65 0.12 145);
  --chart-2: oklch(0.7 0.1 200);
  --chart-3: oklch(0.72 0.1 260);
  --chart-4: oklch(0.75 0.1 60);
  --chart-5: oklch(0.7 0.15 330);

  --sidebar: oklch(0.1 0.01 145);
  --sidebar-foreground: oklch(0.9 0.02 145);
  --sidebar-primary: oklch(0.65 0.12 145);
  --sidebar-primary-foreground: oklch(0.1 0.01 145);
  --sidebar-accent: oklch(0.22 0.04 145);
  --sidebar-accent-foreground: oklch(0.9 0.02 145);
  --sidebar-border: oklch(0.28 0.04 145);
  --sidebar-ring: oklch(0.65 0.12 145);
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  html {
    font-size: var(--base-font-size, 14px);
  }
  body {
    @apply bg-background text-foreground;
  }
}
