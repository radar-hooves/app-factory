@import 'tailwindcss';
@import '@poodle64/design-tokens/tokens.tw.css';
@import '@poodle64/design-tokens/tokens.css';

/* The component stylesheet. Carries the shadcn semantic surface (--card,
   --popover, --muted, --accent, --input, --radius, and the -foreground pairs)
   AND the Tailwind registration those names need, so bg-card / bg-muted /
   bg-accent / border-input compile to real rules instead of nothing at all.
   Must come after the token imports: every name in it aliases a --ds-* token. */
@import '@poodle64/ui/styles.css';
@import 'tw-animate-css';

/* @poodle64/ui ships in node_modules, outside Tailwind's default src/ scan —
   without this the shared components render unstyled: no build error, no
   lint hit, just missing classes in the compiled CSS. */
@source '../node_modules/@poodle64/ui/dist';

@custom-variant dark (&:is(.dark *));

/*
  Per-app primary override for {{ project_name }}.

  The shared token sheet provides all surface, status, radius, spacing, and
  font tokens. Only override --ds-color-primary here. All other brand
  colour adjustments belong in the shared token sheet first.

  Eucalyptus defaults (hue 145) — replace XXX with your chosen hue if different.
*/
:root {
  --ds-color-primary:            oklch(0.55 0.12 145);
  --ds-color-primary-foreground: oklch(1 0 0);
  --ds-color-ring:               oklch(0.55 0.12 145);
}

.dark {
  --ds-color-primary:            oklch(0.65 0.12 145);
  --ds-color-primary-foreground: oklch(0.1 0.01 145);
  --ds-color-ring:               oklch(0.65 0.12 145);
}

/*
  App-local vars not provided by the packages.

  There is deliberately no shadcn alias layer here. @poodle64/ui/styles.css
  ships that whole surface — the --ds-* mapping AND the @theme inline
  registration Tailwind needs — so an app writing its own would only fight it.
  Sidebar and chart colours are the exception the package leaves to each app:
  it ships no sidebar or chart component, and chrome hue is genuinely a
  per-app decision, so they are declared and registered below.
*/
:root {
  --sidebar:                  oklch(0.15 0.01 145);
  --sidebar-foreground:       oklch(0.9 0.02 145);
  --sidebar-primary:          var(--ds-color-primary);
  --sidebar-primary-foreground: var(--ds-color-primary-foreground);
  --sidebar-accent:           oklch(0.25 0.04 145);
  --sidebar-accent-foreground: oklch(0.9 0.02 145);
  --sidebar-border:           oklch(0.3 0.04 145);
  --sidebar-ring:             var(--ds-color-ring);
  --chart-1: oklch(0.55 0.12 145);
  --chart-2: oklch(0.6 0.1 200);
  --chart-3: oklch(0.65 0.1 260);
  --chart-4: oklch(0.7 0.1 60);
  --chart-5: oklch(0.6 0.15 330);
}

.dark {
  --sidebar:                  oklch(0.1 0.01 145);
  --sidebar-foreground:       oklch(0.9 0.02 145);
  --sidebar-primary:          var(--ds-color-primary);
  --sidebar-primary-foreground: var(--ds-color-primary-foreground);
  --sidebar-accent:           oklch(0.22 0.04 145);
  --sidebar-accent-foreground: oklch(0.9 0.02 145);
  --sidebar-border:           oklch(0.28 0.04 145);
  --sidebar-ring:             var(--ds-color-ring);
  --chart-1: oklch(0.65 0.12 145);
  --chart-2: oklch(0.7 0.1 200);
  --chart-3: oklch(0.72 0.1 260);
  --chart-4: oklch(0.75 0.1 60);
  --chart-5: oklch(0.7 0.15 330);
}

@theme inline {
  --color-sidebar:                    var(--sidebar);
  --color-sidebar-foreground:         var(--sidebar-foreground);
  --color-sidebar-primary:            var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent:             var(--sidebar-accent);
  --color-sidebar-accent-foreground:  var(--sidebar-accent-foreground);
  --color-sidebar-border:             var(--sidebar-border);
  --color-sidebar-ring:               var(--sidebar-ring);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }

  html {
    font-size: var(--base-font-size, 14px);
  }

  body {
    @apply bg-background text-foreground;
  }
}
