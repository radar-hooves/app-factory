{% raw %}<script lang="ts">
  import { onMount } from 'svelte';

  let status = $state<string | null>(null);

  onMount(async () => {
    try {
      const res = await fetch('/api/example/');
      if (!res.ok) throw new Error(`${res.status}`);
      const items = await res.json();
      status = `Connected — ${items.length} example items in the database.`;
    } catch (err) {
      status = `Could not reach the API: ${err}`;
    }
  });
</script>

<main class="mx-auto max-w-2xl px-4 py-16">
  <h1 class="text-3xl font-bold text-primary">{% endraw %}{{ project_name }}{% raw %}</h1>
  <p class="mt-2 text-muted-foreground">{% endraw %}{{ description }}{% raw %}</p>

  {#if status}
    <p class="mt-6 rounded-md border bg-card px-4 py-3 text-sm text-card-foreground">
      {status}
    </p>
  {:else}
    <p class="mt-6 text-sm text-muted-foreground">Checking API…</p>
  {/if}
</main>
{% endraw %}
