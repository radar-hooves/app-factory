{% raw %}<script lang="ts">
  import '../app.css';
  import '@fontsource-variable/fraunces';
  import '@fontsource-variable/hanken-grotesk';
  import '@fontsource-variable/jetbrains-mono';
  import { ModeWatcher } from 'mode-watcher';
  import { AppShell } from '@poodle64/ui/app-shell';
  import { Toaster } from '@poodle64/ui/sonner';
  import { page } from '$app/state';

  let { children } = $props();

  // Page title: "Page Name — {% endraw %}{{ project_name }}{% raw %}" or bare app name.
  let pageTitle = $derived(
    page.data.title ? `${page.data.title} — {% endraw %}{{ project_name }}{% raw %}` : '{% endraw %}{{ project_name }}{% raw %}'
  );
</script>

<svelte:head>
  <title>{pageTitle}</title>
</svelte:head>

<ModeWatcher />
<Toaster richColors />

<!-- No nav yet — a fresh app has one route. Pass `nav` once there is more
     than one page to link between (rules-library/svelte/20-sveltekit-frontend.md). -->
<AppShell brandTitle="{% endraw %}{{ project_name }}{% raw %}" currentPath={page.url.pathname} content="standard">
  {@render children()}
</AppShell>
{% endraw -%}
