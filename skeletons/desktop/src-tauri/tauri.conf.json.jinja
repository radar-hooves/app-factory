{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{ project_title }}",
  "version": "0.1.0",
  "identifier": "{{ bundle_identifier }}",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:{{ frontend_port }}",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "{{ project_title }}",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1 | libappindicator3-1"]
      }
    }
  }
}
