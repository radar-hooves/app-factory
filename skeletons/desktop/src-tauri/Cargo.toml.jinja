[package]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
authors = ["poodle64"]
license = "MIT"
edition = "2024"
rust-version = "1.95"

[lib]
name = "{{ package_name }}_lib"
# rlib alone: staticlib and cdylib are what iOS and Android link; a desktop
# app's main.rs links the rlib, and the other two cost every test build a
# static archive and one more full link.
crate-type = ["rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = ["image-png"] }
tracing = "0.1"
# `tauri::generate_context!` expands to `serde_json` paths in this crate.
serde_json = "1"
# The factory's kits, at the commit this app was stamped from ({{ _copier_answers._commit }}).
desktop-shell = { git = "https://github.com/radar-hooves/app-factory", rev = "{{ _copier_conf.vcs_ref_hash }}" }
tauri-plugin-telemetry = { git = "https://github.com/radar-hooves/app-factory", rev = "{{ _copier_conf.vcs_ref_hash }}" }

[target.'cfg(not(any(target_os = "android", target_os = "ios")))'.dependencies]
tauri-plugin-process = "2"
tauri-plugin-updater = "2.14"

# Debug info stays in the objects' side files, where a debugger reads it, rather
# than in every linked test binary: each links the whole app library, and a
# handful at once outruns a 6 GB CI runner. macOS already builds this way.
[profile.dev]
split-debuginfo = "unpacked"

[profile.release]
codegen-units = 1
lto = true
opt-level = "s"
strip = true
