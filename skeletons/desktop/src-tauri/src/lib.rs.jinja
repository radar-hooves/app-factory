use tauri::Manager;

/// Telemetry targets this app allows beyond the ones the kit always does.
const TELEMETRY_TARGETS: &[&str] = &[];

/// Where the Settings pane keeps the telemetry exporter. This app keeps no
/// settings yet, so the fleet environment is the only source; implement both
/// over the app's own store once it has one.
struct TelemetrySettings;

impl tauri_plugin_telemetry::TelemetryStore for TelemetrySettings {
    fn load(&self) -> Option<tauri_plugin_telemetry::Exporter> {
        None
    }

    fn save(&self, _exporter: Option<tauri_plugin_telemetry::Exporter>) -> Result<(), String> {
        Err("{{ project_title }} keeps no settings yet".to_string())
    }
}

#[cfg_attr(mobile, tauri::mobile_entry_point)]
pub fn run() {
    tauri::Builder::default()
        .plugin(tauri_plugin_telemetry::init(
            "{{ project_name }}",
            env!("CARGO_PKG_VERSION"),
            TELEMETRY_TARGETS,
            TelemetrySettings,
        ))
        .setup(|app| {
            if let Some(window) = app.get_webview_window("main") {
                // AppKit centres the buttons in a 52-point title bar: keep the header 52 points.
                desktop_shell::traffic_lights::setup(&window);
            }
            Ok(())
        })
        .run(tauri::generate_context!())
        .expect("error while running the Tauri application");
}
