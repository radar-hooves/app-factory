name: CI

# The desktop skeleton's checks, run by the factory's reusable workflow. On a
# PR or by hand, never per push: commit hooks run the same commands first. A
# check only this app needs goes in a workflow file of its own beside this one.
on:
  pull_request:
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  desktop:
    uses: radar-hooves/app-factory/.github/workflows/desktop-ci.yaml@main
{%- if linux_cargo_args %}
    with:
      linux-cargo-args: '{{ linux_cargo_args }}'
{%- endif %}
