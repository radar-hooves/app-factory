<!doctype html>
<html lang="en"{% if density == 'compact' %} data-ds-density="compact"{% endif %}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{{ project_title }}</title>
{%- if dark_first %}
		<!-- Dark-first: seeds mode-watcher's key and class before first paint when nothing is stored (static/dark-seed.js). -->
		<script src="/dark-seed.js"></script>
{%- endif %}
		%sveltekit.head%
	</head>
	<body data-sveltekit-preload-data="hover">
		<div style="display: contents">%sveltekit.body%</div>
	</body>
</html>
