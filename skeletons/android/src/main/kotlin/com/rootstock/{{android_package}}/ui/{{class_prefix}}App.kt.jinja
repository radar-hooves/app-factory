/** What the home screen is called in the interaction trace. */
private val HOME = Label.of("{{android_package}}_home")

/** The app's home: its title, the way to its section in Settings, and what it shows. */
@Composable
fun {{class_prefix}}App(onOpenSettings: () -> Unit) {
    RootstockScaffold(screen = HOME) { padding ->
        Column(Modifier.fillMaxSize().padding(padding)) {
            RootstockTopBar(
                title = stringResource(R.string.app_name),
                actions = { RootstockIconAction(Icons.Rounded.Settings, "Settings", onClick = onOpenSettings) },
            )
            Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                RootstockEmptyState(message = "Nothing here yet")
            }
        }
    }
}
